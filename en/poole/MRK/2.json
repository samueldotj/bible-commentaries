   "hash": "6b03b164",
   "paragraphs": [
    {
     "id": "poole/MRK.2.18#p1-07b41c43",
     "text": "Mat 9:14\", and following verses to Mat 9:17. The sum of all teacheth us:",
     "verse": 18,
     "anchor": "See Poole on \"",
     "refs": [
      {
       "text": "Mat 9:14",
       "ref": "MAT.9.14"
      },
      {
       "text": "Mat 9:17",
       "ref": "MAT.9.17"
      }
     ]
    },
    {
     "id": "poole/MRK.2.18#p2-c286e6f0",
     "text": "1. That fasting is an exercise suited to afflictive dispensations of Providence, and ought to be proportioned to its season."
    },
    {
     "id": "poole/MRK.2.18#p3-dc2fd7b7",
     "text": "2. That new converts are not to be discouraged by too severe exercises of religion, but to be trained up to them by degrees."
    }
   ]
  },
