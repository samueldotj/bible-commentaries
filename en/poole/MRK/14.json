   "kind": "passage",
   "hash": "1a470a69",
   "paragraphs": [
    {
     "id": "poole/MRK.14.46#p1-442628f4",
     "text": "Ver. 46-50. Having, to complete the history of the passion, especially as to what is said of it by Matthew, Mark, and Luke, in my notes on Matthew considered all passages relating to what Matthew saith, the things here mentioned being opened in our notes on Mat 26:50-56, need not here again be enlarged upon.",
     "refs": [
      {
       "text": "Mat 26:50-56",
       "ref": "MAT.26.50-56"
      }
     ]
    },
    {
     "id": "poole/MRK.14.46#p2-c57788d8",
     "text": "Mat 26:50\", and following verses to Mat 26:56.",
     "anchor": "See Poole on \"",
     "refs": [
