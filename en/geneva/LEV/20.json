   "paragraphs": [
    {
     "id": "geneva/LEV.20.2#p1-bf10deb5",
     "text": "By Molech he means any type of idol, Le 18:21",
     "label": "a",
     "anchor": "Molech",
     "refs": [
      {
       "text": "Le 18:21",
       "ref": "LEV.18.21"
      }
     ]
    }
   ]
  },
  {
   "id": "geneva/LEV.20.3",
   "range": "LEV.20.3",
   "kind": "passage",
   "hash": "b1639512",
   "paragraphs": [
    {
     "id": "geneva/LEV.20.3#p1-b1639512",
     "text": "Read Le 17:10,18:21.",
     "label": "b",
     "anchor": "set my face against that man",
     "refs": [
      {
       "text": "Le 17:10,18:21",
       "ref": "LEV.17.10"
      },
      {
       "text": "Le 17:10,18:21",
       "ref": "LEV.18.21"
      }
     ]
    }
   ]
  },
  {
   "id": "geneva/LEV.20.4",
   "range": "LEV.20.4",
   "kind": "passage",
   "hash": "9f580d15",
   "paragraphs": [
    {
     "id": "geneva/LEV.20.4#p1-9f580d15",
     "text": "Though the people be negligent to do their duty, and defend God's right, yet he will not allow wickedness to go unpunished.",
     "label": "c",
     "anchor": "people of the land do any"
    }
   ]
  },
  {
   "id": "geneva/LEV.20.6",
   "range": "LEV.20.6",
   "kind": "passage",
   "hash": "79244f76",
   "paragraphs": [
    {
     "id": "geneva/LEV.20.6#p1-79244f76",
     "text": "To esteem sorcerers or conjurers is spiritual whoredom, or idolatry.",
     "label": "d",
     "anchor": "whoring after them"
    }
   ]
  },
  {
   "id": "geneva/LEV.20.9",
   "range": "LEV.20.9",
   "kind": "passage",
   "hash": "7b188248",
   "paragraphs": [
    {
     "id": "geneva/LEV.20.9#p1-7b188248",
     "text": "He is worthy to die.",
     "label": "e",
     "anchor": "his blood shall be upon him"
    }
   ]
  },
  {
   "id": "geneva/LEV.20.14",
   "range": "LEV.20.14",
   "kind": "passage",
   "hash": "d17c4efd",
   "paragraphs": [
    {
     "id": "geneva/LEV.20.14#p1-d17c4efd",
     "text": "It is an abominable and detestable thing.",
     "label": "f",
     "anchor": "it is wickedness"
    }
   ]
  },
  {
   "id": "geneva/LEV.20.20",
   "range": "LEV.20.20",
   "kind": "passage",
   "hash": "f7f63120",
   "paragraphs": [
    {
     "id": "geneva/LEV.20.20#p1-f7f63120",
     "text": "They shall be cut off from their people, and their children shall be taken as bastards, and not counted among the Israelites.",
     "label": "g",
     "anchor": "childless"
    }
   ]
  },
  {
   "id": "geneva/LEV.20.21",
   "range": "LEV.20.21",
   "kind": "passage",
   "hash": "3319b053",
   "paragraphs": [
    {
     "id": "geneva/LEV.20.21#p1-3319b053",
     "text": "Read Le 18:16.",
     "label": "h",
     "anchor": "nakedness",
     "refs": [
      {
       "text": "Le 18:16",
       "ref": "LEV.18.16"
      }
     ]
    }
   ]
  },
  {
   "id": "geneva/LEV.20.24",
   "range": "LEV.20.24",
   "kind": "passage",
   "hash": "b0c20d94",
   "paragraphs": [
    {
     "id": "geneva/LEV.20.24#p1-b0c20d94",
     "text": "Full of abundance of all things.",
     "label": "i",
     "anchor": "floweth with milk and honey"
    }
   ]
  },
  {
   "id": "geneva/LEV.20.25",
   "range": "LEV.20.25",
   "kind": "passage",
   "hash": "f5f7ca63",
   "paragraphs": [
    {
     "id": "geneva/LEV.20.25#p1-f5f7ca63",
     "text": "By eating them contrary to my commandment.",
     "label": "k",
     "anchor": "abominable by beast"
    }
   ]
  }
 ]
}
