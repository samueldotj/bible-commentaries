 "units": [
  {
   "id": "geneva/JOS.16.1",
   "range": "JOS.16.1",
   "kind": "passage",
   "hash": "55992a82",
   "paragraphs": [
    {
     "id": "geneva/JOS.16.1#p1-55992a82",
     "text": "That is, to Ephraim and his children: for Manasseh's portion follows.",
     "label": "a",
     "anchor": "children of Joseph fell from Jordan"
    }
   ]
  },
  {
   "id": "geneva/JOS.16.3",
   "range": "JOS.16.3",
   "kind": "passage",
   "hash": "25c2806e",
   "paragraphs": [
    {
     "id": "geneva/JOS.16.3#p1-25c2806e",
     "text": "Of their inheritance.",
     "label": "b",
     "anchor": "thereof are at the sea"
    }
   ]
  },
  {
   "id": "geneva/JOS.16.4",
   "range": "JOS.16.4",
   "kind": "passage",
   "hash": "22234fe5",
   "paragraphs": [
    {
     "id": "geneva/JOS.16.4#p1-22234fe5",
     "text": "Severally, first Ephraim, and then Manasseh.",
     "label": "c",
     "anchor": "took their inheritance"
    }
   ]
  },
  {
   "id": "geneva/JOS.16.7",
   "range": "JOS.16.7",
   "kind": "passage",
   "hash": "be871242",
   "paragraphs": [
    {
     "id": "geneva/JOS.16.7#p1-be871242",
     "text": "For so far the coasts reach.",
     "label": "d",
     "anchor": "and went out at Jordan"
    }
   ]
  },
  {
   "id": "geneva/JOS.16.9",
   "range": "JOS.16.9",
   "kind": "passage",
   "hash": "ee7de6f7",
   "paragraphs": [
    {
     "id": "geneva/JOS.16.9#p1-ee7de6f7",
     "text": "Because Ephraim's tribe was far greater than Manasseh, therefore he had more cities.",
     "label": "e",
     "anchor": "separate cities for the children of"
    }
   ]
  }
 ]
}
