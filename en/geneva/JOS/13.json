   "paragraphs": [
    {
     "id": "geneva/JOS.13.22#p1-7f9e7c3d",
     "text": "So that both they who obeyed wicked counsel and the wicked counsellor perished by the just judgment of God.",
     "label": "f",
     "anchor": "Balaam also the son of Beor"
    }
   ]
  },
  {
