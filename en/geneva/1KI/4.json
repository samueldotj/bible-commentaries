{
 "source": "geneva",
 "book": "1KI",
 "chapter": 4,
 "units": [
  {
   "id": "geneva/1KI.4.2",
   "range": "1KI.4.2",
   "kind": "passage",
   "hash": "837af532",
   "paragraphs": [
    {
     "id": "geneva/1KI.4.2#p1-08354e63",
     "text": "That is, his chief officers.",
     "label": "a",
     "anchor": "princes which he had"
    },
    {
     "id": "geneva/1KI.4.2#p2-1fa59d78",
     "text": "He was the son of Achimais and Zadok's nephew.",
     "label": "b",
     "anchor": "Azariah the son of Zadok the"
    }
   ]
  },
  {
   "id": "geneva/1KI.4.4",
   "range": "1KI.4.4",
   "kind": "passage",
   "hash": "d2a63c84",
   "paragraphs": [
    {
     "id": "geneva/1KI.4.4#p1-d2a63c84",
     "text": "Not Abiathar whom Solomon had put from his office, 1Ki 2:27 but another of that name.",
     "label": "c",
     "anchor": "Abiathar were the priests",
     "refs": [
      {
       "text": "1Ki 2:27",
       "ref": "1KI.2.27"
      }
     ]
    }
   ]
  },
  {
   "id": "geneva/1KI.4.13",
   "range": "1KI.4.13",
   "kind": "passage",
   "hash": "0c4bc32b",
   "paragraphs": [
    {
     "id": "geneva/1KI.4.13#p1-0c4bc32b",
     "text": "Which bore Jair's name, because he took them from the Canaanites, Nu 32:41.",
     "label": "d",
     "anchor": "Jair the son of Manasseh",
     "refs": [
      {
       "text": "Nu 32:41",
       "ref": "NUM.32.41"
      }
     ]
    }
   ]
  },
  {
   "id": "geneva/1KI.4.17",
   "range": "1KI.4.17",
   "kind": "passage",
   "hash": "79e26a7f",
   "paragraphs": [
    {
     "id": "geneva/1KI.4.17#p1-79e26a7f",
     "text": "Solomon did not observe the division that Joshua made, but divided it as might best serve his purposes.",
     "label": "e",
     "anchor": "Issachar"
    }
   ]
  },
  {
   "id": "geneva/1KI.4.20",
   "range": "1KI.4.20",
   "kind": "passage",
   "hash": "f20a7fbd",
   "paragraphs": [
    {
     "id": "geneva/1KI.4.20#p1-f20a7fbd",
     "text": "They lived in all peace and security.",
     "label": "f",
     "anchor": "eating and drinking"
    }
   ]
  },
  {
   "id": "geneva/1KI.4.21",
   "range": "1KI.4.21",
   "kind": "passage",
   "hash": "34ab39d1",
   "paragraphs": [
    {
     "id": "geneva/1KI.4.21#p1-34ab39d1",
     "text": "Which is the Euphrates.",
     "label": "g",
     "anchor": "river unto the land of the"
    }
   ]
  },
  {
   "id": "geneva/1KI.4.24",
   "range": "1KI.4.24",
   "kind": "passage",
   "hash": "05d7a285",
   "paragraphs": [
    {
     "id": "geneva/1KI.4.24#p1-05d7a285",
     "text": "For they were all tributaries to him.",
     "label": "h",
     "anchor": "kings on this side the river"
    }
   ]
  },
  {
   "id": "geneva/1KI.4.25",
   "range": "1KI.4.25",
   "kind": "passage",
   "hash": "f4529896",
   "paragraphs": [
    {
     "id": "geneva/1KI.4.25#p1-f4529896",
     "text": "Throughout all Israel.",
     "label": "i",
     "anchor": "Dan even to Beersheba"
    }
   ]
  },
  {
   "id": "geneva/1KI.4.29",
   "range": "1KI.4.29",
   "kind": "passage",
   "hash": "551231bc",
   "paragraphs": [
    {
     "id": "geneva/1KI.4.29#p1-551231bc",
     "text": "Meaning, great understanding and able to comprehend all things.",
     "label": "k",
     "anchor": "largeness of heart"
    }
   ]
  },
  {
   "id": "geneva/1KI.4.30",
   "range": "1KI.4.30",
   "kind": "passage",
   "hash": "946966c8",
   "paragraphs": [
    {
     "id": "geneva/1KI.4.30#p1-946966c8",
     "text": "That is, the philosophers and astronomers who were judged most wise.",
     "label": "l",
     "anchor": "east country"
    }
   ]
  },
  {
   "id": "geneva/1KI.4.32",
   "range": "1KI.4.32",
   "kind": "passage",
   "hash": "53f8c8c2",
   "paragraphs": [
    {
     "id": "geneva/1KI.4.32#p1-53f8c8c2",
     "text": "Which for the most part are thought to have perished in the captivity of Babylon.",
     "label": "m",
     "anchor": "proverbs"
    }
   ]
  },
  {
   "id": "geneva/1KI.4.33",
   "range": "1KI.4.33",
   "kind": "passage",
   "hash": "ee6a5549",
   "paragraphs": [
    {
     "id": "geneva/1KI.4.33#p1-ee6a5549",
     "text": "From the highest to the lowest.",
     "label": "n",
     "anchor": "hyssop that springeth out of the"
    }
   ]
  }
 ]
}
