{
 "source": "geneva",
 "book": "EXO",
 "chapter": 22,
 "units": [
  {
   "id": "geneva/EXO.22.1",
   "range": "EXO.22.1",
   "kind": "passage",
   "hash": "24c83be7",
   "paragraphs": [
    {
     "id": "geneva/EXO.22.1#p1-24c83be7",
     "text": "Either a great beast of the herd, or a small beast of the flock.",
     "label": "a",
     "anchor": "ox"
    }
   ]
  },
  {
   "id": "geneva/EXO.22.2",
   "range": "EXO.22.2",
   "kind": "passage",
   "hash": "90767e4c",
   "paragraphs": [
    {
     "id": "geneva/EXO.22.2#p1-90767e4c",
     "text": "Breaking a house to enter in, or undermining.",
     "label": "b",
     "anchor": "breaking up"
    }
   ]
  },
  {
   "id": "geneva/EXO.22.3",
   "range": "EXO.22.3",
   "kind": "passage",
   "hash": "3df337e2",
   "paragraphs": [
    {
     "id": "geneva/EXO.22.3#p1-3df337e2",
     "text": "He shall be put to death that kills him.",
     "label": "c",
     "anchor": "blood shed for him"
    }
   ]
  },
  {
   "id": "geneva/EXO.22.8",
   "range": "EXO.22.8",
   "kind": "passage",
   "hash": "5b81b651",
   "paragraphs": [
    {
     "id": "geneva/EXO.22.8#p1-5b81b651",
     "text": "That is, whether he has stolen.",
     "label": "d",
     "anchor": "put his hand unto his neighbour's"
    }
   ]
  },
  {
   "id": "geneva/EXO.22.11",
   "range": "EXO.22.11",
   "kind": "passage",
   "hash": "f7937ccc",
   "paragraphs": [
    {
     "id": "geneva/EXO.22.11#p1-f7937ccc",
     "text": "They should swear by the name of the Lord.",
     "label": "e",
     "anchor": "Then shall an oath of the"
    }
   ]
  },
  {
   "id": "geneva/EXO.22.13",
   "range": "EXO.22.13",
   "kind": "passage",
   "hash": "147a2f52",
   "paragraphs": [
    {
     "id": "geneva/EXO.22.13#p1-147a2f52",
     "text": "He shall show some part of the beast or bring in witnesses.",
     "label": "f",
     "anchor": "it for witness"
    }
   ]
  },
  {
   "id": "geneva/EXO.22.15",
   "range": "EXO.22.15",
   "kind": "passage",
   "hash": "e5176f90",
   "paragraphs": [
    {
     "id": "geneva/EXO.22.15#p1-e5176f90",
     "text": "He that hired it shall be free by paying the hire.",
     "label": "g",
     "anchor": "came for his hire"
    }
   ]
  },
  {
   "id": "geneva/EXO.22.24",
   "range": "EXO.22.24",
   "kind": "passage",
   "hash": "007cb308",
   "paragraphs": [
    {
     "id": "geneva/EXO.22.24#p1-007cb308",
     "text": "The just plague of God on the oppressors.",
     "label": "h",
     "anchor": "wives shall be widows"
    }
   ]
  },
  {
   "id": "geneva/EXO.22.27",
   "range": "EXO.22.27",
   "kind": "passage",
   "hash": "3cc9260d",
   "paragraphs": [
    {
     "id": "geneva/EXO.22.27#p1-3cc9260d",
     "text": "For cold and necessity.",
     "label": "i",
     "anchor": "crieth unto me"
    }
   ]
  },
  {
   "id": "geneva/EXO.22.29",
   "range": "EXO.22.29",
   "kind": "passage",
   "hash": "34751c7d",
   "paragraphs": [
    {
     "id": "geneva/EXO.22.29#p1-34751c7d",
     "text": "Your abundance of your corn.",
     "label": "k",
     "anchor": "first of thy ripe fruits"
    }
   ]
  },
  {
   "id": "geneva/EXO.22.31",
   "range": "EXO.22.31",
   "kind": "passage",
   "hash": "4096df49",
   "paragraphs": [
    {
     "id": "geneva/EXO.22.31#p1-4096df49",
     "text": "And so have nothing to do with it.",
     "label": "l",
     "anchor": "to the dogs"
    }
   ]
  }
 ]
}
