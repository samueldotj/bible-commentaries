   "hash": "5fea4136",
   "paragraphs": [
    {
     "id": "geneva/EXO.27.1#p1-5fea4136",
     "text": "For the burnt offering.",
     "label": "a",
     "anchor": "altar of shittim wood"
    }
   ]
  },
  {
   "id": "geneva/EXO.27.2",
   "range": "EXO.27.2",
   "kind": "passage",
   "hash": "340a3c1d",
   "paragraphs": [
    {
     "id": "geneva/EXO.27.2#p1-340a3c1d",
     "text": "Of the same wood and matter not fastened to it.",
     "label": "b",
     "anchor": "the same"
    }
   ]
  },
  {
   "id": "geneva/EXO.27.9",
   "range": "EXO.27.9",
   "kind": "passage",
   "hash": "9de52f34",
   "paragraphs": [
    {
     "id": "geneva/EXO.27.9#p1-9de52f34",
     "text": "This was the first entry into the tabernacle, where the people abode.",
     "label": "c",
     "anchor": "court of the tabernacle"
    }
   ]
  },
  {
   "id": "geneva/EXO.27.10",
   "range": "EXO.27.10",
   "kind": "passage",
   "hash": "2bf3bae0",
   "paragraphs": [
    {
     "id": "geneva/EXO.27.10#p1-2bf3bae0",
     "text": "They were certain hoops or circles to beautify the pillar.",
     "label": "d",
     "anchor": "fillets shall be of silver"
    }
   ]
  },
  {
   "id": "geneva/EXO.27.13",
   "range": "EXO.27.13",
   "kind": "passage",
   "hash": "32922777",
   "paragraphs": [
    {
     "id": "geneva/EXO.27.13#p1-32922777",
     "text": "Meaning curtains of fifty cubits.",
     "label": "e",
     "anchor": "fifty cubits"
    }
   ]
  },
  {
   "id": "geneva/EXO.27.14",
   "range": "EXO.27.14",
   "kind": "passage",
   "hash": "81386c7f",
   "paragraphs": [
    {
     "id": "geneva/EXO.27.14#p1-81386c7f",
     "text": "Of the door of the court.",
     "label": "f",
     "anchor": "side of the gate shall be"
    }
   ]
  },
  {
   "id": "geneva/EXO.27.19",
   "range": "EXO.27.19",
   "kind": "passage",
   "hash": "58dee303",
   "paragraphs": [
    {
     "id": "geneva/EXO.27.19#p1-58dee303",
     "text": "Or stakes, with which the curtains were fastened to the ground.",
     "label": "g",
     "anchor": "pins thereof"
    }
   ]
  },
  {
   "id": "geneva/EXO.27.20",
   "range": "EXO.27.20",
   "kind": "passage",
   "hash": "a95ab4c2",
   "paragraphs": [
    {
     "id": "geneva/EXO.27.20#p1-a95ab4c2",
     "text": "Such as comes from the olive, when it is first pressed or beaten.",
     "label": "h",
     "anchor": "beaten for the light"
    }
   ]
  }
 ]
}
