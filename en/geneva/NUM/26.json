   "kind": "passage",
   "hash": "17014436",
   "paragraphs": [
    {
     "id": "geneva/NUM.26.51#p1-17014436",
     "text": "This is the third time that they are numbered.",
     "label": "f",
     "anchor": "numbered of the children of Israel"
    }
   ]
  },
  {
   "id": "geneva/NUM.26.64",
   "range": "NUM.26.64",
   "kind": "passage",
   "hash": "9b92cdb6",
   "paragraphs": [
    {
     "id": "geneva/NUM.26.64#p1-9b92cdb6",
     "text": "In which appears the great power of God, that so wonderfully increased his people.",
     "label": "g",
     "anchor": "whom Moses and Aaron the priest"
    }
   ]
  }
 ]
