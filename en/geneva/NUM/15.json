   "paragraphs": [
    {
     "id": "geneva/NUM.15.7#p1-6edd4dd9",
     "text": "The liquor was so called, because it was poured on the thing that was offered.",
     "label": "c",
     "anchor": "drink offering thou shalt offer the"
    }
   ]
  },
  {
   "id": "geneva/NUM.15.12",
   "range": "NUM.15.12",
   "kind": "passage",
   "hash": "37aec9e9",
   "paragraphs": [
    {
     "id": "geneva/NUM.15.12#p1-37aec9e9",
     "text": "Every sacrifice of beasts must have their meat offering and drink offering according to this proportion.",
     "label": "d",
     "anchor": "that ye shall prepare"
    }
   ]
  },
  {
   "id": "geneva/NUM.15.20",
   "range": "NUM.15.20",
