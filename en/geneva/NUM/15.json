   "hash": "1ab7b306",
   "paragraphs": [
    {
     "id": "geneva/NUM.15.20#p1-1ab7b306",
     "text": "Which is made from the first corn you harvest.",
     "label": "e",
     "anchor": "dough for an heave offering"
    }
   ]
  },
  {
   "id": "geneva/NUM.15.22",
