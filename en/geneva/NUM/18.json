{
 "source": "geneva",
 "book": "NUM",
 "chapter": 18,
 "units": [
  {
   "id": "geneva/NUM.18.1",
   "range": "NUM.18.1",
   "kind": "passage",
   "hash": "f3248a8c",
   "paragraphs": [
    {
     "id": "geneva/NUM.18.1#p1-f3248a8c",
     "text": "If you trespass in anything concerning the ceremonies of the sanctuary of your office, you will be punished.",
     "label": "a",
     "anchor": "the iniquity of the sanctuary"
    }
   ]
  },
  {
   "id": "geneva/NUM.18.3",
   "range": "NUM.18.3",
   "kind": "passage",
   "hash": "a076fe83",
   "paragraphs": [
    {
     "id": "geneva/NUM.18.3#p1-a076fe83",
     "text": "That is, the things which are committed to you, or, which you command them.",
     "label": "b",
     "anchor": "keep thy charge"
    }
   ]
  },
  {
   "id": "geneva/NUM.18.4",
   "range": "NUM.18.4",
   "kind": "passage",
   "hash": "b607b2a4",
   "paragraphs": [
    {
     "id": "geneva/NUM.18.4#p1-b607b2a4",
     "text": "Which was not of the tribe of Levi.",
     "label": "c",
     "anchor": "stranger shall not come nigh unto"
    }
   ]
  },
  {
   "id": "geneva/NUM.18.8",
   "range": "NUM.18.8",
   "kind": "passage",
   "hash": "7d2156ba",
   "paragraphs": [
    {
     "id": "geneva/NUM.18.8#p1-7d2156ba",
     "text": "As the first fruit, first born, and the tithes.",
     "label": "d",
     "anchor": "offerings of all the hallowed things"
    }
   ]
  },
  {
   "id": "geneva/NUM.18.9",
   "range": "NUM.18.9",
   "kind": "passage",
   "hash": "e96869e9",
   "paragraphs": [
    {
     "id": "geneva/NUM.18.9#p1-e96869e9",
     "text": "That which was not burned should be the priests.",
     "label": "e",
     "anchor": "fire"
    }
   ]
  },
  {
   "id": "geneva/NUM.18.10",
   "range": "NUM.18.10",
   "kind": "passage",
   "hash": "248a44a7",
   "paragraphs": [
    {
     "id": "geneva/NUM.18.10#p1-248a44a7",
     "text": "That is, in the sanctuary between the court and the holiest of holies.",
     "label": "f",
     "anchor": "holy place shalt thou eat it"
    }
   ]
  },
  {
   "id": "geneva/NUM.18.11",
   "range": "NUM.18.11",
   "kind": "passage",
   "hash": "cd75e890",
   "paragraphs": [
    {
     "id": "geneva/NUM.18.11#p1-cd75e890",
     "text": "Read Le 10:14.",
     "label": "g",
     "anchor": "daughters with thee",
     "refs": [
      {
       "text": "Le 10:14",
       "ref": "LEV.10.14"
      }
     ]
    }
   ]
  },
  {
   "id": "geneva/NUM.18.12",
   "range": "NUM.18.12",
   "kind": "passage",
   "hash": "ca808b23",
   "paragraphs": [
    {
     "id": "geneva/NUM.18.12#p1-ca808b23",
     "text": "Or, fat; chiefest.",
     "label": "h",
     "anchor": "best of the oil"
    }
   ]
  },
  {
   "id": "geneva/NUM.18.17",
   "range": "NUM.18.17",
   "kind": "passage",
   "hash": "3f2952e5",
   "paragraphs": [
    {
     "id": "geneva/NUM.18.17#p1-3f2952e5",
     "text": "Because they are appointed for sacrifice.",
     "label": "i",
     "anchor": "redeem"
    }
   ]
  },
  {
   "id": "geneva/NUM.18.19",
   "range": "NUM.18.19",
   "kind": "passage",
   "hash": "a7e76b75",
   "paragraphs": [
    {
     "id": "geneva/NUM.18.19#p1-a7e76b75",
     "text": "That is, sure, stable and incorruptible.",
     "label": "k",
     "anchor": "of salt for ever before the"
    }
   ]
  },
  {
   "id": "geneva/NUM.18.20",
   "range": "NUM.18.20",
   "kind": "passage",
   "hash": "8949806c",
   "paragraphs": [
    {
     "id": "geneva/NUM.18.20#p1-8949806c",
     "text": "Of Canaan.",
     "label": "l",
     "anchor": "land"
    }
   ]
  },
  {
   "id": "geneva/NUM.18.22",
   "range": "NUM.18.22",
   "kind": "passage",
   "hash": "861bc397",
   "paragraphs": [
    {
     "id": "geneva/NUM.18.22#p1-861bc397",
     "text": "To serve in it: for the Levites are put in their place.",
     "label": "m",
     "anchor": "come nigh the tabernacle of the"
    }
   ]
  },
  {
   "id": "geneva/NUM.18.23",
   "range": "NUM.18.23",
   "kind": "passage",
   "hash": "eeac1514",
   "paragraphs": [
    {
     "id": "geneva/NUM.18.23#p1-eeac1514",
     "text": "If they fail in their office, they will be punished.",
     "label": "n",
     "anchor": "their iniquity"
    }
   ]
  },
  {
   "id": "geneva/NUM.18.27",
   "range": "NUM.18.27",
   "kind": "passage",
   "hash": "08c91530",
   "paragraphs": [
    {
     "id": "geneva/NUM.18.27#p1-08c91530",
     "text": "As acceptable as the fruit of your own ground or vineyard.",
     "label": "o",
     "anchor": "corn of the threshingfloor"
    }
   ]
  },
  {
   "id": "geneva/NUM.18.29",
   "range": "NUM.18.29",
   "kind": "passage",
   "hash": "3a1d4d8e",
   "paragraphs": [
    {
     "id": "geneva/NUM.18.29#p1-2d2b6d1f",
     "text": "Which you have received from the children of Israel.",
     "label": "p",
     "anchor": "gifts ye shall offer every heave"
    },
    {
     "id": "geneva/NUM.18.29#p2-4b13a7a4",
     "text": "Read Nu 18:12.",
     "label": "q",
     "anchor": "best thereof",
     "refs": [
      {
       "text": "Nu 18:12",
       "ref": "NUM.18.12"
      }
     ]
    }
   ]
  },
  {
   "id": "geneva/NUM.18.31",
   "range": "NUM.18.31",
   "kind": "passage",
   "hash": "628dffcf",
   "paragraphs": [
    {
     "id": "geneva/NUM.18.31#p1-628dffcf",
     "text": "As in Nu 18:11.",
     "label": "r",
     "anchor": "place",
     "refs": [
      {
       "text": "Nu 18:11",
       "ref": "NUM.18.11"
      }
     ]
    }
   ]
  },
  {
   "id": "geneva/NUM.18.32",
   "range": "NUM.18.32",
   "kind": "passage",
   "hash": "aff86e59",
   "paragraphs": [
    {
     "id": "geneva/NUM.18.32#p1-e1ce3fd4",
     "text": "You shall not be punished therefore.",
     "label": "s"
    },
    {
     "id": "geneva/NUM.18.32#p2-7b7cd1d7",
     "text": "The offerings which the Israelites have offered to God.",
     "label": "t",
     "anchor": "things of the children of Israel"
    }
   ]
  }
 ]
}
