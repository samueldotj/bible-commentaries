   "kind": "passage",
   "hash": "8567086a",
   "paragraphs": [
    {
     "id": "geneva/ISA.39.4#p1-8567086a",
     "text": "He asks him of the particulars, to make him understand the craft of the wicked, which he before being overcome with their flattery and blinded with ambition, could not see.",
     "label": "d",
     "anchor": "they seen in thy house"
    }
   ]
  },
  {
   "id": "geneva/ISA.39.6",
   "range": "ISA.39.6",
   "kind": "passage",
   "hash": "422fb03e",
   "paragraphs": [
    {
     "id": "geneva/ISA.39.6#p1-422fb03e",
     "text": "By the grievousness of the punishment is declared how greatly God detested ambition and vain glory.",
     "label": "e",
     "anchor": "carried to Babylon"
    }
   ]
  },
  {
   "id": "geneva/ISA.39.7",
   "range": "ISA.39.7",
