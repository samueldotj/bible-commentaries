   "hash": "d384816d",
   "paragraphs": [
    {
     "id": "geneva/ISA.39.7#p1-d384816d",
     "text": "That is, officers and servants.",
     "label": "f",
     "anchor": "eunuchs in the palace of the"
    }
   ]
