       "ref": "MAT.27.51"
      }
     ]
    }
   ]
  },
  {
   "id": "trapp/MRK.15.39",
   "range": "MRK.15.39",
   "kind": "passage",
   "hash": "b51fc529",
   "paragraphs": [
    {
     "id": "trapp/MRK.15.39#p1-b51fc529",
     "text": "{See Trapp on \"Mat 27:54\"} {See Trapp on \"Mat 27:55\"}",
     "refs": [
      {
       "text": "Mat 27:54",
