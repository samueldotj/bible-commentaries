  {
   "id": "trapp/MRK.11.2",
   "range": "MRK.11.2",
   "kind": "passage",
   "hash": "d004ae2b",
   "paragraphs": [
    {
     "id": "trapp/MRK.11.2#p1-d004ae2b",
     "text": "As if it had been done on set purpose. Here was a wheel within a wheel, Eze 1:10, the better to convince the stubborn Jews of his kingly office.",
     "anchor": "Whereon never man sat",
     "refs": [
      {
       "text": "Eze 1:10",
       "ref": "EZK.1.10"
      }
     ]
    }
   ]
  },
  {
   "id": "trapp/MRK.11.3",
   "range": "MRK.11.3",
   "kind": "passage",
   "hash": "89debb0c",
   "paragraphs": [
    {
     "id": "trapp/MRK.11.3#p1-89debb0c",
     "text": "See here six different arguments of our Saviour’s Deity: 1. That he knew there was such an ass colt. 2. That he sent for it. 3. Foresaw that the masters of the colt would question them that set it. 4. That he professeth himself the Lord of all. 5. That he could tell they would send the colt. 6. That accordingly they did so. (Piscater.)",
     "anchor": "Say ye that the Lord hath need of him"
    }
   ]
  },
