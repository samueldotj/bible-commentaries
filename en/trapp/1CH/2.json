   "hash": "8044e86a",
   "paragraphs": [
    {
     "id": "trapp/1CH.2.3#p1-1ecff74c",
     "text": "These are first set down, (1.) For the royal dignity; (2.) For the descent of the Messiah.",
     "anchor": "The sons of Judah."
    },
    {
     "id": "trapp/1CH.2.3#p2-a8ea65f3",
     "text": "Quem nihil latet, Who seeth and punisheth secret sins.",
     "anchor": "Was evil in the sight of the Lord."
    }
   ]
  },
  {
   "id": "trapp/1CH.2.4",
   "range": "1CH.2.4",
   "kind": "passage",
