   "paragraphs": [
    {
     "id": "trapp/1CH.2.4#p1-18679f1c",
     "text": "{See Trapp on \"Mat 1:3\"}",
     "anchor": "And Tamar.",
     "refs": [
      {
       "text": "Mat 1:3",
       "ref": "MAT.1.3"
      }
     ]
    }
   ]
  },
  {
   "id": "trapp/1CH.2.6",
   "range": "1CH.2.6",
   "kind": "passage",
   "hash": "82148543",
   "paragraphs": [
    {
     "id": "trapp/1CH.2.6#p1-82148543",
     "text": "Of these, see on 1Ki 4:31.",
     "anchor": "And Ethan, and Heman, &c.",
     "refs": [
