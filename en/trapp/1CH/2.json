       "text": "1Ki 4:31",
       "ref": "1KI.4.31"
      }
     ]
    }
   ]
  },
  {
   "id": "trapp/1CH.2.7",
   "range": "1CH.2.7",
   "kind": "passage",
   "hash": "ff2d0c6a",
   "paragraphs": [
    {
     "id": "trapp/1CH.2.7#p1-ff2d0c6a",
     "text": "Alias Achan, {Jos 6:1-27; Jos 7:1-26} per paranomasiam.",
     "anchor": "Achar.",
     "refs": [
      {
       "text": "Jos 6:1-27",
       "ref": "JOS.6.1-27"
      },
      {
       "text": "Jos 7:1-26",
       "ref": "JOS.7.1-26"
      }
     ]
    }
   ]
  },
  {
   "id": "trapp/1CH.2.8",
   "range": "1CH.2.8",
   "kind": "passage",
   "hash": "4c438b4d",
   "paragraphs": [
    {
     "id": "trapp/1CH.2.8#p1-4c438b4d",
     "text": "Sons, that is, son: synecdoche.",
     "anchor": "And the sons of Ethan."
    }
   ]
  },
  {
