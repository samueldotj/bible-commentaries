  {
   "id": "trapp/LUK.9.18",
   "range": "LUK.9.18",
   "kind": "passage",
   "hash": "5228dce4",
   "paragraphs": [
    {
     "id": "trapp/LUK.9.18#p1-5228dce4",
     "text": "Examinationi preces praemittendae. All our sacrifices should be salted with this salt.",
     "anchor": "As he was alone praying"
    }
   ]
  },
  {
   "id": "trapp/LUK.9.19",
   "range": "LUK.9.19",
   "kind": "passage",
   "hash": "339ef5c1",
   "paragraphs": [
    {
     "id": "trapp/LUK.9.19#p1-339ef5c1",
     "text": "This Pythagorean transanimation is held by the Jews to this day, viz. ( ut singuli tertio renascantur) against so many clear testimonies of Scripture to the contrary.",
     "anchor": "But some say Elias"
    }
   ]
  },
  {
   "id": "trapp/LUK.9.20",
   "range": "LUK.9.20",
   "kind": "passage",
   "hash": "24bc0003",
   "paragraphs": [
