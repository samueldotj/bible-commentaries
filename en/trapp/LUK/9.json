   ]
  },
  {
   "id": "trapp/LUK.9.13",
   "range": "LUK.9.13",
   "kind": "passage",
   "hash": "216ce646",
   "paragraphs": [
    {
     "id": "trapp/LUK.9.13#p1-216ce646",
     "text": "Which is a thing not only improbable, but impossible. They held it an absurd notion.",
     "anchor": "Except we should go, &c."
    }
   ]
  },
