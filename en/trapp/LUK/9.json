   "paragraphs": [
    {
     "id": "trapp/LUK.9.2#p1-a7ca9db5",
     "text": "See Mat 10:1; Mar 3:13; Mar 6:7.",
     "refs": [
      {
       "text": "Mat 10:1",
       "ref": "MAT.10.1"
      },
      {
       "text": "Mar 3:13",
       "ref": "MRK.3.13"
      },
