 "units": [
  {
   "id": "geneva/1KI.13.1",
   "source_hash": "ef1c4baa",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1KI.13.1#p1-62fe8e64",
     "text": "அதாவது, ஒரு தீர்க்கதரிசி.",
     "anchor": "தேவனுடைய மனிதன் ஒருவன்"
    },
    {
     "id": "geneva/1KI.13.1#p2-fb15aa4e",
     "text": "அது பென்யமீனில் இருந்த லூஸ் என்று அழைக்கப்பட்ட இடம் அல்ல, அந்த பெயருடைய வேறொரு இடம்.",
     "anchor": "பெத்தேல்"
    }
   ]
  },
  {
   "id": "geneva/1KI.13.3",
   "source_hash": "8633096f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1KI.13.3#p1-8633096f",
     "text": "இந்த அடையாளத்தினாலே கர்த்தர் என்னை அனுப்பினார் என்பதை நீ அறிந்துகொள்வாய்.",
     "anchor": "யெகோவா சொன்னதற்கு இதுவே அடையாளம்"
    }
   ]
  },
  {
   "id": "geneva/1KI.13.4",
   "source_hash": "3cb46fb5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1KI.13.4#p1-3cb46fb5",
     "text": "துன்மார்க்கர் தேவனுடைய நியாயத்தீர்ப்பைத் தங்களுக்குத் தெரிவிக்கும் தேவனுடைய தீர்க்கதரிசிகளுக்கு விரோதமாகக் கோபங்கொள்கிறார்கள்.",
     "anchor": "அவனைப் பிடியுங்கள்"
    }
   ]
  },
  {
   "id": "geneva/1KI.13.6",
   "source_hash": "ae970c90",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1KI.13.6#p1-ae970c90",
     "text": "துன்மார்க்கர் தேவனுடைய நியாயத்தீர்ப்பை உணரும்போது சிலகாலம் தங்களைத் தாழ்த்தினாலும், தங்களுடைய பழைய துன்மார்க்கத்திற்கே திரும்புகிறார்கள், தாங்கள் வெறும் மாயமான மாயக்காரர் என்பதை வெளிப்படுத்துகிறார்கள்.",
     "anchor": "உன்னுடைய தேவனாகிய யெகோவாவுடைய சமுகத்தை நோக்கி வேண்டிக்கொண்டு"
    }
   ]
  },
  {
   "id": "geneva/1KI.13.9",
   "source_hash": "61d96f5d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1KI.13.9#p1-61d96f5d",
     "text": "அவனுக்குத் தேவனுடைய வார்த்தை நேரடியாகக் கொடுக்கப்பட்டிருந்தபடியால், மனிதனுடையதோ தூதனுடையதோ ஆன எந்த வேண்டுகோளுக்கும் அவன் அதிலிருந்து விலகக்கூடாது.",
     "anchor": "அப்பம் சாப்பிடாமலும்"
    }
   ]
  },
  {
   "id": "geneva/1KI.13.15",
   "source_hash": "949d8209",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1KI.13.15#p1-949d8209",
     "text": "தீர்க்கதரிசி ஒருவனுக்கு நட்பைக் காண்பிப்பது தன் கடமை என்று எண்ணி, அவன் இதை எளிய மனதுடனே செய்தான்.",
     "anchor": "என்னோடு வீட்டுக்கு வந்து"
    }
   ]
  },
  {
   "id": "geneva/1KI.13.18",
   "source_hash": "8db8f8df",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1KI.13.18#p1-8db8f8df",
     "text": "இவனுடைய குற்றம் இங்கே இரண்டு விதமானது; முதலாவது, தேவனுடைய வெளிப்படையான கற்பனைக்குக் கீழ்ப்படிய அந்தத் தீர்க்கதரிசிக்கு அவன் இடம் கொடுக்காமல் இருந்தது, இரண்டாவது, அதற்கு மாறாக ஒரு வெளிப்படுத்துதல் தனக்குக் கிடைத்ததாக அவன் பொய்யாகச் சொன்னது.",
     "anchor": "ஒரு தூதன் யெகோவாவுடைய வார்த்தையாக என்னோடு சொன்னான்"
    }
   ]
  },
  {
   "id": "geneva/1KI.13.21",
   "source_hash": "0d3fa4d3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1KI.13.21#p1-0d3fa4d3",
     "text": "தேவன் தன்னைத் தவறவழி நடத்தியவனைக் கொண்டே அவனுடைய மதிகேட்டைக் கண்டிக்கச் செய்தார்.",
     "anchor": "நீ கைக்கொள்ளாமல் யெகோவாவுடைய வார்த்தையை மீறி"
    }
   ]
  },
  {
   "id": "geneva/1KI.13.24",
   "source_hash": "4e66cf2c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1KI.13.24#p1-4e66cf2c",
     "text": "இந்தப் பயங்கரமான உதாரணத்தினால், தேவன் தம்மால் அழைக்கப்பட்ட பொறுப்பில் மனிதர்கள் தணிந்த மனத்துடனோ அல்லது வஞ்சகமாகவோ நடந்துகொள்வது எவ்வளவு ஆபத்தானது என்பதை வெளிப்படுத்துகிறார்.",
     "anchor": "ஒரு சிங்கம் அவனுக்கு எதிர்ப்பட்டு"
    }
   ]
  },
  {
   "id": "geneva/1KI.13.28",
   "source_hash": "44107e86",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1KI.13.28#p1-44107e86",
     "text": "இது தேவனுடைய நியாயத்தீர்ப்பு மாத்திரமே என்று வெளிப்படுத்துவதற்காக: ஏனெனில் சிங்கம் பசியினால் இதைச் செய்திருந்தால், அது சடலத்தையும் தின்றுவிட்டிருக்கும்.",
     "anchor": "சடலத்தை சாப்பிடவும் இல்லை"
    }
   ]
  },
  {
   "id": "geneva/1KI.13.30",
   "source_hash": "62b9d000",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1KI.13.30#p1-62b9d000",
     "text": "தனக்காக அவன் ஆயத்தம் செய்திருந்த கல்லறை.",
     "anchor": "தன்னுடைய கல்லறையில்"
    }
   ]
  },
  {
   "id": "geneva/1KI.13.33",
   "source_hash": "3392a983",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1KI.13.33#p1-3392a983",
     "text": "இவ்விதமாகத் துன்மார்க்கர் தேவனுடைய எச்சரிப்புகளால் பயன்பெறாமல், பின்னும் பின்வாங்கிக் கேடுள்ளவர்களாகி மேன்மேலும் கேடுள்ளவர்களாவார்கள், 2 தீமோத்தேயு 3:13.",
     "anchor": "தன்னுடைய பொல்லாத வழியைவிட்டுத் திரும்பாமல்"
    }
   ]
  }
 ]
}
