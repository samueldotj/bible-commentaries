 "units": [
  {
   "id": "geneva/1KI.15.2",
   "source_hash": "037962a6",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1KI.15.2#p1-037962a6",
     "text": "இவன் சாலொமோனின் மகனாகிய அப்சலோம் என்று சிலர் நினைக்கிறார்கள்.",
     "anchor": "அப்சலோமின்"
    }
   ]
  },
  {
   "id": "geneva/1KI.15.4",
   "source_hash": "41b30129",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1KI.15.4#p1-41b30129",
     "text": "அதாவது, யூதாவின்மேல் அரசாளும் ஒரு மகனைக் குறிக்கிறது.",
     "anchor": "எருசலேமில் ஒரு விளக்கை"
    }
   ]
  },
  {
   "id": "geneva/1KI.15.10",
   "source_hash": "bc8a7e38",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1KI.15.10#p1-bc8a7e38",
     "text": "அதாவது, அவனுடைய பாட்டி; தாவீது பல இடங்களில் தன் பேரக்குழந்தைகளின் தகப்பன் என்று அழைக்கப்படுவது போலவே.",
     "anchor": "அவனுடைய தாயின் பெயர் மாகாள்"
    }
   ]
  },
  {
   "id": "geneva/1KI.15.13",
   "source_hash": "2ee78724",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1KI.15.13#p1-2ee78724",
     "text": "தேவனை நிந்தித்து விக்கிரக ஆராதனை செய்கிறவர்களை, அவர்கள் உறவினராயிருந்தாலும், அதிகாரம் உள்ளவராயிருந்தாலும், அதைக் கண்டு பாராதிருக்கக் கூடாது; அவர்கள் தண்டிக்கப்படவே வேண்டும்.",
     "anchor": "ராணியாக இல்லாதபடி விலக்கிவிட்டான்"
    }
   ]
  },
  {
   "id": "geneva/1KI.15.14",
   "source_hash": "f5e3009f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1KI.15.14#p1-f5e3009f",
     "text": "அவன் தேவனை நியமிக்கப்படாத மற்ற இடங்களில் தொழுதுகொள்ள அனுமதித்தது, அறியாமையினால் வந்ததே, தீய எண்ணத்தினால் வந்ததல்ல.",
     "anchor": "அவனுடைய இருதயம் யெகோவாவோடு இணைந்திருந்தது"
    }
   ]
  },
  {
   "id": "geneva/1KI.15.17",
   "source_hash": "95fecc38",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1KI.15.17#p1-95fecc38",
     "text": "யெரொபெயாம் செய்தது போன்ற அதே காரணத்திற்காக, மக்கள் ஆசாவைப் பின்பற்றாதபடி எருசலேமுக்குப் போகாமலிருக்க வேண்டும் என்பதற்காகவே.",
     "anchor": "ராமாவைக்"
    }
   ]
  },
  {
   "id": "geneva/1KI.15.19",
   "source_hash": "0f560ba3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1KI.15.19#p1-0f560ba3",
     "text": "என்னைத் தொடர்ந்து துன்பப்படுத்தாதிருக்கும்படி.",
     "anchor": "என்னைவிட்டு விலகிப்போகும்படி"
    }
   ]
  },
  {
   "id": "geneva/1KI.15.23",
   "source_hash": "9263876c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1KI.15.23#p1-9263876c",
     "text": "அவனுக்கு கீல்வாதம் இருந்தது, மேலும் அவன் கர்த்தரிடம் அல்ல, வைத்தியர்களிடமே நம்பிக்கை வைத்தான், 2 நாளாகமம் 16:12.",
     "anchor": "கால்களில் வியாதி"
    }
   ]
  },
  {
   "id": "geneva/1KI.15.24",
   "source_hash": "511928f3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1KI.15.24#p1-511928f3",
     "text": "அவனுடைய பாட்டனாருடைய தகப்பன்.",
     "anchor": "தகப்பன்"
    }
   ]
  },
  {
   "id": "geneva/1KI.15.29",
   "source_hash": "571f04c9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1KI.15.29#p1-571f04c9",
     "text": "இவ்வாறு தேவன் ஒரு கொடுங்கோலனை எழுப்பி மற்றொருவனுடைய துன்மார்க்கத்தைத் தண்டிக்கச்செய்தார்.",
     "anchor": "யெரொபெயாமின் குடும்பத்தார் எல்லோரையும் கொலைசெய்தான்"
    }
   ]
  },
  {
   "id": "geneva/1KI.15.30",
   "source_hash": "2410ec0f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1KI.15.30#p1-2410ec0f",
     "text": "தன் கன்றுக்குட்டிகளினால் மக்களை விக்கிரக ஆராதனை செய்யப்பண்ணி, இவ்விதமாக தேவனுக்குக் கோபமுண்டாக்கினதினால்.",
     "anchor": "தேவனுக்குக் கோபமுண்டாக்கிய கோபம்"
    }
   ]
  },
  {
   "id": "geneva/1KI.15.33",
   "source_hash": "60b99065",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1KI.15.33#p1-60b99065",
     "text": "இது இஸ்ரவேலின் ராஜாக்கள் தங்கியிருந்த இடமாகும்.",
     "anchor": "திர்சாவிலே"
    }
   ]
  }
 ]
}
