    {
     "id": "geneva/2CH.5.2#p1-e438611c",
     "text": "2 சாமுவேல் 6:12ஐ வாசிக்கவும்.",
     "anchor": "தாவீதின் நகரத்திலிருந்து"
    }
   ]
  },
  {
   "id": "geneva/2CH.5.3",
   "source_hash": "8be5e035",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
