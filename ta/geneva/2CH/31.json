 "units": [
  {
   "id": "geneva/2CH.31.1",
   "source_hash": "eaaac267",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.31.1#p1-deccfeb8",
     "text": "கர்த்தருடைய கற்பனையின்படியே, உபாகமம் 7:25, யோசுவா 7:12.",
     "anchor": "சிலைகளை உடைத்து"
    },
    {
     "id": "geneva/2CH.31.1#p2-e470dc41",
     "text": "அதாவது, பஸ்காவுக்கு வந்திருந்த அனைவரும்.",
     "anchor": "இஸ்ரவேல் மக்கள் எல்லோரும்... திரும்பினார்கள்"
    }
   ]
  },
  {
   "id": "geneva/2CH.31.2",
   "source_hash": "09272890",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.31.2#p1-09272890",
     "text": "அதாவது, அவர்கள் ஒரு கூடாரத்தில் கூடிவந்ததுபோல ஆலயத்தில் கூடிவந்தார்கள்.",
     "anchor": "யெகோவாவுடைய கூடாரங்களில்"
    }
   ]
  },
  {
   "id": "geneva/2CH.31.4",
   "source_hash": "b1280904",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.31.4#p1-78d905b6",
     "text": "ஆசாரியர்களையும் லேவியர்களையும் ஆதரிக்கும்பொருட்டு தசமபாகங்களும் முதற்பலனும்.",
     "anchor": "அவர்களுக்குரிய பாகத்தை"
    },
    {
     "id": "geneva/2CH.31.4#p2-02e8f369",
     "text": "அவர்களுடைய மனது உலகக் காரியங்களுக்காகச் சிக்கிக்கொள்ளாமல், முழுமையாகவும் உற்சாகமாகவும் கர்த்தருக்கு ஊழியம் செய்யும்படியாக.",
     "anchor": "நியாயப்பிரமாணத்தை உற்சாகமாகக் கைக்கொள்ள"
    }
   ]
  },
  {
   "id": "geneva/2CH.31.6",
   "source_hash": "73b6f832",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.31.6#p1-fa4de374",
     "text": "அவைகள் ஒரு பொருத்தனையினால் கர்த்தருக்குப் பரிசுத்தம் செய்யப்பட்டவை.",
     "anchor": "தங்கள் தேவனாகிய யெகோவாவுக்குப் பரிசுத்தம் செய்யப்பட்டவைகளில்"
    },
    {
     "id": "geneva/2CH.31.6#p2-3cfb2975",
     "text": "ஆசாரியர்களும், லேவியர்களும், விதவைகளும், அனாதைச் சிறுவர்களும், தாய் தந்தையில்லாதவர்களும், அந்நியர்களும், குறைவுள்ளவர்களுமான யாவருக்கும் நிவாரணமாக அளிப்பதற்காக.",
     "anchor": "குவியல் குவியலாக"
    }
   ]
  },
  {
   "id": "geneva/2CH.31.8",
   "source_hash": "2d60a7d9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.31.8#p1-2d60a7d9",
     "text": "அவர்கள் கர்த்தரை துதித்து, அவருடைய மக்களுக்கு எல்லா செல்வாக்கும் உண்டாக ஜெபம்பண்ணினார்கள்.",
     "anchor": "ஸ்தோத்திரம் செலுத்தி"
    }
   ]
  },
  {
   "id": "geneva/2CH.31.10",
   "source_hash": "0288838d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.31.10#p1-0288838d",
     "text": "இந்த மிகுதியான தாராளகுணம் ஊழியக்காரரின் பராமரிப்புக்கு அவசியமானது என்றும், அதனால் தேவன் தம்முடைய மக்களை வாழ்வித்து, அவர்கள் கொடுக்கிறதை தம்முடைய ஆசீர்வாதத்தால் பெருகச்செய்கிறார் என்றும் அவன் காண்பிக்கிறான்.",
     "anchor": "சாப்பிட்டுத் திருப்தியடைந்தோம்"
    }
   ]
  },
  {
   "id": "geneva/2CH.31.16",
   "source_hash": "28ba41ec",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.31.16#p1-28ba41ec",
     "text": "இந்தப் பங்கீட்டில் இவர்களுக்கும் ஒரு பங்கும் விகிதமும் இருந்தது.",
     "anchor": "மூன்று வயதுமுதல், அதற்கு மேற்பட்ட"
    }
   ]
  },
  {
   "id": "geneva/2CH.31.18",
   "source_hash": "358830d9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.31.18#p1-358830d9",
     "text": "அதாவது, அதிகாரிகளுடைய உண்மையான பங்கீட்டினால் ஒவ்வொருவருக்கும் காணிக்கையாக செலுத்தப்பட்டவற்றில் தங்கள் பங்கு கிடைத்தது என்பதாகவோ, அல்லது லேவியர்கள் தங்கள் பணியில் உண்மையுள்ளவர்களாய் இருந்ததால் அவர்களுடைய மனைவிகளும் பிள்ளைகளும் அதைச் சார்ந்திருந்து ஆதரவு பெற்றார்கள் என்பதாகவோ பொருள்.",
     "anchor": "உண்மையின்படி பரிசுத்தமாக விசாரித்தார்கள்"
    }
   ]
  }
 ]
}
