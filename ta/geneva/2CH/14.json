    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.14.14#p1-5451258f",
     "text": "கர்த்தர் அவர்களைப் பயத்தால் தாக்கியிருந்தார்.",
     "anchor": "பயங்கரம் உண்டானது"
    }
   ]
  }
 ]
