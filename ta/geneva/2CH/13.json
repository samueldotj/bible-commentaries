 "units": [
  {
   "id": "geneva/2CH.13.1",
   "source_hash": "d0796456",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.13.1#p1-d0796456",
     "text": "அவர் யூதாவையும் பென்யமீனையும் குறிக்கிறார்.",
     "anchor": "யூதாவின்மேல்"
    }
   ]
  },
  {
   "id": "geneva/2CH.13.2",
   "source_hash": "6a337089",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.13.2#p1-81f9f83c",
     "text": "அல்லது மாகாள், 1 இராஜாக்கள் 15:2.",
     "anchor": "அவனுடைய தாயின் பெயர் மிகாயாள், கிபியா ஊரானாகிய ஊரியேலின் மகளாகிய"
    },
    {
     "id": "geneva/2CH.13.2#p2-f79abc6d",
     "text": "அப்சலோம் என்றும் அழைக்கப்பட்டான், ஏனெனில் அப்சலோம் அவளுடைய பாட்டனாக இருந்தான், 1 இராஜாக்கள் 15:2.",
     "anchor": "ஊரியேலின்"
    }
   ]
  },
  {
   "id": "geneva/2CH.13.4",
   "source_hash": "d5410a21",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.13.4#p1-d5410a21",
     "text": "இது எப்பிராயீம் மலைத்தேசத்தின் சிகரங்களில் ஒன்றாயிருந்தது.",
     "anchor": "செமராயிம்"
    }
   ]
  },
  {
   "id": "geneva/2CH.13.5",
   "source_hash": "d3c3a9c0",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.13.5#p1-d3c3a9c0",
     "text": "ஆகையால் அந்தக் கோத்திரத்திலிருந்து அதைக் கைப்பற்றுகிறவன் அல்லது அபகரிக்கிறவன் எவனும் கர்த்தருடைய நியமத்தை மீறுகிறவனாகும். இவ்வாறு அவன் ஒரு மாயக்காரனைப்போல தன் சொந்த நலனுக்காக தேவனுடைய வார்த்தையை எடுத்துக்காட்டுகிறான்.",
     "anchor": "தாவீதுக்கும் என்றைக்கும் ஆளும் அரசாட்சி"
    }
   ]
  },
  {
   "id": "geneva/2CH.13.7",
   "source_hash": "c2aef1be",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.13.7#p1-e9efdef7",
     "text": "இந்த வார்த்தை கல்தேய மொழியில் ரக்கா என்பதாகும், இதையே நம்முடைய இரட்சகர் மத்தேயு 5:22 இல் பயன்படுத்துகிறார்.",
     "anchor": "வீணர்கள்"
    },
    {
     "id": "geneva/2CH.13.7#p2-7ec193b1",
     "text": "இதன் பொருள், இருதயத்திலும் மனத்திண்மையிலும் என்பதாகும்.",
     "anchor": "இளவயதும் உறுதியற்ற மனமுள்ளவனாக"
    }
   ]
  },
  {
   "id": "geneva/2CH.13.9",
   "source_hash": "6602bd8f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.13.9#p1-6602bd8f",
     "text": "விக்கிரக ஆராதனை செய்பவர்களின் இயல்பை இதில் காண்பிக்கிறார்: அவர்கள் தங்கள் ஊழியக்காரரின் அழைப்பையும், வாழ்க்கையையும், உபதேசங்களையும் சோதித்தறியாமல், மிகவும் இழிவான, மிகவும் பெருத்த மிருகங்களே தங்கள் தேவைக்குப் போதுமானது என்று நினைக்கிறார்கள்.",
     "anchor": "இளங்காளையினாலும், ஏழு கடாக்களினாலும்"
    }
   ]
  },
  {
   "id": "geneva/2CH.13.11",
   "source_hash": "fc11f2f9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.13.11#p1-fc11f2f9",
     "text": "நியாயப்பிரமாணத்தில் கட்டளையிடப்பட்டிருந்தபடியே, யாத். 29:39.",
     "anchor": "காலையிலும், மாலையிலும், சர்வாங்க தகனபலிகளையும்...செலுத்தி"
    }
   ]
  },
  {
   "id": "geneva/2CH.13.12",
   "source_hash": "0b26a362",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.13.12#p1-0b26a362",
     "text": "அவர்களுடைய நியாயம் நல்லதாகவும் கர்த்தரால் ஏற்றுக்கொள்ளப்பட்டதாகவும் இருந்தபடியால், அவர்கள் வெற்றியையும் ஜெயத்தையும் சந்தேகிக்கவில்லை.",
     "anchor": "எங்கள் சேனாபதியாக எங்களோடு"
    }
   ]
  },
  {
   "id": "geneva/2CH.13.13",
   "source_hash": "615dc611",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.13.13#p1-615dc611",
     "text": "பரிசுத்த ஆவியானவரிடத்திலிருந்து வந்த நல்ல ஆலோசனையை அற்பமாக எண்ணி, அவன் வஞ்சனையினால் மேற்கொள்ளலாம் என்று நினைத்தான்.",
     "anchor": "அவர்களுக்குப் பின்னாக வரத்தக்கதாக"
    }
   ]
  },
  {
   "id": "geneva/2CH.13.18",
   "source_hash": "138bddd2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.13.18#p1-138bddd2",
     "text": "எல்லா ராஜ்யங்களின் நிலைத்திருப்பும், வெற்றிகளின் நிச்சயமும் நாம் கர்த்தரில் வைக்கும் நம்பிக்கையையும் நிச்சயத்தையும் சார்ந்திருக்கிறதென்று அவர் காண்பிக்கிறார்.",
     "anchor": "தேவனாகிய யெகோவாவைச் சார்ந்துகொண்டதால்"
    }
   ]
  }
 ]
}
