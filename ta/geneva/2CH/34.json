 "chapter": 34,
 "lang": "ta",
 "units": [
  {
   "id": "geneva/2CH.34.2",
   "source_hash": "41993118",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.34.2#p1-41993118",
     "text": "கர்த்தரைப் பின்பற்றின எல்லாக் காரியங்களிலும் அவன் தாவீதைப் பின்பற்றினான்.",
     "anchor": "தன் தகப்பனாகிய தாவீதின்"
    }
   ]
  },
  {
   "id": "geneva/2CH.34.3",
   "source_hash": "b0095b3f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.34.3#p1-b0095b3f",
     "text": "அவனுக்கு பதினாறு வயது மட்டுமே இருந்தபோது, தேவனுடைய மகிமையின்பேரில் வைராக்கியமுள்ளவனாக தன்னைக் காண்பித்தான்; இருபது வயதிலோ விக்கிரக ஆராதனையை அகற்றி, மெய்யான மார்க்கத்தை மீண்டும் நிலைநிறுத்தினான்.",
     "anchor": "இளவயதாயிருக்கும்போது"
    }
   ]
  },
  {
   "id": "geneva/2CH.34.4",
   "source_hash": "af673df3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.34.4#p1-af673df3",
     "text": "இது சீர்திருத்தத்தைத் தன் சொந்தக் கண்களால் கண்டு பார்க்க வேண்டும் என்று அவன் விரும்பினான் என்பதைக் காண்பிக்கிறது.",
     "anchor": "அவனுக்கு முன்பாகப் பாகால்களின் பலிபீடங்களை"
    }
   ]
  },
  {
   "id": "geneva/2CH.34.5",
   "source_hash": "f4218e71",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.34.5#p1-f4218e71",
     "text": "2 இராஜாக்கள் 23:16-ஐ வாசிக்கவும்.",
     "anchor": "பூசாரிகளின் எலும்புகளை அவர்களுடைய பலிபீடங்களின்மேல்"
    }
   ]
  },
  {
   "id": "geneva/2CH.34.7",
   "source_hash": "75ffc701",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.34.7#p1-75ffc701",
     "text": "தேவபக்தியுள்ள இந்த ராஜாவின் இந்தப் பெரிய பக்திவைராக்கியத்தை பரிசுத்த ஆவியானவர் மற்ற ராஜாக்களுக்கும் அதிகாரிகளுக்கும் மாதிரியாகவும் முன்மாதிரியாகவும் வைத்து, தேவன் அவர்களிடத்தில் என்ன கேட்கிறார் என்பதைக் கற்பிக்கும்படி செய்கிறார்.",
     "anchor": "பலிபீடங்களையும் இடித்து"
    }
   ]
  },
  {
   "id": "geneva/2CH.34.10",
   "source_hash": "f75a6219",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.34.10#p1-f75a6219",
     "text": "சாப்பானைக் குறிக்கிறது, முதலியன.",
     "anchor": "விசாரிப்புக்காரரானவர்களின் கையில்"
    }
   ]
  },
  {
   "id": "geneva/2CH.34.11",
   "source_hash": "51a64ccd",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.34.11#p1-51a64ccd",
     "text": "ஏனெனில் ஆலயத்தோடு இணைந்த பல பகுதிகளும் கூறுகளும் இருந்தன.",
     "anchor": "யூதாவின் ராஜாக்கள் கெடுத்துப்போட்ட அறைகளை"
    }
   ]
  },
  {
   "id": "geneva/2CH.34.12",
   "source_hash": "067030b5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.34.12#p1-067030b5",
     "text": "அதாவது, அவர்கள் தங்கள் உண்மைத்தன்மையினிமித்தம் அப்படிப்பட்ட நம்பிக்கைக்குரியவர்களாக இருந்தார்கள் என்று, அவர்கள் பெற்றுக்கொண்டதற்குக் கணக்கு கேட்கப்படவில்லை, 2 இராஜாக்கள் 22:7,9.",
     "anchor": "உண்மையாகச்"
    }
   ]
  },
  {
   "id": "geneva/2CH.34.14",
   "source_hash": "5e0cd7d2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.34.14#p1-5e0cd7d2",
     "text": "2 இராஜாக்கள் 22:8-ஐ வாசிக்கவும்.",
     "anchor": "யெகோவாவுடைய நியாயப்பிரமாணப் புத்தகத்தை"
    }
   ]
  },
  {
   "id": "geneva/2CH.34.16",
   "source_hash": "6319e3f2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.34.16#p1-6319e3f2",
     "text": "ஏனெனில் ராஜா எப்பொழுதும் இந்தப் புத்தகத்தின் ஒரு பிரதியை வைத்திருந்து, இரவும் பகலும் அதை வாசிக்கவேண்டும் என்று கட்டளையிடப்பட்டிருந்தான், உபாகமம் 17:18.",
     "anchor": "ராஜா"
    }
   ]
  },
  {
   "id": "geneva/2CH.34.19",
   "source_hash": "8896d685",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.34.19#p1-8896d685",
     "text": "தேவனுடைய வசனம் இவ்வளவு காலம் அடக்கப்பட்டு, மக்கள் அறியாமையில் வைக்கப்பட்டிருந்ததற்காகவும், அதில் அடங்கியிருந்த மீறுதல்காரருக்கு விரோதமான சாபத்தையும் கருதியும், அவன் துக்கத்தால் இப்படிச் செய்தான்.",
     "anchor": "தன் ஆடைகளைக் கிழித்துக்கொண்டு"
    }
   ]
  },
  {
   "id": "geneva/2CH.34.21",
   "source_hash": "16b8ebc7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.34.21#p1-16b8ebc7",
     "text": "இவ்வாறு தேவபக்தியுள்ளவர்கள் தங்கள் சொந்த பாவங்களுக்காக மட்டுமல்ல, தங்கள் முன்னோர்களும் தேவனுக்கு விரோதமாக குற்றம் செய்திருந்தார்கள் என்பதற்காகவும் புலம்புகிறார்கள்.",
     "anchor": "நம்முடைய முன்னோர்கள் யெகோவாவுடைய வார்த்தையை கைக்கொள்ளாமல்"
    }
   ]
  },
  {
   "id": "geneva/2CH.34.22",
   "source_hash": "539da8f9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.34.22#p1-2699e4f5",
     "text": "ஆசாரியனுடைய அல்லது ராஜாவினுடைய ஆடைகளைக் குறிக்கிறது.",
     "anchor": "ஆடைகள் வைக்கும் அறைகள்"
    },
    {
     "id": "geneva/2CH.34.22#p2-acf496ca",
     "text": "2 இராஜாக்கள் 22:15-ஐ வாசிக்கவும்.",
     "anchor": "இரண்டாம் பகுதி"
    }
   ]
  },
  {
   "id": "geneva/2CH.34.23",
   "source_hash": "4b37aedb",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.34.23#p1-4b37aedb",
     "text": "அதாவது, ராஜாவினிடத்திற்கு.",
     "anchor": "உங்களை என்னிடம் அனுப்பினவருக்கு"
    }
   ]
  },
  {
   "id": "geneva/2CH.34.25",
   "source_hash": "c29229be",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.34.25#p1-c29229be",
     "text": "விக்கிரக ஆராதனை செய்பவர்களை அவமதிக்கும்படியாக அவள் இப்படிப் பேசுகிறாள். அவர்கள் அறிவுக்கும் இயற்கைக்கும் மாறாக, தங்கள் கைகளினால் தானே செய்து உருவாக்கினதைத் தேவனாக அழைக்கிறார்கள்.",
     "anchor": "தங்கள் கைகளின் செயல்கள்"
    }
   ]
  },
  {
   "id": "geneva/2CH.34.27",
   "source_hash": "779ea02d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.34.27#p1-779ea02d",
     "text": "தேவனுடைய எச்சரிப்புகளின் நோக்கம் என்னவென்றால், தமது சொந்த மக்களை மனந்திரும்புதலுக்கு அழைக்கவும், மனந்திரும்பாதவர்களுக்கு அவர்களுடைய அழிவை உறுதிப்படுத்தவும் என்பதை இது காண்பிக்கிறது.",
     "anchor": "இளகி"
    }
   ]
  },
  {
   "id": "geneva/2CH.34.28",
   "source_hash": "409a2c76",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.34.28#p1-409a2c76",
     "text": "தேவன் ராஜாவினிமித்தம் மாத்திரம் சிலகாலத்திற்கு அவர்களை தண்டனையிலிருந்து விலக்கி வைத்தார் என்று காணப்படுவதினால், மிகச் சிலரே உண்மையான மனந்திரும்புதலினால் தொடப்பட்டிருந்தார்கள் என்று தோன்றுகிறது.",
     "anchor": "இடத்தின்"
    }
   ]
  },
  {
   "id": "geneva/2CH.34.30",
   "source_hash": "e6eaa9dc",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.34.30#p1-e6eaa9dc",
     "text": "அதில் அடங்கியிருக்கும் சாபத்திலிருந்து சிறியோர் ஆவது பெரியோர் ஆவது ஒருவரும் விலக்கப்படமுடியாதவர்கள், அவர்கள் மீறுதல் செய்தால், ஆகையால் அது அனைவருக்கும் சம்பந்தப்பட்டது என்றும், தேவனுக்குச் சரியாக ஆராதனை செய்வதன் மூலம் அந்த தண்டனைகளைத் தவிர்க்கும்படி எல்லோரும் கற்றுக்கொள்ளும்படியாக எல்லா வகுப்பினருக்கும் அதை வாசித்துக் காண்பிப்பது தன் கடமையென்றும் அவன் அறிந்திருந்தான்.",
     "anchor": "சிறியோர்"
    }
   ]
  },
  {
   "id": "geneva/2CH.34.33",
   "source_hash": "d60c9869",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.34.33#p1-d60c9869",
     "text": "அவன் எல்லோர்மேலும் பொறுப்புள்ளவனாக இருந்தபடியினாலும், அழிந்துபோகிற ஒவ்வொருவருக்காகவும் கணக்கு கொடுக்கவேண்டியிருந்தபடியினாலும், எல்லோரும் தேவனுடைய வசனத்தை ஏற்றுக்கொள்வதாக அறிக்கை செய்யும்படி பார்த்துக்கொள்வது தன் கடமையென்று அவன் நினைத்தான்.",
     "anchor": "இஸ்ரவேலிலே காணப்பட்டவர்களையெல்லாம்"
    }
   ]
  }
 ]
}
