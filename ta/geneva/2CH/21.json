 "units": [
  {
   "id": "geneva/2CH.21.2",
   "source_hash": "343403b3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.21.2#p1-343403b3",
     "text": "இஸ்ரவேல் என்பதைக்கொண்டு அவன் யூதாவையே குறித்தான் என்பதை 2 நாளாகமம் 15:17-ல் வாசிக்கவும்.",
     "anchor": "இஸ்ரவேலின்"
    }
   ]
  },
  {
   "id": "geneva/2CH.21.4",
   "source_hash": "bc9a92d1",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.21.4#p1-fd85cd2c",
     "text": "துன்மார்க்கர் எப்பொழுதும் பயத்தில் வாழ்கிறவர்களாகவும், அத்துடன் பதவி ஆசை உள்ளவர்களாகவும் இருப்பதால், அவர்கள் கொடூரமுள்ளவர்களாகி, இயற்கையின்படி எவர்களை மிகவும் நேசித்துப் பாதுகாக்க வேண்டுமோ அவர்களையே கொலை செய்யத் தயங்குவதில்லை.",
     "anchor": "தன்னுடைய சகோதரர்கள் எல்லோரையும் ... பட்டயத்தால் கொன்றுபோட்டான்"
    },
    {
     "id": "geneva/2CH.21.4#p2-41dbef7a",
     "text": "யூதா மற்றும் பென்யமீனைக் குறிக்கிறது.",
     "anchor": "இஸ்ரவேலின்"
    }
   ]
  },
  {
   "id": "geneva/2CH.21.6",
   "source_hash": "e0c4cb67",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.21.6#p1-e0c4cb67",
     "text": "இவ்வாறாக, நாம் துன்மார்க்கருடன் இணைந்தும் தேவனுக்கு ஊழியம் செய்தும் இருக்க முடியாது என்பதைக் காண்கிறோம்.",
     "anchor": "மனைவியாயிருந்தாள்"
    }
   ]
  },
  {
   "id": "geneva/2CH.21.10",
   "source_hash": "9650cbfc",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.21.10#p1-9650cbfc",
     "text": "2 இராஜாக்கள் 8:22-ஐ வாசிக்கவும்.",
     "anchor": "லிப்னா பட்டணத்தாரும் கலகம்செய்தார்கள்"
    }
   ]
  },
  {
   "id": "geneva/2CH.21.11",
   "source_hash": "3b5b3e04",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.21.11#p1-3b5b3e04",
     "text": "அதாவது, விக்கிரக ஆராதனை; ஏனெனில் விபசாரி தன் கணவனுக்குச் செய்வதுபோல, விக்கிரக ஆராதனை செய்பவன் தேவனுடைய வாக்குத்தத்தத்தை மீறுகிறான்.",
     "anchor": "வழிவிலகச்செய்து"
    }
   ]
  },
  {
   "id": "geneva/2CH.21.12",
   "source_hash": "0d8273e4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.21.12#p1-0d8273e4",
     "text": "இவர் எலிசாவாக இருந்திருக்கலாம் என்று சிலர் நினைக்கிறார்கள்; ஏனெனில் எலியாவைப்போலவே இவருக்கும் ஆவியானவர் அபரிமிதமாக அருளப்பட்டிருந்தார் என்பதனால் இவ்வாறு அழைக்கப்பட்டிருக்கலாம்.",
     "anchor": "தீர்க்கதரிசியாகிய எலியா"
    }
   ]
  },
  {
   "id": "geneva/2CH.21.15",
   "source_hash": "1a3e8804",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.21.15#p1-1a3e8804",
     "text": "தேவனைவிட்டு விலகி, விக்கிரக ஆராதனை செய்பவர்களாகவும், தங்கள் சகோதரரைக் கொலை செய்பவர்களாகவும் மாறுகிறவர்களில் இந்த முன்மாதிரி நாள்தோறும் நடைமுறையில் காணப்படுகிறதை நாம் காண்கிறோம்.",
     "anchor": "உன் குடல்கள் நாளுக்கு நாள் அழுகி விழும்வரை"
    }
   ]
  },
  {
   "id": "geneva/2CH.21.16",
   "source_hash": "bb8416cd",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.21.16#p1-bb8416cd",
     "text": "எகிப்தை நோக்கி தென்திசையில் ஆபிரிக்காவில் வேறு அரபியரும் இருந்தனர்.",
     "anchor": "எத்தியோப்பியாவுக்கடுத்த"
    }
   ]
  },
  {
   "id": "geneva/2CH.21.17",
   "source_hash": "63412d1e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.21.17#p1-63412d1e",
     "text": "இவன் 2 நாளாகமம் 22:1-ல் அகசியா என்றும், 2 நாளாகமம் 22:6-ல் அசரியா என்றும் அழைக்கப்படுகிறான்.",
     "anchor": "யோவாகாஸ்"
    }
   ]
  },
  {
   "id": "geneva/2CH.21.20",
   "source_hash": "b658cb91",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2CH.21.20#p1-b658cb91",
     "text": "அதாவது, சிலர் எழுதுகிறபடி, அவன் தன் துன்மார்க்கத்தினாலும் விக்கிரக ஆராதனையினாலும் மதிக்கப்படாமல் பதவியிழந்தான்; அதனால் அவனுடைய மகன் (அவனுடைய தகப்பன் இன்னும் உயிரோடிருக்கும்போதே) கனமில்லாமல் 22 வருடங்கள் ஆட்சிசெய்தான், தகப்பன் இறந்தபின் 2 நாளாகமம் 22:2 -ல் இருக்கிறபடி அவன் தொடர்ந்து ஆட்சிசெய்ய உறுதிப்படுத்தப்பட்டான்.",
     "anchor": "ஒருவராலும் விரும்பப்படாமல் இறந்துபோனான்்"
    }
   ]
  }
 ]
}
