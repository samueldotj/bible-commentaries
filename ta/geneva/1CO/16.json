 "chapter": 16,
 "lang": "ta",
 "units": [
  {
   "id": "geneva/1CO.16.1",
   "source_hash": "480a9ddb",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CO.16.1#p1-480a9ddb",
     "text": "பூர்வகாலத்தில் நன்கொடை பணம் அப்போஸ்தலனுடைய நியமனத்தின்படி வாரத்தின் முதலாம் நாளில் சேர்க்கப்பட்டது; அன்றைய நாளிலேயே அப்பொழுது கூடிவருவது வழக்கமாயிருந்தது.",
     "anchor": "பரிசுத்தவான்களுக்காகச் சேர்க்கப்படும் நன்கொடை பணத்தைக்குறித்து"
    }
   ]
  },
  {
   "id": "geneva/1CO.16.2",
   "source_hash": "30c7e6ff",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CO.16.2#p1-651a6c53",
     "text": "இது முற்காலத்தில் வாரத்தின் முதலாம் நாள் என்று அழைக்கப்பட்டது, ஆனால் இப்பொழுது கர்த்தருடைய நாள் என்று அழைக்கப்படுகிறது.",
     "anchor": "வாரத்தின் முதல்நாள்தோறும்"
    },
    {
     "id": "geneva/1CO.16.2#p2-b4f1b909",
     "text": "தேவன் தன்னை ஆசீர்வதித்திருக்கும் திறமைக்கு ஏற்றபடி அவனவன் செலவழிக்கவேண்டும்.",
     "anchor": "தன்தன் வரவிற்கு ஏற்றபடி"
    }
   ]
  },
  {
   "id": "geneva/1CO.16.3",
   "source_hash": "f7a2b61a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CO.16.3#p1-f7a2b61a",
     "text": "நீங்கள் அவர்களிடத்தில் கொண்டுசெல்லும்படி கொடுக்கும் கடிதங்கள்.",
     "anchor": "கடிதங்களைக்"
    }
   ]
  },
  {
   "id": "geneva/1CO.16.4",
   "source_hash": "a0748a58",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CO.16.4#p1-a0748a58",
     "text": "இந்தக் கடிதத்தின் மீதிப் பகுதி சாதாரண விஷயங்களை எழுதுவதில் செலவிடப்பட்டிருக்கிறது; ஆனாலும் எல்லாம் அவர் நோக்கமாகக் கொண்ட இலக்கிற்கே, அதாவது, தேவனுடைய மகிமைக்கும் கொரிந்தியரின் பக்திவளர்ச்சிக்கும் சம்பந்தப்பட்டிருக்கிறது.",
     "anchor": "தகுதியானது என்று தோன்றினால்"
    }
   ]
  },
  {
   "id": "geneva/1CO.16.9",
   "source_hash": "1cc164d7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CO.16.9#p1-1cc164d7",
     "text": "பெரிய காரியங்களைச் செய்யத்தக்க மிகவும் தகுதியும் சாதகமுமான நிலை.",
     "anchor": "சாதகமான கதவு எனக்குத் திறக்கப்பட்டிருக்கிறது"
    }
   ]
  },
  {
   "id": "geneva/1CO.16.10",
   "source_hash": "f30fedd2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CO.16.10#p1-f30fedd2",
     "text": "பயப்படுவதற்கு நியாயமான காரணம் எதுவும் இல்லாதவிதமாக.",
     "anchor": "பயமில்லாமல்"
    }
   ]
  },
  {
   "id": "geneva/1CO.16.11",
   "source_hash": "f7ad2ace",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CO.16.11#p1-f7ad2ace",
     "text": "பாதுகாப்பாகவும் சுகமாகவும், எல்லா வித மரியாதையுடனும்.",
     "anchor": "சமாதானத்தோடு"
    }
   ]
  },
  {
   "id": "geneva/1CO.16.15",
   "source_hash": "8a18b73a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CO.16.15#p1-81cbf88e",
     "text": "ஸ்தேவான் என்பது ஒரு புருஷனுடைய பெயர், ஒரு பெண்ணினுடைய பெயரல்ல.",
     "anchor": "ஸ்தேவானுடைய"
    },
    {
     "id": "geneva/1CO.16.15#p2-e56f438e",
     "text": "தங்களை முழுவதுமாக ஊழியத்திற்கு ஒப்புவித்திருக்கிறார்கள்.",
     "anchor": "ஊழியம் செய்யும்படிக்குத் தங்களை ஒப்புவித்திருக்கிறார்களென்றும்"
    }
   ]
  },
  {
   "id": "geneva/1CO.16.16",
   "source_hash": "842e9511",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CO.16.16#p1-842e9511",
     "text": "நீங்கள் அவர்களைக் கனம்பண்ணி மதிக்கவும், அவர்களுக்குக் கீழ்ப்படியவும், அவர்களால் நடத்தப்படுவதற்குச் சம்மதிக்கவும் வேண்டும், அது உங்களுக்குத் தகுந்தபடியே ஆகும்; ஏனெனில் அவர்கள் தங்களையும் தங்கள் பொருள்களையும் ஒப்புக்கொடுத்து, இதை உங்களுக்கு உதவி செய்யவே செய்திருக்கிறார்கள்.",
     "anchor": "நீங்கள் கீழ்ப்படிந்திருக்கவேண்டும்"
    }
   ]
  },
  {
   "id": "geneva/1CO.16.18",
   "source_hash": "0958fa36",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CO.16.18#p1-3353386c",
     "text": "என் இருதயம்.",
     "anchor": "என் ஆவிக்கும் உங்களுடைய ஆவிக்கும்"
    },
    {
     "id": "geneva/1CO.16.18#p2-4e8d367b",
     "text": "அவர்கள் மெய்யாகவே இருக்கிறவர்களாகவே அவர்களை ஏற்றுக்கொள்ளுங்கள்.",
     "anchor": "இப்படிப்பட்டவர்களை அங்கீகாரம்பண்ணுங்கள்"
    }
   ]
  },
  {
   "id": "geneva/1CO.16.22",
   "source_hash": "1af10a5a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CO.16.22#p1-1af10a5a",
     "text": "இச்சொற்களால் யூதர்களுக்குள் இருந்த மிகக் கடுமையான வகையான சாபமும் சபைநீக்கமும் குறிக்கப்படுகின்றன: மேலும் அச்சொற்கள் \"நம்முடைய கர்த்தர் வருகிறார்\" என்று சொல்லுவதற்குச் சமமானவை. ஆகவே அவனுடைய கருத்து இதாக இருக்கலாம், \"கர்த்தருடைய வருகைவரைக்கும் அவன் சபிக்கப்பட்டவனாக இருக்கக்கடவன்\", அதாவது, அவன் மரிக்கும் நாள்வரைக்கும், என்றென்றைக்கும்.",
     "anchor": "மரானாதா"
    }
   ]
  }
 ]
}
