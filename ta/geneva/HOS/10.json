 "units": [
  {
   "id": "geneva/HOS.10.1",
   "source_hash": "b9b935f4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.10.1#p1-a5cde494",
     "text": "இதன் பழங்களைப் பறித்தாலும், அது புதிய பலத்தைப் பெறும்போதெல்லாம் புதிய துன்மார்க்கத்தில் அதிகரித்தது; ஆகவே அவர்களைக் கீழ்ப்படிதலுக்குக் கொண்டுவர வேண்டிய தண்டனை அவர்களுடைய பிடிவாதத்தை மட்டுமே வெளிப்படுத்தியது.",
     "anchor": "பலனற்ற திராட்சைச்செடி"
    },
    {
     "id": "geneva/HOS.10.1#p2-255fadb4",
     "text": "அவர்கள் செல்வந்தராகவும், பரிபூரணமாகவும் இருந்தபடியால்.",
     "anchor": "தேசத்தின் செழிப்பிற்குச் சரியாக"
    }
   ]
  },
  {
   "id": "geneva/HOS.10.2",
   "source_hash": "5b05a8ba",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.10.2#p1-5b05a8ba",
     "text": "அதாவது, தேவனாகிய அவரிடத்திலிருந்து, தங்கள் தெய்வங்களைச் சேவித்தபடியால்.",
     "anchor": "ஏமாற்றுகிற இருதயம்"
    }
   ]
  },
  {
   "id": "geneva/HOS.10.3",
   "source_hash": "a4059d6b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.10.3#p1-a4059d6b",
     "text": "தேவன் அவர்களுடைய ராஜாவை நீக்கிவிடும் நாள் வரும்; அப்பொழுது அவர்கள் தங்கள் பாவங்களின் கனியை உணர்ந்து, தாங்கள் அவன்மேல் நம்பிக்கை வைத்தது எவ்வளவு வீணாயிருந்தது என்று அறிந்துகொள்வார்கள்; 2 இராஜாக்கள் 17:6-7.",
     "anchor": "ராஜா இருந்தாலும்"
    }
   ]
  },
  {
   "id": "geneva/HOS.10.4",
   "source_hash": "a0762fe4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.10.4#p1-64126ac5",
     "text": "தேவனிடம் உண்மையுள்ளவர்களாக இருப்போம் என்று வாக்குச்செய்வதில்.",
     "anchor": "உடன்படிக்கை செய்துகொண்டார்கள்"
    },
    {
     "id": "geneva/HOS.10.4#p2-5c5245a9",
     "text": "இவ்விதமாக அவர்கள் பாராட்டிக்கொண்ட நேர்மையும் உண்மையும் கசப்பும் துக்கமுமேயன்றி வேறொன்றுமல்ல.",
     "anchor": "நியாயத்தீர்ப்பு முளைக்கும்"
    }
   ]
  },
  {
   "id": "geneva/HOS.10.5",
   "source_hash": "c783118f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.10.5#p1-e0158f54",
     "text": "கன்றுக்குட்டி எடுத்துக்கொள்ளப்படும்போது.",
     "anchor": "கன்றுக்குட்டியினிமித்தம் பயம் அடைவார்கள்"
    },
    {
     "id": "geneva/HOS.10.5#p2-a9b131d9",
     "text": "இவர்கள் தங்கள் பலிகளின்போது கருப்பு உடை அணிந்து, உரத்த சத்தத்துடன் கூப்பிடும் சில விக்கிரக ஆசாரியர்களாக இருந்தார்கள்; இந்த மூடநம்பிக்கையை எலியா ஏளனம் செய்தார், 1 இராஜாக்கள் 18:27. காண்க Geneva \"2 இராஜாக்கள் 23:5\"",
     "anchor": "அதற்காகக் களிகூர்ந்த அதின் பூசாரிகளும்"
    }
   ]
  },
  {
   "id": "geneva/HOS.10.8",
   "source_hash": "07fff1c3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.10.8#p1-07fff1c3",
     "text": "பெத்தேலை அவமதிக்கும்படியாக இதை அவர் சொல்கிறார். ஓசியா 4:15 குறிப்பு (t) பார்க்கவும்.",
     "anchor": "ஆபேனின்"
    }
   ]
  },
  {
   "id": "geneva/HOS.10.9",
   "source_hash": "641e1c1f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.10.9#p1-d369e70b",
     "text": "அந்நாட்களில் நீங்கள் கிபியாவின் மக்களைப் போலவே துன்மார்க்கமாயிருந்தீர்கள், அதை தேவன் அங்கே ஓரளவு வெளிப்படுத்தினார்: ஏனெனில் உங்கள் ஆவேசம் தேவனுடைய நியாயத்தீர்ப்புகளை நிறைவேற்றுவதில் நல்லதாயிருக்க முடியாதிருந்தது, ஏனெனில் உங்கள் சொந்த செயல்களும் அவர்களுடைய செயல்களைப்போலவே துன்மார்க்கமாயிருந்தன.",
     "anchor": "கிபியாவின் நாட்களிலிருந்து பாவம்செய்து"
    },
    {
     "id": "geneva/HOS.10.9#p2-354f0be1",
     "text": "அதாவது, யுத்தம் செய்ய, அல்லது இஸ்ரவேலர்கள் அந்தக் காலத்திலிருந்தே அந்தக் கடினத்தன்மையிலேயே தங்கியிருந்தார்கள்.",
     "anchor": "நிற்கிறார்கள்"
    },
    {
     "id": "geneva/HOS.10.9#p3-cce37c89",
     "text": "கிபியாவின் மக்களின் உதாரணத்தினால் இஸ்ரவேலர்கள் தங்கள் பாவங்களை விட்டுவிடும்படி எழுப்பப்படவில்லை.",
     "anchor": "நெருங்குவதில்லை"
    }
   ]
  },
  {
   "id": "geneva/HOS.10.10",
   "source_hash": "01ddc62a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.10.10#p1-387ef410",
     "text": "அவர்கள் இவ்வளவு பிடிவாதமாய் இருப்பதால், நான் அவர்களை அழிக்க விருப்பமாயிருக்கிறேன்.",
     "anchor": "நான் அவர்களை தண்டிக்க விரும்புகிறேன்"
    },
    {
     "id": "geneva/HOS.10.10#p2-28677f93",
     "text": "அதாவது, அவர்கள் தங்கள் பலத்தையெல்லாம் ஒன்றுசேர்க்கும்போது.",
     "anchor": "இரண்டுவித பாவங்களினாலே"
    }
   ]
  },
  {
   "id": "geneva/HOS.10.11",
   "source_hash": "75d60ec0",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.10.11#p1-1aa79272",
     "text": "இதில் விருப்பம் இருக்கிறது, ஏனெனில் ஏர் உழுவதிலோ பிரயாசமும் வேதனையும் உண்டு.",
     "anchor": "போரடிக்க"
    },
    {
     "id": "geneva/HOS.10.11#p2-f3e708c4",
     "text": "நான் அவளுடைய கொழுத்த கழுத்தின்மேல் என் நுகத்தை வைப்பேன்.",
     "anchor": "அழகான கழுத்தின்"
    }
   ]
  },
  {
   "id": "geneva/HOS.10.12",
   "source_hash": "e88bdc23",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.10.12#p1-e88bdc23",
     "text": "எரேமியா 4:3-ஐப் பார்க்கவும். எரேமியா 4:4-ஐயும் பார்க்கவும்",
     "anchor": "உங்களுடைய தரிசுநிலத்தைப் பண்படுத்துங்கள்"
    }
   ]
  },
  {
   "id": "geneva/HOS.10.14",
   "source_hash": "ba892873",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.10.14#p1-ba892873",
     "text": "அதாவது, சல்மனாசார் அந்த நகரத்தை அழிக்கும்போது பாலிலோ வயதிலோ யாரையும் தப்பவிடவில்லை.",
     "anchor": "யுத்தநாளிலே பெத்தார்பேலைச் சல்மான் அழித்ததுபோல"
    }
   ]
  }
 ]
}
