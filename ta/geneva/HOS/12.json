 "units": [
  {
   "id": "geneva/HOS.12.1",
   "source_hash": "4678c07f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.12.1#p1-e8ad524e",
     "text": "அதாவது, வீணான நம்பிக்கையினால் தன்னைத்தானே சமாதானப்படுத்திக்கொள்கிறான்.",
     "anchor": "காற்றை மேய்ந்து"
    },
    {
     "id": "geneva/HOS.12.1#p2-1b2cec54",
     "text": "நட்பைப் பெறுவதற்காக அனுப்பப்படும் பரிசுகளைக் குறிக்கிறது.",
     "anchor": "எண்ணெய் கொண்டுபோகப்படுகிறது"
    }
   ]
  },
  {
   "id": "geneva/HOS.12.2",
   "source_hash": "ff69853c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.12.2#p1-ff69853c",
     "text": "இது இந்தக் காரியங்களில் எப்பிராயீமுக்கு ஒப்பாக இருந்தது, ஆனாலும் விக்கிரக ஆராதனையில் அல்ல.",
     "anchor": "யூதாவோடும்"
    }
   ]
  },
  {
   "id": "geneva/HOS.12.3",
   "source_hash": "f8b26cee",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.12.3#p1-f8b26cee",
     "text": "தேவன் இவ்விதமாக அவர்களுடைய தகப்பனாகிய யாக்கோபை முற்பட விரும்பியிருக்க, யூதாவின் நன்றியில்லாத தன்மை இன்னும் அருவருக்கத்தக்கதாயிருந்தது.",
     "anchor": "தேவனோடே போராடினான்"
    }
   ]
  },
  {
   "id": "geneva/HOS.12.4",
   "source_hash": "fe14137c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.12.4#p1-3820da3d",
     "text": "ஆதியாகமம் 32:24-32-ஐப் பார்க்கவும்.",
     "anchor": "தூதனுடன் போராடி மேற்கொண்டான்"
    },
    {
     "id": "geneva/HOS.12.4#p2-981055ba",
     "text": "யாக்கோபு பெத்தேலில் தூங்கிக்கொண்டிருந்தபோது தேவன் அவனைக் கண்டு (ஆதியாகமம் 28:12), அங்கே அவனுடன் பேசினார்; அந்தப் பேச்சின் பலன் நாம் அடங்கியிருக்கிற முழு ஜனத்தொகுதிக்கும் சொந்தமானது.",
     "anchor": "பெத்தேலிலே அவர் அவனைக் கண்டு சந்தித்து"
    }
   ]
  },
  {
   "id": "geneva/HOS.12.7",
   "source_hash": "041dda70",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.12.7#p1-041dda70",
     "text": "எப்பிராயீமைப் பொறுத்தமட்டில், அவன் பக்தியுள்ள ஆபிரகாம் அல்லது யாக்கோபுக்கு ஒப்பானவனைக் காட்டிலும் துன்மார்க்கமுள்ள கானானியரைப் போலவே இருக்கிறான்.",
     "anchor": "வியாபாரி"
    }
   ]
  },
  {
   "id": "geneva/HOS.12.8",
   "source_hash": "763ff704",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.12.8#p1-763ff704",
     "text": "இவ்விதமாக துன்மார்க்கர் தேவனுடைய தயவை வெளிப்புற செல்வச் செழிப்பினால் அளந்துகொள்கிறார்கள்; வேஷதாரிகளைப்போல, தங்கள் செய்கைகளைக் குறித்து யாரும் கடிந்துகொள்வதைச் சகிக்கமாட்டார்கள்.",
     "anchor": "பாவமாகிய அக்கிரமம் என்னிடத்தில் கண்டுபிடிக்கப்படுவதில்லை"
    }
   ]
  },
  {
   "id": "geneva/HOS.12.9",
   "source_hash": "8e5229a4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.12.9#p1-8e5229a4",
     "text": "நீ என் உபகாரங்களை ஒப்புக்கொள்ளாதிருப்பதால், நான் உன்னை மறுபடியும் கூடாரங்களில் தங்கியிருக்கச்செய்வேன், நீ இப்பொழுது குற்றஞ்சுமத்துகிற ஆசரிப்புக்கூடாரப் பண்டிகையாகச் செய்யப்படுகிறதுபோல.",
     "anchor": "பண்டிகை நாட்களில்"
    }
   ]
  },
  {
   "id": "geneva/HOS.12.11",
   "source_hash": "0f56a8c1",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.12.11#p1-0f56a8c1",
     "text": "கீலேயாத்தைப் போன்ற பரிசுத்த இடத்திற்கு எதிராகப் பேச யாருக்கும் துணிவு இராது என்று மக்கள் நினைத்தார்கள்; ஆயினும் தீர்க்கதரிசி அவர்களுடைய மதம் முழுவதும் வீணே என்று சொல்கிறார்.",
     "anchor": "கீலேயாத் அக்கிரமத்தின் இடமோ?"
    }
   ]
  },
  {
   "id": "geneva/HOS.12.12",
   "source_hash": "aec865be",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.12.12#p1-aec865be",
     "text": "நீங்கள் உங்கள் செல்வத்தையும் பிரபுத்துவத்தையும் குறித்துப் பெருமை பாராட்டினால், உங்கள் தந்தையை நிந்திப்பதுபோல் தோன்றும், அவர் ஏழையான தேசாந்திரியும் வேலைக்காரனுமாக இருந்தார்.",
     "anchor": "யாக்கோபு சீரியா தேசத்திற்கு ஓடிப்போய்"
    }
   ]
  },
  {
   "id": "geneva/HOS.12.13",
   "source_hash": "57c9b50e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.12.13#p1-57c9b50e",
     "text": "மோசேயைக் குறிக்கிறது; இதனால் அவர்களுக்கு இருந்த எல்லாமும் தேவனுடைய சுயேச்சையான தயவினால் வந்தது என்று விளங்குகிறது.",
     "anchor": "தீர்க்கதரிசியைக் கொண்டு இஸ்ரவேலை எகிப்திலிருந்து புறப்படச்செய்தார்"
    }
   ]
  }
 ]
}
