 "units": [
  {
   "id": "geneva/HOS.5.1",
   "source_hash": "4a68bc8a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.5.1#p1-4a68bc8a",
     "text": "ஆசாரியர்களும் அதிபதிகளும், வேடர்கள் பறவைகளைப் பிடிப்பதுபோல, இந்த இரண்டு உயர்ந்த மலைகளில் ஏழை மக்களைத் தங்கள் கண்ணிகளில் பிடித்தார்கள்.",
     "anchor": "மிஸ்பாவில் கண்ணியும்"
    }
   ]
  },
  {
   "id": "geneva/HOS.5.2",
   "source_hash": "a3cff051",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.5.2#p1-df2c9bae",
     "text": "அவர்கள் பரிசுத்தத்திற்கும் பலிகளுக்கும் முழுவதும் ஒப்புக்கொடுக்கப்பட்டவர்களாகத் தோன்றினாலும், இங்கே இதை அவமதிப்புடன் வதைசெய்தல் என்று அழைக்கிறார்.",
     "anchor": "வதைசெய்கிறார்கள்"
    },
    {
     "id": "geneva/HOS.5.2#p2-50105ceb",
     "text": "நான் அவர்களை என் தீர்க்கதரிசிகளைக்கொண்டு எப்பொழுதும் எச்சரித்திருந்தபோதிலும்.",
     "anchor": "அவர்கள் எல்லோரையும் நான் தண்டிப்பேன்"
    }
   ]
  },
  {
   "id": "geneva/HOS.5.3",
   "source_hash": "9c1153f7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.5.3#p1-9c1153f7",
     "text": "தங்களை இஸ்ரவேலராக மட்டுமல்ல, தங்கள் ராஜாவாகிய யெரொபெயாம் அந்தக் கோத்திரத்திலிருந்து வந்ததால், எப்பிராயீமராகவும் அவர்கள் பெருமை பாராட்டினார்கள்.",
     "anchor": "எப்பிராயீமே"
    }
   ]
  },
  {
   "id": "geneva/HOS.5.5",
   "source_hash": "2e33710a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.5.5#p1-2e33710a",
     "text": "எச்சரிப்புகள் அனைத்தையும் அவர்கள் அசட்டை செய்வதைக் குறிக்கிறது.",
     "anchor": "இஸ்ரவேலின் அகந்தை அவர்களுடைய முகத்திற்கு முன்பாகச் சாட்சியிடுகிறது"
    }
   ]
  },
  {
   "id": "geneva/HOS.5.7",
   "source_hash": "ef488995",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.5.7#p1-262ba042",
     "text": "அதாவது, அவர்களுடைய பிள்ளைகள் சீர்கெட்டவர்களானார்கள், அதனால் அவர்களில் நம்பிக்கை இல்லை.",
     "anchor": "அந்நியபிள்ளைகளைப்"
    },
    {
     "id": "geneva/HOS.5.7#p2-c8e010a4",
     "text": "அவர்களுடைய அழிவு தூரமல்ல.",
     "anchor": "ஒரு மாதத்திற்குள்ளாக அவர்கள் தங்கள் பங்குகளோடே அழிக்கப்படுவார்கள்"
    }
   ]
  },
  {
   "id": "geneva/HOS.5.8",
   "source_hash": "5e516289",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.5.8#p1-5e516289",
     "text": "அதாவது, இந்த கோத்திரத்தின் கீழ் அடங்கியிருந்த இஸ்ரவேல் அனைவரையும் குறிக்கிறது, கர்த்தருடைய வாதைகள் அவர்கள் அழிந்துபோகும்வரை இடத்திற்கு இடம் அவர்களைப் பின்தொடரும் என்பதைக் குறிக்கிறது.",
     "anchor": "பென்யமீனே"
    }
   ]
  },
  {
   "id": "geneva/HOS.5.9",
   "source_hash": "42cbe06c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.5.9#p1-42cbe06c",
     "text": "நடக்கும் காரியத்தினால் நான் இதை நிச்சயமாகத் தீர்மானித்திருக்கிறேன் என்பதை அவர்கள் அறிந்துகொள்வார்கள்.",
     "anchor": "நிச்சயமாக வரப்போகிறதை"
    }
   ]
  },
  {
   "id": "geneva/HOS.5.10",
   "source_hash": "2cff9fc8",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.5.10#p1-2cff9fc8",
     "text": "அவர்கள் அரசியல் ஒழுங்கு அனைத்தையும் மற்றும் எல்லா விதமான மார்க்க வழிபாட்டையும் தலைகீழாகப் புரட்டிவிட்டார்கள்.",
     "anchor": "எல்லைகளை ஒதுக்குகிறவர்களுக்கு"
    }
   ]
  },
  {
   "id": "geneva/HOS.5.11",
   "source_hash": "117bbb40",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.5.11#p1-117bbb40",
     "text": "அதாவது, யெரொபெயாம் இராஜாவின் கற்பனையின்படி நடந்து, தேவனைப் பின்பற்றாமற்போனான்.",
     "anchor": "தகாத கற்பனையை"
    }
   ]
  },
  {
   "id": "geneva/HOS.5.13",
   "source_hash": "8a66b2e3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/HOS.5.13#p1-512c7016",
     "text": "தேவனுடைய கரத்திலிருந்து சிகிச்சை தேடுவதற்குப் பதிலாக.",
     "anchor": "அசீரியனிடம்"
    },
    {
     "id": "geneva/HOS.5.13#p2-8c5e1da8",
     "text": "அசீரியருடைய ராஜாவாக இருந்தவன்.",
     "anchor": "யாரேப் ராஜாவினிடத்தில்"
    }
   ]
  }
 ]
}
