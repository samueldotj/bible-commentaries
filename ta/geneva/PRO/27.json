 "units": [
  {
   "id": "geneva/PRO.27.1",
   "source_hash": "62c2d598",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.27.1#p1-62c2d598",
     "text": "காலத்தைத் தாமதப்படுத்தாமல், சமயம் கிடைக்கும்போதே அதைப் பயன்படுத்திக்கொள்.",
     "anchor": "நாளையத்தினத்தை"
    }
   ]
  },
  {
   "id": "geneva/PRO.27.4",
   "source_hash": "a643e0c4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.27.4#p1-a643e0c4",
     "text": "பொறாமையுள்ளவர்கள் மனமுரண்டானவர்கள், ஒப்புரவாக்கப்பட முடியாதவர்கள்.",
     "anchor": "பொறாமையோவென்றால்"
    }
   ]
  },
  {
   "id": "geneva/PRO.27.6",
   "source_hash": "fc0f66d6",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.27.6#p1-fc0f66d6",
     "text": "அவை முகஸ்துதியாயிருக்கும், நட்பாகவும் தோன்றும்.",
     "anchor": "வஞ்சனையுள்ளவைகள்"
    }
   ]
  },
  {
   "id": "geneva/PRO.27.10",
   "source_hash": "0d095097",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.27.10#p1-0d095097",
     "text": "உன்னுடைய ஆபத்துக் காலத்தில் இவ்வுலகத்தின் எந்த உதவியையும் நம்பாதே.",
     "anchor": "ஆபத்துக்காலத்தில்"
    }
   ]
  },
  {
   "id": "geneva/PRO.27.12",
   "source_hash": "47a98c22",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.27.12#p1-47a98c22",
     "text": "நீதிமொழிகள் 22:3-ன் குறிப்பைப் பார்க்கவும்",
     "anchor": "விவேகி ஆபத்தைக் கண்டு மறைந்துகொள்ளுகிறான்"
    }
   ]
  },
  {
   "id": "geneva/PRO.27.14",
   "source_hash": "4c282164",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.27.14#p1-4c282164",
     "text": "அவசரமாகவும் காரணமில்லாமலும்.",
     "anchor": "அதிகாலையிலே"
    }
   ]
  },
  {
   "id": "geneva/PRO.27.17",
   "source_hash": "d0011819",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.27.17#p1-d0011819",
     "text": "ஒரு கோபக்காரன் மற்றொருவனுக்குக் கோபமுண்டாக்குகிறான்.",
     "anchor": "மனிதனும் தன்னுடைய நண்பனைக் கூர்மையாக்குகிறான்"
    }
   ]
  },
  {
   "id": "geneva/PRO.27.19",
   "source_hash": "7bede418",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.27.19#p1-7bede418",
     "text": "இயல்பினால் மனிதர்களுக்குள் வித்தியாசம் இல்லை, தேவனுடைய கிருபை மட்டுமே அந்த வித்தியாசத்தை உண்டாக்குகிறது.",
     "anchor": "மனிதர்களில் இருதயத்திற்கு இருதயம்"
    }
   ]
  },
  {
   "id": "geneva/PRO.27.21",
   "source_hash": "b4d6dbfc",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.27.21#p1-b4d6dbfc",
     "text": "அதாவது, அவன் பெருமையும் மகிமையும் விரும்புகிறவனாகவோ, அல்லது தாழ்மையும் மனத்தடக்கமும் உள்ளவனாகவோ அறியப்படுகிறான்.",
     "anchor": "புகழ்ச்சியே"
    }
   ]
  },
  {
   "id": "geneva/PRO.27.26",
   "source_hash": "ff02742d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.27.26#p1-ff02742d",
     "text": "இது தேவனுடைய மகா நன்மையை மனிதனிடத்தில் விளங்கப்படுத்துகிறது, அவருடைய வரங்களைப் பாதுகாக்கும்படி அவர் மனிதனிடத்தில் கேட்கும் ஜாக்கிரதையையும் காண்பிக்கிறது.",
     "anchor": "ஆட்டுக்குட்டிகள் உனக்கு ஆடையையும்"
    }
   ]
  }
 ]
}
