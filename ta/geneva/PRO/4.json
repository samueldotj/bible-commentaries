 "units": [
  {
   "id": "geneva/PRO.4.1",
   "source_hash": "958d1718",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.4.1#p1-958d1718",
     "text": "பிரசங்கியும் ஊழியக்காரனும் மக்களுக்குத் தகப்பனைப் போன்றவனாக இருப்பதால், இதை அவன் அப்படிச் சொல்கிறான், நீதிமொழிகள் 2:8.",
     "anchor": "தகப்பன்"
    }
   ]
  },
  {
   "id": "geneva/PRO.4.4",
   "source_hash": "a1328ae3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.4.4#p1-a1328ae3",
     "text": "அதாவது, அவனுடைய தகப்பனாகிய தாவீது.",
     "anchor": "அவர் எனக்குப் போதித்துச் சொன்னது"
    }
   ]
  },
  {
   "id": "geneva/PRO.4.7",
   "source_hash": "90bb7705",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.4.7#p1-90bb7705",
     "text": "நாம் மற்ற காரியங்கள் நமக்கு வாழ்வடையவேண்டுமெனில், முதலாவது தேவனுடைய வார்த்தையிலே ஆரம்பிக்கவேண்டும் என்று அவர் காண்பிக்கிறார்; இது உலகத்தின் நியாயத்தீர்ப்புக்கு எதிரானது, ஏனெனில் உலகம் அதை தன் கடைசி ஆராய்ச்சியாக வைத்திருக்கிறது, அல்லது அதைப்பற்றி ஒருபோதும் கவலைப்படுவதில்லை.",
     "anchor": "ஞானமே முக்கியம்"
    }
   ]
  },
  {
   "id": "geneva/PRO.4.11",
   "source_hash": "e848e86f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.4.11#p1-e848e86f",
     "text": "தன் தகப்பன் தன்னை தேவனுடைய உண்மையான பயத்தில் வளர்க்கும்படி எடுத்துக்கொண்ட கரிசனையை சாலொமோன் இங்கே அறிவிக்கிறான்: ஏனெனில் இது தாவீதின் உறுதிப்பாடாக இருந்தது.",
     "anchor": "ஞானவழியை நான் உனக்குப் போதித்தேன்"
    }
   ]
  },
  {
   "id": "geneva/PRO.4.12",
   "source_hash": "dbf6f6e3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.4.12#p1-dbf6f6e3",
     "text": "நீ ஓர் இடுக்கணும் இல்லாமல் சுயாதீனமாக நடப்பாய்.",
     "anchor": "இடுக்கண்"
    }
   ]
  },
  {
   "id": "geneva/PRO.4.16",
   "source_hash": "e1dc580e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.4.16#p1-e1dc580e",
     "text": "துன்மார்க்கருக்குத் தீங்கு செய்வது, தூங்குவதைவிட, சாப்பிடுவதைவிட, குடிப்பதைவிட, மிகவும் இயல்பானதும் சுபாவமானதுமாய் இருக்கிறது என்னும் பொருள்.",
     "anchor": "தூக்கம் வராது"
    }
   ]
  },
  {
   "id": "geneva/PRO.4.17",
   "source_hash": "ca44abf7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.4.17#p1-ca44abf7",
     "text": "துன்மார்க்கமான வழிமுறைகளாலும் கொடுமையான ஒடுக்குதலாலும் பெற்றது.",
     "anchor": "துன்மார்க்கத்தின்"
    }
   ]
  },
  {
   "id": "geneva/PRO.4.18",
   "source_hash": "5d12c764",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.4.18#p1-5d12c764",
     "text": "தேவபக்தியுள்ளவர்கள் அறிவிலும் முழு துன்பப்படுத்துதலுக்கு வரும்வரைக்கும் நாளுக்குநாள் அதிகரித்துக்கொண்டே செல்கிறார்கள் என்பதைக் குறிக்கிறது, அது அவர்கள் பரலோகங்களில் தங்கள் தலையுடன் இணைக்கப்படும்போது ஆகும்.",
     "anchor": "நடுப்பகல்வரைக்கும் அதிகமதிகமாகப் பிரகாசிக்கிற"
    }
   ]
  },
  {
   "id": "geneva/PRO.4.22",
   "source_hash": "510621ee",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.4.22#p1-510621ee",
     "text": "அதாவது, அவர்களுக்கு சரீர ஆரோக்கியம் உண்டாகும்; இதற்குள் நியாயப்பிரமாணத்தில் வாக்குத்தத்தம் செய்யப்பட்ட மற்ற எல்லா ஆசீர்வாதங்களும் அடங்கியிருக்கின்றன.",
     "anchor": "உடலுக்கெல்லாம்"
    }
   ]
  },
  {
   "id": "geneva/PRO.4.23",
   "source_hash": "cf7d2efd",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.4.23#p1-cf7d2efd",
     "text": "ஏனெனில் இருதயம் எப்படியிருக்கிறதோ, சுத்தமாகவோ அல்லது சீர்கெட்டதாகவோ, அப்படியே மனிதனுடைய வாழ்க்கை முழுவதும் இருக்கும்.",
     "anchor": "ஜீவஊற்று புறப்படும்"
    }
   ]
  },
  {
   "id": "geneva/PRO.4.26",
   "source_hash": "1fd3ae49",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.4.26#p1-1fd3ae49",
     "text": "உன்னுடைய எல்லாச் செயல்களிலும் அளவைக் காத்துக்கொள்.",
     "anchor": "உன்னுடைய நடைகளைச் சீர்தூக்கிப்பார்"
    }
   ]
  }
 ]
}
