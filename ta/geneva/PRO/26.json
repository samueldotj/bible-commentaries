 "units": [
  {
   "id": "geneva/PRO.26.4",
   "source_hash": "b51bffb9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.26.4#p1-b51bffb9",
     "text": "அவனுடைய செய்கைகளுக்கு உடன்படாதே.",
     "anchor": "மதியீனத்தின்படி"
    }
   ]
  },
  {
   "id": "geneva/PRO.26.5",
   "source_hash": "5133eac5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.26.5#p1-5133eac5",
     "text": "காரியத்திற்குத் தேவையானபடி அவனைக் கடிந்துகொள்.",
     "anchor": "அவனுடைய மதியீனத்தின்படி"
    }
   ]
  },
  {
   "id": "geneva/PRO.26.6",
   "source_hash": "8b82d7f4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.26.6#p1-4d63f8f6",
     "text": "அதாவது, அவன் அனுப்புகிற செய்தி கொண்டு போகிறவனுடையது.",
     "anchor": "கால்களையே வெட்டிக்கொண்டு"
    },
    {
     "id": "geneva/PRO.26.6#p2-d8369a86",
     "text": "அதாவது, அதினால் நஷ்டத்தை அடைகிறான்.",
     "anchor": "நஷ்டத்தை அடைகிறான்"
    }
   ]
  },
  {
   "id": "geneva/PRO.26.9",
   "source_hash": "a814573c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.26.9#p1-a814573c",
     "text": "இதனால் அவன் தன்னையும் மற்றவர்களையும் காயப்படுத்துகிறான்.",
     "anchor": "வெறியன் கையில்"
    }
   ]
  },
  {
   "id": "geneva/PRO.26.10",
   "source_hash": "2443c0cd",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.26.10#p1-2443c0cd",
     "text": "தேவனைக் குறிக்கிறது.",
     "anchor": "எல்லாவற்றையும் உருவாக்கிய பெரிய தேவன்"
    }
   ]
  },
  {
   "id": "geneva/PRO.26.12",
   "source_hash": "b2a45440",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.26.12#p1-b2a45440",
     "text": "ஏனெனில் மூடன் அவனைவிட அறிவுரையை ஏற்றுக்கொள்ளக்கூடியவனாக இருப்பான்; மேலும் மூடன் அறியாமையினால் பாவம்செய்கிறான், அவனோ பொறாமையினால் பாவம்செய்கிறான்.",
     "anchor": "மூடனைக்குறித்து அதிக நம்பிக்கையாக இருக்கலாம்"
    }
   ]
  },
  {
   "id": "geneva/PRO.26.13",
   "source_hash": "968b641c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.26.13#p1-968b641c",
     "text": "நீதிமொழிகள் 22:13-ஐ வாசிக்கவும்.",
     "anchor": "வழியிலே சிங்கம்"
    }
   ]
  },
  {
   "id": "geneva/PRO.26.19",
   "source_hash": "4113249e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.26.19#p1-4113249e",
     "text": "தான் இல்லாதவனாகத் தன்னைத் தோற்றுவிக்கிறவன்.",
     "anchor": "தன்னோடு இருந்தவனை"
    }
   ]
  },
  {
   "id": "geneva/PRO.26.23",
   "source_hash": "2c01eeca",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.26.23#p1-2c01eeca",
     "text": "அவைகள் விரைவில் வெளிப்பட்டு தங்களைத் தாங்களே காண்பித்துவிடும்.",
     "anchor": "தீயநெஞ்சம் வெள்ளிப்பூச்சு பூசிய"
    }
   ]
  },
  {
   "id": "geneva/PRO.26.25",
   "source_hash": "cb85167f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.26.25#p1-cb85167f",
     "text": "அநேகம் என்பதைக் குறிக்கிறது: அவன் நிச்சயமற்ற எண்ணிக்கைக்குப் பதிலாக ஒரு நிச்சயமான எண்ணைப் பயன்படுத்துகிறான்.",
     "anchor": "ஏழு அருவருப்புகள்"
    }
   ]
  },
  {
   "id": "geneva/PRO.26.26",
   "source_hash": "488bc89c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.26.26#p1-488bc89c",
     "text": "தேவபக்தியுள்ளவர்களின் சபையில்.",
     "anchor": "மகா சபையிலே"
    }
   ]
  }
 ]
}
