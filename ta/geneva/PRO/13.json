 "units": [
  {
   "id": "geneva/PRO.13.2",
   "source_hash": "626a2136",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.13.2#p1-626a2136",
     "text": "அவன் தன்னுடைய நாவை தேவனுடைய மகிமைக்காகவும், தன் அயலானின் நன்மைக்காகவும் பயன்படுத்தினால், தேவன் அவனை ஆசீர்வதிப்பார்.",
     "anchor": "வாயின்"
    }
   ]
  },
  {
   "id": "geneva/PRO.13.4",
   "source_hash": "115370d6",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.13.4#p1-115370d6",
     "text": "அவன் எப்பொழுதும் விரும்புகிறான், ஆனாலும் ஒன்றைப் பெறுவதற்கு எவ்வித பிரயாசையும் செய்யமாட்டான்.",
     "anchor": "விரும்பியும்"
    }
   ]
  },
  {
   "id": "geneva/PRO.13.8",
   "source_hash": "7506ba07",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.13.8#p1-7506ba07",
     "text": "அவனுடைய தரித்திரத்தினால், கொடிய ஒடுக்குகிறவர்கள் அவனுக்கு எதிராகச் செய்யும் மிரட்டுதல்களைத் தவிர்க்க அவனால் முடியாது.",
     "anchor": "மிரட்டுதலைக் கேட்காமல் இருக்கிறான்"
    }
   ]
  },
  {
   "id": "geneva/PRO.13.10",
   "source_hash": "710366b2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.13.10#p1-710366b2",
     "text": "ஒவ்வொருவனும் மேலாண்மையை அடைய வேண்டுமென்று போராடி, மற்றவனுக்கு இடங்கொடுக்க மனதில்லாதிருக்கும்போது.",
     "anchor": "விவாதம் பிறக்கும்"
    }
   ]
  },
  {
   "id": "geneva/PRO.13.11",
   "source_hash": "d03df410",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.13.11#p1-0fa9891b",
     "text": "அதாவது, தீமையான வழியில் சம்பாதித்த பொருள்.",
     "anchor": "வஞ்சனையால் தேடின பொருள்"
    },
    {
     "id": "geneva/PRO.13.11#p2-1e08722d",
     "text": "அதாவது, தன் சொந்த உழைப்பினால்.",
     "anchor": "கஷ்டப்பட்டு சேர்க்கிறவனோ விருத்தியடைவான்"
    }
   ]
  },
  {
   "id": "geneva/PRO.13.13",
   "source_hash": "98834330",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.13.13#p1-98834330",
     "text": "இது தேவனுடைய வசனத்தைக் குறிக்கிறது, அதினால் அவன் தன் கடமையைக் குறித்து எச்சரிக்கப்படுகிறான்.",
     "anchor": "திருவசனத்தை"
    }
   ]
  },
  {
   "id": "geneva/PRO.13.17",
   "source_hash": "5bd60888",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.13.17#p1-5bd60888",
     "text": "தனக்கும் மற்றவர்களுக்கும் அநேக தொல்லைகளை உண்டாக்குகிறான்.",
     "anchor": "தீமையிலே"
    }
   ]
  },
  {
   "id": "geneva/PRO.13.20",
   "source_hash": "b6ba4e0e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.13.20#p1-b6ba4e0e",
     "text": "அவன் அவர்களுடைய துன்மார்க்கத்தில் பங்குள்ளவனாய், அவர்களுடைய தீய குணங்களைச் சகித்துக்கொள்வதால், அவர்களுக்கு உண்டாகும் தண்டனையே அவனுக்கும் உண்டாகும்.",
     "anchor": "நாசமடைவான்"
    }
   ]
  },
  {
   "id": "geneva/PRO.13.22",
   "source_hash": "b64b3f5d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.13.22#p1-b64b3f5d",
     "text": "யோபு 27:16,17-ஐ வாசிக்கவும்.",
     "anchor": "பாவியின் செல்வமோ...சேர்த்துவைக்கப்படும்"
    }
   ]
  },
  {
   "id": "geneva/PRO.13.23",
   "source_hash": "21fcd2d0",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.13.23#p1-21fcd2d0",
     "text": "தேவன் ஏழைகளின் வேலையை ஆசீர்வதிக்கிறார், தங்களுக்குப் போதுமான உணவு உண்டு என்று நினைத்து அசதியாயிருக்கிறவர்களின் பொருள்களையோ அழிக்கிறார்.",
     "anchor": "ஏழைகளின்"
    }
   ]
  }
 ]
}
