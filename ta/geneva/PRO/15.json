 "units": [
  {
   "id": "geneva/PRO.15.6",
   "source_hash": "3222a354",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.15.6#p1-3222a354",
     "text": "ஏனெனில் அவர்களுக்கு மிகுதியாக இருந்தாலும், அது துன்பத்தினாலும் கவலையினாலும் நிறைந்திருக்கும்.",
     "anchor": "துன்பம்"
    }
   ]
  },
  {
   "id": "geneva/PRO.15.8",
   "source_hash": "5501121a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.15.8#p1-5501121a",
     "text": "துன்மார்க்கர் எதை மிகச் சிறந்ததாகவும், அதினால் தான் மிகவும் அங்கீகரிக்கப்படுவதாகவும் எண்ணுகிறார்களோ, அதுவே தேவனுக்கு முன்பாக அருவருப்பானது.",
     "anchor": "துன்மார்க்கர்களுடைய பலி … அருவருப்பானது"
    }
   ]
  },
  {
   "id": "geneva/PRO.15.10",
   "source_hash": "c8e1fac2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.15.10#p1-c8e1fac2",
     "text": "தேவனுடைய வசனத்தை விட்டு விலகுகிறவன், புத்திமதி கூறப்படுவதைப் பொருந்தமாட்டான்.",
     "anchor": "வழியைவிட்டு விலகுகிறவனுக்கு"
    }
   ]
  },
  {
   "id": "geneva/PRO.15.11",
   "source_hash": "75493201",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.15.11#p1-75493201",
     "text": "தேவனுடைய கண்களுக்கு மறைந்திருக்கக்கூடிய ஆழமான அல்லது இரகசியமான ஒன்றுமே இல்லை; மனுஷனுடைய நினைவுகள் அதற்குக் குறையாதவை.",
     "anchor": "பாதாளமும் அழிவும் யெகோவாவின் பார்வைக்கு முன்பாக இருக்க"
    }
   ]
  },
  {
   "id": "geneva/PRO.15.19",
   "source_hash": "db3802e0",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.15.19#p1-db3802e0",
     "text": "அதாவது, அவன் எப்போதும் ஏதோ ஒரு தடையையோ தாமதத்தையோ கண்டடைந்து, முன்னே செல்ல துணிவதில்லை.",
     "anchor": "முள்வேலிக்குச் சமம்"
    }
   ]
  },
  {
   "id": "geneva/PRO.15.22",
   "source_hash": "1a58db6a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.15.22#p1-1a58db6a",
     "text": "நீதி 11:14-ஐ பார்க்கவும்.",
     "anchor": "ஆலோசனைக்காரர்கள் அநேகர் இருந்தால் அவைகள் உறுதிப்படும்.7f7a\n{f}\nஎன்பதைக் காணவும்.\n\nrefs: நீதிமொழிகள் 11:14"
    }
   ]
  },
  {
   "id": "geneva/PRO.15.23",
   "source_hash": "6229e9be",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.15.23#p1-6229e9be",
     "text": "நம்முடைய பேச்சு ஆறுதலாக இருக்க வேண்டுமானால், நேரத்தையும் தருணத்தையும் பார்த்திருக்க வேண்டும்.",
     "anchor": "ஏற்றகாலத்தில்"
    }
   ]
  },
  {
   "id": "geneva/PRO.15.26",
   "source_hash": "8ed743a6",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.15.26#p1-8ed743a6",
     "text": "அதாவது, கேட்பவர்களுக்கு ஆரோக்கியமும் பிரயோஜனமுமானவை.",
     "anchor": "இன்பமானவைகள்"
    }
   ]
  },
  {
   "id": "geneva/PRO.15.31",
   "source_hash": "1b6a6cfb",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.15.31#p1-1b6a6cfb",
     "text": "தேவனுடைய வசனத்தினால் தன்னைத் திருத்தமாட்டிக் கொள்ளுகிறவன், அது ஜீவனைக் கொண்டுவருகிறது; அப்படியே அவன் திருந்துகிறான்.",
     "anchor": "வாழ்வுக்கேதுவான கடிந்துகொள்ளுதலை ஏற்றுக்கொள்ளும் காது ஞானிகளிடத்திலே தங்கும்"
    }
   ]
  },
  {
   "id": "geneva/PRO.15.33",
   "source_hash": "72db47b7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.15.33#p1-72db47b7",
     "text": "அதாவது, மெய்யாகத் தாழ்மையாக்கப்பட்டவர்களைத் தவிர வேறொருவரையும் தேவன் மேன்மைப்படுத்துகிறதில்லை என்பதாம்.",
     "anchor": "தாழ்மை"
    }
   ]
  }
 ]
}
