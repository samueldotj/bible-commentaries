 "units": [
  {
   "id": "geneva/PRO.22.1",
   "source_hash": "f2984584",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.22.1#p1-f2984584",
     "text": "இது நன்மை செய்வதனால் வருகிறது.",
     "anchor": "பொன் வெள்ளியைவிட தயையே"
    }
   ]
  },
  {
   "id": "geneva/PRO.22.2",
   "source_hash": "f01e1991",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.22.2#p1-f01e1991",
     "text": "ஒருவருக்கொருவர் தேவைப்பட்டு ஒன்றாக வாழுகின்றனர்.",
     "anchor": "ஒருவரையொருவர் சந்திக்கிறார்கள்"
    }
   ]
  },
  {
   "id": "geneva/PRO.22.3",
   "source_hash": "34797369",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.22.3#p1-34797369",
     "text": "அதாவது, துன்மார்க்கருக்காக ஆயத்தமாக்கப்பட்டிருக்கும் தண்டனையைக் கண்டு, தேவனிடத்தில் ஓடி உதவி தேடிக்கொள்கிறான் என்பதாம்.",
     "anchor": "ஆபத்தைக் கண்டு"
    }
   ]
  },
  {
   "id": "geneva/PRO.22.6",
   "source_hash": "269ad053",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.22.6#p1-269ad053",
     "text": "அவனை நல்லொழுக்கத்துடன் வளர்த்தால் அவன் அப்படியே தொடர்ந்திருப்பான்.",
     "anchor": "நடக்கவேண்டிய வழியிலே"
    }
   ]
  },
  {
   "id": "geneva/PRO.22.8",
   "source_hash": "72dc744e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.22.8#p1-72dc744e",
     "text": "அவன் மற்றவர்களை ஒடுக்குவதற்குக் கருவியாக இருந்த அவனுடைய அதிகாரம் அவனிடமிருந்து எடுத்துக்கொள்ளப்படும்.",
     "anchor": "அவனுடைய கடுங்கோபத்தின் கோல் ஒழியும்"
    }
   ]
  },
  {
   "id": "geneva/PRO.22.9",
   "source_hash": "a2c7dd63",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.22.9#p1-a2c7dd63",
     "text": "இரக்கமும் தாராளமும் உள்ளவன்.",
     "anchor": "கருணைக்கண்ணன் ஆசீர்வதிக்கப்படுவான்"
    }
   ]
  },
  {
   "id": "geneva/PRO.22.11",
   "source_hash": "4dbad7e6",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.22.11#p1-4dbad7e6",
     "text": "மனச்சாட்சி நல்லதாயும், பேச்சு ஞானமும் தேவபக்தியும் உள்ளதாயும் இருக்கிறவர்களுடைய பரிச்சயத்தையே அரசர்கள் பயன்படுத்த வேண்டும் என்பதைக் காண்பிக்கிறார்.",
     "anchor": "ராஜா அவனுக்கு நண்பனாவான்"
    }
   ]
  },
  {
   "id": "geneva/PRO.22.12",
   "source_hash": "c1316bd9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.22.12#p1-c1316bd9",
     "text": "ஞானத்தை நேசிக்கிறவர்களுக்குச் சாதகமாயிருக்கும்.",
     "anchor": "ஞானத்தை"
    }
   ]
  },
  {
   "id": "geneva/PRO.22.13",
   "source_hash": "365c08a1",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.22.13#p1-365c08a1",
     "text": "தங்கள் கடமையைச் செய்யாதிருக்க வீணான காரணங்களைக் கண்டுபிடிக்கிறவர்களை அவர் பரிகாசம் செய்கிறார்.",
     "anchor": "வெளியிலே சிங்கம்"
    }
   ]
  },
  {
   "id": "geneva/PRO.22.14",
   "source_hash": "940f6e3d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.22.14#p1-940f6e3d",
     "text": "இவ்விதமாகத் தேவன் ஒரு பாவத்தை மற்றொரு பாவத்தினால் தண்டிக்கிறார், அவர் துன்மார்க்கனை ஒழுங்கீனமான பெண்ணுடன் பழக்கத்திற்குள் விழவிடும்போது.",
     "anchor": "அதிலே விழுவான்"
    }
   ]
  },
  {
   "id": "geneva/PRO.22.15",
   "source_hash": "636433bc",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.22.15#p1-636433bc",
     "text": "அவன் இயல்பாகவே அதற்கு ஆசைப்படுகிறவனாக இருக்கிறான்.",
     "anchor": "பிள்ளையின் இருதயத்தில்"
    }
   ]
  },
  {
   "id": "geneva/PRO.22.19",
   "source_hash": "9b500d64",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.22.19#p1-9b500d64",
     "text": "ஞானத்தின் முடிவு என்ன என்பதைக் காண்பிக்கிறார்: அதாவது, நம்மைக் கர்த்தரிடத்தில் நடத்திச் செல்வதே.",
     "anchor": "யெகோவாமேல்"
    }
   ]
  },
  {
   "id": "geneva/PRO.22.20",
   "source_hash": "44889716",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.22.20#p1-44889716",
     "text": "அதாவது, பலமுறை.",
     "anchor": "சத்திய வார்த்தைகளின் யதார்த்தத்தை"
    }
   ]
  },
  {
   "id": "geneva/PRO.22.24",
   "source_hash": "ce1e46b4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.22.24#p1-ce1e46b4",
     "text": "தன் உணர்ச்சிகளை அடக்கிக்கொள்ள முடியாதவனோடு எந்த தொடர்பும் வைத்துக்கொள்ளாதே; ஏனெனில் அவன் தன் தீய நடத்தையினால் உனக்குத் தீங்கு செய்வான்.",
     "anchor": "கோபக்காரனுக்குத் தோழனாகாதே"
    }
   ]
  },
  {
   "id": "geneva/PRO.22.26",
   "source_hash": "074bab20",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.22.26#p1-074bab20",
