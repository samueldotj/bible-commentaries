 "units": [
  {
   "id": "geneva/PRO.19.7",
   "source_hash": "835918bc",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.19.7#p1-835918bc",
     "text": "அவர்களிடமிருந்து ஆறுதல் பெறுவதற்காக.",
     "anchor": "வார்த்தைகளை"
    }
   ]
  },
  {
   "id": "geneva/PRO.19.8",
   "source_hash": "fde9a0d2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.19.8#p1-fde9a0d2",
     "text": "நியாயத்தீர்ப்பிலும் நிதானமாயிருக்கிறவன் தேவனிடத்தில் தயவைப் பெறுவான்.",
     "anchor": "தன்னுடைய ஆத்துமாவை நேசிக்கிறான்"
    }
   ]
  },
  {
   "id": "geneva/PRO.19.10",
   "source_hash": "b166c0b2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.19.10#p1-b166c0b2",
     "text": "தகுந்த முறையில் பயன்படுத்தத் தெரியாதவனுக்கு பொருள்களைச் சுயேச்சையாக அனுபவிக்க அனுமதிக்கக் கூடாது.",
     "anchor": "மூடனுக்குச் செல்வம்"
    }
   ]
  },
  {
   "id": "geneva/PRO.19.11",
   "source_hash": "f8019aea",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.19.11#p1-f8019aea",
     "text": "அதாவது, அதை அன்பினால் மூடிவைத்து, தேவனுடைய மகிமைக்கு மிகவும் உதவும்படியாக அதில் செய்வதே.",
     "anchor": "குற்றத்தை மன்னிப்பது"
    }
   ]
  },
  {
   "id": "geneva/PRO.19.13",
   "source_hash": "4237a024",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.19.13#p1-4237a024",
     "text": "வீட்டைச் சொட்டிச் சொட்டி அழிக்கும் மழையைப் போல.",
     "anchor": "ஓயாமல் ஒழுகும் நீர்"
    }
   ]
  },
  {
   "id": "geneva/PRO.19.19",
   "source_hash": "f227a5d5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.19.19#p1-f227a5d5",
     "text": "சிலகாலம் அவன் புத்திமதிக்கு இடம் கொடுத்தாலும், சீக்கிரத்திலே தன் கொந்தளிக்கும் உணர்ச்சிகளுக்கே இடம் கொடுப்பான்.",
     "anchor": "தப்புவித்தால்"
    }
   ]
  },
  {
   "id": "geneva/PRO.19.21",
   "source_hash": "6cd50bb7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.19.21#p1-6cd50bb7",
     "text": "மனிதனுடைய திட்டம் தேவன் அதை நடத்தாவிட்டால் வெற்றியடையாது; அவருடைய யோசனையோ மாறாதது.",
     "anchor": "மனிதனுடைய இருதயத்தின்"
    }
   ]
  },
  {
   "id": "geneva/PRO.19.22",
   "source_hash": "f4122198",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.19.22#p1-f4122198",
     "text": "அதாவது, அவன் நேர்மையுள்ளவனாக இருக்க வேண்டும்; ஏனெனில் நேர்மையுள்ள தரித்திரன், நல்குணமில்லாத செல்வனைவிட மேலானவனாக மதிக்கப்பட வேண்டும்.",
     "anchor": "தயவு"
    }
   ]
  },
  {
   "id": "geneva/PRO.19.25",
   "source_hash": "75372c77",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.19.25#p1-75372c77",
     "text": "அதாவது, துன்மார்க்கர் தண்டிக்கப்படுவதைக் காணும்போது, எளிய அறிவற்ற மனிதர் கற்றுக்கொள்கிறார்கள்.",
     "anchor": "பேதை எச்சரிக்கப்படுவான்"
    }
   ]
  },
  {
   "id": "geneva/PRO.19.28",
   "source_hash": "e3872343",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PRO.19.28#p1-e3872343",
     "text": "பெருந்தீனிக்காரரும் குடிகாரரும் விலையுயர்ந்த உணவு பானங்களில் இன்பமும் விருப்பமும் அடைவதைப்போல, அதிலே இன்பமும் விருப்பமும் அடைகிறான்.",
     "anchor": "அக்கிரமத்தை விழுங்கும்"
    }
   ]
  }
 ]
}
