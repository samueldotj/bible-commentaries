 "units": [
  {
   "id": "geneva/AMO.5.2",
   "source_hash": "7978209e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/AMO.5.2#p1-7978209e",
     "text": "அவர்கள் தங்களைக் குறித்துப் பெருமை பாராட்டியதனாலோ, அல்லது காமவிகாரத்திற்கும் சுகபோகத்திற்கும் ஒப்புக்கொடுக்கப்பட்டவர்களாக இருந்ததனாலோ, அவர்களை இவ்வாறு அழைக்கிறார்.",
     "anchor": "கன்னிப்பெண் விழுந்தாள்"
    }
   ]
  },
  {
   "id": "geneva/AMO.5.3",
   "source_hash": "6ca1c7b3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/AMO.5.3#p1-6ca1c7b3",
     "text": "பொருள், பத்தில் ஒரு பங்கினர்தான் அரிதாக இரட்சிக்கப்பட்டு இருப்பார்கள் என்பதே.",
     "anchor": "நூறுபேரில்"
    }
   ]
  },
  {
   "id": "geneva/AMO.5.5",
   "source_hash": "c3562f57",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/AMO.5.5#p1-c3562f57",
     "text": "அந்த இடங்களில் அவர்கள் புதிய விக்கிரகங்களைத் தொழுதுகொண்டார்கள், அவை முன்பு தேவனுடைய உண்மையான கனத்திற்காகப் பயன்பட்டவை: ஆகையால் இவை அவர்களை இரட்சிக்கமாட்டாது என்று அவர் சொல்கிறார்.",
     "anchor": "கில்கால்"
    }
   ]
  },
  {
   "id": "geneva/AMO.5.7",
   "source_hash": "83ca9ed1",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/AMO.5.7#p1-83ca9ed1",
     "text": "நியாயத்திற்கும் நேர்மைக்கும் பதிலாக அவர்கள் கொடுமையையும் ஒடுக்குதலையும் நடப்பிக்கிறார்கள்.",
     "anchor": "நியாயத்தைக் கசப்பாக மாற்றி"
    }
   ]
  },
  {
   "id": "geneva/AMO.5.8",
   "source_hash": "0993a65a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/AMO.5.8#p1-0993a65a",
     "text": "அவர் தேவனுடைய வல்லமையை விவரிக்கிறார்; யோபு 9:9.",
     "anchor": "நட்சத்திரங்களையும் மிருகசீரிஷத்தையும் உண்டாக்கினவர்"
    }
   ]
  },
  {
   "id": "geneva/AMO.5.10",
   "source_hash": "594f0ce0",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/AMO.5.10#p1-594f0ce0",
     "text": "பொது சபைகளில் தங்களைக் கடிந்துகொள்ளும் தீர்க்கதரிசிகளை அவர்கள் பகைக்கிறார்கள்.",
     "anchor": "நுழைவுவாயிலிலே கடிந்துகொள்ளுகிறவனை"
    }
   ]
  },
  {
   "id": "geneva/AMO.5.11",
   "source_hash": "46efcff3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/AMO.5.11#p1-46efcff3",
     "text": "நீங்கள் அவனுடைய பணத்தையும், அவன் பிழைக்கவேண்டிய உணவையும் எடுத்துக்கொள்கிறீர்கள்.",
     "anchor": "கையிலே தானியத்தைச் சுமைசுமையாக வாங்குகிறபடியினால்"
    }
   ]
  },
  {
   "id": "geneva/AMO.5.13",
   "source_hash": "0fc4d7d8",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/AMO.5.13#p1-0fc4d7d8",
     "text": "தேவன் அவர்களைத் தண்டிக்கும்படியாக, தேவபக்தியுள்ளவர்கள் தங்கள் குற்றங்களை எச்சரிக்கும்படி ஒரு வார்த்தையும் திறந்து பேச முடியாதபடி அவர்களைச் செய்வார்.",
     "anchor": "புத்திமான் அந்தக்காலத்திலே மௌனமாக இருக்கவேண்டும்"
    }
   ]
  },
  {
   "id": "geneva/AMO.5.16",
   "source_hash": "9d02a0d9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/AMO.5.16#p1-9d02a0d9",
     "text": "இதனால் பெரிய வாதைகளின் காரணமாக எல்லா வகையான மக்களும் புலம்புவதற்குக் காரணம் உண்டாகும்.",
     "anchor": "பயிரிடுகிறவர்களைத் துக்கங்கொண்டாடுகிறதற்கும்"
    }
   ]
  },
  {
   "id": "geneva/AMO.5.18",
   "source_hash": "a0365349",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/AMO.5.18#p1-a0365349",
     "text": "துன்மார்க்கரும் மாயக்காரரும் தேவனுடைய நியாயத்தீர்ப்புகளைச் சகித்துக்கொள்ள தாங்கள் தயாராக இருக்கிறோம் என்று சொன்னதினால் அவன் இவ்விதமாகப் பேசுகிறார்; ஆனால் பக்தியுள்ளவர்களோ நடுங்கி பயப்படுகிறார்கள்; எரேமியா 30:7, யோவேல் 2:2,11, செப்பனியா 1:15.",
     "anchor": "நியாயத்தீர்ப்பின் நாளை விரும்புகிறவர்களுக்கு"
    }
   ]
  },
  {
   "id": "geneva/AMO.5.22",
   "source_hash": "c5ad301c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/AMO.5.22#p1-c5ad301c",
     "text": "நீங்கள் என்னுடைய உண்மையான ஆராதனையைக் கெடுத்து, உங்களுடைய பாதகங்களில் அடங்காதவர்களாக நிலைத்திருக்கிறபடியால்; ஏசாயா 1:11, எரேமியா 6:10.",
     "anchor": "நான் அங்கீகரிக்கமாட்டேன்"
    }
   ]
  },
  {
   "id": "geneva/AMO.5.24",
   "source_hash": "8cd091d7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/AMO.5.24#p1-8cd091d7",
     "text": "தேவனுக்கும் உங்கள் அடுத்திருப்பவனுக்கும் உங்கள் கடமையைச் செய்யுங்கள், அப்பொழுது தேவனுடைய வார்த்தையின்படி உங்கள் பரிபூரண பாசத்தைக் காண்பித்தால், அவருடைய கிருபையை நீங்கள் நிறைவாக அனுபவிப்பீர்கள்.",
     "anchor": "தண்ணீரைப்போலவும்"
    }
   ]
  },
  {
   "id": "geneva/AMO.5.26",
   "source_hash": "6db6a296",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/AMO.5.26#p1-6db6a296",
     "text": "நீங்கள் ராஜாவைப் போல எண்ணிய அந்த விக்கிரகம், மற்றும் நீங்கள் கீயூனைச் சுமந்து சென்றதுபோல சுமந்துசென்ற சிலைகள்; அந்தச் சிலைகளில் ஒரு விதமான தெய்வத்தன்மை உண்டு என்று நீங்கள் நினைத்தீர்கள்.",
     "anchor": "மோளோகு... உங்களுடைய சிலைகள்"
    }
   ]
  }
 ]
}
