 "units": [
  {
   "id": "geneva/AMO.3.2",
   "source_hash": "f77311c4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/AMO.3.2#p1-f77311c4",
     "text": "மற்ற எல்லா மக்களுக்குள்ளும் என்னுடையவர்களாக இருக்க உங்களை மட்டும் தெரிந்துகொண்டேன்; ஆயினும் நீங்கள் என்னைவிட்டு விலகிப்போனீர்கள்.",
     "anchor": "எல்லா வம்சங்களுக்குள்ளும் உங்களைமட்டும் அறிந்துகொண்டேன்"
    }
   ]
  },
  {
   "id": "geneva/AMO.3.3",
   "source_hash": "d546cc08",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/AMO.3.3#p1-d546cc08",
     "text": "இதனால் தீர்க்கதரிசி தான் தன்னிலிருந்து பேசாமல், தேவன் தன்னை வழிநடத்தி ஏவுகிறபடியே பேசுகிறேன் என்று குறிக்கிறார்; இது தேவனுக்கும் அவருடைய தீர்க்கதரிசிகளுக்கும் இடையேயுள்ள ஒருமனப்படுதல் என்று அழைக்கப்படுகிறது.",
     "anchor": "ஒருமனப்படாமல்"
    }
   ]
  },
  {
   "id": "geneva/AMO.3.4",
   "source_hash": "7f67afae",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/AMO.3.4#p1-7f67afae",
     "text": "ஏதேனும் ஒரு பெரிய காரணம் இல்லாவிட்டால், தேவன் தம்முடைய தீர்க்கதரிசியைக்கொண்டு எச்சரிப்பாரோ?",
     "anchor": "காட்டிலே சிங்கம் கெர்ச்சிக்குமோ"
    }
   ]
  },
  {
   "id": "geneva/AMO.3.5",
   "source_hash": "38422e3b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/AMO.3.5#p1-d9b86358",
     "text": "தேவனுடைய பராமரிப்பின்றி ஏதாவது நிகழ முடியுமோ?",
     "anchor": "அது கண்ணியில் அகப்படுமோ?"
    },
    {
     "id": "geneva/AMO.3.5#p2-ed04d655",
     "text": "அவருடைய எச்சரிப்புகள் வீணாய்ப் போகுமோ?",
     "anchor": "கண்ணி தரையிலிருந்து எடுக்கப்படுமோ?"
    }
   ]
  },
  {
   "id": "geneva/AMO.3.6",
   "source_hash": "78853ae6",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/AMO.3.6#p1-02ce09ba",
     "text": "தீர்க்கதரிசிகள் தேவனுடைய நியாயத்தீர்ப்புகளை எச்சரித்தால், மக்கள் கலங்காமல் இருப்பார்களோ?",
     "anchor": "ஊரில் எக்காளம் ஊதினால்"
    },
    {
     "id": "geneva/AMO.3.6#p2-fa14ffcb",
     "text": "தேவனுடைய நியமனம் இல்லாமல் எந்தத் தீங்கும் வருமோ? ஏசாயா 45:7",
     "anchor": "ஊரில் தீங்கு உண்டாகுமோ?"
    }
   ]
  },
  {
   "id": "geneva/AMO.3.7",
   "source_hash": "37c11fbb",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/AMO.3.7#p1-37c11fbb",
     "text": "தேவன் இஸ்ரவேலரை மற்ற மக்களைப் போல நடத்துவதில்லை; ஏனெனில் அவர் எப்போதும் தமது தீர்க்கதரிசிகளின் மூலமாக தமது ஆபத்துகளைக் குறித்து முன்னதாக அவர்களை எச்சரிக்கிறார்.",
     "anchor": "தமது இரகசியத்தை வெளிப்படுத்தாமல்"
    }
   ]
  },
  {
   "id": "geneva/AMO.3.8",
   "source_hash": "ddef92fc",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/AMO.3.8#p1-ddef92fc",
     "text": "மக்கள் எப்போதும் தீர்க்கதரிசிகளுக்கு எதிராக முறுமுறுத்ததால், தேவனுடைய ஆவியானவரே அவர்களைத் தாங்கள் சொன்னபடி பேசத் தூண்டினார் என்பதை அவர் காண்பிக்கிறார்.",
     "anchor": "தீர்க்கதரிசனம் சொல்லாதிருப்பான்"
    }
   ]
  },
  {
   "id": "geneva/AMO.3.9",
   "source_hash": "b094956d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/AMO.3.9#p1-b094956d",
     "text": "பெலிஸ்தரும் எகிப்தியரும் ஆகிய அந்நியரை, இஸ்ரவேலர்கள் தங்கள் கொடுமையினாலும் ஒடுக்குதலினாலும் அடைந்த தேவனுடைய நியாயத்தீர்ப்புகளுக்கு சாட்சியாயிருக்கும்படி அவர் அழைக்கிறார்.",
     "anchor": "அஸ்தோத்தின்"
    }
   ]
  },
  {
   "id": "geneva/AMO.3.10",
   "source_hash": "778a1435",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/AMO.3.10#p1-778a1435",
     "text": "தங்களுடைய கொடுமையினாலும் கொள்ளையினாலும் வந்த பலன், தங்களுடைய வீடுகளில் அவர்கள் வைத்திருக்கும் மகா செல்வத்தினால் காணப்படுகிறது.",
     "anchor": "தங்களுடைய அரண்மனைகளில்"
    }
   ]
  },
  {
   "id": "geneva/AMO.3.12",
   "source_hash": "730cc31a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/AMO.3.12#p1-af421131",
     "text": "சிங்கம் தன் பசியைத் தணித்தபின், மேய்ப்பன் ஒரு கால் அல்லது ஒரு காதின் துண்டைக் கண்டுபிடிப்பான், அது ஆடுகள் அதன் பற்களால் கிழிக்கப்பட்டன என்பதைக் காண்பிக்கும்.",
     "anchor": "சிங்கத்தின் வாயிலிருந்து"
    },
    {
     "id": "geneva/AMO.3.12#p2-5b884aa4",
     "text": "தமஸ்குவில் தங்களுக்கு நிச்சயமான அரணும் பாதுகாப்பும் உண்டு என்று அவர்கள் நினைத்திருந்த இடத்தில்.",
     "anchor": "தமஸ்குவின் மெத்தையின் மேலிருந்தும்"
    }
   ]
  }
 ]
}
