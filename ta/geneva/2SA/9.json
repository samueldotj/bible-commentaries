   "paragraphs": [
    {
     "id": "geneva/2SA.9.1#p1-c2aec8f0",
     "text": "யோனத்தானுக்கு நான் செய்த ஆணையும் வாக்குத்தத்தமும் நிமித்தமாக, 1 சாமுவேல் 20:15.",
     "anchor": "யோனத்தானுக்காக"
    }
   ]
  },
  {
   "id": "geneva/2SA.9.3",
   "source_hash": "3e030258",
   "generator": {
    "name": "claude",
