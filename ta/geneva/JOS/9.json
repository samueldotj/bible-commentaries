 "units": [
  {
   "id": "geneva/JOS.9.1",
   "source_hash": "48ff6b87",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOS.9.1#p1-af461c3a",
     "text": "மோவாபின் சமபூமியைப் பொருத்தவரையில்.",
     "anchor": "யோர்தான் நதிக்கு மேற்கு திசையிலுள்ள"
    },
    {
     "id": "geneva/JOS.9.1#p2-ad4fe901",
     "text": "மத்திய தரை சமுத்திரம் என்று அழைக்கப்படும் பெருங்கடல்.",
     "anchor": "லீபனோனுக்கு எதிரான மத்திய தரை சமுத்திரத்தின்"
    }
   ]
  },
  {
   "id": "geneva/JOS.9.4",
   "source_hash": "8ba10a99",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOS.9.4#p1-8ba10a99",
     "text": "அவைகள் எல்லாம் தேய்ந்து போயிருந்தபடியால்.",
     "anchor": "பீறலும் பொத்தலுமான"
    }
   ]
  },
  {
   "id": "geneva/JOS.9.7",
   "source_hash": "83c626d3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOS.9.7#p1-83c626d3",
     "text": "ஏனெனில் கிபியோனியரும் ஏவியர்களும் ஒரே மக்களாக இருந்தார்கள்.",
     "anchor": "ஏவியர்களை"
    }
   ]
  },
  {
   "id": "geneva/JOS.9.9",
   "source_hash": "89813e90",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOS.9.9#p1-89813e90",
     "text": "விக்கிரக ஆராதனை செய்பவர்கள்கூட மரண பயத்தினால் மெய்யான தேவனை மகிமைப்படுத்துவதுபோல் நடித்து, அவருடைய மதத்தை ஏற்றுக்கொள்வார்கள்.",
     "anchor": "உம்முடைய தேவனாகிய யெகோவாவுடைய நாமத்தை"
    }
   ]
  },
  {
   "id": "geneva/JOS.9.12",
   "source_hash": "65ec45d4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOS.9.12#p1-65ec45d4",
     "text": "தேவனுடைய ஊழியக்காரரை வஞ்சிக்க விரும்பும்போது, துன்மார்க்கருக்குத் தங்கள் தந்திரத்தை வெளிப்படுத்த யுக்தியும் குறையாது, பொய்களும் குறையாது.",
     "anchor": "இந்த அப்பத்தைச் சுடச்சுட"
    }
   ]
  },
  {
   "id": "geneva/JOS.9.14",
   "source_hash": "6b1bf62e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOS.9.14#p1-6b1bf62e",
     "text": "இஸ்ரவேலர்கள் அவர்களுடைய உணவுப்பதார்த்தங்களைப் புசித்தார்கள் என்றும், அதன் மூலமாக அவர்களுடன் உடன்படிக்கை செய்தார்கள் என்றும் சிலர் நினைக்கிறார்கள்.",
     "anchor": "அவர்களுடைய உணவுப்பதார்த்தங்களிலே சிறிது வாங்கிக்கொண்டார்கள்"
    }
   ]
  },
  {
   "id": "geneva/JOS.9.17",
   "source_hash": "c854d586",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOS.9.17#p1-c854d586",
     "text": "கில்காலிலிருந்து.",
     "anchor": "பிரயாணம்செய்யும்போது"
    }
   ]
  },
  {
   "id": "geneva/JOS.9.18",
   "source_hash": "e9584ec4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOS.9.18#p1-e9584ec4",
     "text": "தங்கள் பாவத்தினிமித்தம் தேவனுடைய வாதை தங்கள் எல்லோர்மேலும் வரும் என்று அவர்கள் பயந்ததினால்.",
     "anchor": "பிரபுக்களுக்கு எதிராக முறுமுறுத்தார்கள்"
    }
   ]
  },
  {
   "id": "geneva/JOS.9.20",
   "source_hash": "242bf9c1",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOS.9.20#p1-242bf9c1",
     "text": "இது பதற்றமான ஆணைகளை ஏற்படுத்துவதற்காக அல்ல, மாறாக தேவன் தம்முடையவர்கள்மேல் காண்பிக்கும் இரக்கத்தைக் காண்பிக்கிறது, அவர் அவர்களுடைய பாவத்தினிமித்தம் அவர்களைத் தண்டிக்க விரும்பவில்லை.",
     "anchor": "நாம் அவர்களுக்குக் கொடுத்த வாக்கின்படி"
    }
   ]
  },
  {
   "id": "geneva/JOS.9.23",
   "source_hash": "72ee8e05",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOS.9.23#p1-72ee8e05",
     "text": "ஆசரிப்புக்கூடாரத்தின் உபயோகத்திற்காகவும், கட்டப்படவிருக்கும் ஆலயத்தின் உபயோகத்திற்காகவும்.",
     "anchor": "என் தேவனுடைய ஆலயத்திற்கு"
    }
   ]
  },
  {
   "id": "geneva/JOS.9.26",
   "source_hash": "041d28c0",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOS.9.26#p1-041d28c0",
     "text": "தேவனுடைய கடுங்கோபத்திற்குப் பயந்து அவர்களைக் கொன்றுபோட மனதாயிருந்தவர்கள்.",
     "anchor": "இஸ்ரவேல் மக்கள் அவர்களைக் கொன்றுபோடாதபடி"
    }
   ]
  },
  {
   "id": "geneva/JOS.9.27",
   "source_hash": "543bc614",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOS.9.27#p1-543bc614",
     "text": "அதாவது, யோசுவா 9:23-ல் இருப்பதுபோல, ஆலயத்தின் ஊழியத்திற்காக.",
     "anchor": "யெகோவா... பலிபீடத்திற்கும்"
    }
   ]
  }
 ]
}
