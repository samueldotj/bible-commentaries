 "units": [
  {
   "id": "geneva/JOS.24.1",
   "source_hash": "442e47a8",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOS.24.1#p1-4344c80f",
     "text": "அதாவது, ஒன்பது கோத்திரங்களும் அரை கோத்திரமும்.",
     "anchor": "இஸ்ரவேலின் கோத்திரங்களையெல்லாம் சீகேமிலே"
    },
    {
     "id": "geneva/JOS.24.1#p2-3f0c8fe3",
     "text": "யோசேப்பின் எலும்புகளை அடக்கம்செய்யப் போனபோது சீகேமுக்குக் கொண்டுவரப்பட்ட பெட்டிக்கு முன்பாக.",
     "anchor": "தேவனுடைய"
    }
   ]
  },
  {
   "id": "geneva/JOS.24.2",
   "source_hash": "25491216",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOS.24.2#p1-25491216",
     "text": "மெசொப்பொத்தாமியாவிலுள்ள ஐப்பிராத்து நதி, ஆதியாகமம் 11:26.",
     "anchor": "நதிக்கு அப்பால், பூர்வ காலத்திலே"
    }
   ]
  },
  {
   "id": "geneva/JOS.24.7",
   "source_hash": "81d08c76",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOS.24.7#p1-81d08c76",
     "text": "நாற்பது வருடங்களே.",
     "anchor": "அநேகநாட்கள்"
    }
   ]
  },
  {
   "id": "geneva/JOS.24.11",
   "source_hash": "ae864d8d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOS.24.11#p1-ae864d8d",
     "text": "அது தலைமையான பட்டணமாய் இருந்ததால், அதைக்கொண்டு அந்த நாடு முழுவதையும் குறிக்கிறார்; இல்லையானால் அந்தப் பட்டணத்தார் மாத்திரம் யுத்தம் செய்யவில்லை.",
     "anchor": "எரிகோவின் குடிகளும்... யுத்தம்செய்தார்கள்"
    }
   ]
  },
  {
   "id": "geneva/JOS.24.14",
   "source_hash": "0d4795a7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOS.24.14#p1-0d4795a7",
     "text": "தேவனுடைய உபகாரங்களைக் கொண்டு நாம் அவருக்குப் பயந்து, உத்தம மனச்சாட்சியோடு அவரைத் தொழுதுகொள்ள கற்றுக்கொள்வதே அவைகளின் மெய்யான பயன்பாடாகும்.",
     "anchor": "யெகோவாவுக்குப் பயந்து"
    }
   ]
  },
  {
   "id": "geneva/JOS.24.15",
   "source_hash": "e16e1197",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOS.24.15#p1-e16e1197",
     "text": "உலகம் முழுவதும் தேவனை விட்டு விலகினாலும், நம்மில் ஒவ்வொருவரும் தனித்தனியாக அவரைப் பற்றிக்கொள்ள கடமைப்பட்டிருக்கிறோம் என்பதை இது நமக்குக் காண்பிக்கிறது.",
     "anchor": "நானும் என் வீட்டார்களுமோவென்றால்"
    }
   ]
  },
  {
   "id": "geneva/JOS.24.18",
   "source_hash": "b6c49e6f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOS.24.18#p1-b6c49e6f",
     "text": "நம்முடைய ஆத்துமாக்களின் மீட்பைப் பெற்றுக்கொண்ட கிறிஸ்துவிற்குள்ளாக, நாம் தேவனுக்கு ஊழியம் செய்ய இன்னும் அதிகமாகக் கடமைப்பட்டிருக்கிறோம்.",
     "anchor": "அவரே நம்முடைய தேவன்"
    }
   ]
  },
  {
   "id": "geneva/JOS.24.22",
   "source_hash": "0d3037e0",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOS.24.22#p1-0d3037e0",
     "text": "நீங்கள் இதற்கு எதிராக நடந்தால், உங்களுடைய வாய்களே உங்களைக் குற்றஞ்சுமத்தும்.",
     "anchor": "நீங்களே உங்களுக்குச் சாட்சிகள்"
    }
   ]
  },
  {
   "id": "geneva/JOS.24.23",
   "source_hash": "7f341109",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOS.24.23#p1-7f341109",
     "text": "உங்களுடைய இருதயங்களிலிருந்தும் மற்றும்படியாகவும்.",
     "anchor": "உங்களுடைய நடுவே இருக்கிற அந்நிய தெய்வங்களை"
    }
   ]
  },
  {
   "id": "geneva/JOS.24.25",
   "source_hash": "01c5aed7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOS.24.25#p1-01c5aed7",
     "text": "தேவனையும் மக்களையும் இணைப்பதனால்: மேலும் நியாயப்பிரமாணத்திலிருந்து வாக்குத்தத்தங்களையும் எச்சரிப்புகளையும் மீண்டும் கூறினான்.",
     "anchor": "மக்களோடு உடன்படிக்கைசெய்து"
    }
   ]
  },
  {
   "id": "geneva/JOS.24.27",
   "source_hash": "89c30021",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOS.24.27#p1-89c30021",
     "text": "மனிதனுடைய வஞ்சகம் தண்டனையின்றி நீங்காதபடிக்கு, ஊமையான உருவங்களே பழிவாங்குதலுக்காக கூக்குரலிடும்.",
     "anchor": "கேட்டது; நீங்கள் உங்களுடைய தேவனுக்கு எதிராகப் பொய்சொல்லாதபடி"
    }
   ]
  },
  {
   "id": "geneva/JOS.24.31",
   "source_hash": "88a4c52b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOS.24.31#p1-88a4c52b",
     "text": "பொதுவாக ஆளுநர்கள் எப்படியிருப்பார்களோ, மக்களும் அப்படியே இருக்கிறார்கள்.",
     "anchor": "யெகோவாவைச் சேவித்தார்கள்"
    }
   ]
  }
 ]
}
