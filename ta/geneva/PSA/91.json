 "units": [
  {
   "id": "geneva/PSA.91.1",
   "source_hash": "6cb9b036",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.91.1#p1-6cb9b036",
     "text": "தேவனையே தன் அடைக்கலமும் நம்பிக்கையுமாக வைத்திருக்கிறவன், அவருடைய பாதுகாப்பு மகா நிச்சயமான காவலாக இருக்கிறதை உணருவான்.",
     "anchor": "உன்னதமான தேவனுடைய மறைவில்"
    }
   ]
  },
  {
   "id": "geneva/PSA.91.2",
   "source_hash": "b4620a3a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.91.2#p1-b4620a3a",
     "text": "இந்தப் பாதுகாப்பை நிச்சயமாக அறிந்திருப்பதால், அவன் கர்த்தரை நோக்கி ஜெபம்பண்ணுகிறான்.",
     "anchor": "நான் யெகோவாவை நோக்கி... சொல்லுவேன்"
    }
   ]
  },
  {
   "id": "geneva/PSA.91.3",
   "source_hash": "eadcbae9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.91.3#p1-eadcbae9",
     "text": "அதாவது, சாத்தான் நமமேல் இரகசியமாக தாக்குகிறபோதும், அதை அவர் கண்ணி என்று அழைக்கிறார், அல்லது வெளிப்படையாக தாக்குகிறபோதும், இங்கே அது கொள்ளை நோயால் குறிக்கப்படுகிறது, தேவனுடைய உதவி நமக்கு எந்நேரமும் மிகவும் தயாராயிருக்கிறது.",
     "anchor": "வேடனுடைய கண்ணிக்கும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.91.4",
   "source_hash": "ed472def",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.91.4#p1-ed472def",
     "text": "அதாவது, உனக்குத் தேவைப்படும் போது உதவிசெய்யும்படி அவர் வாக்குத்தத்தத்தை உண்மையாகக் காத்தருளுதல்.",
     "anchor": "சத்தியம் உனக்கு பெரிய கவசமும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.91.5",
   "source_hash": "0f3d3b91",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.91.5#p1-0f3d3b91",
     "text": "தேவன் தமக்குச் சொந்தமானவர்கள் மேல் வைத்திருக்கிற பராமரிப்பே அவர்களை எல்லா ஆபத்துகளிலிருந்தும் காக்க போதுமானதாகும்.",
     "anchor": "இரவில் உண்டாகும் பயங்கரத்திற்கும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.91.8",
   "source_hash": "83a56a12",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.91.8#p1-83a56a12",
     "text": "பக்தியுள்ளவர்கள் இந்த ஜீவிதத்திலேயே துன்மார்க்கருக்கு எதிரான தேவனுடைய நியாயத்தீர்ப்புகளின் சில அனுபவத்தைப் பெறுவார்கள்; ஆனாலும் எல்லாம் வெளிப்படுத்தப்படும் அந்த நாளிலே அதை முழுமையாகக் காண்பார்கள்.",
     "anchor": "கண்களால்மட்டும் நீ அதைப் பார்த்து"
    }
   ]
  },
  {
   "id": "geneva/PSA.91.11",
   "source_hash": "8c0a9740",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.91.11#p1-8c0a9740",
     "text": "தேவன் ஒவ்வொரு மனிதனுக்கும் ஒரு தூதனை நியமிக்கவில்லை, மாறாக, தம்முடைய அழைப்பில் நடக்கும் தம்முடையவர்களைக் காக்கவும் பாதுகாக்கவும் தம்முடைய பராமரிப்பின் ஊழியர்களாக இருக்க அநேக தூதர்களை நியமித்திருக்கிறார்; இதுவே தேவனைச் சோதிக்காமல் நடக்கும் வழியாகும்.",
     "anchor": "தம்முடைய தூதர்களுக்குக் கட்டளையிடுவார்"
    }
   ]
  },
  {
   "id": "geneva/PSA.91.13",
   "source_hash": "2d3a2792",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.91.13#p1-2d3a2792",
     "text": "நீ எல்லாத் தீங்கிலிருந்தும் காக்கப்படுவது மட்டுமல்ல, அது மறைவானதோ வெளிப்படையானதோ, அதை மேற்கொள்வாயும்.",
     "anchor": "பாலசிங்கத்தையும் வலுசர்ப்பத்தையும் மிதித்து"
    }
   ]
  },
  {
   "id": "geneva/PSA.91.14",
   "source_hash": "3133d821",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.91.14#p1-3133d821",
     "text": "உண்மையுள்ளவர்களுக்கு தேவனுடைய பாதுகாப்பை உறுதிப்படுத்த, அவர் அதையே உறுதிப்படுத்தும்படி தேவனையே கொண்டுவருகிறார்.",
     "anchor": "அவன் என்னிடத்தில் வாஞ்சையாக இருக்கிறபடியால்"
    }
   ]
  },
  {
   "id": "geneva/PSA.91.16",
   "source_hash": "05c2d1be",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.91.16#p1-05c2d1be",
     "text": "ஏனெனில் தேவன் கொடுக்கும் அந்த ஜீவனைக்கொண்டு அவன் திருப்தியாயிருக்கிறான்; ஏனெனில் மரணத்தினால் இந்த ஜீவனுடைய குறுகிய காலம் அழியாமையினால் ஈடுசெய்யப்படுகிறது.",
     "anchor": "நீடித்த நாட்களால் அவனைத் திருப்தியாக்கி"
    }
   ]
  }
 ]
}
