 "units": [
  {
   "id": "geneva/PSA.115.1",
   "source_hash": "22e2eb5e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.115.1#p1-22e2eb5e",
     "text": "தேவன் தம்முடைய நாமத்தினிமித்தமே அவர்களை விடுவிப்பதாக வாக்குத்தத்தம் செய்தார், அவர்களுடைய நிமித்தமல்ல, ஏசாயா 48:11; ஆகையால் அவர்கள் தங்கள் ஜெபத்தை இந்த வாக்குத்தத்தத்தின்மேல் நிலைநிறுத்துகிறார்கள்.",
     "anchor": "எங்களுக்கு அல்ல"
    }
   ]
  },
  {
   "id": "geneva/PSA.115.2",
   "source_hash": "339e256a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.115.2#p1-339e256a",
     "text": "துன்மார்க்கர் தேவன் தாங்கள் நினைத்தபடி தமது வாக்குத்தத்தத்தை எப்பொழுதும் நிறைவேற்றாமல் இருப்பதைக் காணும்போது, தேவன் இல்லை என்று நினைக்கிறார்கள்.",
     "anchor": "அவர்களுடைய தேவன் இப்பொழுது எங்கே"
    }
   ]
  },
  {
   "id": "geneva/PSA.115.3",
   "source_hash": "1f7069f2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.115.3#p1-1f7069f2",
     "text": "எந்த தடைகளும் அவருடைய செயலைத் தாமதப்படுத்த முடியாது; மாறாக அந்தத் தடைகளையே அவர் தமது சித்தத்தை நிறைவேற்ற பயன்படுத்துகிறார்.",
     "anchor": "சித்தமான"
    }
   ]
  },
  {
   "id": "geneva/PSA.115.4",
   "source_hash": "bae08c51",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.115.4#p1-bae08c51",
     "text": "பொருளும் வடிவமும் அவர்களுடைய விக்கிரகங்களைப் பாராட்டத்தக்கதாக இல்லாதிருப்பதால், அவைகள் மதிக்கப்படுவதற்கு எவ்வித காரணமும் இல்லை என்பது தெளிவாகிறது.",
     "anchor": "வெள்ளியும் பொன்னும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.115.7",
   "source_hash": "2091e90c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.115.7#p1-2091e90c",
     "text": "தங்களிடம் உதவி இல்லாமலிருப்பது மட்டுமல்ல, உணர்வும் அறிவும் இல்லாதவைகளிடம் உதவி தேடுவது எவ்வளவு பெரிய வீணானதென்று அவர் காண்பிக்கிறார்.",
     "anchor": "கைகளிருந்தும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.115.8",
   "source_hash": "21460020",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.115.8#p1-21460020",
     "text": "கல் மற்றும் மரக்கட்டைகளைப்போலவே உணர்வற்றவர்கள்.",
     "anchor": "அவைகளைப்போலவே"
    }
   ]
  },
  {
   "id": "geneva/PSA.115.10",
   "source_hash": "0c624b56",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.115.10#p1-0c624b56",
     "text": "ஏனெனில் மற்றவர்கள் பின்பற்றும்படி விசுவாசத்திற்கும் தேவபக்திக்கும் அறிவுறுத்துபவர்களாகவும் போதகர்களாகவும் தேவனால் அவர்கள் நியமிக்கப்பட்டிருந்தார்கள்.",
     "anchor": "ஆரோன் குடும்பத்தாரே"
    }
   ]
  },
  {
   "id": "geneva/PSA.115.12",
   "source_hash": "9b9a18ca",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.115.12#p1-9b9a18ca",
     "text": "அதாவது, அவர் தம்முடைய கிருபைகளைத் தம்முடைய மக்களிடத்தில் தொடர்ந்து செய்வார்.",
     "anchor": "இஸ்ரவேல் குடும்பத்தார்களை ஆசீர்வதிப்பார்"
    }
   ]
  },
  {
   "id": "geneva/PSA.115.15",
   "source_hash": "aad07351",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.115.15#p1-aad07351",
     "text": "ஆகையால் அவர் அதிலுள்ள எல்லாவற்றையும் இன்னும் ஆளுகை செய்து காத்துக்கொண்டிருக்கிறார்.",
     "anchor": "வானத்தையும் பூமியையும் படைத்த"
    }
   ]
  },
  {
   "id": "geneva/PSA.115.16",
   "source_hash": "e5a912a9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.115.16#p1-e5a912a9",
     "text": "அவை அவருடைய தேவைக்குமேற்பட்ட பரிபூரணத்தை நன்றாக விளங்கப்படுத்துகின்றன, அதனால் உலகம் அவருக்கு எந்தப் பயனும் செய்யாமல், மனிதர்கள்பேரில் அவருக்குள்ள பிதாவின் அன்பான கரிசனையை மாத்திரம் வெளிப்படுத்துகிறது.",
     "anchor": "வானங்கள்"
    }
   ]
  },
  {
   "id": "geneva/PSA.115.17",
   "source_hash": "965766f5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.115.17#p1-965766f5",
     "text": "இறந்தவர்கள் தேவனுடைய மகிமையை வெளிப்படுத்துகிறார்கள் என்றாலும், அவர் இங்கே குறிக்கிறது என்னவென்றால், அவர்கள் அவருடைய சபையிலும் சபையாரிடத்திலும் அவரைத் துதிக்கமாட்டார்கள் என்பதே.",
     "anchor": "மவுனத்தில் இறங்குகிற"
    }
   ]
  }
 ]
}
