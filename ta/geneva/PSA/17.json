 "units": [
  {
   "id": "geneva/PSA.17.1",
   "source_hash": "5a8e008a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.17.1#p1-5a8e008a",
     "text": "என்னுடைய நீதியான காரியம்.",
     "anchor": "நியாயத்தை"
    }
   ]
  },
  {
   "id": "geneva/PSA.17.2",
   "source_hash": "d58231ad",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.17.2#p1-d58231ad",
     "text": "என்னுடைய பகைவர்களுக்கு எதிராக நீர் காட்டப்போகும் தண்டனை.",
     "anchor": "உம்முடைய சந்நிதியிலிருந்து என்னுடைய நியாயம் வெளிப்படுவதாக"
    }
   ]
  },
  {
   "id": "geneva/PSA.17.3",
   "source_hash": "98e127d4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.17.3#p1-06deb342",
     "text": "உம்முடைய ஆவியானவர் என்னுடைய மனச்சாட்சியை பரிசோதித்தபோது.",
     "anchor": "என்னுடைய இருதயத்தைப் பரிசோதித்து"
    },
    {
     "id": "geneva/PSA.17.3#p2-e828dfb7",
     "text": "என்னுடைய பகைவனிடத்தில் செயலிலும் நினைவிலும் நான் குற்றமற்றவனாக இருந்தேன்.",
     "anchor": "என்னுடைய வாய் மீறாதபடி தீர்மானம் செய்திருக்கிறேன்"
    }
   ]
  },
  {
   "id": "geneva/PSA.17.4",
   "source_hash": "904089fe",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.17.4#p1-904089fe",
     "text": "துன்மார்க்கர் எனக்குத் தீமைக்குத் தீமை செய்யத் தூண்டினாலும், உம்முடைய வசனம் என்னைத் தடுத்துக் காத்தது.",
     "anchor": "உம்முடைய உதடுகளின் வாக்கினாலே"
    }
   ]
  },
  {
   "id": "geneva/PSA.17.6",
   "source_hash": "fc57c3af",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.17.6#p1-fc57c3af",
     "text": "தேவன் தன்னுடைய வேண்டுதலை மறுக்கமாட்டார் என்று அவன் உறுதியாக நம்பியிருந்தான்.",
     "anchor": "நீர் எனக்குப் பதில்கொடுப்பீர்"
    }
   ]
  },
  {
   "id": "geneva/PSA.17.7",
   "source_hash": "9ba71d81",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.17.7#p1-9ba71d81",
     "text": "ஏனெனில் உம்முடைய சபையைத் தொந்தரவு செய்கிற அனைவரும் உமக்கு விரோதமாகக் கலகம் செய்கிறார்கள்.",
     "anchor": "அவர்களுக்கு விரோதமாக எழும்புகிறவர்களிடத்திலிருந்து"
    }
   ]
  },
  {
   "id": "geneva/PSA.17.9",
   "source_hash": "b631a01a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.17.9#p1-b631a01a",
     "text": "அவர்களுடைய கொடுமை என் மரணத்தினாலேயன்றி மற்றொன்றினாலும் திருப்தியாகாது.",
     "anchor": "சூழ்ந்துகொள்ளுகிற"
    }
   ]
  },
  {
   "id": "geneva/PSA.17.10",
   "source_hash": "a3f89342",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.17.10#p1-a3f89342",
     "text": "கொழுப்பினால் அடைபட்ட வயிற்றைப்போல, அவர்கள் கர்வத்தினால் ஊதிப்போயிருக்கிறார்கள்.",
     "anchor": "கொழுத்துப்போய்"
    }
   ]
  },
  {
   "id": "geneva/PSA.17.13",
   "source_hash": "6f4eb5ce",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.17.13#p1-6f4eb5ce",
     "text": "அவனுடைய கடுங்கோபத்தை அடக்கும்.",
     "anchor": "அவனை முறியடியும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.17.14",
   "source_hash": "9118277e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.17.14#p1-4689d4b0",
     "text": "உம்முடைய பரம வல்லமையினால்.",
     "anchor": "கையினால்"
    },
    {
     "id": "geneva/PSA.17.14#p2-8456c634",
     "text": "தேவனுடைய பிள்ளைகள் அடிக்கடி அனுபவிக்கும் வேதனையை உணராமல் இருக்கும்படி.",
     "anchor": "இம்மையில் தங்களுடைய பங்கைப் பெற்றிருக்கிற"
    }
   ]
  },
  {
   "id": "geneva/PSA.17.15",
   "source_hash": "e4425359",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.17.15#p1-4b6a759a",
     "text": "தேவனுடைய முகமும் தயையுள்ள முகமும் நமக்குத் திறக்கப்படுவதே சகல தாக்குதல்களுக்கும் விரோதமாகத் தேற்றரவு அளிக்கும் முழு பாக்கியம்.",
     "anchor": "நீதியில்"
    },
    {
     "id": "geneva/PSA.17.15#p2-f76467ad",
     "text": "என் மிகுந்த கஷ்டங்களிலிருந்து நான் விடுவிக்கப்படும்போது.",
     "anchor": "நான் விழிக்கும்போது"
    }
   ]
  }
 ]
}
