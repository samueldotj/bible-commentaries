 "units": [
  {
   "id": "geneva/PSA.62.1",
   "source_hash": "034d2c67",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.62.1#p1-034d2c67",
     "text": "சாத்தான் அவனை தேவனுக்கு விரோதமாக முறுமுறுக்கும்படி சோதித்தாலும், அவன் தன் உணர்வுகளைக் கட்டுப்படுத்தி, தேவனுடைய வாக்குத்தத்தத்தின்மேல் தங்கியிருந்தான்.",
     "anchor": "தேவனையே நோக்கி என்னுடைய ஆத்துமா அமர்ந்திருக்கிறது"
    }
   ]
  },
  {
   "id": "geneva/PSA.62.2",
   "source_hash": "7a00bd95",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.62.2#p1-7a00bd95",
     "text": "இந்த வார்த்தை அடிக்கடி திரும்பத் திரும்பச் சொல்லப்பட்டிருப்பதினால், தீர்க்கதரிசி தேவன்மேல் தங்கியிருப்பதினால் அநேக சோதனைகளை அனுபவித்தார் என்றும், பொறுமையினால் அவைகள் அனைத்தையும் மேற்கொண்டார் என்றும் தெரிகிறது.",
     "anchor": "அவரே என் கன்மலையும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.62.3",
   "source_hash": "b544f5b6",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.62.3#p1-91934d69",
     "text": "தேவனால் ராஜ்யத்திற்கு நியமிக்கப்பட்ட மனிதனாக, தன்னையே குறிக்கிறார்.",
     "anchor": "மனிதனுக்கு"
    },
    {
     "id": "geneva/PSA.62.3#p2-23afb46f",
     "text": "நீங்கள் கனத்தில் இருக்கிறதாகக் காணப்பட்டாலும், தேவன் உங்களை உடனடியாக அழிப்பார்.",
     "anchor": "சாய்ந்த மதிலுக்கும் இடிந்த சுவருக்கும் ஒப்பாவீர்கள்"
    }
   ]
  },
  {
   "id": "geneva/PSA.62.5",
   "source_hash": "68df4cdd",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.62.5#p1-68df4cdd",
     "text": "தாவீது இந்தத் தொல்லைகளால் மிகவும் கலங்கினார், அதனால் தேவனை நம்பும்படி தன்னைத் தானே தூண்டுகிறார்.",
     "anchor": "என்னுடைய ஆத்துமாவே"
    }
   ]
  },
  {
   "id": "geneva/PSA.62.7",
   "source_hash": "1bd9d869",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.62.7#p1-1bd9d869",
     "text": "சாத்தானின் பயங்கரமான தாக்குதலுக்கு எதிராக தன்னுடைய விசுவாசத்தைப் பலப்படுத்திக்கொள்ள, இந்தத் தீவிரமான மற்றும் அடிக்கடி மீண்டும் கூறப்படும் வார்த்தைகள் அவசியமாயிருந்தன.",
     "anchor": "மகிமையும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.62.8",
   "source_hash": "2e186729",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.62.8#p1-2e186729",
     "text": "நமது துன்மார்க்க இயல்பைக் குறித்து நம்மை எச்சரிக்கிறார்; அது நமது துக்கத்தை மறைத்து, கடிவாளத்தைக் கடித்துக்கொண்டு பொறுத்துக்கொள்ளுவதையே, தேவனிடத்தில் நமது துயரத்தை வெளிப்படுத்தி நிவாரணம் பெறுவதைவிட விரும்புகிறது.",
     "anchor": "உங்களுடைய இருதயத்தை ஊற்றிவிடுங்கள்"
    }
   ]
  },
  {
   "id": "geneva/PSA.62.10",
   "source_hash": "cc05d5ea",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.62.10#p1-cc05d5ea",
     "text": "தேவனுடைய நியாயப்பிரமாணத்திற்கு விரோதமான எல்லாவற்றையும் விட்டுவிட்டு, உங்களை முழுவதுமாக தேவனுக்கு ஒப்புக்கொடுங்கள்.",
     "anchor": "கொள்ளையினால் பெருமைபாராட்டாதிருங்கள்"
    }
   ]
  },
  {
   "id": "geneva/PSA.62.11",
   "source_hash": "b5b85f78",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.62.11#p1-b5b85f78",
     "text": "அவர் தமது வல்லமையைப் பற்றி தெளிவாகச் சாட்சி கொடுத்திருக்கிறார், ஆகவே அதைப்பற்றி ஒருவரும் சந்தேகிக்க வேண்டியதில்லை.",
     "anchor": "ஒருமுறை பேசினார்"
    }
   ]
  },
  {
   "id": "geneva/PSA.62.12",
   "source_hash": "768e97db",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.62.12#p1-768e97db",
     "text": "இதனால் துன்மார்க்கன் உம்முடைய வல்லமையை உணருவான், தேவபக்தியுள்ளவனோ உம்முடைய இரக்கத்தை உணருவான்.",
     "anchor": "செய்கைக்குத் தகுந்தபடி பலனளிக்கிறீர்"
    }
   ]
  }
 ]
}
