 "units": [
  {
   "id": "geneva/PSA.95.1",
   "source_hash": "68fa3e8c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.95.1#p1-68fa3e8c",
     "text": "தேவனுடைய பணிவிடை உயிரற்ற சடங்குகளில் அல்ல, முதன்மையாகத் துதியும் ஸ்தோத்திரமுமான பலியில் நிற்கிறது என்பதைக் காண்பிக்கிறார்.",
     "anchor": "கெம்பீரமாகப் பாடி, நம்முடைய இரட்சணியக் கன்மலையை"
    }
   ]
  },
  {
   "id": "geneva/PSA.95.3",
   "source_hash": "3acc05ff",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.95.3#p1-3acc05ff",
     "text": "மனிதர்களைப் பொறுத்தமட்டில் தேவனாக எண்ணப்படும் தூதனானவர்களும்கூட அவருடைய பார்வையில் ஒன்றுமில்லை; மனிதனுடைய மனது கற்பனை செய்து உண்டாக்கும் விக்கிரகங்கள் இன்னும் எவ்வளவு அற்பமானவைகள்.",
     "anchor": "தெய்வங்களுக்கும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.95.4",
   "source_hash": "47383644",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.95.4#p1-47383644",
     "text": "எல்லாம் அவருடைய பராமரிப்பினாலே ஆளப்படுகிறது.",
     "anchor": "மலைகளின் உயரங்களும் அவருடையவைகள்"
    }
   ]
  },
  {
   "id": "geneva/PSA.95.6",
   "source_hash": "213e70c5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.95.6#p1-213e70c5",
     "text": "இந்த மூன்று வார்த்தைகளினாலும் ஒரே காரியத்தையே அவர் குறிக்கிறார்: அதாவது, தேவனுக்கு ஊழியம் செய்யும்படி தங்களை முழுவதுமாக ஒப்புக்கொடுக்க வேண்டும் என்பதே.",
     "anchor": "பணிந்து குனிந்து"
    }
   ]
  },
  {
   "id": "geneva/PSA.95.7",
   "source_hash": "33bd8664",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.95.7#p1-33bd8664",
     "text": "அதாவது, அவர் தமது கையினால் ஆளுகை செய்யும் மக்கள். அவர்கள் தேவனுடைய மக்களாக இருப்பது எப்படி என்று அவர் காண்பிக்கிறார், அதாவது, அவர்கள் அவருடைய குரலைக் கேட்பார்களானால்.",
     "anchor": "கைக்குள்ளான"
    }
   ]
  },
  {
   "id": "geneva/PSA.95.8",
   "source_hash": "bb3cae8b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.95.8#p1-bb3cae8b",
     "text": "தேவனுடைய வசனத்தை அவமதிப்பதினால்.",
     "anchor": "உங்களுடைய இருதயத்தைக் கடினப்படுத்தாமலிருங்கள்"
    }
   ]
  },
  {
   "id": "geneva/PSA.95.10",
   "source_hash": "d7cfb355",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.95.10#p1-d7cfb355",
     "text": "அவர்களுக்கு நியாயத்தீர்ப்பும் புத்தியும் இல்லாதிருந்தது.",
     "anchor": "வழுவிப்போகிற இருதயமுள்ள"
    }
   ]
  },
  {
   "id": "geneva/PSA.95.11",
   "source_hash": "adaa7b2e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.95.11#p1-adaa7b2e",
     "text": "அதாவது, அவர் அவர்களுக்கு இளைப்பாறுதலைக் கொடுப்பேன் என்று வாக்குத்தத்தம் செய்த கானான் தேசத்திற்குள்.",
     "anchor": "என்னுடைய இளைப்பாறுதலில்"
    }
   ]
  }
 ]
}
