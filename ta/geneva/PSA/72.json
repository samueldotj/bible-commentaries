 "chapter": 72,
 "lang": "ta",
 "units": [
  {
   "id": "geneva/PSA.72.1",
   "source_hash": "8829056a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.72.1#p1-e9a53bb8",
     "text": "தாவீது தன் மகனாகிய சாலொமோனின் ஆளுகையைக் குறித்து இயற்றியது.",
     "anchor": "a"
    },
    {
     "id": "geneva/PSA.72.1#p2-e28bd10e",
     "text": "ராஜா உலகத்தின் கொடுங்கோலரசர்கள் ஆளுகை செய்வது போல ஆளாதபடிக்கு, அவனை ஞானத்தின் மற்றும் நியாயத்தின் ஆவியினால் நிரப்பும்.",
     "anchor": "நியாயத்தீர்ப்புகளையும்"
    },
    {
     "id": "geneva/PSA.72.1#p3-f21fb234",
     "text": "அதாவது, அவனுடைய சந்ததிக்கு.",
     "anchor": "மகனுக்கு"
    }
   ]
  },
  {
   "id": "geneva/PSA.72.3",
   "source_hash": "6d320de8",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.72.3#p1-6d320de8",
     "text": "நியாயம் ஆளுகை செய்யும்போது, மிகவும் பாலைவனமான இடங்களும் உம்முடைய ஆசீர்வாதங்களினால் செழிப்படையும்.",
     "anchor": "மலைகள் மக்களுக்குச் சமாதானத்தைத் தரும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.72.4",
   "source_hash": "fe2e6db5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.72.4#p1-fe2e6db5",
     "text": "அரசர்களுக்கு பட்டயம் ஒப்புவிக்கப்பட்டதன் காரணத்தை அவர் காண்பிக்கிறார், அதாவது, குற்றமில்லாதவரைப் பாதுகாத்து, துன்மார்க்கரை அடக்குவதற்காக.",
     "anchor": "மக்களில் சிறுமைப்படுகிறவர்களை அவர் நியாயம் விசாரித்து"
    }
   ]
  },
  {
   "id": "geneva/PSA.72.5",
   "source_hash": "21b8c2f8",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.72.5#p1-21b8c2f8",
     "text": "நீர் உம்முடைய வார்த்தையின்படி ஆளுகை செய்கின்ற ஒரு ராஜாவைத் தந்தருளும்போது, மக்கள் உம்முடைய உண்மையான மார்க்கத்தை ஏற்றுக்கொள்வார்கள்.",
     "anchor": "உள்ளவரை...தலைமுறை தலைமுறையாகப் பயந்திருப்பார்கள்"
    }
   ]
  },
  {
   "id": "geneva/PSA.72.6",
   "source_hash": "bd370925",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.72.6#p1-bd370925",
     "text": "இது எல்லா பக்தியுள்ள ராஜாக்களிடத்திலும் உண்மையாயிருப்பது போலவே, முதன்மையாக கிறிஸ்துவிடத்தில் நிறைவேறுகிறது; அவர் தம்முடைய பரம பனியினால் தம் சபையை என்றும் செழிக்கச் செய்கிறார்.",
     "anchor": "புல் அறுக்கப்பட வெளியின்மேல் பெய்யும் மழையைப்போலவும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.72.8",
   "source_hash": "f80cb6ce",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.72.8#p1-f80cb6ce",
     "text": "அதாவது, சிவந்த சமுத்திரம் தொடங்கி சீரியாக்கும் என்று அழைக்கப்படும் சமுத்திரம்வரைக்கும், ஐப்பிராத்து ஆற்றுக்கு அப்பாலும் என்பதாம்; இதனால் கிறிஸ்துவின் ராஜ்யம் விரிவும் சர்வவியாபகமும் உடையதாக இருக்கும் என்பதைக் குறிக்கிறது.",
     "anchor": "ஒரு சமுத்திரந்தொடங்கி மறுசமுத்திரம்வரைக்கும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.72.10",
   "source_hash": "2cd7d0aa",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.72.10#p1-972df329",
     "text": "சிலிசியாவினுடையவும், கடலுக்கு அப்பாலுள்ள மற்ற எல்லா தேசங்களினுடையவும், அவைகளைத்தான் அவர் தீவுகள் என்று குறிக்கிறார்.",
     "anchor": "தர்ஷீசின் ராஜாக்களும் மத்திய தரைக் கடல் தீவுகளின் ராஜாக்களும் காணிக்கைகளைக் கொண்டுவருவார்கள்"
    },
    {
     "id": "geneva/PSA.72.10#p2-8fa8bae1",
     "text": "அதாவது, செல்வமுள்ள தேசமான அரேபியாவினுடையவும், அதில் எத்தியோப்பியாவை ஒட்டியிருந்த ஒரு பகுதியாகிய சேபாவினுடையவும்.",
     "anchor": "ஷேபாவிலும் சேபாவிலுமுள்ள ராஜாக்கள் வெகுமானங்களைக் கொண்டுவருவார்கள்"
    }
   ]
  },
  {
   "id": "geneva/PSA.72.14",
   "source_hash": "0a315fa6",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.72.14#p1-0a315fa6",
     "text": "கொடுங்கோலர் இரத்தம் சிந்துவதற்கு தயங்காதிருந்தாலும், இந்த தேவபக்தியுள்ள ராஜா தன் குடிமக்களை எல்லாவித அநீதிகளிலிருந்தும் காப்பாற்றுவார்.",
     "anchor": "அவருடைய பார்வைக்கு அருமையாக இருக்கும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.72.15",
   "source_hash": "97109585",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.72.15#p1-97109585",
     "text": "தேவன் அவருடைய ஜீவனை வாழ்வித்து, ஜனங்களை அவருக்குக் கீழ்ப்படியும்படி மனமுள்ளவர்களாக்குவார்.",
     "anchor": "சேபாவின் பொன்"
    }
   ]
  },
  {
   "id": "geneva/PSA.72.16",
   "source_hash": "7e145ed0",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.72.16#p1-7e145ed0",
     "text": "இப்படிப்பட்ட ஒரு அரசனுடைய ஆட்சியில் பலனிலும், மனிதவர்க்கத்தின் பெருக்கத்திலும் மிகுந்த செழிப்பு உண்டாகும்.",
     "anchor": "அதின் விளைவு லீபனோனைப்போல அசையும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.72.17",
   "source_hash": "b3707584",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.72.17#p1-b3707584",
     "text": "அவர்கள் அவருடைய தொடர்ச்சிக்காக தேவனை நோக்கி ஜெபம்பண்ணுவார்கள், தேவன் அவரது நிமித்தமாகவே தங்களை வாழச்செய்கிறார் என்று அறிந்துகொள்வார்கள்.",
     "anchor": "பாக்கியமுடையவர்கள் என்று வாழ்த்துவார்கள்"
    }
   ]
  },
  {
   "id": "geneva/PSA.72.18",
   "source_hash": "5f007724",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.72.18#p1-5f007724",
     "text": "தேவன் தம்முடைய ஜனத்தை அற்புதமாகக் காக்காவிட்டால், அரசனாகிலும் அரசாட்சியாகிலும் நிலைத்திருக்கமுடியாது என்பதை அவர் இங்கே அறிக்கையிடுகிறார்.",
     "anchor": "அதிசயங்களைச் செய்கிறவர்"
    }
   ]
  },
  {
   "id": "geneva/PSA.72.20",
   "source_hash": "609577f0",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.72.20#p1-609577f0",
     "text": "தாவீது தன் மகனாகிய சாலொமோனைக் குறித்துச் சொன்ன விண்ணப்பங்கள்.",
     "anchor": "ஈசாயின் மகனாகிய தாவீதின் விண்ணப்பங்கள்"
    }
   ]
  }
 ]
}
