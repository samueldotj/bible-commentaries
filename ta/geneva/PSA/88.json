 "units": [
  {
   "id": "geneva/PSA.88.1",
   "source_hash": "599fee3f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.88.1#p1-f031df78",
     "text": "அதாவது, தாழ்மைப்படுத்துதல் என்று பொருள். இது இந்தச் சங்கீதம் இசைக்கப்பட்ட ராகத்தின் ஆரம்ப வரியாக இருந்தது.",
     "anchor": "முஹலாத்"
    },
    {
     "id": "geneva/PSA.88.1#p2-8eb9c56e",
     "text": "பலர் தங்கள் துக்கங்களில் கூப்பிடுகிறார்கள் என்றாலும், தன் இரட்சிப்பின் காரணரென அறிக்கையிட்டவனாக, அவன் கூப்பிட்டதுபோல அவர்கள் தேவனிடத்தில் மனந்திரும்புதலுக்காக ஊக்கமாகக் கூப்பிடுவதில்லை.",
     "anchor": "உம்மை நோக்கி"
    }
   ]
  },
  {
   "id": "geneva/PSA.88.5",
   "source_hash": "eea12c33",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.88.5#p1-e9980fc9",
     "text": "ஏனெனில் மரித்தவன் இந்த ஜீவனுடைய கவலைகளும் வியாபாரங்களும் நீங்கி விடுதலை பெற்றவனாக இருக்கிறான்; அப்படியே அவன் இதைச் சொல்கிறான், ஏனெனில் அவன் மனுஷனுடைய ஜீவியத்திற்குத் தொடர்பான எல்லா காரியங்களுக்கும் பயனற்றவனாகவும், இந்த உலகத்திலிருந்து அறுக்கப்பட்டவனாகவும் ஆனான்.",
     "anchor": "மரித்தவர்களில் ஒருவனைப்போல் தள்ளப்பட்டிருக்கிறேன்"
    },
    {
     "id": "geneva/PSA.88.5#p2-966505ef",
     "text": "அதாவது, உம்முடைய பராமரிப்பினாலும் கவனிப்பினாலும் நீங்கியவனாக; இது சரீரத்தின்படியான நியாயத்தீர்ப்பின்படி சொல்லப்பட்டதாகும்.",
     "anchor": "கையால்"
    }
   ]
  },
  {
   "id": "geneva/PSA.88.7",
   "source_hash": "f2d19a66",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.88.7#p1-f2d19a66",
     "text": "உம்முடைய கடுங்கோபத்தின் புயல்கள் என்னை அமிழ்த்திவிட்டன.",
     "anchor": "அலைகள்"
    }
   ]
  },
  {
   "id": "geneva/PSA.88.8",
   "source_hash": "f354dd95",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.88.8#p1-0cfbda3e",
     "text": "தன் நண்பர்களை இழந்ததற்கும், அவர்களுடைய அதிருப்திக்கும் காரணம் தேவனுடைய பராமரிப்பு என்று கூறுகிறார்; அதினாலே அவர் ஒரு பங்கில் தண்டிக்கிறார், மற்றொரு பங்கில் தம்முடையவர்களைச் சோதிக்கிறார்.",
     "anchor": "எனக்கு அறிமுகமானவர்களை எனக்குத் தூரமாக விலக்கி"
    },
    {
     "id": "geneva/PSA.88.8#p2-a30dfe6a",
     "text": "என் துக்கங்களுக்கு முடிவைக் காணவில்லை.",
     "anchor": "நான் வெளியேற முடியாதபடி அடைபட்டிருக்கிறேன்"
    }
   ]
  },
  {
   "id": "geneva/PSA.88.9",
   "source_hash": "b591c606",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.88.9#p1-b591c606",
     "text": "என்னுடைய கண்ணும் முகமும் என்னுடைய துக்கங்களை வெளிப்படுத்துகின்றன.",
     "anchor": "துக்கத்தினால் என்னுடைய கண் தொய்ந்துபோனது"
    }
   ]
  },
  {
   "id": "geneva/PSA.88.10",
   "source_hash": "7f934823",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.88.10#p1-7f934823",
     "text": "தேவன் மனுஷர் தங்கள் ஆபத்துகளில் அவரை நோக்கிக் கூப்பிடும்போது உதவிசெய்வது, அவர்கள் இறந்துபோனபின் காத்திருந்து பின்பு அவர்களை எழுந்திருக்கச்செய்வதைக் காட்டிலும் மிகவும் தகுந்த காலம் என்று அவர் காண்பிக்கிறார்.",
     "anchor": "இறந்தவர்களுக்கு அதிசயங்களை"
    }
   ]
  },
  {
   "id": "geneva/PSA.88.12",
   "source_hash": "956c4991",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.88.12#p1-956c4991",
     "text": "அதாவது, சரீரம் மட்டும் எவ்வித உணர்வும் நினைவும் இல்லாமல் கிடக்கும் கல்லறையில்.",
     "anchor": "மறதியின் பூமியில்"
    }
   ]
  },
  {
   "id": "geneva/PSA.88.15",
   "source_hash": "828da899",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.88.15#p1-828da899",
     "text": "நான் ஒவ்வொரு நிமிடமும் என் உயிர் முற்றிலும் வெட்டப்பட்டுப்போகுமோ என்னும்படி எப்போதும் பெரும் ஆபத்துகளிலும் துக்கங்களிலும் இருக்கிறேன்.",
     "anchor": "சிறுவயதுமுதல்"
    }
   ]
  }
 ]
}
