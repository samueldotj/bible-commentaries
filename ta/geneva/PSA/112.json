   "paragraphs": [
    {
     "id": "geneva/PSA.112.1#p1-7286f42d",
     "text": "தேவனுடைய பிள்ளைகளுக்குள் இருக்கிற பயபக்தியுள்ள பயத்தையே இவன் குறிக்கிறான்; இது அவர்களை தேவவசனத்தில் மாத்திரம் பிரியமாயிருக்கச் செய்கிறது.",
     "anchor": "யெகோவாவுக்குப் பயந்து"
    }
   ]
  },
  {
   "id": "geneva/PSA.112.3",
   "source_hash": "50992ef4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.112.3#p1-50992ef4",
     "text": "தேவபக்தியுள்ளவர்களுக்குச் செழிப்பும் திருப்தியும் உண்டாயிருக்கும், ஏனெனில் அவர்களுடைய இருதயம் தேவனாகிய தேவன் ஒருவரிலேயே திருப்தியடைந்திருக்கும்.",
     "anchor": "செழிப்பும் செல்வமும் அவனுடைய வீட்டிலிருக்கும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.112.4",
   "source_hash": "9679123a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.112.4#p1-9679123a",
     "text": "உண்மையுள்ளவர்கள் தங்களுடைய எல்லா துன்பங்களிலும், தேவன் இரக்கமுள்ளவராகவும் நீதியுள்ளவராகவும் இருப்பதால், தங்களுக்கு எல்லாம் நன்மையாக நடக்கும் என்று அறிந்திருக்கிறார்கள்.",
     "anchor": "செம்மையானவர்களுக்கு இருளிலே வெளிச்சம் உதிக்கும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.112.5",
   "source_hash": "027b3b62",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.112.5#p1-027b3b62",
     "text": "இரக்கத்தின் கனி என்னவென்று இவன் காண்பிக்கிறான்; அதாவது, ஆதாயத்திற்காக அல்ல, மனநிறைவோடு கடன் கொடுப்பதும், மேலும் தேவை உண்டானபோது உதவி செய்யக்கூடியவனாக இருக்கும்படி தன் காரியங்களை அளவோடு நடத்துவதும், எல்லாவற்றையும் தனக்கே செலவழிக்காமல் இருப்பதுமே.",
     "anchor": "கடன்கொடுத்து"
    }
   ]
  },
  {
   "id": "geneva/PSA.112.9",
   "source_hash": "55a88735",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.112.9#p1-1a1cc897",
     "text": "தேவபக்தியுள்ளவர்கள் கஞ்சத்தனமாக இருப்பதில்லை, மாறாக ஏழைகளின் தேவைக்கும் தன் பராக்கிரமத்திற்கும் ஏற்றபடி தாராளமாகப் பகிர்ந்து கொடுக்கிறார்கள்.",
     "anchor": "வாரியிறைத்தான்"
    },
    {
     "id": "geneva/PSA.112.9#p2-9994d230",
     "text": "அவனுடைய பராக்கிரமும் செழிப்பான நிலையும்.",
     "anchor": "கொம்பு மகிமையாக உயர்த்தப்படும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.112.10",
   "source_hash": "086d61bd",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.112.10#p1-086d61bd",
     "text": "தேவன் தம்முடைய பிள்ளைகள்மேல் அருளும் ஆசீர்வாதங்கள் துன்மார்க்கனைப் பொறாமையினால் மரிக்கச் செய்யும்.",
     "anchor": "கரைந்துபோவான்"
    }
   ]
  }
 ]
}
