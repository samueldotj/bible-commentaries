 "units": [
  {
   "id": "geneva/PSA.141.1",
   "source_hash": "bcaa380b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.141.1#p1-bcaa380b",
     "text": "நமக்கு தேவையேற்படும்போது ஆத்துமாவின் ஆறுதலுக்காக தேவனிடத்தில் ஓடிப்போவதைத் தவிர வேறு தஞ்சம் இல்லை என்று அவர் காண்பிக்கிறார்.",
     "anchor": "நோக்கிக் கூப்பிடுகிறேன்"
    }
   ]
  },
  {
   "id": "geneva/PSA.141.2",
   "source_hash": "6840a941",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.141.2#p1-6840a941",
     "text": "இவன் தன் ஜெபத்தில் காண்பித்த ஆவலான ஆசையையும் சைகையையும் குறிக்கிறான்: இது தேவனுடைய கற்பனையின்படி பழைய நியாயப்பிரமாணத்தில் பலியிடப்பட்ட பலிகளைக் குறிப்பதாக இருக்கிறது.",
     "anchor": "என் கையுயர்த்துதல்"
    }
   ]
  },
  {
   "id": "geneva/PSA.141.3",
   "source_hash": "649f2ce2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.141.3#p1-649f2ce2",
     "text": "தான் பழிவாங்குதலை நினைப்பதிலிருந்தும் நடப்பிப்பதிலிருந்தும் தன்னுடைய நினைவுகளையும் வழிகளையும் காத்துக்கொள்ளும்படி தேவனை வேண்டுகிறார்.",
     "anchor": "என்னுடைய உதடுகளின் வாசலைக் காத்துக்கொள்ளும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.141.4",
   "source_hash": "65eaaf37",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.141.4#p1-65eaaf37",
     "text": "அவர்களுடைய செல்வப்பெருக்கு என்னை அவர்களைப்போல துன்மார்க்கனாகும்படி இழுத்துவிடாதிருக்கட்டும்.",
     "anchor": "ருசியுள்ள உணவுகளில்"
    }
   ]
  },
  {
   "id": "geneva/PSA.141.5",
   "source_hash": "c596338c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.141.5#p1-c596338c",
     "text": "அன்புள்ள இருதயத்திலிருந்து வரும் எந்தத் திருத்தத்தையும் அவன் ஏற்றுக்கொள்ள முடியும்.",
     "anchor": "என்னைக் கடிந்துகொள்ளட்டும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.141.6",
   "source_hash": "03c4baee",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.141.6#p1-03c4baee",
     "text": "தீர்க்கதரிசியைத் துன்புறுத்துகிற தங்களுடைய துன்மார்க்கமான நியாயாதிபதிகளைப் பின்பற்றின மக்கள், அவர்களுடைய துன்மார்க்கமான நியாயாதிபதிகள் தண்டிக்கப்படுகிறதைக் காணும்போது மனந்திரும்பி தேவனிடத்தில் திரும்புவார்கள்.",
     "anchor": "என்னுடைய வார்த்தைகள் இன்பமானவைகளென்று கேட்பார்கள்"
    }
   ]
  },
  {
   "id": "geneva/PSA.141.7",
   "source_hash": "44cc31e4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.141.7#p1-44cc31e4",
     "text": "இதிலிருந்து தாவீது 2 கொரிந்தியர் 1:9,10-ல் உள்ளதுபோல அநேக மரணங்களிலிருந்து அற்புதமாக காப்பாற்றப்பட்டார் என்று தெரிகிறது.",
     "anchor": "பாதாள வாய்க்கு"
    }
   ]
  },
  {
   "id": "geneva/PSA.141.10",
   "source_hash": "fb433909",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.141.10#p1-0445fce4",
     "text": "தேவனுடைய வலைகளில், அவைகளினால் அவர் துன்மார்க்கரை அவர்களுடைய சொந்த பொல்லாப்பினாலேயே பிடிக்கிறார்.",
     "anchor": "தங்களுடைய வலைகளில்"
    },
    {
     "id": "geneva/PSA.141.10#p2-c2d27c96",
     "text": "அவர்களில் ஒருவரும் தப்பிக்காதபடிக்கு.",
     "anchor": "நானோ அதற்குத் தப்பிக் கடந்துபோவேன்"
    }
   ]
  }
 ]
}
