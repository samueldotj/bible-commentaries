 "units": [
  {
   "id": "geneva/PSA.97.1",
   "source_hash": "674124c5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.97.1#p1-efa27202",
     "text": "தேவன் ராஜரிகம்செய்கிற இடத்தில் எல்லா சந்தோஷமும் ஆவிக்குரிய மகிழ்ச்சியும் உண்டு என்று அவர் காண்பிக்கிறார்.",
     "anchor": "யெகோவா ராஜரிகம்செய்கிறார்"
    },
    {
     "id": "geneva/PSA.97.1#p2-de95558a",
     "text": "ஏனெனில் நற்செய்தி யூதேயாவில் மட்டும் பிரசங்கம் செய்யப்படாமல், எல்லா தீவுகளிலும் நாடுகளிலும் பிரசங்கிக்கப்படும்.",
     "anchor": "திரளான தீவுகள் மகிழட்டும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.97.2",
   "source_hash": "ef7d66ca",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.97.2#p1-ef7d66ca",
     "text": "பொதுவாகத் தேவனுடைய வல்லமையை அற்பமாக நினைக்கிற தம்முடைய எதிரிகளை பயத்தில் வைக்கும்படி அவர் இவ்விதமாக விவரிக்கப்படுகிறார்.",
     "anchor": "மேகமும் மந்தாரமும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.97.4",
   "source_hash": "a7851d7d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.97.4#p1-a7851d7d",
     "text": "இந்தப் பயம் துன்மார்க்கரை உண்மையான கீழ்ப்படிதலுக்குக் கொண்டுவராமல், அவர்களைத் தேவனிடத்திலிருந்து ஓடிப்போகச் செய்கிறது.",
     "anchor": "அதிர்ந்தது"
    }
   ]
  },
  {
   "id": "geneva/PSA.97.7",
   "source_hash": "1b3635fc",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.97.7#p1-a29fd56a",
     "text": "தேவனுடைய நியாயத்தீர்ப்புகள் விக்கிரக ஆராதனையை அழிக்கத் தயாராயிருக்கின்றன என்று அவர் குறிப்பிடுகிறார்.",
     "anchor": "சிலைகளை வணங்கி, விக்கிரகங்களைப்பற்றிப் பெருமைபாராட்டுகிற அனைவரும் வெட்கப்பட்டுப் போவார்களாக"
    },
    {
     "id": "geneva/PSA.97.7#p2-bd4f246c",
     "text": "உலகத்தில் மேன்மையாய் எண்ணப்படுகிற அனைவரும் அவருக்கு முன்பாக விழுந்து தொழுதுகொள்ளக்கடவது.",
     "anchor": "தெய்வங்களே, நீங்களெல்லோரும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.97.8",
   "source_hash": "3ddcabb3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.97.8#p1-3ddcabb3",
     "text": "யூதரல்லாதவர்கள் தேவனுடைய தயவில் யூதர்களோடு பங்குபெற்றவர்களானதைக் குறித்து யூதர்களுக்கு சந்தோஷப்படுவதற்கான வாய்ப்பு உண்டாகும்.",
     "anchor": "யூதாவின் மகள்கள் சந்தோஷப்பட்டார்கள்"
    }
   ]
  },
  {
   "id": "geneva/PSA.97.10",
   "source_hash": "09374e0a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.97.10#p1-09374e0a",
     "text": "அவர் தம்முடைய பிள்ளைகளிடத்தில் இரண்டு காரியங்களைக் கேட்கிறார்: ஒன்று, அவர்கள் தீமையை வெறுக்க வேண்டும் என்பதும், மற்றொன்று, தங்கள் விடுதலைக்காக தேவன்மேல் நம்பிக்கை வைக்க வேண்டும் என்பதும்.",
     "anchor": "யெகோவாவில் அன்புகூருகிறவர்களே"
    }
   ]
  },
  {
   "id": "geneva/PSA.97.11",
   "source_hash": "13998626",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.97.11#p1-13998626",
     "text": "தேவனுடைய விடுதலை உடனடியாகக் காணப்படாவிட்டாலும், அது அவர்களுக்காக விதைக்கப்பட்டு பதுக்கி வைக்கப்பட்டிருக்கிறது.",
     "anchor": "நீதிமானுக்காக வெளிச்சமும்... விதைக்கப்பட்டிருக்கிறது"
    }
   ]
  },
  {
   "id": "geneva/PSA.97.12",
   "source_hash": "476d8607",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.97.12#p1-476d8607",
     "text": "அவருடைய நன்மைகளை நினைவுகூர்ந்து, அவருடைய பாதுகாப்பையே நம்புங்கள்.",
     "anchor": "பரிசுத்தத்தின் நினைவுகூருதலை"
    }
   ]
  }
 ]
}
