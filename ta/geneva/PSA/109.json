 "chapter": 109,
 "lang": "ta",
 "units": [
  {
   "id": "geneva/PSA.109.1",
   "source_hash": "c22c7dd4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.109.1#p1-c22c7dd4",
     "text": "உலகம் முழுவதும் என்மேல் குற்றஞ்சுமத்தினாலும், நீர் என் குற்றமில்லாமையை ஏற்றுக்கொள்வீர், அதே எனக்குப் போதுமான துதியாக இருக்கும்.",
     "anchor": "துதிக்கும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.109.4",
   "source_hash": "bfda3dbd",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.109.4#p1-bfda3dbd",
     "text": "என் மனச்சாட்சி அமைதியாயிருந்த உம்மைத் தவிர எனக்கு வேறு அடைக்கலம் இல்லை என்பதை தெரிவிக்கும்படி.",
     "anchor": "நானோ ஜெபம் செய்து கொண்டிருக்கிறேன்"
    }
   ]
  },
  {
   "id": "geneva/PSA.109.6",
   "source_hash": "5aa7264b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.109.6#p1-5aa7264b",
     "text": "அது தோவேக்காக இருந்தாலும் சவுலாக இருந்தாலும், அல்லது தன்னைத் துரோகம் செய்த ஒரு நெருங்கிய நண்பனாக இருந்தாலும், அவன் தன் தனிப்பட்ட பகைமையினால் ஜெபம்பண்ணுகிறதில்லை, மாறாக தேவனுடைய ஆவியானவரால் ஏவப்பட்டு, தேவன் அவனுக்குப் பழிவாங்குமாறு வேண்டுகிறான்.",
     "anchor": "அவனுக்கு மேலாகத் தீயவனை ஏற்படுத்தி வையும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.109.7",
   "source_hash": "09326162",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.109.7#p1-09326162",
     "text": "தெரிந்துகொள்ளப்பட்டவர்களுக்கு எல்லாக் காரியங்களும் நன்மையாக மாறுவது போல, ஒதுக்கப்பட்டவர்களுக்கு நல்லவையாகவே இருக்கிற காரியங்களும் அழிவுக்கு ஏதுவாக மாறும்.",
     "anchor": "அவனுடைய ஜெபம் பாவமாகட்டும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.109.8",
   "source_hash": "702c4d62",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.109.8#p1-702c4d62",
     "text": "இது முதன்மையாக யூதாஸ்காரியோத்தில் நிறைவேறியது, அப். நட. 1:20.",
     "anchor": "வேலையை வேறொருவன் பெறட்டும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.109.11",
   "source_hash": "bd19bd60",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.109.11#p1-bd19bd60",
     "text": "கொள்ளையடிக்கிறவர்களின்மேல் தேவனுடைய சாபம் இருக்கிறது என்று அவர் அறிவிக்கிறார்; அவர்கள் அநியாயமாக ஈட்டிய பொருளினால் தங்கள் பிள்ளைகளை செல்வந்தராக்க நினைத்தும், தேவனுடைய நீதியான நியாயத்தீர்ப்பினால் எல்லாவற்றையும் இழந்துவிடுகிறார்கள்.",
     "anchor": "கடன் கொடுத்தவன் அவனுக்கு உள்ளதெல்லாவற்றையும் அபகரித்துக்கொள்ளட்டும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.109.14",
   "source_hash": "b1203692",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.109.14#p1-b1203692",
     "text": "இவ்விதமாய் கர்த்தர் பெற்றோரின் துன்மார்க்கத்தை அவர்களுடைய துன்மார்க்கமான பிள்ளைகளிலே மூன்றாம் நாலாம் தலைமுறைவரைக்கும் தண்டிக்கிறார்.",
     "anchor": "அவனுடைய முன்னோர்களின் அக்கிரமம்"
    }
   ]
  },
  {
   "id": "geneva/PSA.109.16",
   "source_hash": "b3aa4fb5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.109.16#p1-b3aa4fb5",
     "text": "மற்றவர்களுக்குத் தாம் கொடூரமாக நடந்துகொள்கிறவர்களை தேவன் ஒரு அபூர்வமான விதத்தில் வாதிக்கிறார் என்பதை இவன் காண்பிக்கிறான்.",
     "anchor": "தயவுசெய்ய நினைக்காமல்"
    }
   ]
  },
  {
   "id": "geneva/PSA.109.17",
   "source_hash": "5f2e3637",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.109.17#p1-5f2e3637",
     "text": "இவ்விதமாக, கர்த்தர் ஒவ்வொரு மனிதனுக்கும் அவன் விரும்புகிற காரியத்தையே கொடுக்கிறார், அதனால் ஒதுக்கப்பட்டவர்கள் தங்கள் இச்சைகளுக்கும் ஒதுக்கப்பட்ட மனதிற்கும் கையளிக்கப்படும்போது தேவனை அநீதி செய்கிறவர் என்று குற்றம் சாட்ட முடியாது.",
     "anchor": "அது அவனுக்கு வரும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.109.20",
   "source_hash": "c9aa3bf7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.109.20#p1-c9aa3bf7",
     "text": "மனித உதவி இல்லாதவனாக இருந்ததால், அவர் தன்னை விடுவிப்பார் என்று கர்த்தரை முழுமையாக நம்பினான்.",
     "anchor": "யெகோவாவால் வரும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.109.21",
   "source_hash": "96f256da",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.109.21#p1-96f256da",
     "text": "தேவரீர் இரக்கமும், கிருபையும், நீடிய பொறுமையும் உள்ளவர் என்று பெயரிடப்பட்டிருக்கிறபடி, அப்படியே கிரியையிலும் உம்மைக் காண்பித்தருளும்.",
     "anchor": "பெயரினிமித்தம்"
    }
   ]
  },
  {
   "id": "geneva/PSA.109.23",
   "source_hash": "448c16e4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.109.23#p1-448c16e4",
     "text": "இவ்வுலகத்தில் தனக்கு நிலைத்திருப்போ நிச்சயமுமோ இல்லை என்று அர்த்தம்.",
     "anchor": "வெட்டுக்கிளியைப்போல்"
    }
   ]
  },
  {
   "id": "geneva/PSA.109.24",
   "source_hash": "1638a20c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.109.24#p1-1638a20c",
     "text": "துக்கத்தினால் உண்டான பசியினால், அவன் மெலிந்து அவனுடைய சுபாவமான ஈரம் குறைந்துபோனது.",
     "anchor": "பலமற்று உலர்ந்து போகிறது"
    }
   ]
  },
  {
   "id": "geneva/PSA.109.26",
   "source_hash": "9df12281",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.109.26#p1-9df12281",
     "text": "சாத்தான் அவனை எவ்வளவு கொடுமையாகத் தாக்கினானோ, அவ்வளவு அதிகமாக அவன் ஜெபத்தில் ஊக்கத்துடனும் தீவிரமுடனும் இருந்தான்.",
     "anchor": "உமது கிருபையின்படி என்னைக் காப்பாற்றும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.109.28",
   "source_hash": "cb24864f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.109.28#p1-cb24864f",
     "text": "என்னைச் சபிப்பதினால் அவர்களுக்கு ஒன்றும் கிடைக்காது.",
     "anchor": "சபித்தாலும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.109.30",
   "source_hash": "2428121e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.109.30#p1-2428121e",
     "text": "என்னுள்ளே இரகசியமாக அறிக்கை செய்வது மட்டுமல்ல, சபையார் அனைவருக்கு முன்பாக அதை வெளிப்படுத்துவதும்.",
     "anchor": "வாயினால்"
    }
   ]
  },
  {
   "id": "geneva/PSA.109.31",
   "source_hash": "aad3e5a3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.109.31#p1-aad3e5a3",
     "text": "இதினால் அவன் சிற்றளவு வலிமையுள்ளவர்களோடு அல்ல, உலகத்தின் நியாயாதிபதிகளோடும் அதிபதிகளோடும் தொடர்புள்ளவனாக இருந்தான் என்பதைக் காண்பிக்கிறான்.",
     "anchor": "தண்டனைக்குள்ளாகத் தீர்க்கிறவர்களிடம்"
    }
   ]
  }
 ]
}
