 "units": [
  {
   "id": "geneva/PSA.118.1",
   "source_hash": "5525a569",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.118.1#p1-5525a569",
     "text": "தேவன் தாவீதை ராஜாவாக்கினதினால், தமது உபத்திரவப்பட்ட சபையின்மேல் தமது இரக்கத்தை வெளிப்படுத்தினபடியால், தீர்க்கதரிசி தானே தேவனுக்கு ஸ்தோத்திரம் செலுத்துகிறது மாத்திரமல்ல, மக்கள் அனைவரையும் அப்படியே செய்யும்படி புத்தி சொல்லுகிறார்.",
     "anchor": "யெகோவாவை துதியுங்கள்"
    }
   ]
  },
  {
   "id": "geneva/PSA.118.5",
   "source_hash": "60b9a6e1",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.118.5#p1-60b9a6e1",
     "text": "துன்பங்கள் நம்மை அதிகமாக நெருக்குகின்ற அளவிற்கு, நாம் அதிகமாக ஜெபத்தில் தரித்திருக்க வேண்டும் என்பதை இங்கே கற்றுக்கொள்கிறோம்.",
     "anchor": "நெருக்கத்திலிருந்து"
    }
   ]
  },
  {
   "id": "geneva/PSA.118.6",
   "source_hash": "332d1cc3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.118.6#p1-332d1cc3",
     "text": "இந்த நிலைக்கு உயர்த்தப்பட்டதினால், மனிதன் எப்போதும் தனக்கு பகைவனாய் இருப்பான் என்று அவன் உறுதியாய் அறிந்திருந்தான். ஆனாலும் தேவன் தன்னை நிலைநிறுத்தி வைப்பார் என்பதில் அவன் சந்தேகப்படவில்லை, ஏனெனில் தேவனே தன்னை அந்த நிலையில் வைத்திருந்தார்.",
     "anchor": "மனிதன் எனக்கு என்ன செய்வான்"
    }
   ]
  },
  {
   "id": "geneva/PSA.118.8",
   "source_hash": "a376bc1d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.118.8#p1-a376bc1d",
     "text": "அரசுக்கு முன்னுரிமை பெற தான் மனுஷன் மேல் நம்பிக்கை வைத்திருந்தால் அந்த நம்பிக்கை வீணாயிருக்கும் என்பதைக் காண்பிக்கிறார்; ஆகவே அவர் தேவன் மேல் பற்றுதலாயிருந்து அதைப் பெற்றுக்கொண்டார்.",
     "anchor": "மனிதனை நம்புவதைவிட"
    }
   ]
  },
  {
   "id": "geneva/PSA.118.13",
   "source_hash": "f1bba54b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.118.13#p1-f1bba54b",
     "text": "அவனுடைய முதன்மையான எதிரியாகிய சவுலைக் குறிக்கிறான்.",
     "anchor": "நான் விழும்படி நீ என்னைத் தள்ளினாய்"
    }
   ]
  },
  {
   "id": "geneva/PSA.118.14",
   "source_hash": "391b99ff",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.118.14#p1-391b99ff",
     "text": "அவன் விடுவிக்கப்பட்டதில், அது தன்னிலிருந்தோ, மனுஷனுடைய பலத்திலிருந்தோ வந்ததல்ல, தேவனுடைய தயவினால் மட்டுமே வந்தது; ஆகையால் அவன் அவரைத் துதிப்பான்.",
     "anchor": "பாடலுமானவர்"
    }
   ]
  },
  {
   "id": "geneva/PSA.118.15",
   "source_hash": "1a3fe006",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.118.15#p1-1a3fe006",
     "text": "தான் கிருபை செலுத்துவதுடன், மற்றவர்களையும் அதைச் செய்யத்தூண்டுவேன் என்று வாக்குத்தத்தம் செய்கிறார்; ஏனெனில் அவருடைய நபரில் சபை மீட்டு நிறுத்தப்பட்டது.",
     "anchor": "இரட்சிப்பின் கெம்பீர சத்தம் உண்டு"
    }
   ]
  },
  {
   "id": "geneva/PSA.118.17",
   "source_hash": "f7c64b7f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.118.17#p1-f7c64b7f",
     "text": "அதனால் தூரத்திலும் அருகிலும் இருக்கிற அனைவரும் அவருடைய வல்லமையான சக்தியைக் காணும்படியாக.",
     "anchor": "யெகோவாவுடைய செய்கைகளை விவரிப்பேன்"
    }
   ]
  },
  {
   "id": "geneva/PSA.118.19",
   "source_hash": "541cf94c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.118.19#p1-541cf94c",
     "text": "தன் நன்றியறிதலுள்ள மனதை வெளிப்படுத்துவதற்காக ஆசரிப்புக்கூடாரத்தின் வாசல்கள் திறக்கப்படவேண்டும் என்று விரும்புகிறான்.",
     "anchor": "நீதியின் வாசல்களை"
    }
   ]
  },
  {
   "id": "geneva/PSA.118.22",
   "source_hash": "190b81ce",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.118.22#p1-190b81ce",
     "text": "சவுலும் முதன்மையான அதிகாரிகளும் என்னை ராஜாவாக ஏற்றுக்கொள்ளாமல் தள்ளினாலும், தேவன் என்னை அவர்கள் எல்லோரையும்விட உயர்த்தினார்.",
     "anchor": "தள்ளின கல்லே, மூலைக்குத் தலைக்கல்லானது"
    }
   ]
  },
  {
   "id": "geneva/PSA.118.24",
   "source_hash": "06a9e6fd",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.118.24#p1-06a9e6fd",
     "text": "என்னை ராஜாவாக ஏற்படுத்தி, தமது சபையை விடுவித்ததினால், அந்த நாளிலே தேவன் தமது இரக்கத்தை முதன்மையாக காண்பித்திருக்கிறார்.",
     "anchor": "யெகோவா உண்டாக்கின நாள்"
    }
   ]
  },
  {
   "id": "geneva/PSA.118.25",
   "source_hash": "86aaa3ad",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.118.25#p1-86aaa3ad",
     "text": "கிறிஸ்துவின் நிழலாட்சியாக இருந்த தாவீதின் ராஜ்யத்தின் செழிப்புக்காக மக்கள் ஜெபம்பண்ணுகிறார்கள்.",
     "anchor": "யெகோவாவே"
    }
   ]
  },
  {
   "id": "geneva/PSA.118.26",
   "source_hash": "878d4b93",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.118.26#p1-878d4b93",
     "text": "இவர்கள் ஆசாரியர்கள், எண்ணாகமம் 6:23 இல் இருப்பதுபோல அதற்குப் பொறுப்புள்ளவர்கள்.",
     "anchor": "உங்களை ஆசீர்வதிக்கிறோம்"
    }
   ]
  },
  {
   "id": "geneva/PSA.118.27",
   "source_hash": "185b5356",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.118.27#p1-185b5356",
     "text": "அவர் நம்மை இருளிலிருந்து ஒளியினிடத்திற்குத் திரும்பிவரச்செய்தபடியால், நாம் அவருக்குப் பலிகளையும் துதிகளையும் செலுத்துவோம்.",
     "anchor": "பிரகாசிக்கச்செய்கிற"
    }
   ]
  }
 ]
}
