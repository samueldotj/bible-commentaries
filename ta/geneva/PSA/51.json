 "chapter": 51,
 "lang": "ta",
 "units": [
  {
   "id": "geneva/PSA.51.1",
   "source_hash": "038d2bd3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.51.1#p1-09c93134",
     "text": "அவன் கொடிய பாவங்களைச் செய்து, மனந்திரும்புதலின்றி ஒரு வருடமுழுவதற்கும் மேலாக அவற்றில் கிடந்ததினிமித்தம் அவனைக் கடிந்துகொள்ளும்படி."
    },
    {
     "id": "geneva/PSA.51.1#p2-9aeaa67d",
     "text": "அவனுடைய பாவங்கள் அநேகமும் பெரியனவுமாய் இருந்தபடியால், தேவனுடைய மேன்மையும் மிகுதியுமான இரக்கங்களை அவன் உணரும்படி தேவன் அவற்றைத் தனக்கு அருளிச்செய்யவேண்டுமென்று வேண்டிக்கொள்கிறான்.",
     "anchor": "உமது மிகுந்த இரக்கங்களின்படி"
    }
   ]
  },
  {
   "id": "geneva/PSA.51.2",
   "source_hash": "33e3d973",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.51.2#p1-33e3d973",
     "text": "என் பாவங்கள் என்னில் இவ்வளவு ஆழமாக பதிந்திருக்கிறபடியால், ஒரு விசேஷித்த வகையான கழுவுதல் எனக்குத் தேவைப்படுகிறது.",
     "anchor": "முற்றிலும் கழுவி"
    }
   ]
  },
  {
   "id": "geneva/PSA.51.3",
   "source_hash": "2d74554b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.51.3#p1-2d74554b",
     "text": "என்னுடைய மனச்சாட்சி என்னைக் குற்றப்படுத்துகிறபடியால், நான் ஒப்புரவாக்கப்படும்வரை எனக்கு ஓய்வு இல்லை.",
     "anchor": "என்னுடைய மீறுதல்களை நான் அறிந்திருக்கிறேன்"
    }
   ]
  },
  {
   "id": "geneva/PSA.51.4",
   "source_hash": "ffe8bbc1",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.51.4#p1-ffe8bbc1",
     "text": "பாவிகளுக்கு விரோதமாக நீர் நியாயத்தீர்ப்புக் கொடுக்கும்போது, அவர்கள் உம்மை நீதியுள்ளவர் என்றும், தங்களைப் பாவிகள் என்றும் அறிக்கையிடவேண்டும்.",
     "anchor": "பேசும்போது"
    }
   ]
  },
  {
   "id": "geneva/PSA.51.6",
   "source_hash": "6eebb685",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.51.6#p1-6eebb685",
     "text": "உள்ளத்தின் தூய்மையில் அன்புகூரும் தேவன், இயல்பாகவே பாவியாயிருக்கிற மனிதனை நியாயமாக அழிக்கக்கூடும், அவர் தம்முடைய பரம ஞானத்தில் போதித்திருந்தவனையும் அதிலும் அதிகமாக அழிக்கக்கூடும் என்பதை அவன் இங்கே அறிக்கைசெய்கிறான்.",
     "anchor": "உள்ளத்தில் உண்மையிருக்க விரும்புகிறீர்"
    }
   ]
  },
  {
   "id": "geneva/PSA.51.8",
   "source_hash": "3e8f4623",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.51.8#p1-1b5ec3ef",
     "text": "பாவமன்னிப்புப் பெற்ற பாவிகள்மேல் தேவன் காண்பிக்கும் ஆறுதலான கிருபைகளையே அவர் குறிக்கிறார்.",
     "anchor": "சந்தோஷமும் மகிழ்ச்சியும்"
    },
    {
     "id": "geneva/PSA.51.8#p2-566d6101",
     "text": "எலும்புகளினால் ஆத்துமாவினுடையவும் சரீரத்தினுடையவும் முழு பலத்தையும் அவர் குறிக்கிறார், அது கவலைகளாலும் துக்கத்தாலும் தேய்ந்துபோகிறது.",
     "anchor": "நீர் நொறுக்கின எலும்புகள்"
    }
   ]
  },
  {
   "id": "geneva/PSA.51.10",
   "source_hash": "5c73175c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.51.10#p1-5c73175c",
     "text": "தேவனுடைய ஆவியானவர் நமக்குள் தணிந்துபோனபொழுது, அதை மறுபடியும் புதுப்பிக்கப்படுவது ஒரு புதுச்சிருஷ்டிப்புக்குச் சமானமென்று இவன் அறிக்கையிடுகிறான்.",
     "anchor": "சுத்த இருதயத்தை என்னிலே உருவாக்கும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.51.12",
   "source_hash": "2802552a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.51.12#p1-2802552a",
     "text": "இது நான் பாவத்தின் அடிமைத்தனத்திலிருந்து விடுவிக்கப்பட்டேன் என்பதை எனக்கு உறுதிப்படுத்தும்.",
     "anchor": "உற்சாகமான ஆவி"
    }
   ]
  },
  {
   "id": "geneva/PSA.51.13",
   "source_hash": "33904371",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.51.13#p1-33904371",
     "text": "தன்னுடைய முன்மாதிரியினால் மற்றவர்கள் தேவனிடத்தில் மனந்திரும்புமாறு தான் ஆயத்தமாயிருப்பதாக அவர் வாக்குத்தத்தம் செய்கிறார்.",
     "anchor": "வழிகளை"
    }
   ]
  },
  {
   "id": "geneva/PSA.51.14",
   "source_hash": "ded4419f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.51.14#p1-ded4419f",
     "text": "உரியாவினுடையவும் அவனுடன் கொலையுண்ட மற்றவர்களினுடையவும் கொலையிலிருந்து, 2 சாமுவேல் 11:17.",
     "anchor": "இரத்தப்பழிகளுக்கு"
    }
   ]
  },
  {
   "id": "geneva/PSA.51.15",
   "source_hash": "4f5464c5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.51.15#p1-4f5464c5",
     "text": "தேவரீர் என்னுடைய பாவங்களை மன்னிக்கும்போது, உம்மைத் துதிக்கும்படியான வாய்ப்பை எனக்குக் கொடுப்பதினால்.",
     "anchor": "என்னுடைய உதடுகளைத் திறந்தருளும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.51.17",
   "source_hash": "5647f6ec",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.51.17#p1-5647f6ec",
     "text": "இது இருதயத்தில் ஏற்படும் காயமாகும், அது தேவனிடம் இரக்கத்தைத் தேடும் விசுவாசத்திலிருந்து உண்டாகிறது.",
     "anchor": "நொறுங்குண்ட ஆவி"
    }
   ]
  },
  {
   "id": "geneva/PSA.51.18",
   "source_hash": "80a9775b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.51.18#p1-80a9775b",
     "text": "அவனுடைய பாவத்தினால் தேவனுடைய நியாயத்தீர்ப்புக்கு ஆபத்தில் இருந்த முழு சபைக்காகவும் அவன் ஜெபம்பண்ணுகிறான்.",
     "anchor": "சீயோனுக்கு"
    }
   ]
  },
  {
   "id": "geneva/PSA.51.19",
   "source_hash": "d6bea464",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.51.19#p1-d6bea464",
     "text": "அதாவது, நியாயமும் நீதியுமானது, விசுவாசத்தையும் மனந்திரும்புதலையும் நடப்பிக்கும் சரியான நோக்கத்திற்குப் பயன்படுத்தப்படுவது.",
     "anchor": "நீதியின்"
    }
   ]
  }
 ]
}
