 "units": [
  {
   "id": "geneva/PSA.96.1",
   "source_hash": "bec7b70e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.96.1#p1-bec7b70e",
     "text": "தீர்க்கதரிசி, தமது நற்செய்தி வெளிப்படுத்தப்படுவதனால் எல்லா தேசங்களும் கர்த்தரைத் துதிக்க வாய்ப்புப் பெறும் காலம் வருமென்று காண்பிக்கிறார்.",
     "anchor": "யெகோவாவுக்குப் புதுப்பாட்டைப்"
    }
   ]
  },
  {
   "id": "geneva/PSA.96.4",
   "source_hash": "dc27fb10",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.96.4#p1-dc27fb10",
     "text": "அவர் தம்முடைய தெய்வீக மகிமையை எல்லா தேசங்களுக்கும் அவைகளின் சொந்த எதிர்பார்ப்புக்கு மாறாக வெளிப்படுத்துவார் என்பதால், அவைகள் அனைத்தும் தங்கள் சொந்த எண்ணங்களுக்கு மாறாக, அவர் நியமித்தபடி மட்டுமே அவரைத் தொழுதுகொள்ள வேண்டும்.",
     "anchor": "பெரியவரும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.96.5",
   "source_hash": "2b26ffdf",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.96.5#p1-2b26ffdf",
     "text": "விக்கிரகங்களானாலும் அல்லது பரலோகத்தை உண்டாக்காத எதுவும் தேவனாக இருக்க முடியாது.",
     "anchor": "வானங்களை உண்டாக்கினவர்"
    }
   ]
  },
  {
   "id": "geneva/PSA.96.6",
   "source_hash": "325c2bf6",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.96.6#p1-325c2bf6",
     "text": "தேவனை அவருடைய வல்லமையினாலும் மகிமையினாலும் அல்லாமல் அறியமுடியாது; அவைகளின் அடையாளங்கள் அவருடைய பரிசுத்த ஸ்தலத்திலே காணப்படுகின்றன.",
     "anchor": "மகிமையும், மேன்மையும் அவர் சமுகத்தில் இருக்கிறது"
    }
   ]
  },
  {
   "id": "geneva/PSA.96.7",
   "source_hash": "45a73def",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.96.7#p1-45a73def",
     "text": "அது அவருக்கு மாத்திரம் செலுத்தப்படவேண்டியது என்பதை நீங்கள் அனுபவத்தினால் காண்கிறபடியே.",
     "anchor": "வல்லமையையும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.96.8",
   "source_hash": "5699f759",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.96.8#p1-5699f759",
     "text": "உங்களை முழுவதுமாக தேவனுக்குக் காணிக்கையாக ஒப்புக்கொடுத்து, நீங்கள் அவரை மாத்திரமே தொழுதுகொள்கிறீர்கள் என்பதை வெளிப்படுத்துங்கள்.",
     "anchor": "காணிக்கைகளைக்"
    }
   ]
  },
  {
   "id": "geneva/PSA.96.10",
   "source_hash": "4613ac0d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.96.10#p1-13116b45",
     "text": "யூதரல்லாதவர்களும் யூதர்களோடு தேவனுடைய வாக்குத்தத்தத்தில் பங்குபெறுவார்கள் என்று அவர் தீர்க்கதரிசனமாக முன்னறிவிக்கிறார்.",
     "anchor": "தேசங்களுக்குள்ளே ... யெகோவா ராஜரிகம்செய்கிறார் என்று சொல்லுங்கள்"
    },
    {
     "id": "geneva/PSA.96.10#p2-c14dd30c",
     "text": "அவர்களை தமது ஆவியானவரால் புதிதாக மறுபிறப்பு அடையச்செய்து, தேவனுடைய சாயலுக்கு மீண்டும் மாற்றுவார்.",
     "anchor": "நிதானமாக"
    }
   ]
  },
  {
   "id": "geneva/PSA.96.12",
   "source_hash": "1de1ecf8",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.96.12#p1-1de1ecf8",
     "text": "உணர்வற்ற சிருஷ்டிகளும் தேவன் வரும்போது மகிழ்ச்சிக்கு காரணமுள்ளதாக இருக்குமெனில், அவர் எங்களிடமிருந்து சாபத்தையும் பாவத்தையும் அகற்றிவிட்ட நாங்களோ இன்னும் அதிகமாய் மகிழ வேண்டியவர்களாய் இருக்கின்றோம்.",
     "anchor": "காட்டுமரங்களெல்லாம் கெம்பீரிக்கும்"
    }
   ]
  }
 ]
}
