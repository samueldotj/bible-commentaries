 "units": [
  {
   "id": "geneva/PSA.81.1",
   "source_hash": "bc439c93",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.81.1#p1-5c0d8ef1",
     "text": "கித்தில் இருந்து கொண்டுவரப்பட்ட ஒரு இசைக்கருவி.",
     "anchor": "கெம்பீரமாக"
    },
    {
     "id": "geneva/PSA.81.1#p2-fe28f1cb",
     "text": "இந்தச் சங்கீதம் ஒரு காலத்திற்கு இந்தச் சடங்குகள் கட்டளையிடப்பட்டிருந்த ஜனத்தின் பண்டிகைநாட்களுக்கும் ஆசரிப்புக்களுக்கும் நியமிக்கப்பட்டதாகத் தோன்றுகிறது; ஆனால் இப்பொழுது நற்செய்தியின்படி அவை நீக்கப்பட்டிருக்கின்றன.",
     "anchor": "நம்முடைய பெலனாகிய தேவனைக் கெம்பீரமாகப் பாடி"
    }
   ]
  },
  {
   "id": "geneva/PSA.81.3",
   "source_hash": "be12aea7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.81.3#p1-be12aea7",
     "text": "இந்தப் பண்டிகையின் கீழ் மற்ற எல்லாப் பரிசுத்த நாட்களையும் அவர் உட்படுத்துகிறார்.",
     "anchor": "மாதப்பிறப்பிலும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.81.5",
   "source_hash": "979dc263",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.81.5#p1-0f2d3fc6",
     "text": "அதாவது, இஸ்ரவேலில்; ஏனெனில் யூதாவுக்குத் தலைமை முன்னே கொடுக்கப்பட்டிருந்தபோதிலும், யோசேப்பின் குடும்பம் முதன்மையானதாக எண்ணப்பட்டது.",
     "anchor": "யோசேப்பிலே சாட்சியாக"
    },
    {
     "id": "geneva/PSA.81.5#p2-25562324",
     "text": "தேவன் மக்களின் தலைவராயிருந்தபடியால், மக்களின் நிலையிலிருந்து பேசுகிறார்.",
     "anchor": "நாம் அறியாத"
    }
   ]
  },
  {
   "id": "geneva/PSA.81.6",
   "source_hash": "14411825",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.81.6#p1-14411825",
     "text": "சரீரப்பிரகார அடிமைத்தனத்திலிருந்து விடுவிக்கப்பட்டதற்காக அவர்கள் தேவனுக்குப் போதுமான ஸ்தோத்திரம் செலுத்த முடியாதவர்களாக இருந்தார்களானால், சாத்தானுடையவும் பாவத்தினுடையவும் கொடுங்கோலாட்சியிலிருந்து நமக்குக் கிடைத்த ஆவிக்குரிய விடுதலைக்காக நாம் அவருக்கு எவ்வளவு அதிகமாகக் கடமைப்பட்டவர்களாக இருக்கிறோம்?",
     "anchor": "கூடைக்கு"
    }
   ]
  },
  {
   "id": "geneva/PSA.81.7",
   "source_hash": "f3c87dbb",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.81.7#p1-f3c87dbb",
     "text": "விசித்திரமான, ஆச்சரியப்படத்தக்க விதத்தில்.",
     "anchor": "இடிமுழக்கம் உண்டாகும் மறைவிடத்திலிருந்து உனக்கு உத்திரவு அருளினேன்"
    }
   ]
  },
  {
   "id": "geneva/PSA.81.8",
   "source_hash": "762416b3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.81.8#p1-762416b3",
     "text": "தேவனுடைய சத்தத்திற்குச் செவிகொடுக்கவும், அதற்குக் கீழ்ப்படியவும் மக்கள் கவனமாயிராத எல்லாக் கூடிவருதல்களையும் அவர் குற்றஞ்சுமத்துகிறார்.",
     "anchor": "கேள்"
    }
   ]
  },
  {
   "id": "geneva/PSA.81.10",
   "source_hash": "ce08ca6b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.81.10#p1-ce08ca6b",
     "text": "தேவன் தமது ஆசீர்வாதங்களை இவ்வளவு பரிபூரணமாக ஊற்றியும், அவற்றைப் பெற்றுக்கொள்ள அவர்கள் தங்கள் வாயைத் திறக்காதிருந்ததால், அவர்களுடைய அவநம்பிக்கையைக் குறித்து அவர் குற்றஞ்சாட்டுகிறார்.",
     "anchor": "உன்னுடைய வாயை விரிவாகத் திற"
    }
   ]
  },
  {
   "id": "geneva/PSA.81.13",
   "source_hash": "8e0dee67",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.81.13#p1-8e0dee67",
     "text": "தேவன் தம்முடைய வார்த்தையினால் எல்லோரையும் அழைக்கிறார், ஆனாலும் அவருடைய மறைவான தெரிந்துகொள்ளுதலே பலன் தருபவர்கள் யார் என்பதைத் நியமிக்கிறது.",
     "anchor": "என்னுடைய மக்கள் எனக்குச் செவிகொடுத்து"
    }
   ]
  },
  {
   "id": "geneva/PSA.81.14",
   "source_hash": "45f6285b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.81.14#p1-45f6285b",
     "text": "அவர்களுடைய பாவங்கள் இல்லாதிருந்தால்.",
     "anchor": "எதிரிகளுக்கு விரோதமாக"
    }
   ]
  },
  {
   "id": "geneva/PSA.81.15",
   "source_hash": "c8256356",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.81.15#p1-c8256356",
     "text": "இஸ்ரவேலர்கள் தேவனுடைய உடன்படிக்கையை முறிக்காதிருந்திருந்தால், அவர் அவர்களுடைய பகைவர்களுக்கு எதிராக அவர்களுக்கு வெற்றியைக் கொடுத்திருப்பார்.",
     "anchor": "என்றென்றைக்கும் இருக்கும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.81.16",
   "source_hash": "421653bd",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.81.16#p1-421653bd",
     "text": "அதாவது, மிகச்செழுமையான கோதுமையினாலும், ஏராளமான தேனினாலும்.",
     "anchor": "செழுமையான கோதுமையினால்"
    }
   ]
  }
 ]
}
