 "units": [
  {
   "id": "geneva/PSA.60.1",
   "source_hash": "4ee4606e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.60.1#p1-955d9615",
     "text": "இவை குறிப்பிட்ட சங்கீதங்களாகும், இவற்றின் இராகத்தின்படி இந்தச் சங்கீதம் பாடப்பட்டது."
    },
    {
     "id": "geneva/PSA.60.1#p2-327f43bd",
     "text": "சோபேனே என்றும் அழைக்கப்பட்டது, இது ஐப்பிராத்து நதியின் அருகில் அமைந்திருந்தது."
    },
    {
     "id": "geneva/PSA.60.1#p3-c415cba6",
     "text": "சவுல் எதிரியை எதிர்க்க முடியாத போது, மக்கள் அங்கும் இங்கும் சிதறி ஓடினார்கள்; ஏனெனில் அவர்கள் தங்கள் சொந்த வீடுகளில் பாதுகாப்பாக இல்லாதிருந்தார்கள்.",
     "anchor": "எங்களைச் சிதறடித்தீர்"
    }
   ]
  },
  {
   "id": "geneva/PSA.60.2",
   "source_hash": "d0c2e3bb",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.60.2#p1-d0c2e3bb",
     "text": "பூமியதிர்ச்சியினால் வெடித்ததுபோல.",
     "anchor": "வெடிப்பாக்கினீர்"
    }
   ]
  },
  {
   "id": "geneva/PSA.60.3",
   "source_hash": "1c38d590",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.60.3#p1-1c38d590",
     "text": "தேவனாகிய நீர் உம்முடைய மக்களை கடினமாக நடத்தினீர், அவர்கள் துன்மார்க்கனாகிய சவுல் ராஜாவுக்கு உதவி செய்ததற்காக அவர்களிடத்தில் புத்தியும் நியாயத்தீர்ப்பும் கேட்டு, தேவன் அரசாட்சியின் நியாயமான உரிமையைக் கொடுத்திருந்த ஒருவனுக்கு விரோதமாக நின்ற சவுலைத் தண்டித்ததற்காக அவர்களைத் தண்டித்தீர்.",
     "anchor": "கடினமான காரியத்தைக் காண்பித்தீர்"
    }
   ]
  },
  {
   "id": "geneva/PSA.60.4",
   "source_hash": "e3a03fd1",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.60.4#p1-e3a03fd1",
     "text": "என்னை அரசனாக்கியதினால், பயனிழந்ததாகத் தோன்றிய உம்முடைய வாக்குத்தத்தத்தை நிறைவேற்றியிருக்கிறீர்.",
     "anchor": "பயந்து நடக்கிறவர்களுக்கு ஒரு கொடியை"
    }
   ]
  },
  {
   "id": "geneva/PSA.60.6",
   "source_hash": "d8f8efb6",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.60.6#p1-d8f8efb6",
     "text": "நான் சவுல் தன் பிள்ளைகளுக்கு விட்டுவைத்த அந்த இடங்களை உரிமையாக்குவேன் என்பது ஒரு தேவவசனத்தால் சொல்லப்பட்டதைப் போல உறுதியானது.",
     "anchor": "பரிசுத்தத்தைக் கொண்டு"
    }
   ]
  },
  {
   "id": "geneva/PSA.60.7",
   "source_hash": "780e73c6",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.60.7#p1-088e9791",
     "text": "ஏனெனில் அது பலமும் மக்கள் நிறைந்ததாகவும் இருந்தது.",
     "anchor": "என்னுடைய தலையின் பெலன்"
    },
    {
     "id": "geneva/PSA.60.7#p2-ef4127fd",
     "text": "தாவீது இங்கு தன் ராஜ்ஜியம் இந்தக் கோத்திரத்தில் ஸ்திரப்படுத்தப்படும் என்பதைக் குறிக்கிறார், ஆதி. 49:10.",
     "anchor": "யூதா என்னுடைய செங்கோல்"
    }
   ]
  },
  {
   "id": "geneva/PSA.60.8",
   "source_hash": "cd90c72c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.60.8#p1-bece65e0",
     "text": "மிகவும் இழிவான அடிமைத்தனத்தில்.",
     "anchor": "பாதங்களைக் கழுவும் பாத்திரம்"
    },
    {
     "id": "geneva/PSA.60.8#p2-13728862",
     "text": "நீ பொய் சொல்லி மகிழ்ச்சியாக இருப்பதுபோல் காட்டிக்கொள்வாய்.",
     "anchor": "பெலிஸ்தியாவே"
    }
   ]
  },
  {
   "id": "geneva/PSA.60.9",
   "source_hash": "df605a26",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.60.9#p1-df605a26",
     "text": "தன்னுடைய பகைவர்கள் தங்களுக்குப் பாதுகாப்பானதாக நினைத்திருந்த பலமான பட்டணங்களைத் தேவன் தமக்குக் கொடுப்பார் என்று அவன் நிச்சயமாக இருந்தான்.",
     "anchor": "பாதுகாப்பான பட்டணத்திற்குள்"
    }
   ]
  }
 ]
}
