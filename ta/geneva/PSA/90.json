 "chapter": 90,
 "lang": "ta",
 "units": [
  {
   "id": "geneva/PSA.90.1",
   "source_hash": "f7235dce",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.90.1#p1-4f6eec5a",
     "text": "இவ்விதமாக வேதவாக்கியம் தீர்க்கதரிசிகளைக் குறிக்கிறது."
    },
    {
     "id": "geneva/PSA.90.1#p2-7096344d",
     "text": "இப்பொழுது இந்த நானூறு வருடங்களாக, எங்களுடைய எல்லா கிலேசங்களிலும், பயணங்களிலும், நீர் எங்களுக்கு ஒரு வீடும் காவலுமாக இருந்திருக்கிறீர்.",
     "anchor": "தலைமுறை தலைமுறையாக எங்களுக்கு அடைக்கலமானவர்"
    }
   ]
  },
  {
   "id": "geneva/PSA.90.2",
   "source_hash": "18a1856a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.90.2#p1-18a1856a",
     "text": "உலகத்தின் அஸ்திபாரங்கள் போடப்படுவதற்கு முன்பே, நீர் எங்களை உம்முடைய மக்களாக தெரிந்துகொண்டீர்.",
     "anchor": "மலைகள் தோன்றுமுன்பும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.90.3",
   "source_hash": "b6ffe649",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.90.3#p1-b6ffe649",
     "text": "மோசே மனிதனுடைய பலவீனத்தையும் ஆயுளின் குறுகிய தன்மையையும் புலம்புகிறதினால் தேவனை மனதுருக வைக்கிறார்.",
     "anchor": "தூளாக்கி"
    }
   ]
  },
  {
   "id": "geneva/PSA.90.4",
   "source_hash": "79118bfd",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.90.4#p1-79118bfd",
     "text": "மனிதன் தன் ஆயுள் நீளமானது என்று நினைக்கிறான், ஆனாலும் அது உண்மையில் மிகவும் குறுகியது; ஆயிரம் வருடங்களாக இருந்தாலும், தேவனுடைய பார்வைக்கோ அது ஒன்றுமில்லாததைப் போலவும், மூன்று மணி நேரம் மட்டும் நீடிக்கும் காவல் வேளையைப் போலவும் இருக்கிறது.",
     "anchor": "உமது பார்வைக்கு ஆயிரம் வருடங்கள்"
    }
   ]
  },
  {
   "id": "geneva/PSA.90.5",
   "source_hash": "6be3f533",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.90.5#p1-6be3f533",
     "text": "நீர் அவர்களைச் சடுதியாக அடித்துக்கொண்டு போகிறீர்.",
     "anchor": "வெள்ளம்போல் அடித்துக்கொண்டு போகிறீர்"
    }
   ]
  },
  {
   "id": "geneva/PSA.90.7",
   "source_hash": "e4013543",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.90.7#p1-e4013543",
     "text": "எங்கள் வாழ்க்கையின் புயல்களைச் சிந்தித்துப் பார்க்கும்படி நீர் எங்களைச் சாட்டைகளால் அழைத்தீர், எங்கள் பாவங்களினிமித்தம் எங்கள் நாட்களைக் குறைத்துவிடுகிறீர்.",
     "anchor": "கோபத்தினால் அழிந்து"
    }
   ]
  },
  {
   "id": "geneva/PSA.90.9",
   "source_hash": "9593a0d1",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.90.9#p1-9593a0d1",
     "text": "எங்களுடைய நாட்கள் குறுகியவை மாத்திரமல்ல, எங்கள் பாவங்கள் தினமும் உமது கடுங்கோபத்தைத் தூண்டுவதால் அவை துயரமுள்ளவைகளாகவும் இருக்கின்றன.",
     "anchor": "ஒரு கதையைப்போல் எங்கள் வருடங்களைக் கழித்துப்போட்டோம்"
    }
   ]
  },
  {
   "id": "geneva/PSA.90.10",
   "source_hash": "53f73371",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.90.10#p1-53f73371",
     "text": "பொது வாழ்க்கை நிலைமைக்கேற்ப அர்த்தம்.",
     "anchor": "எண்பது வருடங்களாக"
    }
   ]
  },
  {
   "id": "geneva/PSA.90.11",
   "source_hash": "d56929a1",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.90.11#p1-d56929a1",
     "text": "மனுஷனுடைய ஆயுள் குறுகியதினால் பரிதபிக்கத்தக்கதென்றால், அதின்மேல் உமது கடுங்கோபம் இருக்குமானால் அது இன்னும் அதிகமாகும்; இதை உமக்குப் பயப்படுகிறவர்கள் மட்டுமே அறிந்திருக்கிறார்கள்.",
     "anchor": "உமது கோபத்தின் வல்லமையையும்... அறிந்துகொள்கிறவன் யார்?"
    }
   ]
  },
  {
   "id": "geneva/PSA.90.12",
   "source_hash": "76e7bb17",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.90.12#p1-76e7bb17",
     "text": "அதாவது, நம்முடைய ஜீவனின் குறுகிய தன்மையைச் சிந்தித்து, பரம மகிழ்ச்சிகளை தியானிப்பதினாலே.",
     "anchor": "ஞான இருதயமுள்ளவர்களாகும்படி"
    }
   ]
  },
  {
   "id": "geneva/PSA.90.13",
   "source_hash": "43beb0d1",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.90.13#p1-43beb0d1",
     "text": "அதாவது, நீர் கோபமாயிருப்பீரோ?",
     "anchor": "எதுவரைக்கும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.90.16",
   "source_hash": "b7e88d29",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.90.16#p1-495e8719",
     "text": "அதாவது, தலையான செயலாகிய உமது இரக்கம்.",
     "anchor": "உமது செயல்கள்... விளங்குவதாக"
    },
    {
     "id": "geneva/PSA.90.16#p2-1da223ee",
     "text": "தேவனுடைய வாக்குத்தத்தங்கள் அவர்களுடைய எளிமைக்குப் பொருந்துவது போலவே, மோசே அவர்களுடைய சந்ததிக்காகவும் ஜெபம்பண்ணுகிறார்.",
     "anchor": "பிள்ளைகளுக்கும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.90.17",
   "source_hash": "f1a7dfb0",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.90.17#p1-6fd3bf9c",
     "text": "அதாவது, அவர் தமது சபைக்கு நன்மை செய்வதை நிறுத்தும்போது அது மறைந்துபோனதாக இருந்தது என்பது பொருள்.",
     "anchor": "எங்களுடைய தேவனாகிய ஆண்டவரின் பிரியம்"
    },
    {
     "id": "geneva/PSA.90.17#p2-fc8cf85a",
     "text": "ஏனெனில் நீர் உம்முடைய பரிசுத்த ஆவியானவரால் எங்களை நடத்தாவிட்டால், எங்களுடைய முயற்சிகள் வெற்றியடையாது.",
     "anchor": "எங்களுடைய கைகளின் செயல்களை எங்களிடத்தில் உறுதிப்படுத்தும்"
    }
   ]
  }
 ]
}
