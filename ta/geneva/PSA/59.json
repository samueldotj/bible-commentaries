 "units": [
  {
   "id": "geneva/PSA.59.1",
   "source_hash": "5c2836a2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.59.1#p1-cf52cc11",
     "text": "அல்லது, ஒரு குறிப்பிட்ட ராகம்.",
     "anchor": "a"
    },
    {
     "id": "geneva/PSA.59.1#p2-940bd87d",
     "text": "அவனுடைய எதிரிகள் அவனை அழிக்க அருகில் இருந்தாலும், தேவனுக்குத் தன்னைத் தப்புவிக்க வழிகள் இருந்தன என்று அவன் தனக்குத்தானே உறுதி கொள்கிறான்.",
     "anchor": "என்னுடைய எதிரிகளுக்கு என்னைத் தப்புவியும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.59.3",
   "source_hash": "e0d17274",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.59.3#p1-e0d17274",
     "text": "ஏனெனில் நான் அவர்களுக்கு விரோதமாக குற்றமில்லாதவனாக இருக்கிறேன், அவர்களுக்கு எந்த அபராதமும் செய்யவில்லை.",
     "anchor": "மீறுதலும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.59.5",
   "source_hash": "197835d9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.59.5#p1-197835d9",
     "text": "துன்மார்க்கரைத் தண்டிப்பது தேவனுடைய நியாயத்தீர்ப்புகளுக்குரியதாக இருப்பதால், தம்முடைய சபையைத் துரோகமாகவும் பகைமையாகவும் துன்பப்படுத்துகிற கைவிடப்பட்டவன்மேல் தேவன் தம்முடைய கோபாக்கினையைச் செலுத்தும்படி அவன் விரும்புகிறான்.",
     "anchor": "வஞ்சகமாகத் துரோகஞ்செய்கிற ஒருவருக்கும் தயை செய்யாமலிரும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.59.6",
   "source_hash": "09b5f468",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.59.6#p1-09b5f468",
     "text": "தீமை செய்வதில் அவர்கள் ஒருபோதும் சோர்வடையாதவர்கள் என்பதைக் காண்பிக்க, அவர்களுடைய கொடுமையை பசியுள்ள நாய்களுக்கு ஒப்பிடுகிறார்.",
     "anchor": "நாய்களைப்போல"
    }
   ]
  },
  {
   "id": "geneva/PSA.59.7",
   "source_hash": "5e62860e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.59.7#p1-5e62860e",
     "text": "அவர்கள் தங்களுடைய துன்மார்க்கமான சூழ்ச்சிகளைப் பகிரங்கமாக பெருமையாகப் பேசுகிறார்கள், ஒவ்வொரு வார்த்தையும் ஒரு வாளைப் போலிருக்கிறது; ஏனெனில் அவர்கள் தேவனுக்குப் பயப்படுவதுமில்லை, மனிதர்களுக்கு முன்பாக வெட்கப்படுவதுமில்லை.",
     "anchor": "தங்களுடைய வார்த்தைகளைக் கக்குகிறார்கள்"
    }
   ]
  },
  {
   "id": "geneva/PSA.59.9",
   "source_hash": "ab42bff1",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.59.9#p1-ab42bff1",
     "text": "சவுலுக்கு பெரிய வல்லமை இருந்தாலும், நீர் அவனைக் கட்டுப்படுத்துகிறீர் என்று நான் அறிவேன்; ஆகையால் நான் பொறுமையாக உம்மில் நம்பிக்கையுடன் காத்திருப்பேன்.",
     "anchor": "அவன் வல்லமையை நான்"
    }
   ]
  },
  {
   "id": "geneva/PSA.59.10",
   "source_hash": "d240f650",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.59.10#p1-d240f650",
     "text": "தேவைப்படும் நேரத்தில் அவர் எனக்கு உதவாமல் விடமாட்டார்.",
     "anchor": "என்னைச் சந்திப்பார்"
    }
   ]
  },
  {
   "id": "geneva/PSA.59.11",
   "source_hash": "31f7d5c3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.59.11#p1-31f7d5c3",
     "text": "முழுவதுமாக அல்ல, சிறிது சிறிதாக, அதனால் மக்கள் உமது நியாயத்தீர்ப்புகளை அடிக்கடி கண்டு, உம்மை நினைவுகூருவார்கள்.",
     "anchor": "கொன்றுபோடாமலிரும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.59.12",
   "source_hash": "6e68fd76",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.59.12#p1-6e68fd76",
     "text": "அவர்கள் தங்கள் அவமானத்திலும் துக்கத்திலும் தேவனுடைய நீதியான பழிவாங்குதலின் கண்ணாடிகளும் திருஷ்டாந்தங்களும் ஆகும்படி.",
     "anchor": "தங்களுடைய பெருமையில் அகப்படுவார்களாக"
    }
   ]
  },
  {
   "id": "geneva/PSA.59.13",
   "source_hash": "c9de07ba",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.59.13#p1-c9de07ba",
     "text": "உம்முடைய காலம் வரும்போது, மற்றவர்களுக்கு உம்முடைய கடுங்கோபத்தின் உதாரணமாக அவர்கள் போதுமான அளவு பணிவிடை செய்தபின்.",
     "anchor": "உம்முடைய கடுங்கோபத்திலே அழித்துப்போடும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.59.14",
   "source_hash": "0cc845e8",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.59.14#p1-0cc845e8",
     "text": "தங்களுடைய வீணான திட்டங்களை அவர் ஏளனம் செய்கிறார், அவைகள் நிறைவேறாது என்பதை உறுதியாக அறிந்திருக்கிறார்.",
     "anchor": "திரும்பிவந்து"
    }
   ]
  },
  {
   "id": "geneva/PSA.59.16",
   "source_hash": "0356f88b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.59.16#p1-0356f88b",
     "text": "பலவீனமான ஒரு பெண்ணின் யுக்தியைப் பயன்படுத்தி பகைவனுடைய பலத்தைக் குலைத்தவர், 1 சாமுவேல் 19:12.",
     "anchor": "வல்லமையை"
    }
   ]
  },
  {
   "id": "geneva/PSA.59.17",
   "source_hash": "74e74655",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.59.17#p1-74e74655",
     "text": "தன்னில் எந்த வல்லமையும் பெலனும் இல்லாதவன் என்று ஒப்புக்கொண்டு, அவன் அனைத்தையும் தேவனுக்கே உரியதாக்குகிறான்.",
     "anchor": "பெலனே"
    }
   ]
  }
 ]
}
