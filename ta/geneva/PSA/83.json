 "chapter": 83,
 "lang": "ta",
 "units": [
  {
   "id": "geneva/PSA.83.1",
   "source_hash": "2f2699df",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.83.1#p1-2f2699df",
     "text": "இந்தச் சங்கீதம் யோசபாத்தின் நாட்களில் சபை இருந்த ஆபத்துகளுக்கு விரோதமாக ஜெபம்பண்ணும் ஒரு வடிவமாக இயற்றப்பட்டதாகத் தோன்றுகிறது.",
     "anchor": "மவுனமாக இருக்கவேண்டாம்"
    }
   ]
  },
  {
   "id": "geneva/PSA.83.2",
   "source_hash": "c16f353a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.83.2#p1-c16f353a",
     "text": "தமது சபைக்குப் பகைவராயிருக்கிறவர்களையே அவர் தேவனுடைய எதிரிகள் என்று அழைக்கிறார்.",
     "anchor": "எதிரிகள் கொந்தளித்து"
    }
   ]
  },
  {
   "id": "geneva/PSA.83.3",
   "source_hash": "1cdb7b05",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.83.3#p1-1cdb7b05",
     "text": "தேவனுடைய தெரிந்துகொள்ளப்பட்டவர்கள் அவருடைய மறைவில் இருக்கிறவர்கள்; ஏனெனில் அவர் அவர்களைத் தம்முடைய ஆசரிப்புக்கூடாரத்தின் மறைவில் மறைத்து, எல்லா ஆபத்துகளிலும் இருந்து காக்கிறார்.",
     "anchor": "மறைவில் இருக்கிறவர்கள்"
    }
   ]
  },
  {
   "id": "geneva/PSA.83.4",
   "source_hash": "02362146",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.83.4#p1-02362146",
     "text": "அவர்கள் சபையைச் சிறைப்பிடிப்பதோடு திருப்தியடையவில்லை; அதை முழுவதுமாக அழித்துவிடவே முயன்றார்கள்.",
     "anchor": "ஒரு தேசமாக இல்லாமலும்... அழிப்போம்"
    }
   ]
  },
  {
   "id": "geneva/PSA.83.5",
   "source_hash": "f9b507f8",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.83.5#p1-45ec77fe",
     "text": "எல்லா அந்தரங்க வழிமுறைகளினாலும்.",
     "anchor": "ஏகமனதாக"
    },
    {
     "id": "geneva/PSA.83.5#p2-60e9b304",
     "text": "சபையின் நிலைத்தத்தன்மை நிலைநிறுத்தப்பட்டிருந்த உம்முடைய ஆலோசனையைக் கவிழ்த்துப்போடத் தீர்மானித்தார்கள்.",
     "anchor": "உமக்கு விரோதமாக"
    }
   ]
  },
  {
   "id": "geneva/PSA.83.8",
   "source_hash": "c720d1da",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.83.8#p1-c720d1da",
     "text": "அம்மோனியர் மற்றும் மோவாபியருடைய துன்மார்க்கம் இவ்விடத்தில் விவரிக்கப்படுகிறது, அதாவது அவர்கள் இஸ்ரவேலருக்கு எதிராகப் போர் செய்யும்படி இந்த மற்ற தேசங்களைத் தூண்டினார்கள் என்பதே.",
     "anchor": "லோத்தின் சந்ததிகளுக்கு"
    }
   ]
  },
  {
   "id": "geneva/PSA.83.9",
   "source_hash": "2b8feb78",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.83.9#p1-2b8feb78",
     "text": "இந்த உதாரணங்களினால் தேவன் தமது மக்களை முழுவதும் அழிந்துபோக விடமாட்டார் என்பதை அவர்கள் உறுதிசெய்துகொண்டார்கள், நியா 7:21, 4:15.",
     "anchor": "மீதியானியர்களுக்குச் செய்தது"
    }
   ]
  },
  {
   "id": "geneva/PSA.83.10",
   "source_hash": "97cd14cb",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.83.10#p1-97cd14cb",
     "text": "சேற்றைப்போல கால்களால் மிதிக்கப்பட்டது.",
     "anchor": "நிலத்திற்கு எருவாய்ப்போன"
    }
   ]
  },
  {
   "id": "geneva/PSA.83.12",
   "source_hash": "97837de4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.83.12#p1-97837de4",
     "text": "அதாவது, யூதேயா: ஏனெனில் அவருடைய சபை இருக்கும் இடத்தில், அவர் அவர்களுக்குள் வாசம்செய்கிறார்.",
     "anchor": "தேவனுடைய வாசஸ்தலங்களை எங்களுக்குச் சுதந்தரமாக"
    }
   ]
  },
  {
   "id": "geneva/PSA.83.13",
   "source_hash": "65237253",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.83.13#p1-65237253",
     "text": "தள்ளப்பட்டவர்களைத் திருத்த முடியாததால், அவர்கள் முற்றிலும் அழிந்துபோகவும், நிலையில்லாதவர்களாகி எல்லாக் காற்றுகளாலும் அடிபடுவவர்களாகவும் இருக்கும்படி அவர் ஜெபம்பண்ணுகிறார்.",
     "anchor": "சுழல்காற்றின் புழுதிக்கும்"
    }
   ]
  },
  {
   "id": "geneva/PSA.83.16",
   "source_hash": "1357132b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.83.16#p1-1357132b",
     "text": "அதாவது, உம்முடைய வாதைகளினால் நிர்ப்பந்திக்கப்பட்டு உம்முடைய வல்லமையை அறிக்கையிட வேண்டியவர்களாகும்படி.",
     "anchor": "உமது பெயரைத் தேடும்படிக்கு"
    }
   ]
  },
  {
   "id": "geneva/PSA.83.18",
   "source_hash": "e9e5798f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/PSA.83.18#p1-e9e5798f",
     "text": "அவர்கள் விசுவாசிக்காவிட்டாலும், நீர் உம்முடைய ஆலோசனையை எதிர்த்து நிற்பது வீணானது என்றும், உம்முடைய சபையை நிலைநிறுத்துவீர் என்றும் அனுபவத்தினால் தெரிந்துகொள்ளும்படி நேரிடும்.",
     "anchor": "நீர்... என்பதை அறியும்படி"
    }
   ]
  }
 ]
}
