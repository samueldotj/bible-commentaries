 "units": [
  {
   "id": "geneva/EST.1.2",
   "source_hash": "bdcfd453",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EST.1.2#p1-bdcfd453",
     "text": "அதாவது, இளைப்பாறுதலும் அமைதியும் பெற்றிருந்தான்.",
     "anchor": "சிங்காசனத்தின்மேல் அமர்ந்திருந்தான்"
    }
   ]
  },
  {
   "id": "geneva/EST.1.6",
   "source_hash": "2523c1ff",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EST.1.6#p1-2523c1ff",
     "text": "அவைகளை அந்த நாடுகளில் மேஜைகளுக்குப் பதிலாகப் பயன்படுத்தினார்கள்.",
     "anchor": "பொற்சரிகையும் வெள்ளிச்சரிகையுமான மெத்தைகள்"
    }
   ]
  },
  {
   "id": "geneva/EST.1.7",
   "source_hash": "d56f373e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EST.1.7#p1-d56f373e",
     "text": "இவ்வளவு மகிமையுள்ள ராஜாவுக்கு ஏற்றவாறு.",
     "anchor": "ராஜாவின் கொடைத்தன்மைக்கு ஏற்றவாறு"
    }
   ]
  },
  {
   "id": "geneva/EST.1.8",
   "source_hash": "039171e7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EST.1.8#p1-039171e7",
     "text": "ஒருவனும் தனக்கு விருப்பமான அளவைவிட அதிகமாகக் குடிக்கும்படி கட்டாயப்படுத்தப்படவில்லை.",
     "anchor": "கட்டாயப்படுத்தவில்லை"
    }
   ]
  },
  {
   "id": "geneva/EST.1.10",
   "source_hash": "cfff3940",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EST.1.10#p1-cfff3940",
     "text": "இது எஸ்தர் 1:5-ல் குறிப்பிட்டபடி, ராஜா மக்களுக்குக் கொடுத்த பண்டிகையின் கடைசிநாள் ஆகும்.",
     "anchor": "ஏழாம் நாளிலே பேரழகியாயிருந்த ராணியாகிய வஸ்தியின் அழகை மக்களுக்கும் அதிகாரிகளுக்கும் காண்பிப்பதற்காக, ராஜகிரீடம் அணிந்தவளாக, அவளைத் தனக்கு முன்பாக அழைத்துவரவேண்டுமென்று,,label,g,refs,text,Es 1:5,ref,EST.1.5"
    }
   ]
  },
  {
   "id": "geneva/EST.1.13",
   "source_hash": "17f7c683",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EST.1.13#p1-17f7c683",
     "text": "காலங்களை உன்னிப்பாய் கவனித்து நீண்ட காலமாக அனுபவித்து அறிந்திருந்தவர்கள்.",
     "anchor": "காலங்களை அறிந்தவர்கள்"
    }
   ]
  },
  {
   "id": "geneva/EST.1.14",
   "source_hash": "fd0f3987",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EST.1.14#p1-fd0f3987",
     "text": "எப்பொழுதும் அவனிடம் பிரவேசிக்கக்கூடிய அவனுடைய பிரதான ஆலோசனைக்காரர்.",
     "anchor": "நியாயப்பிரமாணத்தையும் ராஜநீதியையும் அறிந்தவர்களிடம் பேசுவது"
    }
   ]
  },
  {
   "id": "geneva/EST.1.16",
   "source_hash": "25302378",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EST.1.16#p1-25302378",
     "text": "அவள் கீழ்ப்படியாதிருந்ததினால் தன் கணவனுக்குச் செய்ததைப்போலவே செய்ய எல்லா பெண்களுக்கும் ஒரு முன்மாதிரியைக் காண்பித்திருக்கிறாள்.",
     "anchor": "ராஜாவிற்கு மட்டும் அல்ல"
    }
   ]
  },
  {
   "id": "geneva/EST.1.17",
   "source_hash": "18ee83ae",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EST.1.17#p1-18ee83ae",
     "text": "அதாவது, அவளுடைய கீழ்ப்படியாமையை.",
     "anchor": "அவள் வரமாட்டேன் என்று சொன்ன செய்தி"
    }
   ]
  },
  {
   "id": "geneva/EST.1.18",
   "source_hash": "9ed6d8bd",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EST.1.18#p1-9ed6d8bd",
     "text": "அதாவது, அவர்கள் அதைச் செய்யும்படி முதல் சந்தர்ப்பத்தை எடுத்துக்கொள்வார்கள், மற்ற பெண்களும் அப்படியே செய்வார்கள்.",
     "anchor": "பிரபுக்களின் பெண்கள் ராணியின் செய்தியைக் கேட்கும்போது"
    }
   ]
  },
  {
   "id": "geneva/EST.1.19",
   "source_hash": "1ba0e4d0",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EST.1.19#p1-1ba0e4d0",
     "text": "அவளுக்கு விவாகரத்து செய்யப்பட்டு, மற்றொருத்தி ராஜாத்தியாக்கப்படக்கடவள்.",
     "anchor": "ராஜாவாகிய அகாஸ்வேருவுக்கு முன்பாக வரக்கூடாது"
    }
   ]
  },
  {
   "id": "geneva/EST.1.20",
   "source_hash": "90160ee0",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EST.1.20#p1-90160ee0",
     "text": "ஏனெனில் அவனுக்குக் கீழே நூற்றிருபத்தேழு நாடுகள் இருந்தன.",
     "anchor": "ராஜ்ஜியமெங்கும்"
    }
   ]
  },
  {
   "id": "geneva/EST.1.22",
   "source_hash": "51f8488c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EST.1.22#p1-51f8488c",
     "text": "அதாவது, மனைவி கணவனுக்குக் கீழ்ப்பட்டவளாகவும் அவனுடைய கற்பனைக்கு உட்பட்டவளாகவும் இருக்கவேண்டும் என்பதாம்.",
     "anchor": "தன்னுடைய வீட்டிற்குத் தானே அதிகாரியாக இருக்கவேண்டும்"
    }
   ]
  }
 ]
}
