 "units": [
  {
   "id": "geneva/MIC.2.1",
   "source_hash": "ebf360be",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MIC.2.1#p1-ebf360be",
     "text": "அவர்கள் எழுந்த உடனே, இராமுழுவதும் தீட்டிய தங்கள் துன்மார்க்கத் திட்டங்களைச் செயல்படுத்தி, தங்கள் வல்லமைக்குத் தகுந்தபடி மற்றவர்களைச் சேதப்படுத்துகிறார்கள்.",
     "anchor": "விடியற்காலமாகிறபோது"
    }
   ]
  },
  {
   "id": "geneva/MIC.2.4",
   "source_hash": "e5b0cd59",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MIC.2.4#p1-e5b0cd59",
     "text": "இவ்வாறாக யூதர்கள் புலம்பி, தங்கள் சொத்துக்கள் பகைவர்களுக்குள் பங்கிடப்பட்டதைக் கண்டு, திரும்பக் கிடைக்கும் நம்பிக்கை ஒன்றுமில்லை என்று சொல்லுகிறார்கள்.",
     "anchor": "நாம் முற்றிலும் பாழானோம்"
    }
   ]
  },
  {
   "id": "geneva/MIC.2.5",
   "source_hash": "99516500",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MIC.2.5#p1-99516500",
     "text": "முன்பு காலங்களில் இருந்தது போலவும், யூபிலி வருஷத்தில் நீங்கள் அளந்துகொண்டிருந்தது போலவும், இனிமேல் உங்களுக்குப் பங்கிடும்படி நிலங்கள் இருக்காது.",
     "anchor": "யெகோவாவின் சபையில் நிலங்களை அளந்துகொடுக்கிறவர்கள்"
    }
   ]
  },
  {
   "id": "geneva/MIC.2.6",
   "source_hash": "0cec3ea2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MIC.2.6#p1-d612ba66",
     "text": "இவ்விதமாக மக்கள் தீர்க்கதரிசிகளை எச்சரிக்கிறார்கள், தங்களிடத்தில் இனி பேசவேண்டாம் என்று; ஏனெனில் அவர்களால் அவர்களுடைய எச்சரிப்புகளைச் சகிக்க முடியாது.",
     "anchor": "தீர்க்கதரிசனம் சொல்லாதிருப்பீர்களாக என்கிறார்கள்"
    },
    {
     "id": "geneva/MIC.2.6#p2-e15800a9",
     "text": "தேவன் சொல்லுகிறார், அவர்கள் தீர்க்கதரிசனம் சொல்லமாட்டார்கள் என்றும், இவர்களுடைய கண்டனங்களையாவது நிந்தனைகளையாவது இனி ஏற்றுக்கொள்ளமாட்டார்கள் என்றும்.",
     "anchor": "அவர்கள் தீர்க்கதரிசனம் சொல்லுவார்கள்"
    }
   ]
  },
  {
   "id": "geneva/MIC.2.7",
   "source_hash": "61d17742",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MIC.2.7#p1-59184446",
     "text": "இவைகள் அவருடைய நியாயப்பிரமாணத்திற்கு ஏற்ற செயல்களோ?",
     "anchor": "அவருடைய செயல்கள் இவைகள்தானோ"
    },
    {
     "id": "geneva/MIC.2.7#p2-ecbd3210",
     "text": "பக்தியுள்ளவர்கள் என் வார்த்தைகளில் ஆறுதலைக் காணுகிறார்கள் அல்லவோ?",
     "anchor": "செம்மையாக நடக்கிறவனுக்கு"
    }
   ]
  },
  {
   "id": "geneva/MIC.2.8",
   "source_hash": "882b0025",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MIC.2.8#p1-787ba583",
     "text": "அதாவது, முன்பு நடந்த காலங்களில்.",
     "anchor": "ஆரம்பம்முதல்"
    },
    {
     "id": "geneva/MIC.2.8#p2-ca8a0a44",
     "text": "ஏழைகளுக்கு அவர்களால் எந்தப் பிரயோஜனமும் இல்லை, மாறாக அவர்கள் எதிரிகளைப்போல் அவர்களைப் பறித்துக்கொள்கிறார்கள்.",
     "anchor": "மேலங்கியையும் ஆடையையும் உரிந்துகொண்டீர்கள்"
    }
   ]
  },
  {
   "id": "geneva/MIC.2.9",
   "source_hash": "196a998f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MIC.2.9#p1-196a998f",
     "text": "அதாவது, தேவனுடைய ஆசீர்வாதமாகிய அவர்களுடைய பொருளையும் வாழ்வையும், அவருடைய மகிமையின் ஒரு பங்காயிருந்ததையும் குறிக்கும்.",
     "anchor": "என் அலங்காரத்தை என்றைக்கும்"
    }
   ]
  },
  {
   "id": "geneva/MIC.2.10",
   "source_hash": "0d65d7f4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MIC.2.10#p1-0d65d7f4",
     "text": "எருசலேம் உங்களுக்குப் பாதுகாப்பாக இருக்காது; மாறாக அது உங்களுடைய அழிவின் காரணமாகவே இருக்கும்.",
     "anchor": "இளைப்பாறும் இடம்"
    }
   ]
  },
  {
   "id": "geneva/MIC.2.11",
   "source_hash": "7af174a1",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MIC.2.11#p1-332d73ee",
     "text": "அதாவது, தன்னைத் தீர்க்கதரிசியாகக் காண்பித்துக்கொள்ளுதல்.",
     "anchor": "மனம்போகிற போக்கிலே போய், பொய்யானதைச் சொல்லுகிற"
    },
    {
     "id": "geneva/MIC.2.11#p2-e982c88f",
     "text": "அவர்கள் எந்தத் தீர்க்கதரிசிகளில் மனமகிழ்ச்சி கொள்கிறார்கள் என்பதைக் காண்பிக்கிறார், அதாவது, தங்களுக்கு இன்பமான கதைகளைச் சொல்லி, தங்களுக்குக் கிடைக்கும் நன்மைகளைக் குறித்துப் பேசுகிற முகஸ்துதி செய்பவர்களில்.",
     "anchor": "நான் உனக்குப் பிரசங்கிப்பேன்"
    }
   ]
  },
  {
   "id": "geneva/MIC.2.12",
   "source_hash": "1a778a24",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MIC.2.12#p1-1a778a24",
     "text": "உங்களை அழிக்கும்படி.",
     "anchor": "உங்களெல்லோரையும்"
    }
   ]
  },
  {
   "id": "geneva/MIC.2.13",
   "source_hash": "a43d8215",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MIC.2.13#p1-1564e96a",
     "text": "பகைவன் அவர்களுடைய வாசல்களையும் மதில்களையும் உடைத்து, அவர்களைக் கல்தேயருக்குள் கொண்டுபோவான்.",
     "anchor": "தடைகளை நீக்கிப்போடுகிறவர் அவர்களுக்கு முன்பாக நடந்துபோகிறார்"
    },
    {
     "id": "geneva/MIC.2.13#p2-8557ca45",
     "text": "அவர்களை முன்னோக்கித் துரத்திச் செலுத்தி, அவர்களுடைய பகைவர்களுக்கு உதவி செய்யும்படி.",
     "anchor": "அவர்களுடைய ராஜா அவர்களுக்கு முன்பாகப் போவார்"
    }
   ]
  }
 ]
}
