 "units": [
  {
   "id": "geneva/DEU.12.1",
   "source_hash": "3808b3be",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.12.1#p1-3808b3be",
     "text": "இதினால் வேறொரு தேவனைத் தேடாதபடிக்கு அவர்களுக்கு எச்சரிக்கை செய்யப்படுகிறது.",
     "anchor": "முற்பிதாக்களின் தேவனாகிய யெகோவா"
    }
   ]
  },
  {
   "id": "geneva/DEU.12.3",
   "source_hash": "6e0943dd",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.12.3#p1-6e0943dd",
     "text": "தங்களுடைய விக்கிரகங்களுக்குப் பலியிட்ட இடங்கள் அவைகளாகும்.",
     "anchor": "தோப்புகளை அக்கினியால்"
    }
   ]
  },
  {
   "id": "geneva/DEU.12.4",
   "source_hash": "3d88723c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.12.4#p1-3d88723c",
     "text": "நீங்கள் மூடநம்பிக்கைகளால் கர்த்தரை ஆராதிக்கவேண்டாம்.",
     "anchor": "நீங்கள் அப்படிச் செய்யாமல்"
    }
   ]
  },
  {
   "id": "geneva/DEU.12.6",
   "source_hash": "92b1d30d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.12.6#p1-92b1d30d",
     "text": "முதற்பலன்களைக் குறிக்கும்.",
     "anchor": "கை ஏறெடுத்துப் படைக்கும் படைப்புகளையும்"
    }
   ]
  },
  {
   "id": "geneva/DEU.12.7",
   "source_hash": "09ea785b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.12.7#p1-09ea785b",
     "text": "அவருடைய பெட்டகம் இருக்குமிடத்தில்.",
     "anchor": "உங்கள் தேவனாகிய யெகோவாவுடைய சந்நிதியிலே"
    }
   ]
  },
  {
   "id": "geneva/DEU.12.8",
   "source_hash": "73fe9c1d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.12.8#p1-73fe9c1d",
     "text": "அவர்கள் தங்கள் இச்சையின்படி பலியிட்டதினால் அல்ல, ஆனாலும் தேவன் கானான் தேசத்தில் மிகவும் சுத்தமான முறையில் சேவிக்கப்படும்படியே.",
     "anchor": "இங்கே இந்நாளில்"
    }
   ]
  },
  {
   "id": "geneva/DEU.12.10",
   "source_hash": "d9c469a0",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.12.10#p1-d9c469a0",
     "text": "தேவன் தம்முடைய பாதுகாப்பின்கீழ் அவர்களை இளைப்பாறுதலில் காத்துக்கொள்ளாவிட்டால், வெற்றி பெறுவது மட்டும் போதுமானதாக இருக்காது.",
     "anchor": "சுற்றிலும் இருக்கிற உங்களுடைய எதிரிகளையெல்லாம் அவர் விலக்கி, உங்களை இளைப்பாறச்செய்கிறதினால்"
    }
   ]
  },
  {
   "id": "geneva/DEU.12.14",
   "source_hash": "e28146c5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.12.14#p1-e28146c5",
     "text": "பெட்டியை சீலோவிலே 243 வருடங்களாக, அல்லது சிலர் எழுதுகிறபடி 300 வருடங்களுக்கு மேலாக, வைத்திருந்ததினாலும், ஆலயம் கட்டப்படும்வரை மற்ற இடங்களிலும் வைத்திருந்ததினாலும் இது எப்போதும் அறிவிக்கப்பட்டது.",
     "anchor": "உன் கோத்திரங்களின் ஒன்றில்"
    }
   ]
  },
  {
   "id": "geneva/DEU.12.15",
   "source_hash": "d19fb54c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.12.15#p1-a93157d5",
     "text": "தேவன் உனக்குக் கொடுத்த வல்லமைக்கும் ஆற்றலுக்கும் ஏற்றபடி.",
     "anchor": "உனக்கு அருளும் ஆசீர்வாதத்திற்குத்தக்கதாக"
    },
    {
     "id": "geneva/DEU.12.15#p2-b22e6027",
     "text": "பலிக்குக் குறிக்கப்பட்ட மிருகத்தையும் மற்றதையும் ஒவ்வொருவரும் வீட்டிலே சமமாக சாப்பிடலாம்.",
     "anchor": "வெளிமானையும் கலைமானையும் சாப்பிடுவதுபோல"
    }
   ]
  },
  {
   "id": "geneva/DEU.12.17",
   "source_hash": "0e433089",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.12.17#p1-0e433089",
     "text": "அதாவது, கர்த்தருக்குப் படைக்கப்பட்ட எதுவும், அவர் குறித்த இடத்தில் அல்லாமல் வேறு எங்கும் சாப்பிடப்படக்கூடாது.",
     "anchor": "உன்னுடைய தானியத்திலும், திராட்சைரசத்திலும், எண்ணெயிலும், தசமபாகத்தையும்"
    }
   ]
  },
  {
   "id": "geneva/DEU.12.23",
   "source_hash": "09160fcf",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.12.23#p1-09160fcf",
     "text": "மிருகங்களின் உயிர் அவைகளுடைய இரத்தத்தில் இருக்கிறபடியால்.",
     "anchor": "இரத்தமே உயிர்"
    }
   ]
  },
  {
   "id": "geneva/DEU.12.26",
   "source_hash": "8e563250",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.12.26#p1-8e563250",
     "text": "நீ பலியிடப்போகிறவை.",
     "anchor": "உனக்குரிய பரிசுத்த பொருட்களையும்"
    }
   ]
  },
  {
   "id": "geneva/DEU.12.28",
   "source_hash": "cce876a1",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.12.28#p1-cce876a1",
     "text": "தேவன் தம்முடைய வாக்கிற்குக் கீழ்ப்படிகிறவர்களுக்கு நன்மை செய்வதாக வாக்குத்தத்தத்தின் மூலமாகத் தம்மைக் கட்டுப்படுத்திக்கொள்கிறார்.",
     "anchor": "நன்றாயிருப்பதற்கு"
    }
   ]
  },
  {
   "id": "geneva/DEU.12.30",
   "source_hash": "9de5b362",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.12.30#p1-9de5b362",
     "text": "அவர்களுடைய மாயவழிபாடுகளையும் விக்கிரக ஆராதனைகளையும் பின்பற்றி, அதனாலே என்னைச் சேவிக்கிறோம் என்று நினைப்பதனால்.",
     "anchor": "பின்பற்றிச் சிக்கிக்கொள்ளாதபடிக்கும்"
    }
   ]
  },
  {
   "id": "geneva/DEU.12.31",
   "source_hash": "9a1011ab",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.12.31#p1-9a1011ab",
     "text": "தங்கள் விக்கிரகங்களுக்குக் காணிக்கையாகச் செலுத்த அவர்கள் எதையும் பெரிதாக எண்ணவில்லை.",
     "anchor": "தங்கள் தெய்வங்களுக்கு அக்கினியிலே சுட்டெரித்தார்களே"
    }
   ]
  }
 ]
}
