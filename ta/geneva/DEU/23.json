 "units": [
  {
   "id": "geneva/DEU.23.1",
   "source_hash": "6958b0ce",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.23.1#p1-6958b0ce",
     "text": "பதவி வகிக்கவும், அல்லது மனைவியை மணந்துகொள்ளவும் கூடாது.",
     "anchor": "யெகோவாவுடைய சபையில் சேர்க்கப்படக்கூடாது"
    }
   ]
  },
  {
   "id": "geneva/DEU.23.2",
   "source_hash": "feb81107",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.23.2#p1-feb81107",
     "text": "அவர்களுடைய சந்ததி வெறுக்கப்படாதபடிக்கு, அவர்கள் கற்புள்ளவர்களாக வாழும்படி இது செய்யப்பட்டது.",
     "anchor": "வேசித்தனத்தினால் பிறந்த பிள்ளையும் யெகோவாவுடைய சபையில் சேர்க்கப்படக்கூடாது"
    }
   ]
  },
  {
   "id": "geneva/DEU.23.4",
   "source_hash": "e1f9a430",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.23.4#p1-e1f9a430",
     "text": "தேவனுடைய பிள்ளைகள் தங்கள் அழைப்பிலிருக்கும்போது அவர்களுக்கு உதவி செய்யாதவர்கள் எல்லோரையும் இதனால் அவர் குற்றஞ்சுமத்துகிறார்.",
     "anchor": "அப்பத்தோடும், தண்ணீரோடும் உங்களுக்கு எதிர்கொண்டு வராததினாலும்"
    }
   ]
  },
  {
   "id": "geneva/DEU.23.6",
   "source_hash": "6d6ef573",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.23.6#p1-6d6ef573",
     "text": "நீ அவர்களோடு எவ்வித தொடர்பும் வைத்துக்கொள்ளக்கூடாது.",
     "anchor": "சமாதானத்தையும் நன்மையையும்"
    }
   ]
  },
  {
   "id": "geneva/DEU.23.8",
   "source_hash": "fd87a96a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.23.8#p1-fd87a96a",
     "text": "தகப்பன்மார் தங்கள் விக்கிரக ஆராதனையைத் தள்ளிவிட்டு, விருத்தசேதனம் பண்ணிக்கொண்டிருந்தால்.",
     "anchor": "பிள்ளைகள் யெகோவாவுடைய சபையில் சேர்க்கப்படலாம்"
    }
   ]
  },
  {
   "id": "geneva/DEU.23.12",
   "source_hash": "d9091fd0",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.23.12#p1-d9091fd0",
     "text": "இயற்கையின் தேவைகளுக்காக.",
     "anchor": "மலம் கழிக்கும்"
    }
   ]
  },
  {
   "id": "geneva/DEU.23.13",
   "source_hash": "d210292b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.23.13#p1-d210292b",
     "text": "இதன் மூலம் தமது மக்கள் சரீரத்திலும் ஆத்துமாவிலும் சுத்தமாக இருக்கவேண்டும் என்பதைக் குறிக்கிறார்.",
     "anchor": "உன்னிலிருந்து கழிந்துபோனதை மூடிப்போடவேண்டும்"
    }
   ]
  },
  {
   "id": "geneva/DEU.23.15",
   "source_hash": "692c7cf5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.23.15#p1-692c7cf5",
     "text": "இது தங்கள் எஜமான்களுடைய கொடுமையின் நிமித்தம் ஓடிப்போய், மெய்யான மார்க்கத்தைத் தழுவிக்கொண்ட அந்நியமக்களைக் குறித்துச் சொல்லப்பட்டது.",
     "anchor": "வேலைக்காரனை அவனுடைய எஜமான் கையில் ஒப்புக்கொடாதே"
    }
   ]
  },
  {
   "id": "geneva/DEU.23.18",
   "source_hash": "4bc59cba",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.23.18#p1-4bc59cba",
     "text": "தீமையான காரியங்களினால் பெறப்பட்ட எந்த வருமானமும் தேவனுடைய பணிவிடைக்குப் பயன்படுத்தப்படலாகாது என்று தடை செய்கிறார், மீகா 2:7.",
     "anchor": "வேசிப்பணத்தையும்"
    }
   ]
  },
  {
   "id": "geneva/DEU.23.20",
   "source_hash": "f79da7fa",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.23.20#p1-5e2fe29a",
     "text": "இது அவர்களுடைய இருதயத்தின் கடினத்தினிமித்தம் ஒரு காலத்திற்கு அனுமதிக்கப்பட்டது.",
     "anchor": "அந்நியன் கையில் நீ வட்டிவாங்கலாம்"
    },
    {
     "id": "geneva/DEU.23.20#p2-183b4189",
     "text": "நீ உன் சகோதரனுக்கு அன்பு காண்பித்தால், தேவன் உன்மேலுள்ள தமது அன்பை வெளிப்படுத்துவார்.",
     "anchor": "நீ கையிட்டுச்செய்யும் வேலையிலெல்லாம் உன்னை ஆசீர்வதிக்க"
    }
   ]
  },
  {
   "id": "geneva/DEU.23.23",
   "source_hash": "336d2419",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.23.23#p1-336d2419",
     "text": "பொருத்தனையானது நியாயமானதும் தேவபக்திக்கானதுமாக இருந்தால்.",
     "anchor": "நிறைவேற்றவேண்டும்"
    }
   ]
  },
  {
   "id": "geneva/DEU.23.24",
   "source_hash": "3fb423a8",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.23.24#p1-54dd1bfc",
     "text": "கூலி வேலைக்காக அமர்த்தப்பட்டிருத்தல்.",
     "anchor": "பிறனுடைய திராட்சைத்தோட்டத்தில்"
    },
    {
     "id": "geneva/DEU.23.24#p2-26fe8550",
     "text": "உன் வீட்டிற்குக் கொண்டுவருதற்கு.",
     "anchor": "கூடையிலே"
    }
   ]
  }
 ]
}
