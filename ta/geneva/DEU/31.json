 "units": [
  {
   "id": "geneva/DEU.31.2",
   "source_hash": "5af75aea",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.31.2#p1-5af75aea",
     "text": "நான் இனி என்னுடைய பணியை நடத்த முடியாது.",
     "anchor": "போக்கும் வரத்துமாக இருக்கக்கூடாது"
    }
   ]
  },
  {
   "id": "geneva/DEU.31.5",
   "source_hash": "37263945",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.31.5#p1-37263945",
     "text": "உங்கள் கைகளில்.",
     "anchor": "உங்களுக்கு ஒப்புக்கொடுப்பார்"
    }
   ]
  },
  {
   "id": "geneva/DEU.31.7",
   "source_hash": "3074ba31",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.31.7#p1-3074ba31",
     "text": "ஏனெனில் மக்களை நடத்த வேண்டியவன், தீமையை அடக்குவதற்குப் பராக்கிரமமுள்ளவனாகவும், நல்லொழுக்கத்தைக் காத்துக்கொள்வதற்கு உறுதியுள்ளவனாகவும் இருக்க வேண்டும்.",
     "anchor": "திடமனதாயிரு"
    }
   ]
  },
  {
   "id": "geneva/DEU.31.8",
   "source_hash": "322feba1",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.31.8#p1-322feba1",
     "text": "தேவனுடைய தயவையும் உதவியையும் பற்றி நிச்சயம் இல்லாத மனுஷன் ஒருபோதும் நல்ல மனத்துணிவு உடையவனாக இருக்க முடியாது என்பதைக் குறிக்கிறது.",
     "anchor": "உனக்கு முன்பாகப் போகிறவர்"
    }
   ]
  },
  {
   "id": "geneva/DEU.31.11",
   "source_hash": "3ada74c2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.31.11#p1-3ada74c2",
     "text": "தேவனுடைய சந்நிதியின் அடையாளமாகவும், கிறிஸ்துவின் சாயலாகவும் இருந்த உடன்படிக்கைப் பெட்டிக்கு முன்பாக.",
     "anchor": "அவருடைய சந்நிதியில்"
    }
   ]
  },
  {
   "id": "geneva/DEU.31.13",
   "source_hash": "0ec1bc69",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.31.13#p1-0ec1bc69",
     "text": "நியாயப்பிரமாணம் கொடுக்கப்பட்டபோது பிறவாதிருந்தவர்கள்.",
     "anchor": "அதை அறியாத"
    }
   ]
  },
  {
   "id": "geneva/DEU.31.15",
   "source_hash": "f4b7ea9d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.31.15#p1-f4b7ea9d",
     "text": "தூணைப்போல ஆக்கப்பட்ட ஒரு மேகத்தில்.",
     "anchor": "மேகமண்டலத்தில்"
    }
   ]
  },
  {
   "id": "geneva/DEU.31.17",
   "source_hash": "250226ab",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.31.17#p1-250226ab",
     "text": "அதாவது, நான் என் தயவை அவர்களிடமிருந்து எடுத்துக்கொள்வேன்; அவர் தமது முகத்தை நம்மிடம் திருப்புவது அவருடைய தயவைக் காண்பிக்கிறது.",
     "anchor": "என் முகத்தை அவர்களுக்கு மறைப்பேன்"
    }
   ]
  },
  {
   "id": "geneva/DEU.31.19",
   "source_hash": "40236196",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.31.19#p1-40236196",
     "text": "தேவனுடைய கிருபைகளை நினைவுகூருவதன் மூலமாக, உங்களையும் உங்கள் பிள்ளைகளையும் விக்கிரக ஆராதனையிலிருந்து காக்கும்படிக்கு.",
     "anchor": "இந்தப் பாட்டு"
    }
   ]
  },
  {
   "id": "geneva/DEU.31.20",
   "source_hash": "486a77f9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.31.20#p1-486a77f9",
     "text": "ஏனெனில் இதுவே சரீரத்தின் இயல்பு, அது தண்டனைக்குட்பட்டிருக்கும்வரை மட்டுமே தேவனுக்குக் கீழ்ப்படிதலோடு இருக்கும்.",
     "anchor": "அவர்கள் வேறே தெய்வங்களிடத்தில் திரும்பி"
    }
   ]
  },
  {
   "id": "geneva/DEU.31.21",
   "source_hash": "992e7008",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.31.21#p1-992e7008",
     "text": "அவர்கள் என்னைவிட்டு விலகிப்போனதினால் இந்தத் தீமைகள் அவர்களுக்கு வந்தன என்பதைக் காண்பிக்கும்.",
     "anchor": "விரோதமான சாட்சி சொல்லும்"
    }
   ]
  },
  {
   "id": "geneva/DEU.31.26",
   "source_hash": "ac11cc2e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.31.26#p1-ac11cc2e",
     "text": "நீங்கள் அதில் அடங்கியிருக்கும் உபதேசத்தைவிட்டு விலகும்போது, உங்கள் அவிசுவாசத்தைக் குறித்து.",
     "anchor": "உனக்கு எதிரான சாட்சியாயிருக்கும்"
    }
   ]
  },
  {
   "id": "geneva/DEU.31.28",
   "source_hash": "84527a12",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.31.28#p1-84527a12",
     "text": "ஆளுநர்கள், நியாயாதிபதிகள் மற்றும் அதிகாரிகளைப் போன்றவர்கள்.",
     "anchor": "அதிபதிகள்"
    }
   ]
  },
  {
   "id": "geneva/DEU.31.29",
   "source_hash": "78b22425",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.31.29#p1-78b22425",
     "text": "விக்கிரக ஆராதனையினாலும், உங்கள் கைகளின் வேலையாகிய சிலைகளை வணங்குவதினாலும்.",
     "anchor": "கைகளின் செயல்களினாலே"
    }
   ]
  }
 ]
}
