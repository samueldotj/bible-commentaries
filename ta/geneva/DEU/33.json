 "units": [
  {
   "id": "geneva/DEU.33.1",
   "source_hash": "fa0b0568",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.33.1#p1-fa0b0568",
     "text": "இந்த ஆசீர்வாதம் ஒரு வெறும் ஜெபத்தை மட்டும் அல்ல, அதன் பலனைப்பற்றிய நிச்சயமுமாக அடக்கியிருக்கிறது.",
     "anchor": "ஆசீர்வதித்த ஆசீர்வாதமாவது"
    }
   ]
  },
  {
   "id": "geneva/DEU.33.2",
   "source_hash": "74f1189a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.33.2#p1-74f1189a",
     "text": "எண்ணற்ற தூதர்களைக் குறிக்கிறது.",
     "anchor": "பத்தாயிரங்களான பரிசுத்தவான்களுடன்"
    }
   ]
  },
  {
   "id": "geneva/DEU.33.3",
   "source_hash": "6dddaabc",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.33.3#p1-397b421a",
     "text": "எபிரெயம், அவருடைய பரிசுத்தவான்கள், அதாவது இஸ்ரவேல் மக்கள்.",
     "anchor": "அவருடைய பரிசுத்தவான்கள் எல்லோரும் உம்முடைய கையில்"
    },
    {
     "id": "geneva/DEU.33.3#p2-bd0a0634",
     "text": "உம்முடைய சீடர்களாக.",
     "anchor": "உம்முடைய பாதத்தில்"
    }
   ]
  },
  {
   "id": "geneva/DEU.33.4",
   "source_hash": "d085d000",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.33.4#p1-d085d000",
     "text": "நமக்கும் நம்முடைய சந்ததியாருக்கும்.",
     "anchor": "யாக்கோபின் சபைக்குச் சொந்தமானது"
    }
   ]
  },
  {
   "id": "geneva/DEU.33.6",
   "source_hash": "6194eea7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.33.6#p1-6194eea7",
     "text": "ரூபன் தேவனுடைய மக்களின் கோத்திரங்களில் ஒன்றாக இருப்பான், ஆனாலும் அவனுடைய பாவத்தினிமித்தம் அவனுடைய கனம் குறைந்திருக்கும், அவனுடைய கோத்திரமும் சிறியதாயிருக்கும்.",
     "anchor": "ரூபன் மரணமடையாமல் பிழைப்பானாக"
    }
   ]
  },
  {
   "id": "geneva/DEU.33.7",
   "source_hash": "559291ce",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.33.7#p1-559291ce",
     "text": "யாக்கோபுக்குத் தரப்பட்ட வாக்குத்தத்தத்தை அவன் அரிதாகவே பெறுவான் என்பதைக் குறிக்கிறது, ஆதி. 49:8.",
     "anchor": "அவனுடைய கை பலப்படுவதாக்குக்கு போதுமானது ஆகும்படி அவன்_amount போதுமானதாக இருக்கும்."
    }
   ]
  },
  {
   "id": "geneva/DEU.33.9",
   "source_hash": "33254657",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.33.9#p1-33254657",
     "text": "அவன் இயற்கையான எல்லா பாசத்திற்கும் தேவனுடைய மகிமையையே முதன்மையாக வைத்தான், யாத். 28:30.",
     "anchor": "அவர்களைப் பார்த்ததில்லை"
    }
   ]
  },
  {
   "id": "geneva/DEU.33.11",
   "source_hash": "cf2140ab",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.33.11#p1-cf2140ab",
     "text": "தேவனுடைய ஊழியக்காரருக்கு அநேக பகைவர்கள் இருக்கிறார்கள் என்பதை அவன் அறிவிக்கிறான்; ஆகவே அவர்களுக்காக ஜெபம்பண்ண வேண்டிய அவசியம் உண்டு.",
     "anchor": "அவனுக்கு விரோதமாக எழும்புகிறவர்களுடைய இடுப்புகளை"
    }
   ]
  },
  {
   "id": "geneva/DEU.33.12",
   "source_hash": "7f5a03ef",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.33.12#p1-7f5a03ef",
     "text": "ஆலயம் பென்யமீன் கோத்திரத்தில் இருந்த சீயோனில் கட்டப்படும் என்பதால், தேவன் அங்கே அவனுடன் தங்கியிருப்பார் என்பதை இவன் காண்பிக்கிறான்.",
     "anchor": "அவருடன் சுகமாகத் தங்கியிருப்பான்"
    }
   ]
  },
  {
   "id": "geneva/DEU.33.16",
   "source_hash": "b57ca342",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.33.16#p1-b57ca342",
     "text": "இது மோசேக்குத் தரிசனமான தேவனாக இருந்தது, யாத். 3:2.",
     "anchor": "முட்செடியில்"
    }
   ]
  },
  {
   "id": "geneva/DEU.33.18",
   "source_hash": "90154bbc",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.33.18#p1-90154bbc",
     "text": "கடலின்மேல் நீ செய்யும் செழிப்பான கப்பல் பயணங்களில், ஆதி. 49:13.",
     "anchor": "வெளியே புறப்பட்டுப்போகும்போதும்"
    }
   ]
  },
  {
   "id": "geneva/DEU.33.19",
   "source_hash": "e89d4418",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.33.19#p1-e89d4418",
     "text": "செபுலோன் கோத்திரம்.",
     "anchor": "சம்பூரணத்தையும்... அநுபவிப்பார்கள்"
    }
   ]
  },
  {
   "id": "geneva/DEU.33.21",
   "source_hash": "f50781c8",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.33.21#p1-f50781c8",
     "text": "இப்படியே யோர்தானின் இப்புறத்திலிருந்த காத்தியரின் பங்கும், மற்றவர்களின் பங்கும் தேவனுடையதாக இருந்தது, அது அவ்வளவாக அறியப்படாதிருந்தாலும்.",
     "anchor": "நியாயப்பிரமாணிகன்"
    }
   ]
  },
  {
   "id": "geneva/DEU.33.23",
   "source_hash": "50f9a067",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.33.23#p1-50f9a067",
     "text": "கடலின் அருகில் என்று அர்த்தம்.",
     "anchor": "மேற்குத் திசையையும் தெற்குத் திசையையும்"
    }
   ]
  },
  {
   "id": "geneva/DEU.33.25",
   "source_hash": "05f7b32a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.33.25#p1-05f7b32a",
     "text": "நீ பலமாயிருப்பாய், அல்லது, உன் நாடு உலோகங்களால் நிறைந்திருக்கும். சிமியோன் இதில் விடுபட்டதாகத் தோன்றுகிறது, ஏனெனில் அவன் யூதாவின் கீழிருந்தான், அவனுடைய சொத்துப் பங்கும் அவனுடையதே, யோசுவா 19:9.",
     "anchor": "இரும்பும் வெண்கலமும்"
    }
   ]
  },
  {
   "id": "geneva/DEU.33.28",
   "source_hash": "e39abd8b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.33.28#p1-e39abd8b",
     "text": "ஒரு ஊற்றைப்போல திரளான சந்ததியை உடையவனாயிருந்தான்.",
     "anchor": "யாக்கோபின் ஊற்றானது"
    }
   ]
  },
  {
   "id": "geneva/DEU.33.29",
   "source_hash": "d025e48e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/DEU.33.29#p1-d025e48e",
     "text": "உன் எதிரிகள் பயத்தினால் பொய் சொல்லி, கீழ்ப்படிந்திருப்பதைப் போல் காண்பிப்பார்கள்.",
     "anchor": "உன் எதிரிகள் உன்னை நிந்தித்துப் பேசி அடங்குவார்கள்"
    }
   ]
  }
 ]
}
