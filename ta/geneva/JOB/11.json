 "units": [
  {
   "id": "geneva/JOB.11.2",
   "source_hash": "bbc9a0d9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.11.2#p1-bbc9a0d9",
     "text": "தான் நீதிமான் என்று தன் ஏராளமான வார்த்தைகளினால் நம்பச்செய்ய வேண்டுமோ?",
     "anchor": "வாயடிக்கிறவன் நீதிமானாக விளங்குவானோ"
    }
   ]
  },
  {
   "id": "geneva/JOB.11.4",
   "source_hash": "74af77f5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.11.4#p1-74af77f5",
     "text": "தான் சொன்னது சத்தியம் என்றும், தேவனுடைய பார்வையில் தான் பாவமில்லாதவன் என்றும் யோபு சொன்னதாகக் குற்றம்சாட்டுகிறான்.",
     "anchor": "என் சொல் சுத்தம்"
    }
   ]
  },
  {
   "id": "geneva/JOB.11.6",
   "source_hash": "01004172",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.11.6#p1-01004172",
     "text": "இது தன்னைத்தானே நீதிமானாக்கிக்கொள்ளுவதில் நிலைத்து நிற்கக்கூடாது என்பதைக் குறிக்கிறது: மனுஷன் மற்றொருவனுடன் தர்க்கம் செய்துகொண்டிருக்கும்போது தான் தோற்கடிக்கப்படுவதற்கு ஒப்புக்கொள்ளமாட்டான் என்பதை அவன் காட்டுகிறான்; ஆகையால் தேவனே அந்த வாக்குவாதத்தை முடிவுக்குக் கொண்டுவந்து மனுஷனுடைய வாயை அடைக்க வேண்டும்.",
     "anchor": "ஞானத்தின் இரகசியங்களை"
    }
   ]
  },
  {
   "id": "geneva/JOB.11.8",
   "source_hash": "51553b1d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.11.8#p1-51553b1d",
     "text": "அதாவது, தேவனுடைய இந்தப் பரிபூரணத்தை. மனிதன் பரலோகத்தின் உயரத்தையும், பூமியின் ஆழத்தையும், சமுத்திரத்தின் விசாலத்தையும், அவை சிருஷ்டிகளாக இருந்தும், அறிந்துகொள்ள முடியாமல் இருக்க, சிருஷ்டிகருடைய பரிபூரணத்தை அவன் எப்படி எட்டமுடியும்.",
     "anchor": "பாதாளத்திலும் ஆழமானது"
    }
   ]
  },
  {
   "id": "geneva/JOB.11.10",
   "source_hash": "cc257c13",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.11.10#p1-cc257c13",
     "text": "தேவன் காரியங்களின் நிலைமையை மாற்றி, இயற்கையில் ஒரு புதிய ஒழுங்கை நிலைநிறுத்தினால், அவரை யார் தடுக்கக்கூடும்?",
     "anchor": "அடைத்தாலும்"
    }
   ]
  },
  {
   "id": "geneva/JOB.11.12",
   "source_hash": "acf501ac",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.11.12#p1-acf501ac",
     "text": "அதாவது, அறிவில்லாதவனாகவே பிறக்கிறான்; ஆகவே பின்பு அவனுக்கு உண்டாகும் எந்தத் திறமைகளும் இயற்கையிலிருந்து அல்ல, தேவனிடத்திலிருந்தே வருகின்றன.",
     "anchor": "காட்டுக்கழுதைக்குட்டி"
    }
   ]
  },
  {
   "id": "geneva/JOB.11.13",
   "source_hash": "392feb74",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.11.13#p1-392feb74",
     "text": "நீர் மனந்திரும்பினால், அவரை நோக்கி ஜெபம்பண்ணும்.",
     "anchor": "உம்முடைய இருதயத்தை ஆயத்தப்படுத்தி"
    }
   ]
  },
  {
   "id": "geneva/JOB.11.14",
   "source_hash": "227c3022",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.11.14#p1-227c3022",
     "text": "உம்முடைய சொந்த பொல்லாத செயல்களைத் துறந்துவிட்டு, நீர் மேற்பார்வை செய்யும் அவர்கள் தேவனுக்கு அபராதம் செய்யாதபடி பார்த்துக்கொள்ளும்.",
     "anchor": "கையிலே"
    }
   ]
  },
  {
   "id": "geneva/JOB.11.15",
   "source_hash": "47558f79",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.11.15#p1-47558f79",
     "text": "உண்மையான மனந்திரும்புதலோடு தேவனிடத்தில் திரும்புகிறவர்களுக்கு உண்டாகும் மனச்சாட்சியின் அமைதியையும் எல்லாக் காரியங்களிலும் உள்ள வெற்றியையும் அவர் விவரிக்கிறார்.",
     "anchor": "வெட்கமில்லாமல் தலைநிமிர்ந்து"
    }
   ]
  },
  {
   "id": "geneva/JOB.11.20",
   "source_hash": "7317798c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.11.20#p1-7317798c",
     "text": "மனந்திரும்பாதவர்களுக்கு எதிர்மாறான காரியங்கள் நேரிடும் என்பதை அவன் காண்பிக்கிறான்.",
     "anchor": "கண்கள் பூத்துப்போய்"
    }
   ]
  }
 ]
}
