 "units": [
  {
   "id": "geneva/JOB.14.1",
   "source_hash": "d2ea29de",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.14.1#p1-d2ea29de",
     "text": "தன் விரோதிகளின் வார்த்தைகளை வாய்ப்பாகக் கொண்டு, மனிதனுடைய பிறப்பு முதல் மரணம் வரையுள்ள வாழ்க்கை நிலையை விவரிக்கிறான்.",
     "anchor": "பெண்ணிடத்தில் பிறந்த மனிதன்"
    }
   ]
  },
  {
   "id": "geneva/JOB.14.3",
   "source_hash": "9633b004",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.14.3#p1-9633b004",
     "text": "அவனுடைய கருத்தாவது, மனுஷன் இவ்வளவு பலவீனமுள்ள சிருஷ்டியாக இருக்கும்போது, தேவன் அவனை இவ்வளவு கடுமையாக நடத்தக்கூடாது என்பதே; இதில் யோபு, ஆவியானவருக்குக் கீழ்ப்படியாதிருக்கும்போது சரீரத்தின் துன்மார்க்கத்தைக் காண்பிக்கிறார்.",
     "anchor": "இப்படிப்பட்டவன்மேல்"
    }
   ]
  },
  {
   "id": "geneva/JOB.14.6",
   "source_hash": "812a50ca",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.14.6#p1-812a50ca",
     "text": "அவனுக்கு மரிக்கும்படி நீர் நியமித்திருக்கிற காலம்வரை, அதை அவன் ஆசையோடு எதிர்பார்த்திருக்கிறான், கூலிக்காரன் தன் வேலையின் முடிவில் தன் கூலியைப் பெற எதிர்பார்த்திருக்கிறதுபோலவே.",
     "anchor": "ஒரு கூலிக்காரனைப்போல"
    }
   ]
  },
  {
   "id": "geneva/JOB.14.10",
   "source_hash": "c7bc1406",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.14.10#p1-c7bc1406",
     "text": "அவர் இங்கே நித்தியத்துவத்தின்மேல் எவ்வித நம்பிக்கையும் இல்லாதவனாகப் பேசவில்லை, மாறாக துன்பங்களினாலும் வேதனைகளினாலும் புத்தி மேற்கொள்ளப்பட்ட, கடும் வேதனையிலிருக்கும் ஒரு மனிதனாகப் பேசுகிறார்.",
     "anchor": "மனிதனோவென்றால் இறந்தபின்"
    }
   ]
  },
  {
   "id": "geneva/JOB.14.13",
   "source_hash": "3522a294",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.14.13#p1-60e0e201",
     "text": "இதன் மூலம் அவர் தேவனுடைய நியாயத்தீர்ப்பின் மேலுள்ள பயமே தான் மரிக்க விரும்பியதற்குக் காரணம் என்பதை வெளிப்படுத்துகிறார்.",
     "anchor": "உமது கோபம் தணியும்வரை"
    },
    {
     "id": "geneva/JOB.14.13#p2-bda708ab",
     "text": "அதாவது, என் வேதனையை நீக்கி, என்னை இரக்கத்திற்கு உட்படுத்தும்.",
     "anchor": "என்னைத் திரும்ப நினைப்பதற்கு"
    }
   ]
  },
  {
   "id": "geneva/JOB.14.14",
   "source_hash": "f8394fb6",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.14.14#p1-f8394fb6",
     "text": "அதாவது, தான் மாற்றப்பட்டு புதுப்பிக்கப்படும் உயிர்த்தெழுதலின் நாள்வரைக்கும் என்று பொருள்.",
     "anchor": "எனக்கு மாறுதல் எப்போது வரும்"
    }
   ]
  },
  {
   "id": "geneva/JOB.14.15",
   "source_hash": "5975ec29",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.14.15#p1-5975ec29",
     "text": "இந்த வாழ்வில் நான் உபத்திரவப்பட்டாலும், உயிர்த்தெழுதலில் உம்முடைய கிருபைகளை நான் உணர்ந்து, நீர் என்னைக் கூப்பிடும்போது பதில் சொல்லுவேன்.",
     "anchor": "நான் உமக்கு பதில் சொல்லுவேன்"
    }
   ]
  },
  {
   "id": "geneva/JOB.14.17",
   "source_hash": "98e0aa9d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.14.17#p1-98e0aa9d",
     "text": "நீர் அவைகளையெல்லாம் ஒன்றுசேர்த்து வைத்து, என் பாவங்களில் ஒன்றையும் தண்டனையின்றி விட்டுவிடாதிருக்கிறீர்.",
     "anchor": "கட்டாக"
    }
   ]
  },
  {
   "id": "geneva/JOB.14.18",
   "source_hash": "97cc33b5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.14.18#p1-97cc33b5",
     "text": "தேவனுக்கு விரோதமாக சரீரத்தின் அவசரப்படாத்தன்மையினால் அவன் முறையிடுகிறான், கடின கன்மலைகளுக்கு விரோதமாகவும், புரண்டு பாயும் தண்ணீர்களுக்கு விரோதமாகவும் அவர் மிகுந்த கடுமையை நடத்துவது போல, இதனால் தன் நம்பிக்கையின் சந்தர்ப்பம் நீக்கப்பட்டுவிடும் என்று எண்ணுகிறான்.",
     "anchor": "கன்மலை தன் இடத்தைவிட்டுப் பெயர்ந்துபோகும்.,label:k"
    }
   ]
  },
  {
   "id": "geneva/JOB.14.22",
   "source_hash": "a37220b3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.14.22#p1-a37220b3",
     "text": "அதாவது, அவன் வேதனையிலும் துக்கத்திலும் இருக்கும்வரை.",
     "anchor": "அவனுடைய உடல் அவனிலிருக்கும்வரை அதற்கு வியாதியிருக்கும்"
    }
   ]
  }
 ]
}
