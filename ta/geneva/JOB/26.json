 "units": [
  {
   "id": "geneva/JOB.26.2",
   "source_hash": "a005a3bf",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.26.2#p1-5928b69f",
     "text": "நீ ஒன்றையும் முடிவுக்குக் கொண்டுவரவில்லை, ஏனெனில் எல்லா உதவியும் இல்லாமல் இருந்த நான் இருக்கும்போது நீ எனக்கு உதவி செய்யவுமில்லை, தேவனுக்காக போதுமான அளவு பேசவுமில்லை; அவருடைய பாதுகாப்பிற்கு உன் காரியவாதம் தேவையில்லையே.",
     "anchor": "பெலனில்லாதவனுக்கு நீ எப்படி உதவிசெய்தாய்?"
    },
    {
     "id": "geneva/JOB.26.2#p2-adf0b40d",
     "text": "ஆனாலும் நீ அதைச் சரியான நோக்கத்திற்குப் பயன்படுத்தவில்லை.",
     "anchor": "பெலனற்ற கையை நீ எப்படி ஆதரித்தாய்?"
    }
   ]
  },
  {
   "id": "geneva/JOB.26.4",
   "source_hash": "41beb035",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.26.4#p1-41beb035",
     "text": "அதாவது, இதைச் சொல்ல உன்னைத் தூண்டுவது எது?",
     "anchor": "உன்னிடத்திலிருந்து புறப்பட்ட"
    }
   ]
  },
  {
   "id": "geneva/JOB.26.5",
   "source_hash": "f3639b62",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.26.5#p1-f3639b62",
     "text": "தேவனுடைய வல்லமையும் பராமரிப்பும் ஆழமான பூமியின் அடியில் இருக்கும் கனிமங்களிலும் உலோகங்களிலும் எவ்வளவு பலமாய் செயல்படுகிறது என்பதை யோபு விவரிக்கத் தொடங்குகிறார்.",
     "anchor": "தண்ணீரின் கீழ் இறந்தவர்களுக்கும்"
    }
   ]
  },
  {
   "id": "geneva/JOB.26.6",
   "source_hash": "5490da16",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.26.6#p1-273c265e",
     "text": "பூமியின் அடியில் மறைந்திருக்கிற ஒன்றும் இல்லை, அவர் அதைக் காண்கிறார்.",
     "anchor": "பாதாளம் தெரியும்விதத்தில் திறந்திருக்கிறது"
    },
    {
     "id": "geneva/JOB.26.6#p2-5158b34e",
     "text": "அதாவது, பொருள்கள் அழுகிப்போகிற கல்லறை.",
     "anchor": "நரகம் மூடப்படாதிருக்கிறது"
    }
   ]
  },
  {
   "id": "geneva/JOB.26.7",
   "source_hash": "0f56a31c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.26.7#p1-0f56a31c",
     "text": "பூமி முழுவதும் வடதுருவத்தை மையமாகக்கொண்டு சுழலும்படி அவர் செய்கிறார்.",
     "anchor": "வடக்குமண்டலத்தை வெட்டவெளியிலே"
    }
   ]
  },
  {
   "id": "geneva/JOB.26.10",
   "source_hash": "b60ec53b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.26.10#p1-a1d9bc67",
     "text": "அதாவது, அவர் தமது சிங்காசனம் என்று சொல்லப்படும் பரலோகத்தை மறைத்தார்.",
     "anchor": "தண்ணீர்கள்மேல் சுழற்சி வட்டம் அமைத்தார்"
    },
    {
     "id": "geneva/JOB.26.10#p2-fbbf50f7",
     "text": "இந்த உலகம் நிலைத்திருக்கும் வரையில்.",
     "anchor": "வெளிச்சமும் இருளும் முடியும்வரை"
    }
   ]
  },
  {
   "id": "geneva/JOB.26.11",
   "source_hash": "e71d63f8",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.26.11#p1-e71d63f8",
     "text": "பரலோகத்திற்குத் தூண்கள் இருக்கிறது என்பதல்ல, ஆனால் அவர் ஒரு உவமையினால் பேசுகிறார், அதாவது பரலோகமே அவருடைய கண்டிப்பைத் தாங்க முடியாது என்பது போலவே.",
     "anchor": "வானத்தின் தூண்கள் அதிர்ந்து தத்தளிக்கும்"
    }
   ]
  },
  {
   "id": "geneva/JOB.26.13",
   "source_hash": "74d28c6f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.26.13#p1-74d28c6f",
     "text": "இது ஒரு நட்சத்திரக்கூட்டத்தைக் குறிக்கிறது; அதன் நெளிவான தோற்றத்தினிமித்தம் அது சர்ப்பத்தின் உருவமாகக் காணப்படுகிறது.",
     "anchor": "நெளிவான சர்ப்ப நட்சத்திரத்தை"
    }
   ]
  },
  {
   "id": "geneva/JOB.26.14",
   "source_hash": "59d546b9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JOB.26.14#p1-59d546b9",
     "text": "நாம் ஒவ்வொரு நாளும் நம் கண்களால் காணும் இந்தச் சிறு காரியங்கள் அவருடைய பெரிய வல்லமையையும் பராமரிப்பையும் வெளிப்படுத்துமானால், நாம் அவருடைய எல்லா செயல்களையும் உணர்ந்துகொள்ளக்கூடுமானால் அவை எவ்வளவு அதிகமாய் வெளிப்படும்.",
     "anchor": "அவரைக்குறித்து நாங்கள் கேட்டது எவ்வளவு கொஞ்சம்"
    }
   ]
  }
 ]
}
