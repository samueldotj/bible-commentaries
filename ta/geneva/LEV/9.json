 "units": [
  {
   "id": "geneva/LEV.9.1",
   "source_hash": "ceb18584",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LEV.9.1#p1-ceb18584",
     "text": "அவர்களுடைய அபிஷேகத்திற்குப் பின்பு: ஏனெனில் முந்தின ஏழு நாட்களில் ஆசாரியர்கள் அபிஷேகம் செய்யப்பட்டார்கள்.",
     "anchor": "எட்டாம் நாளிலே"
    }
   ]
  },
  {
   "id": "geneva/LEV.9.2",
   "source_hash": "80f99aa0",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LEV.9.2#p1-80f99aa0",
     "text": "ஆரோன் ஆசாரிய ஊழியத்தை ஏற்றுக்கொள்கிறான்: நான்கு பிரதான காணிக்கைகளைப் பலியிடுகிறான், அவையாவன சர்வாங்க தகனபலி, பாவநிவாரணபலி, சமாதானபலி, உணவுபலி ஆகியவை.",
     "anchor": "பாவநிவாரணபலியாக"
    }
   ]
  },
  {
   "id": "geneva/LEV.9.5",
   "source_hash": "5f1b61f2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LEV.9.5#p1-5f1b61f2",
     "text": "அவருடைய மகிமை காணப்பட்ட பலிபீடத்திற்கு முன்பாக.",
     "anchor": "யெகோவாவுடைய சந்நிதியில்"
    }
   ]
  },
  {
   "id": "geneva/LEV.9.7",
   "source_hash": "d148c474",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LEV.9.7#p1-d148c474",
     "text": "இந்தப் பகுதியைப் புரிந்துகொள்ள எபிரெயர் 4:5, 7:27-ஐ வாசிக்கவும்.",
     "anchor": "உனக்காகவும்"
    }
   ]
  },
  {
   "id": "geneva/LEV.9.10",
   "source_hash": "566460e9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LEV.9.10#p1-566460e9",
     "text": "அதாவது, அவன் அவற்றை ஒழுங்காக வைத்தான், அப்படியே கர்த்தர் நெருப்பை அனுப்பியபோது அவை எரிந்தன.",
     "anchor": "பலிபீடத்தின்மேல் எரித்து"
    }
   ]
  },
  {
   "id": "geneva/LEV.9.14",
   "source_hash": "02ce2a3d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LEV.9.14#p1-02ce2a3d",
     "text": "இவையெல்லாம் பின்னர் எரிக்கப்பட்ட பலிகளை ஆயத்தப்படுத்தினதைக் குறித்தே எடுத்துக்கொள்ளவேண்டும், லேவி 9:24.",
     "anchor": "பலிபீடத்தின்மேல் இருந்த சர்வாங்க தகனபலியின்மேல் எரித்தான்"
    }
   ]
  },
  {
   "id": "geneva/LEV.9.21",
   "source_hash": "8705f6d7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LEV.9.21#p1-8705f6d7",
     "text": "காளையினுடையவும் ஆட்டுக்கடாவினுடையவும்.",
     "anchor": "மார்புப்பகுதிகளையும் வலது முன்னந்தொடையையும் ஆரோன்"
    }
   ]
  },
  {
   "id": "geneva/LEV.9.22",
   "source_hash": "43a67c17",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LEV.9.22#p1-43a67c17",
     "text": "பலிபீடம் பரிசுத்த ஸ்தலத்திற்கு அருகில் இருந்தது, அது மேல் முனையில் இருந்தது; ஆகையால் அவன் இறங்கினான் என்று சொல்லப்படுகிறது.",
     "anchor": "செலுத்தின இடத்திலிருந்து இறங்கினான்"
    }
   ]
  },
  {
   "id": "geneva/LEV.9.23",
   "source_hash": "2ebe229c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LEV.9.23#p1-2ebe229c",
     "text": "அல்லது மக்களுக்காக ஜெபம்பண்ணினார்கள்.",
     "anchor": "மக்களை ஆசீர்வதித்தார்கள்"
    }
   ]
  }
 ]
}
