 "units": [
  {
   "id": "geneva/LEV.5.1",
   "source_hash": "e1143981",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LEV.5.1#p1-e1143981",
     "text": "இதனால் சத்தியத்திற்குச் சாட்சி கொடுக்கவும், அவபக்தியுள்ளவர்களின் அக்கிரமத்தை வெளிப்படுத்தவும் கட்டளையிடப்பட்டிருக்கிறது.",
     "anchor": "கண்டதையும் அறிந்ததையும்"
    }
   ]
  },
  {
   "id": "geneva/LEV.5.4",
   "source_hash": "6d643431",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LEV.5.4#p1-6d643431",
     "text": "அல்லது, சூழ்நிலைகளை முறையாகச் சிந்தித்துப் பார்க்காமல், அதன் விளைவு என்னவாகும் என்று அறியாமல் பதறிப் பொருத்தனைச்செய்தல்.",
     "anchor": "ஆணையிடும்"
    }
   ]
  },
  {
   "id": "geneva/LEV.5.5",
   "source_hash": "da9b8bf2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LEV.5.5#p1-da9b8bf2",
     "text": "இந்த அதிகாரத்தில் முன்பு குறிப்பிடப்பட்டவைகள்.",
     "anchor": "இப்படிப்பட்டவைகள்"
    }
   ]
  },
  {
   "id": "geneva/LEV.5.10",
   "source_hash": "57df6a30",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LEV.5.10#p1-57df6a30",
     "text": "அல்லது, அந்தப் பாவத்திலிருந்து அவன் சுத்திகரிக்கப்பட்டவன் என்று அறிவிக்கவேண்டும்.",
     "anchor": "அவன் செய்த பாவத்தை ஆசாரியன் நிவிர்த்தி செய்யக்கடவன்"
    }
   ]
  },
  {
   "id": "geneva/LEV.5.11",
   "source_hash": "f651a1ca",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LEV.5.11#p1-2df7c9ab",
     "text": "இது சுமார் அரை காலன் அளவாக இருந்தது.",
     "anchor": "ஒரு கிலோ அளவான மெல்லிய மாவிலே பத்தில் ஒரு பங்கை"
    },
    {
     "id": "geneva/LEV.5.11#p2-2f806131",
     "text": "உணவுபலியாகிய காணிக்கையில் இருந்தது போலவே, லேவியராகமம் 2:1.",
     "anchor": "எண்ணெய் ஊற்றாமலும்"
    }
   ]
  },
  {
   "id": "geneva/LEV.5.15",
   "source_hash": "c1112792",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LEV.5.15#p1-be110f90",
     "text": "ஆசாரியர்களுக்கும் லேவியர்களுக்கும் செலுத்தப்படவேண்டிய முதற்பலன்கள் அல்லது தசமபாகங்களைக் குறித்தது.",
     "anchor": "யெகோவாவுக்குரிய பரிசுத்தமானவைகளில்"
    },
    {
     "id": "geneva/LEV.5.15#p2-2cc5e1aa",
     "text": "ஆசாரியனுடைய மதிப்பீட்டின்படியே, லேவியராகமம் 27:12.",
     "anchor": "நீ அவன்மேல் சுமத்தும் அபராதம் எவ்வளவோ, அவ்வளவு வெள்ளிச் சேக்கல் மதிப்புள்ள”,"
    }
   ]
  },
  {
   "id": "geneva/LEV.5.17",
   "source_hash": "0cbf66b5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LEV.5.17#p1-0cbf66b5",
     "text": "அதாவது, தான் பாவம்செய்தபின்பு தன் மனச்சாட்சி அவனைக் குற்றப்படுத்துகையில் அவன் நினைவுகூருகிறான்.",
     "anchor": "தன் அக்கிரமத்தைச் சுமப்பான்"
    }
   ]
  },
  {
   "id": "geneva/LEV.5.18",
   "source_hash": "ff8f33ec",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LEV.5.18#p1-ff8f33ec",
     "text": "இல்லையென்றால், தேவனுக்கு விரோதமாக அவன் செய்த பாவம் துணிகரத்தினால் உண்டானதாக இருந்தால், அவன் மரிக்கவேண்டும்; எண்ணாகமம் 15:30.",
     "anchor": "அவன் அறியாமல் செய்த குற்றத்தை"
    }
   ]
  }
 ]
}
