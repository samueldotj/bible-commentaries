 "units": [
  {
   "id": "geneva/EZK.1.1",
   "source_hash": "489fc27b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.1.1#p1-9787bbdc",
     "text": "நியாயப்பிரமாணப் புத்தகம் கண்டுபிடிக்கப்பட்ட பின்பு, அது யோசியாவின் ஆட்சியில் பதினெட்டாம் வருடமாக இருந்தது; இந்தப் புத்தகம் கண்டுபிடிக்கப்பட்ட இருபத்தைந்து வருடங்களுக்குப் பின்பு, யெகொனியா எசேக்கியேலோடும் மக்களில் அநேகரோடும் சிறைப்பட்டுக் கொண்டுபோகப்பட்டான்; அவர்களே முதலாம் வருடத்திலே பின்பு இந்தத் தரிசனங்களைக் கண்டவர்கள்.",
     "anchor": "முப்பதாம் வருடம்"
    },
    {
     "id": "geneva/EZK.1.1#p2-31767cfc",
     "text": "இது ஐப்பிராத்தின் ஒரு பகுதியாய், அப்படி அழைக்கப்பட்டது.",
     "anchor": "கேபார்"
    },
    {
     "id": "geneva/EZK.1.1#p3-8af2eff5",
     "text": "அதாவது, குறிப்பிடத்தக்க, மேன்மையான தரிசனங்கள்; இவை இயல்பான மனித சிந்தனையால் உண்டானவை அல்ல, தேவனிடத்திலிருந்து வந்தவை என்று அறியப்படும்படியாக இருந்தது.",
     "anchor": "தேவதரிசனங்களைக்"
    }
   ]
  },
  {
   "id": "geneva/EZK.1.3",
   "source_hash": "0ff8ad8a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.1.3#p1-0ff8ad8a",
     "text": "அதாவது, தீர்க்கதரிசன ஆவி, எசேக்கியேல் 3:22, 37:1-ல் இருப்பதுபோல.",
     "anchor": "யெகோவாவுடைய கரம் அவன்மேல் அமர்ந்தது"
    }
   ]
  },
  {
   "id": "geneva/EZK.1.4",
   "source_hash": "709588c0",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.1.4#p1-709588c0",
     "text": "இந்த வேறுபட்ட வார்த்தைகளினால், தேவனுடைய பயங்கரமான நியாயத்தீர்ப்பையும் எருசலேமின்மேல் வரவிருந்த பெரிய உபத்திரவங்களையும் அவர் குறிப்பிடுகிறார்.",
     "anchor": "வடக்கேயிருந்து புயல்காற்றும்"
    }
   ]
  },
  {
   "id": "geneva/EZK.1.5",
   "source_hash": "b35b6600",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.1.5#p1-b35b6600",
     "text": "இவை சகரியா 11:22 இல் இருப்பதுபோல, தேவனுடைய மகிமையைக் காண்பித்த நான்கு கேருபீன்கள்.",
     "anchor": "நான்கு உயிரினங்கள்"
    }
   ]
  },
  {
   "id": "geneva/EZK.1.9",
   "source_hash": "1c44b704",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.1.9#p1-1c44b704",
     "text": "ஒன்றின் இறக்கை மற்றதின் இறக்கையைத் தொட்டுக்கொண்டிருந்தது.",
     "anchor": "மற்றதின் இறக்கைகளுடன் சேர்ந்திருந்தன"
    }
   ]
  },
  {
   "id": "geneva/EZK.1.10",
   "source_hash": "34043435",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.1.10#p1-34043435",
     "text": "ஒவ்வொரு கேருபீனுக்கும் நான்கு முகங்கள் இருந்தன, வலதுபக்கத்தில் மனிதனுடைய முகமும் சிங்கத்தினுடைய முகமும், இடது பக்கத்தில் எருதினுடைய முகமும் கழுகினுடைய முகமும் இருந்தன.",
     "anchor": "மனிதனுடைய முகமும்"
    }
   ]
  },
  {
   "id": "geneva/EZK.1.14",
   "source_hash": "cc504893",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.1.14#p1-cc504893",
     "text": "அதாவது, அவைகள் தேவனுடைய சித்தத்தை நிறைவேற்றியபோது; ஏனெனில் தேவன் காரியங்களின் நிலைமையை மாற்றும்வரை அவைகள் முன்பு திரும்பவில்லை.",
     "anchor": "ஓடித்திரிந்தன"
    }
   ]
  },
  {
   "id": "geneva/EZK.1.16",
   "source_hash": "15bba8e5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.1.16#p1-15bba8e5",
     "text": "எபிரெய வார்த்தை தர்ஷீஷ் என்பதாகும், அதாவது அந்த நிறம் சிலிசியா கடலின் நிறத்தைப் போல அல்லது அப்படிப்பட்ட பெயருடைய ஒரு விலையுயர்ந்த கல்லைப் போல இருந்தது என்பதாகும்.",
     "anchor": "படிகப்பச்சை"
    }
   ]
  },
  {
   "id": "geneva/EZK.1.24",
   "source_hash": "7b26b121",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.1.24#p1-55c97766",
     "text": "இது தேவனுடைய நியாயத்தீர்ப்புகளின் விரைவையும் பயங்கரத்தையும் காண்பித்தது.",
     "anchor": "இறக்கைகளின்"
    },
    {
     "id": "geneva/EZK.1.24#p2-5ce67f05",
     "text": "இது அவைகளுக்குத் தங்களிடம் ஒரு வல்லமையும் இல்லாமல், தேவனுடைய கற்பனையை நிறைவேற்றுவதற்காக மட்டும் காத்திருந்தன என்பதைக் குறித்தது.",
     "anchor": "தங்களுடைய இறக்கைகளைத் தளரவிட்டிருந்தன"
    }
   ]
  },
  {
   "id": "geneva/EZK.1.27",
   "source_hash": "7167d801",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.1.27#p1-7167d801",
     "text": "இதினால் பூமிக்கு விரோதமான பயங்கரமான நியாயத்தீர்ப்பு குறிக்கப்பட்டது.",
     "anchor": "உட்புறம் சுற்றிலும்"
    }
   ]
  },
  {
   "id": "geneva/EZK.1.28",
   "source_hash": "92005655",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.1.28#p1-92005655",
     "text": "தேவனுடைய மகிமையையும் சரீரத்தின் பலவீனத்தையும் சிந்தித்து.",
     "anchor": "முகங்குப்புற"
    }
   ]
  }
 ]
}
