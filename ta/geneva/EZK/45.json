   "paragraphs": [
    {
     "id": "geneva/EZK.45.24#p1-90f4bb0a",
     "text": "யாத்திராகமம் 29:40-ஐ வாசிக்கவும்.",
     "anchor": "ஒரு மரக்கால் மாவுடன் ஒருபடி எண்ணெய்"
    }
   ]
  }
 ]
