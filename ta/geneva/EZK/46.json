   "paragraphs": [
    {
     "id": "geneva/EZK.46.17#p1-c3265a23",
     "text": "இது யூபிலி வருடத்தில் நடந்தது, லேவி. 25:9.",
     "anchor": "விடுதலையின் வருடம்வரை"
    }
   ]
  },
  {
   "id": "geneva/EZK.46.18",
   "source_hash": "ea418084",
   "generator": {
    "name": "claude",
