    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.37.19#p1-e3ce7042",
     "text": "அதாவது, இஸ்ரவேல் வம்சம்.",
     "anchor": "யோசேப்பின்"
    }
   ]
  },
  {
   "id": "geneva/EZK.37.25",
   "source_hash": "76f0e8dc",
   "generator": {
    "name": "claude",
