 "units": [
  {
   "id": "geneva/EZK.16.3",
   "source_hash": "bfa8e5c5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.16.3#p1-bfa8e5c5",
     "text": "நீ ஆபிரகாமின் சந்ததியென்று பெருமை பாராட்டுகிறாய், ஆனால் நீ சீர்கெட்டவளாயிருந்து, பிள்ளைகள் தங்கள் பெற்றோரின் நடத்தையைப் பின்பற்றுவதுபோல, துன்மார்க்கரான கானானியரின் அருவருப்புகளைப் பின்பற்றுகிறாய், ஏசாயா 1:4, 57:3.",
     "anchor": "கானான்"
    }
   ]
  },
  {
   "id": "geneva/EZK.16.4",
   "source_hash": "a976dcbc",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.16.4#p1-a976dcbc",
     "text": "நான் உங்களை எகிப்திலிருந்து வெளியே கொண்டுவந்து, இந்த தேசத்தில் என் சபையாக இருக்கும்படி நாட்டின பொழுது.",
     "anchor": "பிறந்த நாளிலே உன்னுடைய தொப்புள் அறுக்கப்படவுமில்லை"
    }
   ]
  },
  {
   "id": "geneva/EZK.16.6",
   "source_hash": "94209275",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.16.6#p1-94209275",
     "text": "இப்படி நீ உன் அசுத்தத்தில் கிடந்து, எல்லோராலும் கைவிடப்பட்டிருந்தபோது, நான் உன்னை எடுத்துப் பிழைக்கச் செய்தேன்: இதனால் குறிக்கப்படுவது, தேவன் தமது சபையைக் கழுவி பிழைக்கச் செய்யுமுன்பு, அசுத்தமும் மரணமுமே அன்றி வேறொன்றும் இல்லை என்பதே.",
     "anchor": "உன்னுடைய இரத்தத்தில் கிடக்கிற உன்னைப் பார்த்து"
    }
   ]
  },
  {
   "id": "geneva/EZK.16.8",
   "source_hash": "8c073762",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.16.8#p1-edcb6e58",
     "text": "இரத்தம், அசுத்தம், நிர்வாணம், மாசு என்ற இந்த வார்த்தைகள் அவர்களுடைய பெருமையை அடக்குவதற்காகவும், தேவன் தங்களை இரக்கத்திற்கு ஏற்றுக்கொண்டு, தங்கள்மேல் தயவுகாட்டி, தங்களுடைய வெட்கத்தை மூடுவதற்கு முன்பு தாங்கள் எப்படிப்பட்டவர்களாக இருந்தார்கள் என்பதைச் சிந்திக்கச் செய்வதற்காகவும் அடிக்கடி திரும்பத்திரும்பச் சொல்லப்படுகின்றன.",
     "anchor": "உன்னுடைய நிர்வாணத்தை"
    },
    {
     "id": "geneva/EZK.16.8#p2-0a6d8014",
     "text": "நீ எனக்குப் பரிசுத்தமான மனைவியாக இருக்கவேண்டும் என்றும், நான் உன்னைப் பராமரித்து உனக்கு எல்லாக் கிருபைகளையும் அளிக்கவேண்டும் என்றும் இதன் பொருள்.",
     "anchor": "உன்னுடன்"
    }
   ]
  },
  {
   "id": "geneva/EZK.16.9",
   "source_hash": "62d35496",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.16.9#p1-46abdda0",
     "text": "நான் உன் பாவங்களைக் கழுவினேன்.",
     "anchor": "தண்ணீரால் கழுவி"
    },
    {
     "id": "geneva/EZK.16.9#p2-b54bfa45",
     "text": "நான் என் பரிசுத்த ஆவியானவரால் உன்னைப் பரிசுத்தமாக்கினேன்.",
     "anchor": "எண்ணெய் பூசி"
    }
   ]
  },
  {
   "id": "geneva/EZK.16.12",
   "source_hash": "09aabbd0",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.16.12#p1-09aabbd0",
     "text": "இதன் மூலம் அவர் தம்முடைய சபையை இரட்சித்து, அதைச் செல்வவளமாக்கி, அதற்கு ஆளும் வல்லமையும் ஆளுகையும் அளித்தார் என்பதைக் காண்பிக்கிறார்.",
     "anchor": "சிங்காரமான கிரீடத்தையும்"
    }
   ]
  },
  {
   "id": "geneva/EZK.16.14",
   "source_hash": "d62a52d5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.16.14#p1-d62a52d5",
     "text": "எருசலேமின் மேன்மை எதில் இருந்தது என்பதை அவர் விளங்கப்படுத்துகிறார்: அதாவது, கர்த்தர் தம்முடைய அழகையும் மகிமையையும் அவர்களுக்குக் கொடுத்ததில் அது இருந்தது.",
     "anchor": "அழகினாலே"
    }
   ]
  },
  {
   "id": "geneva/EZK.16.15",
   "source_hash": "f5acc45e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.16.15#p1-6800e7a0",
     "text": "நான் அளித்த வரங்களை தவறாகப் பயன்படுத்தி, உன்னுடைய ஞானத்திலும் மேன்மையிலும் நம்பிக்கை வைத்ததால், அவையே உன்னுடைய விக்கிரக ஆராதனைக்கு வாய்ப்பாக இருந்தன.",
     "anchor": "உன்னுடைய அழகை நம்பி"
    },
    {
     "id": "geneva/EZK.16.15#p2-9475ef43",
     "text": "நீ உன்னைத் தீட்டுப்படுத்தாத விக்கிரக ஆராதனை ஒன்றும் இல்லை.",
     "anchor": "வழிப்போக்கர்களில் உனக்கு எதிர்பட்ட எல்லோரோடும் வேசித்தனம்செய்து"
    }
   ]
  },
  {
   "id": "geneva/EZK.16.16",
   "source_hash": "048c3481",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.16.16#p1-048c3481",
     "text": "விக்கிரக ஆராதனை செய்பவர்கள் தங்களுடைய கண்களுக்கும் வெளிப்புற உணர்வுகளுக்கும் விருப்பமான காரியங்களிலேயே தங்களுடைய முதன்மையான மகிழ்ச்சியை வைக்கிறார்கள் என்பதை இது வெளிப்படுத்துகிறது.",
     "anchor": "அவைகளின்மேல் வேசித்தனம்செய்தாய்"
    }
   ]
  },
  {
   "id": "geneva/EZK.16.17",
   "source_hash": "e932de36",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.16.17#p1-e932de36",
     "text": "நான் உன்னைச் சேவிக்கும்படி உனக்குக் கொடுத்த என்னுடைய பாத்திரங்களையும் கருவிகளையும் நீ உன்னுடைய விக்கிரகங்களின் பயனுக்காக மனமாற்றத்துடன் மாற்றிக்கொண்டாய்.",
     "anchor": "ஆண் உருவங்களை உண்டாக்கி"
    }
   ]
  },
  {
   "id": "geneva/EZK.16.20",
   "source_hash": "1df78229",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.16.20#p1-1df78229",
     "text": "நெருப்பினால் என்று பொருள்படும், லேவியராகமம் 18:21, 2 இராஜாக்கள் 23:10-ஐ வாசிக்கவும்.",
     "anchor": "இரையாக பலியிட்டாய்"
    }
   ]
  },
  {
   "id": "geneva/EZK.16.26",
   "source_hash": "98b05b0d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.16.26#p1-98b05b0d",
     "text": "முதலில் தேவனைவிட்டு விலகி அந்நிய தேசங்களிடத்தில் உதவி தேடிச் சென்ற இந்த ஜனத்தின் பெரும் அவபக்தியை அவர் இங்கே குறிக்கிறார்; அவர்கள் அதற்குப் பின்பு அவர்களுடைய நட்பை மேலும் உறுதிப்படுத்துவதற்காக அவர்களுடைய விக்கிரக ஆராதனையையே ஏற்றுக்கொண்டார்கள் என்று எண்ணினார்கள்.",
     "anchor": "அயல் தேசத்தாராகிய எகிப்திய மக்களுடன்"
    }
   ]
  },
  {
   "id": "geneva/EZK.16.31",
   "source_hash": "ac4a0ebe",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.16.31#p1-ac4a0ebe",
     "text": "சில வேசிகள் சிறிய கூலியை அலட்சியம் செய்வர்கள் என்று பொருள்; ஆனால் இஸ்ரவேலுக்கு ஒரு நேசருமே கூலி கொடுக்கவில்லை, மற்ற எல்லோருக்கும் அவர்கள் கொடுத்தார்கள் என்பதைக் குறிக்கிறது; அதாவது, விக்கிரக ஆராதனைக்காரர் தேவனிடமிருந்து அவருடைய மகிமைக்காகப் பெற்ற தங்கள் செல்வத்தையெல்லாம் தங்கள் அருவருப்பான அசுத்த வழிபாட்டைச் சேவிக்கும்படி செலவழிக்கிறார்கள்.",
     "anchor": "நீ கட்டணத்தை அலட்சியம் செய்கிறதினால்"
    }
   ]
  },
  {
   "id": "geneva/EZK.16.37",
   "source_hash": "a45ca9cb",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.16.37#p1-a45ca9cb",
     "text": "நீ உன்னுடைய நேசர்களாக நினைத்திருந்த எகிப்தியரும், அசீரியரும், கல்தேயரும் வந்து உன்னை அழிப்பார்கள், எசேக்கியேல் 23:9.",
     "anchor": "நீ நேசித்த யாவரையும்"
    }
   ]
  },
  {
   "id": "geneva/EZK.16.38",
   "source_hash": "7e3eb932",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.16.38#p1-7e3eb932",
     "text": "விபசாரிகளையும் இரத்தம் சிந்தினவர்களையும் நியாயந்தீர்க்கிறபடியே நான் உன்னை மரணத்திற்கு நியாயந்தீர்ப்பேன்.",
     "anchor": "விபசாரிகளையும் இரத்தம் சிந்தினவர்களையும்"
    }
   ]
  },
  {
   "id": "geneva/EZK.16.42",
   "source_hash": "f2586026",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.16.42#p1-f2586026",
     "text": "நான் உன்னை முழுவதுமாக அழித்து, இவ்விதமாக என்னுடைய எரிச்சல் ஓய்ந்துபோகும்.",
     "anchor": "என்னுடைய எரிச்சல் உன்னை விட்டு நீங்கும்படி"
    }
   ]
  },
  {
   "id": "geneva/EZK.16.43",
   "source_hash": "51794619",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EZK.16.43#p1-51794619",
     "text": "நான் உன்னுடைய குற்றங்களுக்குத் தண்டனை கொடுத்தேன், ஆனாலும் நீ மனந்திரும்பவில்லை.",
     "anchor": "உன்னுடைய வழியின் பலனை உன்னுடைய தலையின்மேல் சுமரச்செய்வேன்"
    }
   ]
  },
  {
   "id": "geneva/EZK.16.44",
   "source_hash": "f8095e20",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
