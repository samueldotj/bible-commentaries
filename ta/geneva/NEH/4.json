 "units": [
  {
   "id": "geneva/NEH.4.2",
   "source_hash": "ab90b6cd",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NEH.4.2#p1-34d93de3",
     "text": "சமாரியாவில் குடியிருந்த தன்னுடைய தோழர்களைக் குறித்து.",
     "anchor": "சகோதரர்களுக்கும் சமாரியாவின் படைக்கும்"
    },
    {
     "id": "geneva/NEH.4.2#p2-93538066",
     "text": "இவ்விதமாக, தேவனுடைய வல்லமை தம்முடையவர்களைக் காக்க எப்போதும் ஆயத்தமாயிருக்கிறதை நினைத்துப் பாராத துன்மார்க்கர், அவர்கள் பலவீனரும் சக்தியற்றவர்களுமாய் இருப்பதைப் போல அவர்களை ஏளனம் செய்கிறார்கள்.",
     "anchor": "அற்பமான யூதர்கள்"
    }
   ]
  },
  {
   "id": "geneva/NEH.4.4",
   "source_hash": "7d52660d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NEH.4.4#p1-8818b82d",
     "text": "தேவனுடைய பிள்ளைகள் தங்கள் சத்துருக்களின் இகழ்ச்சிக்கும் பயமுறுத்தலுக்கும் எதிராகக் கொண்டிருக்கிற மறுமருந்து இதுவே, ஜெபத்தினால் தேவனிடத்தில் ஓடிப்போவதே.",
     "anchor": "கேட்டு"
    },
    {
     "id": "geneva/NEH.4.4#p2-22a5dcb2",
     "text": "அவர்கள் கொள்ளையிடப்பட்டு சிறையாக்கப்பட்டுப் போகக்கடவர்கள்.",
     "anchor": "சிறையிருப்பின் தேசத்திலே"
    }
   ]
  },
  {
   "id": "geneva/NEH.4.5",
   "source_hash": "8125fb4f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NEH.4.5#p1-8125fb4f",
     "text": "அவர்கள் தங்களை உமக்கும் உம்முடைய சபைக்கும் விரோதமாக நிற்கவைத்திருக்கிறார்கள் என்பதை வாதைகள் உலகத்திற்குத் தெரியப்படுத்தக்கடவது; அவர் தேவனுடைய மகிமையையே கவனித்து ஜெபம்பண்ணுகிறார், எந்த சொந்தப் பற்றுதலையோ பகைமையையோ கவனித்தல்ல.",
     "anchor": "அக்கிரமத்தை"
    }
   ]
  },
  {
   "id": "geneva/NEH.4.12",
   "source_hash": "6e3d1c35",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NEH.4.12#p1-5a5a5862",
     "text": "அதாவது, அடிக்கடி.",
     "anchor": "பத்துமுறை"
    },
    {
     "id": "geneva/NEH.4.12#p2-c1ebfaed",
     "text": "செய்தி கொண்டுவந்தவர்கள் இதைச் சொன்னார்கள்: நீங்கள் உங்கள் வேலையை விட்டு, சாப்பிடவோ ஓய்வெடுக்கவோ போகும்போது, உங்கள் எதிரிகள் உங்களைத் தாக்குவார்கள்.",
     "anchor": "பல இடங்களிலுமிருந்து"
    }
   ]
  },
  {
   "id": "geneva/NEH.4.14",
   "source_hash": "27b63617",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NEH.4.14#p1-27b63617",
     "text": "அவர் தம்முடையவர்களை ஆபத்திலிருந்து விடுவிக்கும்படி எப்பொழுதும் தயாராயிருக்கிறவர்: ஆகையால் அவர்கள் தேவனுடைய மகிமையின் நிலைநிற்றலுக்காகவும், தங்கள் சொந்த உயிர்களையும் தங்களுடையவர்களுடையவற்றையும் காப்பாற்றுவதற்காகவும் யுத்தம் செய்யவேண்டியிருந்ததால், தைரியசாலிகளாய் நடக்கும்படி அவர்களை உற்சாகப்படுத்துகிறார்.",
     "anchor": "கர்த்தரை நினைத்து"
    }
   ]
  },
  {
   "id": "geneva/NEH.4.16",
   "source_hash": "22402877",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NEH.4.16#p1-22402877",
     "text": "அவர்களை மேற்கொள்வதற்கும் அவர்களுடைய வேலையில் அவர்களை உற்சாகப்படுத்துவதற்கும்.",
     "anchor": "யூதாவின் மக்கள் எல்லோருக்கும் பின்புறமாக"
    }
   ]
  },
  {
   "id": "geneva/NEH.4.20",
   "source_hash": "ca0e0324",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NEH.4.20#p1-ca0e0324",
     "text": "தேவையானால், அவர்களுடைய பகைவர்களை எதிர்க்க வேண்டும் என்பதே பொருள்.",
     "anchor": "வந்து, எங்களோடு கூடுங்கள்"
    }
   ]
  },
  {
   "id": "geneva/NEH.4.23",
   "source_hash": "fa87b2b1",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NEH.4.23#p1-fa87b2b1",
     "text": "அதாவது, அவர்கள் தங்களைச் சுத்தம் செய்துகொண்ட போது அல்லது தங்களுடைய உடைகளைத் துவைத்த போது.",
     "anchor": "கழுவுவதற்காக"
    }
   ]
  }
 ]
}
