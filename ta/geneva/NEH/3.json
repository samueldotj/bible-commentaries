    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NEH.3.30#p1-35f64ac5",
     "text": "அவனுடைய குமாரரில் ஆறாவது மகன் என்று அர்த்தம்.",
     "anchor": "சாலாபின் ஆறாவது மகனாகிய"
    }
   ]
  },
  {
   "id": "geneva/NEH.3.31",
   "source_hash": "19360320",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
