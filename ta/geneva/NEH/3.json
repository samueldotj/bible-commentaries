    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NEH.3.26#p1-ad52f81e",
     "text": "எஸ்றா 2:43-ஐப் பார்க்கவும்.",
     "anchor": "ஓபேலிலே குடியிருக்கிற நிதனீமியர்களைச்"
    }
   ]
  },
  {
   "id": "geneva/NEH.3.30",
   "source_hash": "35f64ac5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
