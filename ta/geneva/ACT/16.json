 "units": [
  {
   "id": "geneva/ACT.16.1",
   "source_hash": "f4cc3ce9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.16.1#p1-50087771",
     "text": "பவுல் தானே தீமோத்தேயுவை போதுமான சாட்சியும், சகோதரருடைய அனுமதியும் இல்லாமல் ஊழியத்தில் ஏற்றுக்கொள்ளவில்லை.",
     "anchor": "தெர்பைக்கும் லீஸ்திராவிற்கும் போனான்"
    },
    {
     "id": "geneva/ACT.16.1#p2-2b735514",
     "text": "பவுல், தீமோத்தேயுவுக்கு எழுதின இரண்டாம் கடிதத்தில், தீமோத்தேயுவின் தாயினுடையவும் பாட்டியினுடையவும் தேவபக்தியைப் புகழ்கிறார்.",
     "anchor": "யூதப்பெண்"
    }
   ]
  },
  {
   "id": "geneva/ACT.16.2",
   "source_hash": "137445fa",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.16.2#p1-137445fa",
     "text": "அவனுடைய தேவபக்திக்காகவும் நேர்மைக்காகவும்.",
     "anchor": "நற்சாட்சிப் பெற்றவனாக"
    }
   ]
  },
  {
   "id": "geneva/ACT.16.3",
   "source_hash": "588e0737",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.16.3#p1-588e0737",
     "text": "தீமோத்தேயுவுக்கு விருத்தசேதனம் செய்யப்பட்டது, ஒருபோதும் அது தேவையானதென்பதற்காக அல்ல, யூதர்களை ஆதாயப்படுத்திக்கொள்வதற்காக அக்காலத்தின் நிலைமையை மட்டும் கருதி செய்யப்பட்டது.",
     "anchor": "அவனைப் பவுல் தன்னோடுகூட கூட்டிக்கொண்டு போகவேண்டுமென்று விரும்பி"
    }
   ]
  },
  {
   "id": "geneva/ACT.16.4",
   "source_hash": "c0d71878",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.16.4#p1-b5967a64",
     "text": "பலவீனரையும் சபையின் சமாதானத்தையும் கருதி, சம்பந்தமில்லாத காரியங்களில் அன்பு காக்கப்பட வேண்டும்.",
     "anchor": "அவர்கள் பட்டணங்களுக்குப் போகும்போது"
    },
    {
     "id": "geneva/ACT.16.4#p2-41cd6295",
     "text": "இவை முந்தின அதிகாரத்தில் அவன் குறிப்பிட்ட கட்டளைகளாகும்.",
     "anchor": "விதிக்கப்பட்ட சட்டங்களைக் கைக்கொண்டு"
    }
   ]
  },
  {
   "id": "geneva/ACT.16.6",
   "source_hash": "dcaa3fad",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.16.6#p1-866decc2",
     "text": "தேவன் தமது சத்தியத்தை வெளிப்படுத்தி முன்வைப்பதற்கு குறிப்பிட்ட காலங்களை நியமித்திருக்கிறார், அதனால் தெரிந்துகொள்ளுதலும் அழைப்பும் கிருபையினால் நடைபெறும்.",
     "anchor": "நாடுகளைக் கடந்துச்சென்றபோது"
    },
    {
     "id": "geneva/ACT.16.6#p2-2252d642",
     "text": "அவர்கள் ஏன் தடைசெய்யப்பட்டார்கள் என்பதை அவர் காண்பிக்கவில்லை, அவர்கள் தடைசெய்யப்பட்டார்கள் என்பதை மட்டுமே காண்பிக்கிறார், இது நாம் விசாரிக்காமல் கீழ்ப்படிதலுடன் இருக்க வேண்டும் என்பதைப் போதிக்கிறது.",
     "anchor": "பரிசுத்த ஆவியானவராலே தடைசெய்யப்பட்டு"
    }
   ]
  },
  {
   "id": "geneva/ACT.16.9",
   "source_hash": "26a3db31",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.16.9#p1-26a3db31",
     "text": "கெட்டுப்போகும் நிலையிலிருந்தவர்களுக்கு அவர் உதவி செய்யும்படி பயன்படுத்துகிறவர்கள் நற்செய்தியின் ஊழியக்காரராகிய இவர்களே.",
     "anchor": "பவுலுக்கு ஒரு தரிசனம் உண்டானது"
    }
   ]
  },
  {
   "id": "geneva/ACT.16.10",
   "source_hash": "bf258773",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.16.10#p1-bf258773",
     "text": "பரிசுத்தவான்கள் ஒவ்வொரு தரிசனத்தையும் எளிதில் விசுவாசிக்கவில்லை.",
     "anchor": "தரிசனத்தை அவன் கண்டபோது"
    }
   ]
  },
  {
   "id": "geneva/ACT.16.13",
   "source_hash": "093b8f6a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.16.13#p1-2954e903",
     "text": "தேவன் ஒரு பெண்ணின் மனமாற்றத்தினால் மக்கெதோனியாவில் தமது ராஜ்யத்தைத் தொடங்குகிறார், இதனால் நற்செய்தியில் ஒருவரும் பட்சபாதமாக மதிக்கப்படுவதில்லை என்பதைக் காண்பிக்கிறார்.",
     "anchor": "ஓய்வுநாளில் நாங்கள்... போய்"
    },
    {
     "id": "geneva/ACT.16.13#p2-16625e43",
     "text": "அவர்கள் வழக்கமாகக் கூடிவரும் இடம்.",
     "anchor": "வழக்கமாக ஜெபம்பண்ணுகிற இடத்தில்"
    }
   ]
  },
  {
   "id": "geneva/ACT.16.14",
   "source_hash": "ddf43899",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.16.14#p1-ddf43899",
     "text": "பிரசங்கம் செய்யப்படுகிற வசனத்தைக் கேட்பதற்காக கர்த்தர் இருதயத்தைத் திறக்கிறார்.",
     "anchor": "லீதியாள் என்னும் பெயருள்ள ஒரு பெண்"
    }
   ]
  },
  {
   "id": "geneva/ACT.16.15",
   "source_hash": "1af38e60",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.16.15#p1-1af38e60",
     "text": "தேவபக்தியுள்ள ஒரு வீட்டு எஜமானியின் மாதிரி.",
     "anchor": "அவளும் அவள் குடும்பத்தில் உள்ளவர்களும் ஞானஸ்நானம் பெற்றப்பின்பு"
    }
   ]
  },
  {
   "id": "geneva/ACT.16.16",
   "source_hash": "3e9f8c45",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.16.16#p1-accccefc",
     "text": "சாத்தான் தன்னை ஒளியின் தூதனாக மாறுரூபமாக்கி, தந்திரமாக உட்புகும்படி ஆசைப்படுகிறான், ஆனால் பவுல் அவனை வெளிப்படையாக தடுத்து அவனை வெளியே தள்ளுகிறார்.",
     "anchor": "நாங்கள் ஜெபம்பண்ணுகிற இடத்திற்குப் போகும்போது"
    },
    {
     "id": "geneva/ACT.16.16#p2-794e2062",
     "text": "இது அப்பொல்லோ என்னும் தேவனுடைய நிச்சயமான அடையாளமாகும், அவன் தன்னைக் கேட்பவர்களுக்கு பதில்களைக் கொடுப்பான்.",
     "anchor": "குறிசொல்லுகிற ஆவியினால்... எங்களுக்கு எதிரே வந்தாள்"
    }
   ]
  },
  {
   "id": "geneva/ACT.16.18",
   "source_hash": "2b9bb110",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.16.18#p1-2b9bb110",
     "text": "பவுல் இந்த அற்புதத்தைச் செய்ய அவசரப்படவில்லை, ஏனெனில் அவன் ஆவியானவரால் நடத்தப்பட்டபடி எல்லாவற்றையும் செய்தான்.",
     "anchor": "பல நாட்கள்"
    }
   ]
  },
  {
   "id": "geneva/ACT.16.19",
   "source_hash": "c34517bf",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.16.19#p1-c34517bf",
     "text": "கெட்ட ஆதாயத்தின்மேலும் இலாபத்தின்மேலும் இருக்கும் பொருளாசையே சத்தியத்தைத் துன்பப்படுத்துவதற்குக் காரணமாக இருக்கிறது. இதற்கிடையில், தேவன் தீமோத்தேயுவை காப்பாற்றி, பவுலையும் சீலாவையும் அதிக பலமுள்ளவர்களாக இந்தப் போருக்கு அழைக்கிறார்.",
     "anchor": "அவளுடைய எஜமான்கள்... கண்டு"
    }
   ]
  },
  {
   "id": "geneva/ACT.16.20",
   "source_hash": "07227e7c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.16.20#p1-07227e7c",
     "text": "பொதுவான சமாதானத்தையும் தேவபக்தியையும் விரும்புவதைப்போல பேராசை பாசாங்கு செய்கிறது.",
     "anchor": "அவர்களை அதிகாரிகளிடத்தில் ஒப்படைத்து"
    }
   ]
  },
  {
   "id": "geneva/ACT.16.21",
   "source_hash": "78381ea8",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.16.21#p1-78381ea8",
     "text": "முன்னோர்களின் அதிகாரத்தைப் பயன்படுத்துவது சாத்தானுடைய ஒரு வாதமாகும், அது எந்த முன்னோர்கள் என்று சரியாக வேறுபடுத்தாதிருந்தாலும்.",
     "anchor": "பழக்கவழக்கங்களைப் போதிக்கிறார்கள்"
    }
   ]
  },
  {
   "id": "geneva/ACT.16.22",
   "source_hash": "da047fc0",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.16.22#p1-da047fc0",
     "text": "மக்களுடைய கோபத்திற்கும் கடுங்கோபத்திற்கும் கீழ்ப்படிந்த தீய அதிகாரிகளுடைய ஒரு உதாரணம்.",
     "anchor": "மக்கள் கூட்டம்கூடி"
    }
   ]
  },
  {
   "id": "geneva/ACT.16.24",
   "source_hash": "bada08f8",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.16.24#p1-bada08f8",
     "text": "அவர்கள் தப்பியோடாதபடிக்கு இன்னும் உறுதியாக இருக்கவேண்டும் என்பதற்காக, அவன் அவர்களைத் தொழுமரத்தில் உறுதியாக மாட்டிவைத்தான்.",
     "anchor": "தொழுமரத்தின் ஓட்டைகளில் மாட்டிவைத்தான்"
    }
   ]
  },
  {
   "id": "geneva/ACT.16.25",
   "source_hash": "71ae5857",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.16.25#p1-71ae5857",
     "text": "பக்தியுள்ளவர்களுடைய ஜெபம் பரலோகத்தையும் பூமியையும் அசைக்கும்.",
     "anchor": "நடுராத்திரியிலே பவுலும் சீலாவும்"
    }
   ]
  },
  {
   "id": "geneva/ACT.16.27",
   "source_hash": "0d497294",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.16.27#p1-0d497294",
