 "chapter": 23,
 "lang": "ta",
 "units": [
  {
   "id": "geneva/ACT.23.1",
   "source_hash": "c6d106c4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.23.1#p1-c6d106c4",
     "text": "பவுல் தன் விரோதிகளின் பொய்க் குற்றச்சாட்டுகளுக்கு எதிராக, தன் நல்மனச்சாட்சியை வெளிப்படுத்துகிறான்; அதற்கு அத்தாட்சியாக அவன் தன் வாழ்க்கையின் முழுவழியையும் திரும்பச் சொல்லுகிறான்.",
     "anchor": "பவுல்"
    }
   ]
  },
  {
   "id": "geneva/ACT.23.2",
   "source_hash": "98220078",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.23.2#p1-98220078",
     "text": "மாயக்காரர்கள் இறுதியில் தங்கள் கடுங்கோபத்தினாலே தங்களைத் தாங்களே காட்டிக்கொடுக்கும்படி வலியப்படுகிறார்கள்.",
     "anchor": "பிரதான ஆசாரியனாகிய அனனியா...கட்டளையிட்டான்"
    }
   ]
  },
  {
   "id": "geneva/ACT.23.3",
   "source_hash": "8840358d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.23.3#p1-0f8d3355",
     "text": "நமக்கு நேரிடும் அநியாயங்களைப் பற்றி முறையிடுவதும், துன்மார்க்கரை தேவனுடைய நியாயத்தீர்ப்பு ஆசனத்திற்கு அழைப்பதும் நமக்கு அனுமதிக்கப்பட்டதே; ஆயினும் அதை நாம் வெறுப்பில்லாமல், அமைதியும் சமாதானமுமான மனதுடன் செய்ய வேண்டும்.",
     "anchor": "அப்பொழுது பவுல் அவனைப் பார்த்து:"
    },
    {
     "id": "geneva/ACT.23.3#p2-516ff8fd",
     "text": "இது கடுமையான, வலிமையான பேச்சே, ஆனாலும் அவமதிப்பானது அல்ல; ஏனெனில் தேவபக்தியுள்ளவர்கள் கடுமையாகப் பேசலாம், ஆயினும் கடுமையான, கோபமான மனதின் கசப்பான உணர்வு அற்றவர்களாக இருக்கலாம்.",
     "anchor": "வெள்ளையடிக்கப்பட்ட சுவரே"
    },
    {
     "id": "geneva/ACT.23.3#p3-f353be35",
     "text": "ஏனெனில் நியாயப்பிரமாணம், குற்றம் சாட்டப்பட்டவனை பொறுமையாகக் கேட்கவும், நியாயத்தீர்ப்பை விவேகத்துடன் அறிவிக்கவும் நியாயாதிபதிக்குக் கட்டளையிடுகிறது.",
     "anchor": "நியாயபிரமாணத்திற்கு விரோதமாக"
    }
   ]
  },
  {
   "id": "geneva/ACT.23.5",
   "source_hash": "873ded77",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.23.5#p1-873ded77",
     "text": "அதிகாரிகள் கொடுங்கோலரானாலும், நாம் மனப்பூர்வமாகவும் இருதயத்தில் இருந்தும் அவர்களுக்கு மதிப்புக் கொடுக்க வேண்டும்.",
     "anchor": "அதற்குப் பவுல்"
    }
   ]
  },
  {
   "id": "geneva/ACT.23.6",
   "source_hash": "e3a0a632",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.23.6#p1-e3a0a632",
     "text": "சத்தியத்திற்கு இடையூறு வராதபடிக்கு, துன்மார்க்கர் தங்களுக்குள்ளே ஒருவரையொருவர் எதிர்க்கும்படி நாம் அவர்களை ஒருவர்மேல் ஒருவரை சரியான வேளையில் ஏவிவிடுவது சட்டப்பூர்வமானதாக இருக்கலாம்.",
     "anchor": "பவுல் அறிந்து"
    }
   ]
  },
  {
   "id": "geneva/ACT.23.7",
   "source_hash": "a9c95fea",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.23.7#p1-a9c95fea",
     "text": "துன்மார்க்கருடைய உடன்படிக்கை பலவீனமானது, அவர்கள் சத்தியத்தை ஒடுக்குவதற்காக ஒன்றாகக் கூடி சதி செய்தாலும்.",
     "anchor": "அவன் இப்படிச் சொன்னபோது"
    }
   ]
  },
  {
   "id": "geneva/ACT.23.8",
   "source_hash": "2fc3215c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.23.8#p1-a52504f6",
     "text": "தூதனும் ஆத்துமாவும் இல்லையென்று மறுப்பதும், மேலும் மரித்தோர் உயிர்த்தெழுதலையும் மறுப்பதும், சதுசேயர்களுடைய பழைய மதபேதம்.",
     "anchor": "சதுசேயர்கள்... சொல்லுகிறார்கள்"
    },
    {
     "id": "geneva/ACT.23.8#p2-6400f8b1",
     "text": "சரீரமில்லாமல் இருக்கிற பொருள்கள்.",
     "anchor": "தேவதூதனும்"
    }
   ]
  },
  {
   "id": "geneva/ACT.23.9",
   "source_hash": "432bd7de",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.23.9#p1-b93bf758",
     "text": "கர்த்தர், தமக்குப் பிரியமானபோது, தம்முடைய பகைவர்களுக்குள்ளும் தம்முடைய காரியத்தை ஆதரிப்பவர்களைக் காணும்படி செய்கிறார்.",
     "anchor": "மிகுந்த இரைச்சல் உண்டானது"
    },
    {
     "id": "geneva/ACT.23.9#p2-e13f418b",
     "text": "வேதபண்டிதன் என்னும் பதவி ஒரு பொது பதவியாக இருந்தது, பரிசேயன் என்னும் பெயரோ ஒரு சமயத்தாரின் பெயராக இருந்தது.",
     "anchor": "பரிசேய சமயத்தாரான வேதபண்டிதர்களில்"
    }
   ]
  },
  {
   "id": "geneva/ACT.23.10",
   "source_hash": "5a7ca0ba",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.23.10#p1-5a7ca0ba",
     "text": "தேவன் தம்முடையவர்களை முடிவுபரியந்தமும் கைவிடமாட்டார்.",
     "anchor": "அதிகமாக கலவரம் உண்டானபோது"
    }
   ]
  },
  {
   "id": "geneva/ACT.23.12",
   "source_hash": "7fada190",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.23.12#p1-ec5afbb4",
     "text": "மதிகெட்ட வைராக்கியத்தால் இழுத்துச்செல்லப்படுகிறவர்கள், தாங்கள் பொய் சொல்லலாம், கொலைசெய்யலாம், தாங்கள் விரும்பும் எந்தத் தீங்கையும் செய்யலாம் என்று நினைக்கிறார்கள்.",
     "anchor": "விடியற்காலமானபோது"
    },
    {
     "id": "geneva/ACT.23.12#p2-88092e64",
     "text": "தங்களைத் தாங்களே சபித்து, தடைசெய்துகொண்டு, அவர்கள் வாக்குத்தத்தம் செய்தார்கள்.",
     "anchor": "சபதம்பண்ணிக்கொண்டார்கள்"
    }
   ]
  },
  {
   "id": "geneva/ACT.23.15",
   "source_hash": "b19cf17e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.23.15#p1-b19cf17e",
     "text": "நீங்களும் ஆலோசனைச் சங்கத்தினரும் ஒரே காரியத்தைக் கேட்கவேண்டும்; அப்படிச் செய்தால், இது ஒரு தனிநபருடைய தனிப்பட்ட நோக்கத்தினிமித்தம் அதிபதியிடம் கேட்கப்பட்டதென்று அவர் நினைக்கமாட்டார்.",
     "anchor": "ஆலோசனைச் சங்கத்தினரோடு கூடப்போய்... ரோம அதிபதிக்குக் காண்பித்து"
    }
   ]
  },
  {
   "id": "geneva/ACT.23.17",
   "source_hash": "62588004",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.23.17#p1-62588004",
     "text": "ஆவியானவரின் ஞானமானது எளிமையுடன் இணைந்திருக்க வேண்டும்.",
     "anchor": "அப்பொழுது பவுல் நூற்றுக்கு அதிபதிகளில் ஒருவனை அழைத்து"
    }
   ]
  },
  {
   "id": "geneva/ACT.23.22",
   "source_hash": "5821a64e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.23.22#p1-5821a64e",
     "text": "கர்த்தருக்கும் அவருடைய ஊழியக்காரர்களுக்கும் விரோதமாக ஒரு ஆலோசனையும் நடக்காது.",
     "anchor": "ரோம அதிபதி"
    }
   ]
  },
  {
   "id": "geneva/ACT.23.26",
   "source_hash": "f4a57d99",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.23.26#p1-f4a57d99",
     "text": "லீசியா, கர்த்தரால் திடீரென பவுலின் பாதுகாவலனாக ஆக்கப்படுகிறார்.",
     "anchor": "கிலவுதியுலீசியா கனம்பொருந்திய தேசாதிபதியாகிய பேலிக்ஸ் என்பவருக்கு"
    }
   ]
  }
 ]
}
