 "units": [
  {
   "id": "geneva/ACT.28.1",
   "source_hash": "25d46604",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.28.1#p1-25d46604",
     "text": "இன்று நாம் மெலித்தா என்று அழைக்கிற இடம்.",
     "anchor": "மெலித்தா"
    }
   ]
  },
  {
   "id": "geneva/ACT.28.3",
   "source_hash": "01eea7f8",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.28.3#p1-01eea7f8",
     "text": "தேவபக்தியுள்ளவர்களுக்கு ஆபத்தின்மேல் ஆபத்து நிச்சயமாக வரும், ஆனாலும் அவர்களுக்கு எப்போதும் ஒரு மகிமையான முடிவு உண்டு.",
     "anchor": "பவுல் சில விறகுகளை வாரி"
    }
   ]
  },
  {
   "id": "geneva/ACT.28.4",
   "source_hash": "99b9476b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.28.4#p1-6f7317eb",
     "text": "ஆபத்து பாவத்தின் தண்டனை என்றாலும், மனிதர்களைத் தண்டிக்கும்போது தேவன் எப்பொழுதும் பாவத்தினிமித்தமே தண்டிக்கிறதில்லை என்பதைக் கண்டு, முடிவுக்காகக் காத்திராமல் அல்லது மனிதர்களை அவர்களுடைய சம்பூர்த்தியையோ ஆபத்தையோ கொண்டு நியாயந்தீர்த்து மதிக்கிறவர்கள் அவசரமாய் நியாயம் தீர்க்கிறார்கள்.",
     "anchor": "அந்தத் தீவின் மக்கள் கண்டபோது"
    },
    {
     "id": "geneva/ACT.28.4#p2-a784e40f",
     "text": "நியாயமும் தகுதியுமானது.",
     "anchor": "பழியானது இவனைப் பிழைக்க விடவில்லை"
    }
   ]
  },
  {
   "id": "geneva/ACT.28.6",
   "source_hash": "4a98e381",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.28.6#p1-2b2f5a73",
     "text": "கிரேக்கு வார்த்தை அழற்சி அடைவதையோ வீங்குவதையோ குறிக்கிறது; மேலும், டியோஸ்கோரிடிஸ் தன் ஆறாம் புத்தகம், 38-ஆம் அதிகாரத்தில், விரியன் பாம்பின் கடி உடலில் வீக்கத்தை உண்டாக்குகிறதென்று சாட்சி கொடுக்கிறார்; நிகாண்டர் தன் விஷத்திற்கான மருந்துகள் பற்றிய நூலிலும் இப்படியே சொல்கிறார்.",
     "anchor": "வீக்கங்கொண்டு"
    },
    {
     "id": "geneva/ACT.28.6#p2-f592f583",
     "text": "மெய்யான மார்க்கத்தை அறியாதவர்களைப் போல எல்லா வகையிலும் மாறிப்போகிறவர்கள் வேறு யாருமில்லை.",
     "anchor": "நெடுநேரமாகப் பார்த்துக்கொண்டிருந்தும்"
    }
   ]
  },
  {
   "id": "geneva/ACT.28.7",
   "source_hash": "466dfc28",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.28.7#p1-466dfc28",
     "text": "தேவனுடைய ஊழியனை ஏற்றுக்கொண்ட எவனுக்கும், அவன் எவ்வளவு பரிதாபமும் ஏழையுமாக இருந்தாலும், அதற்காக ஒருபோதும் வருத்தம் உண்டானதில்லை.",
     "anchor": "நிலங்கள் அந்த இடத்திற்கு அருகில் இருந்தது"
    }
   ]
  },
  {
   "id": "geneva/ACT.28.9",
   "source_hash": "d3e5b800",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.28.9#p1-d3e5b800",
     "text": "பவுல் ஒரு கட்டுண்டவனாக இருந்தபோதிலும், தேவனுடைய வல்லமை கட்டுண்டதாக இருக்கவில்லை.",
     "anchor": "இது நடந்தபின்பு"
    }
   ]
  },
  {
   "id": "geneva/ACT.28.10",
   "source_hash": "8c99f0dd",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.28.10#p1-8c99f0dd",
     "text": "தேவன் தம்முடைய பிள்ளைகளின் நிமித்தமாக அந்நியர்களுக்கு நன்மை செய்கிறார்.",
     "anchor": "அவர்கள் எங்களுக்கு அதிக மரியாதை செய்து"
    }
   ]
  },
  {
   "id": "geneva/ACT.28.11",
   "source_hash": "d4a2c27f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.28.11#p1-4b232c9e",
     "text": "விக்கிரகங்கள் பரிசுத்தவான்களைத் தீட்டுப்படுத்துவதில்லை, அவர்கள் அவற்றுக்கு ஒப்புதல் கொடுக்காதவர்களாயிருக்கிறபடியால்.",
     "anchor": "மூன்று மாதங்கள் சென்றபின்பு நாங்கள் புறப்பட்டு,"
    },
    {
     "id": "geneva/ACT.28.11#p2-fc14f7b7",
     "text": "அவர்கள் தங்கள் கப்பல்களின் முன்பகுதியை இவ்வாறு அலங்கரிப்பது வழக்கமாயிருந்தது, அதனால் அவற்றின் கப்பல்களுக்கு அத்தகைய பெயர்கள் வழங்கப்பட்டன.",
     "anchor": "மிதுனம் என்னும் அடையாளமுடைய"
    }
   ]
  },
  {
   "id": "geneva/ACT.28.14",
   "source_hash": "a81d7916",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.28.14#p1-a81d7916",
     "text": "தேவன் தமது சொந்தமானவர்களுக்குத் தயவு காண்பிக்க அவருக்கு விருப்பமானபடி, பக்தியில்லாத மனிதர்களின் இருதயங்களையும் திருப்பி வளைக்கிறார்.",
     "anchor": "அங்கே சகோதரர்களைக் கண்டோம்"
    }
   ]
  },
  {
   "id": "geneva/ACT.28.15",
   "source_hash": "84cf4502",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.28.15#p1-ba1a5f88",
     "text": "தேவன் தம்முடையவர்கள் தங்கள் பலத்திற்கு மேலாகத் துன்பப்படுவதற்கு ஒருபோதும் அனுமதிக்கமாட்டார்.",
     "anchor": "அந்த இடத்திலுள்ள"
    },
    {
     "id": "geneva/ACT.28.15#p2-49547510",
     "text": "அப்பியுபரம் என்பது குருடனாகிய அப்பியுஸ் தன் சேவகர்களின் உதவியால் அமைத்த ஒரு கல்பாவிய பாதையாகும், அது நீளமும் அகலமும் உள்ளதாய், கடல் நோக்கி நீண்டு சென்றது, அதிலே மூன்று தங்கும் விடுதிகள் இருந்தன.",
     "anchor": "அப்பியுபரம்"
    }
   ]
  },
  {
   "id": "geneva/ACT.28.16",
   "source_hash": "f9d1a5bd",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.28.16#p1-f9d1a5bd",
     "text": "பொது சிறையிலே அல்ல, தான் தனக்காக வாடகைக்கு எடுத்துக்கொண்ட ஒரு வீட்டிலே.",
     "anchor": "தன்னைக் காத்திருக்கிற போர்ச்சேவகனுடனே தனித்து"
    }
   ]
  },
  {
   "id": "geneva/ACT.28.17",
   "source_hash": "0075e464",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.28.17#p1-0075e464",
     "text": "பவுல் எல்லா இடங்களிலும் தாம் ஒரு அப்போஸ்தலன் என்பதை நினைவில் கொள்கிறார்.",
     "anchor": "மூன்று நாட்களுக்குப்பின்பு"
    }
   ]
  },
  {
   "id": "geneva/ACT.28.19",
   "source_hash": "8e51f9c6",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.28.19#p1-8e51f9c6",
     "text": "தேவன் நமக்குக் கொடுக்கும் வழிமுறைகளை நாம் பயன்படுத்தலாம், ஆனாலும் நமது சொந்த மகிமையை அல்ல, தேவனுடைய மகிமையையே நாடும் விதத்தில் அவற்றைப் பயன்படுத்த வேண்டும்.",
     "anchor": "யூதர்கள் அதற்கு எதிர்பேசினபோது"
    }
   ]
  },
  {
   "id": "geneva/ACT.28.23",
   "source_hash": "2913fad7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.28.23#p1-b7c04a66",
     "text": "நியாயப்பிரமாணமும் நற்செய்தியும் ஒன்றோடொன்று நன்றாக ஒத்துப்போகிறது.",
     "anchor": "அதற்காக அவர்கள் ஒரு நாளைக்குறித்து"
    },
    {
     "id": "geneva/ACT.28.23#p2-41c0771e",
     "text": "நல்ல ஆதாரங்களுடன், தீர்க்கதரிசிகளால் அவர்களுக்கு முன்னறிவிக்கப்பட்ட தேவனுடைய ராஜ்யம் வந்திருக்கிறது என்று நிரூபித்தான்.",
     "anchor": "தேவனுடைய ராஜ்யத்தைக்குறித்துச் சாட்சிக்கொடுத்து"
    }
   ]
  },
  {
   "id": "geneva/ACT.28.24",
   "source_hash": "8b8badb4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.28.24#p1-8b8badb4",
     "text": "நற்செய்தி விசுவாசிக்கிறவர்களுக்கு உயிருக்கான வாசனையாகவும், கீழ்ப்படியாதவர்களுக்கு மரணத்திற்கான வாசனையாகவும் இருக்கிறது.",
     "anchor": "அவன் சொன்னவைகளைச் சிலர் ஏற்றுக்கொண்டனர்"
    }
   ]
  },
  {
   "id": "geneva/ACT.28.26",
   "source_hash": "285aa568",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.28.26#p1-285aa568",
     "text": "அவிசுவாசிகள் சத்தியத்தை மனதோடு எதிர்க்கிறார்கள், ஆனாலும் அது தற்செயலாக நடக்கவில்லை.",
     "anchor": "நீங்கள் காதாரக்கேட்டும் உணராதிருப்பீர்கள்"
    }
   ]
  },
  {
   "id": "geneva/ACT.28.27",
   "source_hash": "5ee0a417",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.28.27#p1-5ee0a417",
     "text": "தாங்கள் விரும்பாதவற்றைக் கண்டும், காணாதவர்போல் நடித்தார்கள்; ஆம், அவர்கள் கண்டார்கள், ஆனாலும் காண மனதில்லாதிருந்தார்கள்.",
     "anchor": "மூடிக்கொண்டார்கள்"
    }
   ]
  },
  {
   "id": "geneva/ACT.28.28",
   "source_hash": "2847f96a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.28.28#p1-2847f96a",
     "text": "தேவனால் தள்ளப்பட்டவர்களும் கைவிடப்பட்டவர்களுமான மனுஷருடைய அவிசுவாசம் தேவனுடைய சத்தியத்தை பயனற்றதாக்கிவிட முடியாது.",
     "anchor": "உங்களுக்குத் தெரிந்திருக்கக்கடவது"
    }
   ]
  },
  {
   "id": "geneva/ACT.28.29",
   "source_hash": "367e8b21",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ACT.28.29#p1-367e8b21",
