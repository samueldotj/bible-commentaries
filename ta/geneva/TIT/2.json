 "units": [
  {
   "id": "geneva/TIT.2.1",
   "source_hash": "706ee9d0",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/TIT.2.1#p1-706ee9d0",
     "text": "ஐந்தாம் புத்திமதி: உபதேசம் பொதுவாகச் சுத்தமாயிருப்பது மட்டுமல்ல, சூழ்நிலைகளின் வேறுபாட்டிற்கேற்ப, எல்லா வயதுகளுக்கும் தரங்களுக்கும் ஏற்றபடி பொருத்தப்படவேண்டும்.",
     "anchor": "உபதேசத்திற்குரியவைகளைப் போதிக்கவேண்டும்"
    }
   ]
  },
  {
   "id": "geneva/TIT.2.2",
   "source_hash": "c4ff7d19",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/TIT.2.2#p1-c4ff7d19",
     "text": "முதிர்வயதுள்ளோருக்கும் இளையோருக்கும், ஆண்களுக்கும் பெண்களுக்கும் முதன்மையான நற்குணங்கள் யாவை: அவற்றைத் தொடர்ந்து செய்யும்படி அவர்கள் எப்படித் தூண்டப்பட வேண்டும் என்பதைக் காண்க.",
     "anchor": "முதிர்வயதுள்ள ஆண்கள் ஜாக்கிரதையுள்ளவர்களும்"
    }
   ]
  },
  {
   "id": "geneva/TIT.2.5",
   "source_hash": "e0a63994",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/TIT.2.5#p1-e0a63994",
     "text": "வெட்டியாக அலைந்து திரியாதவர்கள்.",
     "anchor": "வீட்டில் தரித்திருக்கிறவர்களும்"
    }
   ]
  },
  {
   "id": "geneva/TIT.2.7",
   "source_hash": "f0520b98",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/TIT.2.7#p1-00d5f841",
     "text": "ஆறாவது புத்திமதி: மேய்ப்பனின் வாழ்க்கையும் உபதேசமும் இரண்டும் சுத்தமாக இருக்க வேண்டும் என்பது.",
     "anchor": "எல்லாவற்றிலும் உன்னை...மாதிரியாகக் காண்பித்து"
    },
    {
     "id": "geneva/TIT.2.7#p2-f52068fc",
     "text": "மக்கள் ஊழியக்காரரிடம் வராதபடி விரட்டும் விதமான கண்ணியமல்ல, ஆனால் மிகுந்த மதிப்புடனும் நேர்மையான விதத்திலும் அவர்கள் வருவதற்குக் காரணமாகும் கண்ணியமே.",
     "anchor": "கண்ணியம்"
    }
   ]
  },
  {
   "id": "geneva/TIT.2.9",
   "source_hash": "da901e42",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/TIT.2.9#p1-a1116881",
     "text": "ஏழாவது புத்திமதி, வேலைக்காரர்கள் தங்கள் எஜமான்களுக்குச் செய்யவேண்டிய கடமையைக் குறித்தது.",
     "anchor": "வேலைக்காரர்கள்... கவரக்கூடியதாக்கும்படி"
    },
    {
     "id": "geneva/TIT.2.9#p2-14ee9eb3",
     "text": "தேவனுக்கு அவமதிப்பு இல்லாமல் செய்யக்கூடியவை.",
     "anchor": "எல்லாவிதத்திலும்"
    }
   ]
  },
  {
   "id": "geneva/TIT.2.11",
   "source_hash": "b70fb0f9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/TIT.2.11#p1-b70fb0f9",
     "text": "எட்டாவது புத்திமதி பக்தியுள்ள எல்லோருக்கும் உரியது: தேவன் எல்லா மனிதரையும் நற்செய்தியின்படி அழைக்கிறார், மேலும் கிறிஸ்து நம்மை நீதிமான்களாக்கியும், நம்மைப் பரிசுத்தமாக்கினார், ஆகையால் நாம் எல்லோரும் உண்மையான தேவபக்திக்கும் நீதிக்கும் நம்மை ஒப்புக்கொடுத்து, அந்த அளவற்ற மகிமையின் உறுதியான நம்பிக்கையை நமக்கு முன் வைத்துக்கொள்ள வேண்டும். இந்தச் செய்தி அவர்களால் இவ்வாறு கற்றுக்கொள்ளப்பட வேண்டும், அதை மறுக்கிறவர்களும் வல்லமையுள்ள தேவனுடைய அதிகாரத்தினால் கண்டிக்கப்பட வேண்டும்.",
     "anchor": "தேவகிருபையானது வெளிப்பட்டது"
    }
   ]
  },
  {
   "id": "geneva/TIT.2.12",
   "source_hash": "577e640e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/TIT.2.12#p1-577e640e",
     "text": "சரீரத்தின் இச்சைகள், அவை இந்த வாழ்க்கையின் மற்றும் உலகத்தின் இப்போதைய நிலைமைக்குச் சொந்தமானவை.",
     "anchor": "உலக இச்சைகளையும்"
    }
   ]
  },
  {
   "id": "geneva/TIT.2.13",
   "source_hash": "59f85556",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/TIT.2.13#p1-59f85556",
     "text": "இங்கே கிறிஸ்து மகா தேவன் என்று மிகத் தெளிவாகக் குறிப்பிடப்படுகிறார், மேலும் அவருடைய பிரசன்னமும் வருகையும் ஆகுபெயர் என்ற பேச்சு வழக்கினால் நமது நம்பிக்கை என்று அழைக்கப்படுகிறது.",
     "anchor": "நாம் நம்பியிருக்கிற ஆனந்தபாக்கியத்திற்கும்... எதிர்பார்த்துக்கொண்டிருக்கும்படி"
    }
   ]
  },
  {
   "id": "geneva/TIT.2.14",
   "source_hash": "75acb504",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/TIT.2.14#p1-75acb504",
     "text": "தமக்காகவே விசேஷமாகப் பிரித்து வைக்கப்பட்ட ஒரு பொருளைப் போல.",
     "anchor": "தமக்குரிய சொந்த மக்களாகவும்"
    }
   ]
  },
  {
   "id": "geneva/TIT.2.15",
   "source_hash": "47f59f6e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/TIT.2.15#p1-47f59f6e",
     "text": "முடிந்தமட்டும் எல்லா அதிகாரத்தோடும்.",
     "anchor": "எல்லா அதிகாரத்தோடும்"
    }
   ]
  }
 ]
}
