 "units": [
  {
   "id": "geneva/GEN.12.1",
   "source_hash": "676b4d2a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.12.1#p1-a9f1a80e",
     "text": "பிரளயம் முதல் இந்த நேரம் வரை நானூற்று இருபத்து மூன்று வருடங்கள் ஆயின.",
     "anchor": "உன் பிறந்த தேசத்தையும்விட்டுப் புறப்பட்டு"
    },
    {
     "id": "geneva/GEN.12.1#p2-7c7d462b",
     "text": "திட்டமான இடத்தை அவனுக்குக் குறிக்காமல், அவனுடைய விசுவாசத்தையும் கீழ்ப்படிதலையும் அதிகமாக நிரூபிக்கிறார்.",
     "anchor": "நான் உனக்குக் காண்பிக்கும் தேசத்திற்கு"
    }
   ]
  },
  {
   "id": "geneva/GEN.12.2",
   "source_hash": "52f2c56c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.12.2#p1-52f2c56c",
     "text": "கிறிஸ்துவாகிய உன் வித்தினால் உலகம், ஆதாமில் இழந்துபோன ஆசீர்வாதத்தை மீண்டும் பெறும்.",
     "anchor": "ஆசீர்வாதமாக"
    }
   ]
  },
  {
   "id": "geneva/GEN.12.5",
   "source_hash": "40987675",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.12.5#p1-40987675",
     "text": "வேலையாட்களையும் மிருகஜீவன்களையும் குறிக்கிறது.",
     "anchor": "ஆரானிலே வாங்கியிருந்த மக்களையும்"
    }
   ]
  },
  {
   "id": "geneva/GEN.12.6",
   "source_hash": "27ed853c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.12.6#p1-1362d52e",
     "text": "அவன் தங்குமிடம் கண்டடையும் முன்பே தேசத்தில் இங்கும் அங்கும் சுற்றித்திரிந்தான்: இவ்விதமாக தேவன் தம்முடைய பிள்ளைகளின் விசுவாசத்தைப் பரீட்சை செய்கிறார்.",
     "anchor": "அந்த தேசத்தில் சுற்றித்திரிந்து"
    },
    {
     "id": "geneva/GEN.12.6#p2-9372cc01",
     "text": "இது கொடிய, கலகக்காரத் தேசமாக இருந்தது; இவர்களால் தேவன் தம்முடையவரை இடைவிடாத பரீட்சையில் வைத்திருந்தார்.",
     "anchor": "கானானியர்கள் அந்த தேசத்தில் இருந்தார்கள்"
    }
   ]
  },
  {
   "id": "geneva/GEN.12.7",
   "source_hash": "b828f838",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.12.7#p1-b828f838",
     "text": "தேவனை தன் இருதயத்திலே தொழுதுகொள்வது மட்டும் அவனுக்குப் போதுமானதாக இருக்கவில்லை, மனிதர்களுக்கு முன்பாக வெளிப்படையான அறிக்கையினால் தன் விசுவாசத்தை வெளிப்படுத்துவது ஏற்றதாக இருந்தது; இந்தப் பலிபீடம் அதற்கு ஒரு அடையாளமாக இருந்தது.",
     "anchor": "யெகோவாவுக்கு அங்கே ஒரு பலிபீடத்தைக் கட்டினான்"
    }
   ]
  },
  {
   "id": "geneva/GEN.12.8",
   "source_hash": "a96763d7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.12.8#p1-5237fb74",
     "text": "அந்த துன்மார்க்க மக்களின் மத்தியில் தனக்கு நேரிட்ட கஷ்டங்களினால்.",
     "anchor": "அந்த இடத்தைவிட்டு … மலைக்குப் போய்"
    },
    {
     "id": "geneva/GEN.12.8#p2-59a8cd29",
     "text": "இவ்விதமாக மெய்யான தேவனுக்கு ஆராதனை செய்து, விக்கிரக ஆராதனை முழுவதையும் விட்டுவிட்டான்.",
     "anchor": "யெகோவாவுக்கு ஒரு பலிபீடத்தைக் கட்டி"
    }
   ]
  },
  {
   "id": "geneva/GEN.12.9",
   "source_hash": "c7664521",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.12.9#p1-c7664521",
     "text": "இவ்விதமாக தேவனுடைய பிள்ளைகள் இந்த உலகத்தில் இளைப்பாறுதலை எதிர்பார்க்கக்கூடாது, பரலோக இளைப்பாறுதலையும் அமைதியையும் எதிர்நோக்கிக் காத்திருக்க வேண்டும்.",
     "anchor": "ஆபிராம் புறப்பட்டு, தெற்கே பயணம் செய்தான்"
    }
   ]
  },
  {
   "id": "geneva/GEN.12.10",
   "source_hash": "7a269136",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.12.10#p1-7a269136",
     "text": "இது ஆபிராமின் விசுவாசத்திற்கு ஒரு புதிய சோதனையாக இருந்தது; இதனால் ஒரு உபத்திரவத்தின் முடிவு மற்றொரு உபத்திரவத்தின் ஆரம்பமாக இருக்கிறது என்பதைக் காண்கிறோம்.",
     "anchor": "தேசத்திலே பஞ்சம்"
    }
   ]
  },
  {
   "id": "geneva/GEN.12.13",
   "source_hash": "b9fd7b18",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.12.13#p1-b9fd7b18",
     "text": "நம்முடைய இரட்சிப்பிற்காக முறையற்ற வழிமுறைகளைக் கைக்கொள்ளவும், மற்றவர்களை ஆபத்தில் தள்ளவும் கூடாது என்பதை இதனால் நாம் அறிகிறோம், ஆதி. 12:20. ஆபிரகாம் மரணத்தை பயப்பட்டதற்குமேல், பிள்ளையில்லாமல் மரிப்பதற்கே பயந்தான் என்று தோன்றினாலும், அவன் தேவனுடைய வாக்குத்தத்தம் நிறைவேறியிருக்கவில்லை என்பது போலவே செய்கிறான்; அதில் பலவீனமான விசுவாசம் வெளிப்பட்டது.",
     "anchor": "சகோதரி என்று சொல்லு"
    }
   ]
  },
  {
   "id": "geneva/GEN.12.15",
   "source_hash": "6252076b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.12.15#p1-6252076b",
     "text": "அவனுக்கு மனைவியாக இருப்பதற்காக.",
     "anchor": "பார்வோனுடைய அரண்மனைக்குக் கொண்டுபோகப்பட்டாள்"
    }
   ]
  },
  {
   "id": "geneva/GEN.12.17",
   "source_hash": "eee89ee3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.12.17#p1-eee89ee3",
     "text": "கர்த்தர் இந்த ஏழை அந்நியனுக்கு ஒரு வலிமையான அரசனுக்கு எதிராகப் பாதுகாப்பு அளித்தார்; தமது சொந்தமானவர்கள்மேல் அவர் எப்பொழுதும் கருத்துடையவராயிருப்பதுபோல, சாராயையும் அவர் காப்பாற்றினார்.",
     "anchor": "கொடிய வாதைகளால் வாதித்தார்"
    }
   ]
  },
  {
   "id": "geneva/GEN.12.20",
   "source_hash": "04eda05f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.12.20#p1-04eda05f",
     "text": "அவனுடைய உடலுக்கோ அல்லது பொருள்களுக்கோ ஒருவரும் தீங்கு செய்யாதபடிக்கு.",
     "anchor": "தன்னுடைய மனிதர்களுக்குக் கட்டளை கொடுத்தான்"
    }
   ]
  }
 ]
}
