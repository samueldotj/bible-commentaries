 "units": [
  {
   "id": "geneva/GEN.34.1",
   "source_hash": "14b9b0c9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.34.1#p1-14b9b0c9",
     "text": "இந்த உதாரணம், இளவயதினருக்கு அதிக சுயாதீனம் கொடுக்கப்படக்கூடாது என்பதை நமக்குப் போதிக்கிறது.",
     "anchor": "தேசத்துப் பெண்களைப் பார்க்கப் புறப்பட்டாள்"
    }
   ]
  },
  {
   "id": "geneva/GEN.34.4",
   "source_hash": "51dee771",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.34.4#p1-51dee771",
     "text": "அவிசுவாசிகள்கூட இதைத் தவிர்க்கமுடியாத ஒரு காரியமாக கைக்கொண்டதைக் காண்கிறபோது, திருமணத்தில் பெற்றோரின் சம்மதம் அவசியம் என்பதை இது நிரூபிக்கிறது.",
     "anchor": "இந்தப் பெண்ணை எனக்குத் திருமணம் செய்துவைக்கவேண்டும்"
    }
   ]
  },
  {
   "id": "geneva/GEN.34.14",
   "source_hash": "d6d91778",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.34.14#p1-d38aa7b4",
     "text": "அவர்கள் தேவனுடைய பரிசுத்த நியமத்தைத் தங்களுடைய துன்மார்க்கமான நோக்கத்தை நிறைவேற்றுவதற்கு ஒரு வழியாகப் பயன்படுத்தினார்கள்.",
     "anchor": "நாங்கள்... கொடுக்கமுடியாது"
    },
    {
     "id": "geneva/GEN.34.14#p2-ef66e22d",
     "text": "ஞானஸ்நானம் பெற்றவர்கள் அவிசுவாசிகளுடன் இணைக்கப்படுவது அருவருப்பானதுபோல.",
     "anchor": "அது எங்களுக்கு அவமானமாயிருக்கும்"
    }
   ]
  },
  {
   "id": "geneva/GEN.34.15",
   "source_hash": "63bc8d12",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.34.15#p1-63bc8d12",
     "text": "அவர்கள் தங்கள் வஞ்சகத்தை மறைப்பதற்கு மார்க்கத்தை ஒரு போர்வையாகப் பயன்படுத்தியிருப்பதால், அவர்களுடைய குற்றம் இன்னும் அதிகமாயிருக்கிறது.",
     "anchor": "விருத்தசேதனம் செய்யப்பட்டு"
    }
   ]
  },
  {
   "id": "geneva/GEN.34.20",
   "source_hash": "223afbb7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.34.20#p1-223afbb7",
     "text": "ஏனெனில் அங்கே மக்கள் கூடிவருவது வழக்கம், மற்றும் நியாயம் விசாரிக்கப்பட்டது.",
     "anchor": "பட்டணத்து வாசலில்"
    }
   ]
  },
  {
   "id": "geneva/GEN.34.21",
   "source_hash": "42f7d82a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.34.21#p1-42f7d82a",
     "text": "இவ்விதமாக அநேகர் பொது நலனுக்காகப் பேசுவதுபோல் நடிக்கிறார்கள், ஆனால் உண்மையில் அவர்கள் தங்கள் தனிப்பட்ட ஆதாயத்திற்காகவும் வசதிக்காகவும் மட்டுமே பேசுகிறார்கள்.",
     "anchor": "நம்முடன் சமாதானமாயிருக்கிறார்கள்"
    }
   ]
  },
  {
   "id": "geneva/GEN.34.23",
   "source_hash": "54017601",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.34.23#p1-54017601",
     "text": "பொது நலனைவிட தங்களுடைய சொந்த வசதியை மேலானதாக எண்ணுகிறவர்களுக்கு எந்தவிதமான தவறான வழியும் குறைவாக இல்லை.",
     "anchor": "ஆடுமாடுகள், சொத்துக்கள்"
    }
   ]
  },
  {
   "id": "geneva/GEN.34.25",
   "source_hash": "0b00b714",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.34.25#p1-a0111b73",
     "text": "ஏனெனில் அவர்கள் அந்தக் கூட்டத்திற்குத் தலைவர்களாக இருந்தார்கள்.",
     "anchor": "சிமியோன் லேவி என்னும் இவ்விரண்டுபேரும்"
    },
    {
     "id": "geneva/GEN.34.25#p2-32e3c972",
     "text": "தங்கள் துன்மார்க்கமான அதிபதிகளின் நிமித்தம் மக்கள் தண்டிக்கப்படுகிறார்கள்.",
     "anchor": "ஆண்மக்கள் அனைவரையும்"
    }
   ]
  }
 ]
}
