 "units": [
  {
   "id": "geneva/GEN.3.1",
   "source_hash": "1860ab1b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.3.1#p1-6f224e65",
     "text": "சாத்தான் தன்னை ஒரு ஒளியின் தூதனாக மாற்றிக்கொள்ளக்கூடியவனாக இருப்பதுபோல, மனிதனை வஞ்சிப்பதற்காக பாம்பின் ஞானத்தை அவன் தவறாகப் பயன்படுத்தினான்.",
     "anchor": "காட்டு உயிரினங்களைவிட பாம்பானது தந்திரமுள்ளதாக"
    },
    {
     "id": "geneva/GEN.3.1#p2-aa0a7242",
     "text": "சாத்தானை பாம்பை தன் கருவியாகக் கொண்டு, அதன் மூலமாகப் பேசும்படி தேவன் அனுமதித்தார்.",
     "anchor": "பெண்ணை நோக்கி"
    }
   ]
  },
  {
   "id": "geneva/GEN.3.3",
   "source_hash": "361f0a6c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.3.3#p1-361f0a6c",
     "text": "தேவனுடைய எச்சரிப்பைச் சந்தேகித்ததினால் அவள் சாத்தானுக்கு இடங்கொடுத்தாள்.",
     "anchor": "சாகாமலிருக்க"
    }
   ]
  },
  {
   "id": "geneva/GEN.3.4",
   "source_hash": "0529a922",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.3.4#p1-0529a922",
     "text": "தேவனுடைய எச்சரிப்புகளுக்கு நாம் பயப்படாதபடி செய்வதே சாத்தானின் பிரதான வஞ்சகமாக இருக்கிறது.",
     "anchor": "சாவதில்லை"
    }
   ]
  },
  {
   "id": "geneva/GEN.3.5",
   "source_hash": "cc93dc85",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.3.5#p1-cc93dc85",
     "text": "அவன் சொல்வது போலிருக்கிறது: தேவன் நீங்கள் இந்தக் கனியைச் சாப்பிடுவதைத் தடைசெய்திருப்பது, நீங்கள் அதைச் சாப்பிட்டால் தம்மைப்போல இருப்பீர்கள் என்று தேவன் அறிந்திருக்கிறார் என்பதனால்தான்.",
     "anchor": "நன்மை தீமை அறிந்து"
    }
   ]
  },
  {
   "id": "geneva/GEN.3.6",
   "source_hash": "efc7a8de",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.3.6#p1-efc7a8de",
     "text": "தன் மனைவியைப் பிரியப்படுத்த வேண்டும் என்பதற்காக அல்ல, மாறாக அவளுடைய வற்புறுத்தலால் தூண்டப்பட்ட பெருமையின் நிமித்தமே.",
     "anchor": "சாப்பிட்டான்"
    }
   ]
  },
  {
   "id": "geneva/GEN.3.7",
   "source_hash": "37038a13",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.3.7#p1-37038a13",
     "text": "அவர்கள் தங்கள் பரிதவிப்பை உணரத்தொடங்கினார்கள், ஆனாலும் அவர்கள் அதற்கு நிவாரணம் பெற தேவனை நாடவில்லை.",
     "anchor": "தாங்கள் நிர்வாணிகள் என்று அறிந்து"
    }
   ]
  },
  {
   "id": "geneva/GEN.3.8",
   "source_hash": "343d4692",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.3.8#p1-343d4692",
     "text": "பாவமுள்ள மனச்சாட்சி தேவனுடைய சமுகத்தைவிட்டு விலகி ஓடுகிறது.",
     "anchor": "விலகி, தோட்டத்தின் மரங்களுக்குள்ளே ஒளிந்துகொண்டார்கள்"
    }
   ]
  },
  {
   "id": "geneva/GEN.3.10",
   "source_hash": "3d489204",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.3.10#p1-3d489204",
     "text": "தன்னுடைய நிர்வாணத்திற்குக் காரணமாக இருந்த தேவனுடைய கற்பனையின் மீறுதலை மறைத்ததில் அவனுடைய மாயமாக்கிரமம் வெளிப்படுகிறது.",
     "anchor": "நிர்வாணியாக"
    }
   ]
  },
  {
   "id": "geneva/GEN.3.12",
   "source_hash": "32541c8a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.3.12#p1-32541c8a",
     "text": "தேவன் தனக்குப் பெண்ணைக் கொடுத்ததைக் குறித்து தேவனையே குற்றப்படுத்தினதில் அவனுடைய துன்மார்க்கமும், உண்மையான மனந்திரும்புதல் இல்லாததும் காணப்படுகிறது.",
     "anchor": "என்னுடன் இருப்பதற்காக தேவரீர் தந்த"
    }
   ]
  },
  {
   "id": "geneva/GEN.3.13",
   "source_hash": "2de5a9c2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.3.13#p1-2de5a9c2",
     "text": "தன் பாவத்தை அறிக்கை செய்வதற்குப் பதிலாக, பாம்பின்மேல் குற்றத்தைச் சுமத்துவதன் மூலம் அவள் அதை அதிகரிக்கிறாள்.",
     "anchor": "பாம்பு என்னை ஏமாற்றியது"
    }
   ]
  },
  {
   "id": "geneva/GEN.3.14",
   "source_hash": "c6669a45",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.3.14#p1-dafed174",
     "text": "தேவன் ஆதாமையும் அவனுடைய மனைவியையும் அவர்களை மனந்திரும்புதலுக்குக் கொண்டுவர விரும்பினபடியால் அவர்களிடம் காரணத்தைக் கேட்டார்; ஆனால் பாம்பினிடம் அவர் அதைக் கேட்கவில்லை, ஏனெனில் அவர் அதற்கு இரக்கம் காண்பிக்க விரும்பவில்லை.",
     "anchor": "நீ இதைச் செய்ததால்"
    },
    {
     "id": "geneva/GEN.3.14#p2-13ba5f6e",
     "text": "ஒரு இழிவும் அற்பமுமான மிருகமாக, ஏசாயா 65:25.",
     "anchor": "உயிரோடிருக்கும் நாளெல்லாம் மண்ணைத் தின்பாய்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்,"
    }
   ]
  },
  {
   "id": "geneva/GEN.3.15",
   "source_hash": "c93cea9a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.3.15#p1-03c7080c",
     "text": "பாம்பு பெண்ணை ஏமாற்றியது சாத்தானின் செயலினாலும் வஞ்சனையினாலும் ஆகவே, அவர் முதன்மையாகச் சாத்தானையே குறிக்கிறார்.",
     "anchor": "உனக்கும் பெண்ணுக்கும்"
    },
    {
     "id": "geneva/GEN.3.15#p2-93985782",
     "text": "அதாவது, பாவத்தினுடையவும் மரணத்தினுடையவும் வல்லமையை.",
     "anchor": "தலையை"
    },
    {
     "id": "geneva/GEN.3.15#p3-dfd913af",
     "text": "சாத்தான் கிறிஸ்துவையும் அவருடைய அங்கத்தினரையும் குத்துவான், ஆனாலும் அவர்களை மேற்கொள்ளமாட்டான்.",
     "anchor": "குதிகாலை நசுக்குவாய்"
    }
   ]
  },
  {
   "id": "geneva/GEN.3.16",
   "source_hash": "649d1f40",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.3.16#p1-649d1f40",
     "text": "கர்த்தர் ஆசீர்வதிக்கப்பட்ட வித்தின் வாக்குத்தத்தத்தினால் ஆதாமுக்கு ஆறுதல் அளிக்கிறார், மேலும் ஆத்துமா பாவத்திற்காக அடையவேண்டிய தண்டனையை சரீரத்தின்மேல் விதிக்கிறார்; இதனால் ஆவி மன்னிப்பின் எதிர்பார்ப்பைக் கொண்டு விசுவாசத்தினால் பிழைக்கும்படியாக. 1கொரி. 14:34.",
     "anchor": "கர்ப்பவதியாக இருக்கும்போது உன் வேதனையை"
    }
   ]
  },
  {
   "id": "geneva/GEN.3.17",
   "source_hash": "36db4c6e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.3.17#p1-36db4c6e",
     "text": "தேவனுடைய கற்பனையின் மீறுதலே மனுக்குலமும் மற்ற சகல சிருஷ்டிகளும் சாபத்திற்கு உட்படுவதற்குக் காரணமாயிருந்தது.",
     "anchor": "பூமி உன்னால் சபிக்கப்பட்டிருக்கும்"
    }
   ]
  },
  {
   "id": "geneva/GEN.3.18",
   "source_hash": "a765dbdc",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.3.18#p1-a765dbdc",
     "text": "இவை பூமியின் இயற்கையான கனிகள் அல்ல, மாறாக பாவத்தின் சீர்கேட்டினின்று உண்டானவைகள்.",
     "anchor": "அது உனக்கு முட்செடிகளை முளைப்பிக்கும்"
    }
   ]
  },
  {
   "id": "geneva/GEN.3.21",
   "source_hash": "a9259af1",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.3.21#p1-a9259af1",
     "text": "அல்லது, தோல் உடைகளை உண்டாக்கிக்கொள்ளும்படி அவர்களுக்கு அறிவைக் கொடுத்தார்.",
     "anchor": "தோல் உடைகளை உண்டாக்கி"
    }
   ]
  },
  {
   "id": "geneva/GEN.3.22",
   "source_hash": "3e361266",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.3.22#p1-f72a4a02",
     "text": "இந்த ஏளனத்தினால் ஆதாம் தன் மேட்டிமையினால் விழுந்த சிக்கலான துயரத்தை நிந்தையாகக் காண்பிக்கிறார்.",
     "anchor": "இதோ"
    },
    {
     "id": "geneva/GEN.3.22#p2-f4b30cde",
     "text": "ஆதாம் உயிரை இழந்ததால், அதன் அடையாளத்தையும் இழந்தான்.",
     "anchor": "தன் கையை நீட்டி வாழ்வளிக்கும் மரத்தின் பழத்தையும் பறித்து"
    }
   ]
  }
 ]
}
