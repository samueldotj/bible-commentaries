 "units": [
  {
   "id": "geneva/GEN.44.2",
   "source_hash": "3af73b83",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.44.2#p1-3af73b83",
     "text": "தேவன் நம்மைத் தூய்மையாய் நடக்கும்படி கட்டளையிட்டிருப்பதால், இந்த உதாரணத்தைக் கொண்டு எந்தவொரு நியாயமற்ற செய்கையையும் நீதிமான்களாக்க நாம் பாடில்லை.",
     "anchor": "என் பானபாத்திரத்தையும்... போடு"
    }
   ]
  },
  {
   "id": "geneva/GEN.44.5",
   "source_hash": "f73e7ef2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.44.5#p1-f73e7ef2",
     "text": "மக்கள் அவனுக்கு ஞானபார்வையின் மூலம் தெரிந்துகொள்ளும் திறமை உண்டு என்று நினைத்ததால், அந்த அறிவு தனக்கு உண்டு என்று அவன் தன்னைப் பற்றியே சொல்லிக்கொள்கிறான்: அல்லது குறிசொல்பவர்களிடம் ஆலோசனை கேட்பதாகக் காட்டிக்கொள்கிறான்: இந்த வஞ்சகம் கண்டிக்கத்தக்கது.",
     "anchor": "ஞானபார்வையினால் அவருக்குத் தெரியாதா"
    }
   ]
  },
  {
   "id": "geneva/GEN.44.13",
   "source_hash": "e3702db4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.44.13#p1-e3702db4",
     "text": "இந்தக் காரியம் தங்களுக்கு எவ்வளவு அதிகமாக வருத்தத்தை உண்டாக்கியது என்றும், அதற்காக அவர்கள் எவ்வளவு துக்கப்பட்டார்கள் என்றும் காண்பிப்பதற்காக.",
     "anchor": "தங்கள் உடைகளைக் கிழித்துக்கொண்டு"
    }
   ]
  },
  {
   "id": "geneva/GEN.44.16",
   "source_hash": "dcda90b9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.44.16#p1-dcda90b9",
     "text": "நமது துன்பத்திற்குத் தெளிவான காரணம் நமக்குத் தெரியாதிருக்கும்போது, நம்முடைய பாவங்களுக்காக நம்மை நீதியாக தண்டிக்கிற தேவனுடைய மறைவான ஆலோசனையை நோக்கிப் பார்ப்போம்.",
     "anchor": "அக்கிரமத்தை தேவன் விளங்கச்செய்தார்"
    }
   ]
  },
  {
   "id": "geneva/GEN.44.18",
   "source_hash": "8cb5fed5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.44.18#p1-8cb5fed5",
     "text": "அதிகாரத்தில் சமமானவர், அல்லது ராஜாவுக்கு அடுத்தவர்.",
     "anchor": "பார்வோனுக்கு ஒப்பாயிருக்கிறீர்"
    }
   ]
  },
  {
   "id": "geneva/GEN.44.27",
   "source_hash": "a3c626d7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.44.27#p1-a3c626d7",
     "text": "ராகேல் யாக்கோபுக்கு யோசேப்பையும் பென்யமீனையும் பெற்றெடுத்தாள்.",
     "anchor": "என் மனைவி எனக்கு இரண்டு பிள்ளைகளைப் பெற்றெடுத்தாள்"
    }
   ]
  },
  {
   "id": "geneva/GEN.44.29",
   "source_hash": "bfe8b0bd",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.44.29#p1-bfe8b0bd",
     "text": "நீங்கள் என்னை வியாகுலத்தால் மரிக்கச்செய்வீர்கள்.",
     "anchor": "என் நரைமுடியை வியாகுலத்தோடு பாதாளத்தில் இறங்கச் செய்வீர்கள்"
    }
   ]
  },
  {
   "id": "geneva/GEN.44.34",
   "source_hash": "d2841fef",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.44.34#p1-d2841fef",
     "text": "அதாவது, தன் தகப்பனிடத்திற்குத் திரும்பிப்போய் அவர் துக்கத்தில் இருப்பதைக் காண்பதைவிட, தாம் அவர்களுடைய கைதியாகவே இருந்துவிடுவது நலம் என்று அவன் கருதினான்.",
     "anchor": "எப்படி என் தகப்பனிடத்திற்குப் போவேன்"
    }
   ]
  }
 ]
}
