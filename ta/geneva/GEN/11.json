 "units": [
  {
   "id": "geneva/GEN.11.2",
   "source_hash": "e8317ac9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.11.2#p1-d2e5453f",
     "text": "ஜலப்பிரவாகத்திற்குப் பின் நூற்று முப்பது வருடங்களுக்குப் பின்.",
     "anchor": "பயணம்செய்யும்போது"
    },
    {
     "id": "geneva/GEN.11.2#p2-44497e30",
     "text": "அதாவது, நிம்ரோதும் அவனுடைய கூட்டமும்.",
     "anchor": "மக்கள்"
    },
    {
     "id": "geneva/GEN.11.2#p3-d74ac1a8",
     "text": "அதாவது, பேழை நின்ற ஆர்மேனியாவிலிருந்து.",
     "anchor": "கிழக்கேயிருந்து"
    },
    {
     "id": "geneva/GEN.11.2#p4-f9a7af1a",
     "text": "இது பின்பு கல்தேயா என்று அழைக்கப்பட்டது.",
     "anchor": "சிநெயார்"
    }
   ]
  },
  {
   "id": "geneva/GEN.11.4",
   "source_hash": "bd323f33",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.11.4#p1-bd323f33",
     "text": "அவர்கள் தேவனுடைய கனத்திற்குப் பதிலாகத் தங்கள் சொந்த மகிமையை விரும்பி, பெருமையினாலும் ஆசையினாலும் தூண்டப்பட்டார்கள்.",
     "anchor": "நமக்கு ஒரு நகரத்தையும், வானத்தைத் தொடுமளவு ஒரு கோபுரத்தையும் கட்டி"
    }
   ]
  },
  {
   "id": "geneva/GEN.11.5",
   "source_hash": "2e74f69a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.11.5#p1-2e74f69a",
     "text": "பொருள்: தேவன் அவர்களுடைய துன்மார்க்கமான திட்டத்தை அறிந்திருந்தார் என்பதைத் தமது செயலின் மூலம் வெளிப்படுத்தினார் என்பதே; ஏனெனில் தேவனுடைய வல்லமை எங்கும் நிறைந்திருக்கிறது, அது ஏறுவதுமில்லை, இறங்குவதுமில்லை.",
     "anchor": "பார்க்கிறதற்குக் யெகோவா இறங்கினார்"
    }
   ]
  },
  {
   "id": "geneva/GEN.11.6",
   "source_hash": "59600219",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.11.6#p1-59600219",
     "text": "தேவன் இதை அவர்களுடைய மதியீனமான எண்ணத்தையும் செயலையும் குறித்து ஏளனமாகச் சொல்கிறார்.",
     "anchor": "இதோ"
    }
   ]
  },
  {
   "id": "geneva/GEN.11.7",
   "source_hash": "6e00ec22",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.11.7#p1-3d95e54e",
     "text": "தமது ஞானத்தோடும் வல்லமையோடும் ஆலோசனை செய்தார் என்பது போல அவர் பேசுகிறார்: அதாவது, குமாரனோடும் பரிசுத்த ஆவியானவரோடும்: இது தண்டனையின் பெரிமையையும் நிச்சயத்தையும் குறிக்கிறது.",
     "anchor": "நாம் இறங்கிப்போய்"
    },
    {
     "id": "geneva/GEN.11.7#p2-bddca098",
     "text": "மொழிகளின் இந்தக் குழப்பமான பெரிய வாதையினால் மனுஷனுடைய பெருமையையும் வீணான மகிமையையும் விரோதித்த தேவனுடைய பயங்கரமான நியாயத்தீர்ப்பு வெளிப்படுகிறது.",
     "anchor": "அங்கே அவர்கள் மொழியைத் தாறுமாறாக்குவோம்"
    }
   ]
  },
  {
   "id": "geneva/GEN.11.10",
   "source_hash": "f5017711",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.11.10#p1-f5017711",
     "text": "அவன் ஆபிராமின் வரலாற்றிற்கு வருவதற்காக சேமுடைய வம்சவரலாற்றிற்குத் திரும்புகிறான்; இதிலே தேவனுடைய சபை விவரிக்கப்படுகிறது, இதுவே மோசேயின் முதன்மையான நோக்கமாகும்.",
     "anchor": "சேமுடைய வம்சவரலாறு"
    }
   ]
  },
  {
   "id": "geneva/GEN.11.27",
   "source_hash": "ee7947b5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.11.27#p1-ee7947b5",
     "text": "அவன் முதன்முதலாக ஆபிராமைக் குறிப்பிடுகிறான், அவன் மூத்த மகனாக இருந்ததால் அல்ல, மாறாக அவனைப் பற்றியே சரித்திரம் முக்கியமாக எழுதப்படுவதால். மேலும் பாஷைகள் குழம்பியபோது ஆபிராமுக்கு 43 வயதாக இருந்தது, ஏனெனில் சோதோம் அழிக்கப்பட்டபோது அவனுக்கு 99 வயதாக இருந்தது, அது பாஷைகள் குழம்பிய 52 வருடங்களுக்குப் பின்பு அழிக்கப்பட்டது.",
     "anchor": "ஆபிராம்"
    }
   ]
  },
  {
   "id": "geneva/GEN.11.29",
   "source_hash": "9bea2dab",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.11.29#p1-9bea2dab",
     "text": "இந்த இஸ்காள் சாராய் என்று சிலர் நினைக்கிறார்கள்.",
     "anchor": "இஸ்காளுக்கும்"
    }
   ]
  },
  {
   "id": "geneva/GEN.11.31",
   "source_hash": "a38f7ae0",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.11.31#p1-bcbd15fd",
     "text": "தேவனுடைய அருளுரை ஆபிராமுக்கு வந்தபோதிலும், தேராகு தகப்பனாக இருந்தபடியால் அந்தக் கனம் அவனுக்குக் கொடுக்கப்பட்டிருக்கிறது.",
     "anchor": "தேராகு தன் மகனாகிய ஆபிராமையும்"
    },
    {
     "id": "geneva/GEN.11.31#p2-baabddab",
     "text": "இது மெசொப்பொத்தாமியாவின் ஒரு பட்டணமாயிருந்தது.",
     "anchor": "ஆரான்"
    }
   ]
  }
 ]
}
