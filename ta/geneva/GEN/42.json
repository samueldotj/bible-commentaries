 "units": [
  {
   "id": "geneva/GEN.42.1",
   "source_hash": "5a864736",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.42.1#p1-3f094d52",
     "text": "இந்த வரலாறு எல்லாவற்றையும் தேவன் தம்முடைய சபையின் நன்மைக்காகத் தமது பராமரிப்பினாலே நடத்துகிறார் என்பதை தெளிவாகக் காண்பிக்கிறது.",
     "anchor": "எகிப்திலே தானியம் உண்டென்று யாக்கோபு அறிந்து"
    },
    {
     "id": "geneva/GEN.42.1#p2-92ac555a",
     "text": "ஆலோசனையற்றவர்கள் செய்வதுபோல.",
     "anchor": "நீங்கள் ஒருவர் முகத்தை ஒருவர் பார்த்துக்கொண்டிருக்கிறது"
    }
   ]
  },
  {
   "id": "geneva/GEN.42.7",
   "source_hash": "f683eea1",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.42.7#p1-f683eea1",
     "text": "இந்த மறைத்தல் பின்பற்றப்படக்கூடியது அல்ல, அன்றியும் இந்த தகப்பனுடைய செய்கைகளில் தேவனுடைய வார்த்தையினால் அங்கீகரிக்கப்படாத எந்தச் செயலும் பின்பற்றப்படக்கூடாது.",
     "anchor": "தெரிந்தும் தெரியாதவன்போலக் கடினமாக அவர்களோடு பேசி"
    }
   ]
  },
  {
   "id": "geneva/GEN.42.15",
   "source_hash": "9080824a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.42.15#p1-9080824a",
     "text": "விக்கிரக ஆராதனை செய்கிறவர்களாகிய எகிப்தியர் தங்கள் அரசனுடைய ஜீவனைக்கொண்டு ஆணையிடும் வழக்கமுள்ளவர்கள்: ஆனாலும் தேவனை அல்லாமல் வேறொருவரையும் கொண்டு ஆணையிடுவதைத் தேவன் தடைசெய்கிறார்: ஆயினும் யோசேப்பு துன்மார்க்கருடைய நடுவே குடியிருந்தபடியால் அவர்களால் கெட்டுப்போனான்.",
     "anchor": "பார்வோனின் ஜீவனைக்கொண்டு ஆணையிட்டுச் சொல்லுகிறேன்"
    }
   ]
  },
  {
   "id": "geneva/GEN.42.18",
   "source_hash": "5e03b735",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.42.18#p1-5e03b735",
     "text": "ஆகையால் நான் உண்மையும் நீதியும் உள்ளவன்.",
     "anchor": "தேவனுக்குப் பயப்படுகிறவன்"
    }
   ]
  },
  {
   "id": "geneva/GEN.42.21",
   "source_hash": "a3a3479e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.42.21#p1-a3a3479e",
     "text": "துன்பம் மனிதர்களை, மற்றப்படி மறைத்து வைத்திருக்கும் தங்கள் குற்றங்களை அறிக்கை செய்யத் தூண்டுகிறது.",
     "anchor": "நம்முடைய சகோதரனுக்கு நாம் செய்த துரோகம்"
    }
   ]
  },
  {
   "id": "geneva/GEN.42.22",
   "source_hash": "47717d83",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.42.22#p1-47717d83",
     "text": "தேவன் நம்மிடத்தில் பழிவாங்குவார், நம்மை நம்முடைய அளவைக்கொண்டே அளப்பார்.",
     "anchor": "இரத்தப்பழி வாங்கப்படுகிறது"
    }
   ]
  },
  {
   "id": "geneva/GEN.42.24",
   "source_hash": "313eebf4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.42.24#p1-313eebf4",
     "text": "அவன் கடினமாக நடந்துகொண்டாலும், அவனுடைய சகோதர பாசம் மாறவில்லை.",
     "anchor": "அழுது"
    }
   ]
  },
  {
   "id": "geneva/GEN.42.28",
   "source_hash": "b1f029a7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.42.28#p1-b1f029a7",
     "text": "அவர்களுடைய மனச்சாட்சி அவர்களுடைய பாவத்தை உணர்த்தியபடியால், அந்தப் பணத்தின் மூலமாக தேவன் தங்களுக்குத் தொல்லையைக் கொண்டுவந்தார் என்று அவர்கள் நினைத்தார்கள்.",
     "anchor": "பயந்து"
    }
   ]
  },
  {
   "id": "geneva/GEN.42.36",
   "source_hash": "a7b3a02d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.42.36#p1-a7b3a02d",
     "text": "ஏனெனில் அவர்கள் தங்கள் சகோதரனிடத்தில் எந்தக் கவலையோ அன்போ காட்டவில்லை என்பது தோன்றியது, இது அவனுடைய துக்கத்தை இன்னும் அதிகரித்தது; மற்றும் தோன்றுகிறபடி, யோசேப்பின் காரியத்தில் அவன் அவர்களை சந்தேகித்தான் என்பதும் ஒரு காரணமாயிருந்தது.",
     "anchor": "என்னை"
    }
   ]
  }
 ]
}
