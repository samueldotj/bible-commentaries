 "units": [
  {
   "id": "geneva/GEN.18.2",
   "source_hash": "c53e9e58",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.18.2#p1-c53e9e58",
     "text": "அதாவது, மனித உருவில் இருந்த மூன்று தூதர்கள்.",
     "anchor": "மனிதர்கள் அவனுக்கு எதிரே நின்றார்கள்"
    }
   ]
  },
  {
   "id": "geneva/GEN.18.3",
   "source_hash": "0b150561",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.18.3#p1-0b150561",
     "text": "அவர்களை மனிதர்களாக நினைத்ததால், அவர்களில் மிகவும் மகிமையுள்ளவராகத் தோன்றியவரிடம் பேசுகிறான்.",
     "anchor": "ஆண்டவரே"
    }
   ]
  },
  {
   "id": "geneva/GEN.18.4",
   "source_hash": "b339bc91",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.18.4#p1-b339bc91",
     "text": "ஏனெனில் அந்தத் தேசங்களில் வெப்பத்தினிமித்தம் மனிதர் வெறும் பாதத்தோடே நடக்கும் வழக்கமாக இருந்தார்கள்.",
     "anchor": "கால்களைக் கழுவி"
    }
   ]
  },
  {
   "id": "geneva/GEN.18.5",
   "source_hash": "47bbfa02",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.18.5#p1-47bbfa02",
     "text": "நான் உங்களுக்கு எனது கடமையைச் செய்யும்படி தேவனால் அனுப்பப்பட்டவர்களைப்போல.",
     "anchor": "அடியேனுடைய இடம்வரைக்கும் வந்தீர்கள்"
    }
   ]
  },
  {
   "id": "geneva/GEN.18.8",
   "source_hash": "560b1cde",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.18.8#p1-560b1cde",
     "text": "தேவன் அவர்களுக்கு சிலகாலம் சரீரங்களைக் கொடுத்தது போலவே, நடக்கவும், சாப்பிடவும், குடிக்கவும், அப்படிப்பட்டவைகளையும் செய்வதற்கான தன்மைகளையும் அவர்களுக்குக் கொடுத்தார்.",
     "anchor": "அவர்கள் சாப்பிட்டார்கள்"
    }
   ]
  },
  {
   "id": "geneva/GEN.18.10",
   "source_hash": "24643a30",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.18.10#p1-24643a30",
     "text": "அதாவது, அவள் உயிரோடிருக்கும் இந்தக் காலத்தில், அல்லது பிள்ளை இந்த வாழ்க்கைக்கு வரும் காலத்தில்.",
     "anchor": "கர்ப்பகாலத்திட்டத்தில்"
    }
   ]
  },
  {
   "id": "geneva/GEN.18.12",
   "source_hash": "5b714fce",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.18.12#p1-5b714fce",
     "text": "ஏனெனில் அவள் தேவனுடைய வாக்குத்தத்தத்தை விசுவாசிக்காமல், இயற்கையின் ஒழுங்கையே விசுவாசித்தாள்.",
     "anchor": "தன் உள்ளத்திலே சிரித்து"
    }
   ]
  },
  {
   "id": "geneva/GEN.18.17",
   "source_hash": "e25ade90",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.18.17#p1-e25ade90",
     "text": "யெகோவா என்ற எபிரெய வார்த்தையை நாம் கர்த்தர் என்று அழைக்கிறோம், இது இந்தத் தூதனானவர் கிறிஸ்துவே என்பதைக் காண்பிக்கிறது; ஏனெனில் இந்த வார்த்தை தேவனுக்கு மட்டுமே பயன்படுத்தப்படுகிறது.",
     "anchor": "யெகோவா"
    }
   ]
  },
  {
   "id": "geneva/GEN.18.19",
   "source_hash": "a2526f94",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.18.19#p1-a2526f94",
     "text": "தேவனுடைய நியாயத்தீர்ப்புகளைப் பிதாக்கள் அறிந்திருக்கவும், அவைகளைத் தங்கள் பிள்ளைகளுக்கு அறிவிக்கவும் வேண்டுமென்று இவ்விடத்தில் காண்பிக்கிறார்.",
     "anchor": "தன் பிள்ளைகளுக்கும்... கட்டளையிடுவான்"
    }
   ]
  },
  {
   "id": "geneva/GEN.18.21",
   "source_hash": "1e48936f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.18.21#p1-3d0bec3a",
     "text": "தேவன் மனிதர் பேசும் விதத்தில் பேசுகிறார்: அதாவது, நான் நல்ல ஆலோசனையுடன் நியாயத்தீர்ப்பினுள் பிரவேசிப்பேன்.",
     "anchor": "நான் இறங்கிப்போய்"
    },
    {
     "id": "geneva/GEN.18.21#p2-01a6e929",
     "text": "ஏனெனில் நம்முடைய பாவங்கள் யாரும் நமக்கு விரோதமாகக் குற்றம் சாட்டாவிட்டாலும் பழிவாங்குதலுக்காக கூக்குரல் இடுகின்றன.",
     "anchor": "என்னிடத்தில் வந்து எட்டின அதின் கூக்குரல்"
    }
   ]
  },
  {
   "id": "geneva/GEN.18.26",
   "source_hash": "a83fa509",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.18.26#p1-a83fa509",
     "text": "தமது நியாயத்தீர்ப்புகள் மிகுந்த இரக்கத்தோடு செய்யப்பட்டதென்று தேவன் அறிவிக்கிறார், எல்லோரும் மிகவும் சீர்கெட்டவர்களாக இருந்தபடியால் அங்கே ஐம்பது நீதிமான்கள் மாத்திரமல்ல, பத்துப்பேராகிலும் காணப்படவில்லை என்பதையும், நீதிமான்களினிமித்தம் துன்மார்க்கர்கள் தப்புவிக்கப்படுகிறார்கள் என்பதையும் காண்பிக்கிறார்.",
     "anchor": "ஐம்பது நீதிமான்களை"
    }
   ]
  },
  {
   "id": "geneva/GEN.18.27",
   "source_hash": "192e8530",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.18.27#p1-192e8530",
     "text": "நாம் தேவனிடம் அதிகமாக நெருங்கிச் செல்லச் செல்ல, நமது துன்பமான நிலைமை அதிகமாக வெளிப்படுகிறது, அதிகமாக நாம் தாழ்த்தப்படுகிறோம் என்பதை இதினால் கற்றுக்கொள்கிறோம்.",
     "anchor": "தூளும் சாம்பலுமாயிருக்கிற"
    }
   ]
  },
  {
   "id": "geneva/GEN.18.32",
   "source_hash": "757a6334",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.18.32#p1-757a6334",
     "text": "துன்மார்க்கமான சோதோமியருக்காகச் செய்யப்பட்ட ஜெபத்தை ஆறாம் விண்ணப்பம்வரை தேவன் மறுக்கவில்லை என்றால், துன்பப்படுகின்ற சபைக்காக தேவபக்தியுள்ளவர்கள் செய்யும் ஜெபத்தை அவர் இன்னும் எவ்வளவு அதிகமாய் அங்கீகரிப்பார்!",
     "anchor": "ஒருமுறை"
    }
   ]
  }
 ]
}
