 "units": [
  {
   "id": "geneva/GEN.43.1",
   "source_hash": "92be8c7a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.43.1#p1-92be8c7a",
     "text": "தேவன் தன்னை ஆசீர்வதிப்பதாக வாக்குத்தத்தம் செய்திருந்த தேசத்திலே இப்படிப்பட்ட பெரிய பஞ்சத்தை அனுபவிக்க வேண்டியது யாக்கோபுக்குப் பெரிய சோதனையாக இருந்தது.",
     "anchor": "தேசத்திலே பஞ்சம் கொடிதாயிருந்தது"
    }
   ]
  },
  {
   "id": "geneva/GEN.43.12",
   "source_hash": "d49af109",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.43.12#p1-d49af109",
     "text": "நாம் தேவைநிலையிலோ ஆபத்திலோ இருக்கும்போது, நம் நிலைமையையும் நிலையையும் மேம்படுத்த நேர்மையான வழிமுறைகளைப் பயன்படுத்துவதைத் தேவன் தடைசெய்யவில்லை.",
     "anchor": "பணத்தை இருமடங்கு உங்கள் கைகளில்"
    }
   ]
  },
  {
   "id": "geneva/GEN.43.14",
   "source_hash": "7a7908da",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.43.14#p1-993d610c",
     "text": "நமது முதன்மையான நம்பிக்கை தேவனில் இருக்கவேண்டுமே அன்றி இவ்வுலக வழிமுறைகளில் அல்ல.",
     "anchor": "சர்வவல்லமையுள்ள தேவன் அவனுடைய சமுகத்தில் உங்களுக்கு இரக்கம் கிடைக்கச் செய்வாராக"
    },
    {
     "id": "geneva/GEN.43.14#p2-c5b76e59",
     "text": "இவ்வார்த்தைகளை அவன் மனமுறிவினால் ஏற்படும் ஆற்றாமையினால் அல்ல, தன் மகன்கள் தங்கள் சகோதரனுடன் திரும்பிவர அதிக எச்சரிக்கையுள்ளவர்களாக இருக்கும்படிச் சொல்லுகிறான்.",
     "anchor": "நானோ பிள்ளையில்லாதவனைப்போல் இருப்பேன்"
    }
   ]
  },
  {
   "id": "geneva/GEN.43.18",
   "source_hash": "4c60be8b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.43.18#p1-4c60be8b",
     "text": "தேவனுடைய நியாயத்தீர்ப்பு அவர்கள் மனச்சாட்சியின்மேல் சுமையாக இருந்தது.",
     "anchor": "பயந்து"
    }
   ]
  },
  {
   "id": "geneva/GEN.43.23",
   "source_hash": "7a7885cb",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.43.23#p1-7a7885cb",
     "text": "எகிப்தின் சீர்கேடு இருந்தபோதிலும், யோசேப்பு தன் குடும்பத்தாருக்கு தேவனுக்குப் பயப்படும்படி கற்றுக்கொடுத்தான்.",
     "anchor": "உங்கள் தேவனும்"
    }
   ]
  },
  {
   "id": "geneva/GEN.43.29",
   "source_hash": "944e9c5b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.43.29#p1-944e9c5b",
     "text": "ஏனெனில் இவ்விருவர் மட்டுமே ராகேலினால் பெறப்பட்டவர்கள்.",
     "anchor": "தன் தாய் பெற்ற மகனாகிய தன் சகோதரன்"
    }
   ]
  },
  {
   "id": "geneva/GEN.43.32",
   "source_hash": "ac00b002",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.43.32#p1-fd80b3fb",
     "text": "அவனுடைய கண்ணியத்தைக் குறிக்கும்படி.",
     "anchor": "அவனுக்குத் தனியாகவும்"
    },
    {
     "id": "geneva/GEN.43.32#p2-81ec5fcf",
     "text": "மூட நம்பிக்கைகளின் இயல்பே, தங்களைத்தவிர மற்ற எல்லோரையும் குற்றவாளியாக்குவதே.",
     "anchor": "எகிப்தியருக்கு அருவருப்பாயிருக்கும்"
    }
   ]
  },
  {
   "id": "geneva/GEN.43.34",
   "source_hash": "a158fbff",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.43.34#p1-a158fbff",
     "text": "சில நேரங்களில் இந்த வார்த்தை \"வெறிக்கிறது\" என்று அர்த்தப்படும், ஆனால் இங்கே அவர்களுக்குப் போதுமானதாக இருந்து, சிறந்த திராட்சரசத்தில் குடித்தார்கள் என்பதைக் குறிக்கிறது.",
     "anchor": "குடித்து, அவனோடு சந்தோஷமாயிருந்தார்கள்"
    }
   ]
  }
 ]
}
