 "units": [
  {
   "id": "geneva/GEN.21.2",
   "source_hash": "b562207f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.21.2#p1-b562207f",
     "text": "ஆகையால் அற்புதம் இன்னும் பெரிதாக இருந்தது.",
     "anchor": "முதிர்வயதாக"
    }
   ]
  },
  {
   "id": "geneva/GEN.21.7",
   "source_hash": "6bb07cfb",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.21.7#p1-6bb07cfb",
     "text": "தான் தூதனை விசுவாசிக்காதிருந்ததற்காகத் தன்னைத்தானே நன்றியில்லாதவள் என்று குற்றஞ்சாட்டுகிறாள்.",
     "anchor": "ஆபிரகாமுக்கு யார் சொல்லுவான்"
    }
   ]
  },
  {
   "id": "geneva/GEN.21.9",
   "source_hash": "da58e068",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.21.9#p1-da58e068",
     "text": "அவன் ஈசாக்குக்குச் செய்யப்பட்ட தேவனுடைய வாக்குத்தத்தத்தை ஏளனம் செய்தான்; இதை அப்போஸ்தலன் துன்பப்படுத்துதல் என்று அழைக்கிறார் கலாத்தியர் 4:29.",
     "anchor": "கேலி செய்கிறதை"
    }
   ]
  },
  {
   "id": "geneva/GEN.21.12",
   "source_hash": "75f3bff2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.21.12#p1-75f3bff2",
     "text": "வாக்குத்தத்தம்பண்ணப்பட்ட சந்ததி ஈசாக்கின் வழியாக உண்டாகும், இஸ்மவேலின் வழியாக அல்ல, ரோமர் 9:7, எபிரெயர் 11:18.",
     "anchor": "ஈசாக்கின் வழியாக உன் சந்ததி தோன்றும்"
    }
   ]
  },
  {
   "id": "geneva/GEN.21.13",
   "source_hash": "c760b517",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.21.13#p1-c760b517",
     "text": "இஸ்மாயேலியர் அவனிலிருந்து உண்டாவார்கள்.",
     "anchor": "ஒரு தேசமாக்குவேன்"
    }
   ]
  },
  {
   "id": "geneva/GEN.21.14",
   "source_hash": "1b2da349",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.21.14#p1-1b2da349",
     "text": "மெய்யான விசுவாசம், தேவனுடைய கற்பனைக்குக் கீழ்ப்படிவதற்காக இயல்பான பாசங்கள் அனைத்தையும் விட்டுவிடும்.",
     "anchor": "அனுப்பிவிட்டான்"
    }
   ]
  },
  {
   "id": "geneva/GEN.21.17",
   "source_hash": "b9dad491",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.21.17#p1-b9dad491",
     "text": "ஆபிரகாமுக்குச் செய்யப்பட்ட வாக்குத்தத்தத்தினிமித்தம்; சிறுவனுக்கு ஜெபம்பண்ணுவதற்கான விவேகமும் நியாயத்தீர்ப்பும் இருந்ததினால் அல்ல.",
     "anchor": "சிறுவனின் சத்தத்தைக் கேட்டார்"
    }
   ]
  },
  {
   "id": "geneva/GEN.21.19",
   "source_hash": "5fb15b96",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.21.19#p1-5fb15b96",
     "text": "தேவன் நம்முடைய கண்களைத் திறக்காதவரையில், நம்முடைய முன்னிலையில் இருக்கிற வழிவகைகளைக் காணவும், அவற்றைப் பயன்படுத்தவும் நமக்குக் கூடாது.",
     "anchor": "கண்களைத் திறந்தார்"
    }
   ]
  },
  {
   "id": "geneva/GEN.21.20",
   "source_hash": "cebc74f3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.21.20#p1-cebc74f3",
     "text": "வெளிப்படையான காரியங்களைப் பொருத்தமட்டில் தேவன் அவனை வர்த்திக்கச்செய்தார்.",
     "anchor": "சிறுவனுடனே இருந்தார்"
    }
   ]
  },
  {
   "id": "geneva/GEN.21.24",
   "source_hash": "688408dd",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.21.24#p1-688408dd",
     "text": "ஆகையால், முக்கியமான காரியங்களில் சத்தியத்தை நீதிமானாக்கவும், நம்முடைய உண்மையான நோக்கத்தை மற்றவர்களுக்கு உறுதிப்படுத்தவும் ஆணையிட்டுக்கொடுப்பது நியாயமான காரியமாக இருக்கிறது.",
     "anchor": "ஆணையிட்டுக்கொடுக்கிறேன்"
    }
   ]
  },
  {
   "id": "geneva/GEN.21.26",
   "source_hash": "1a5424a4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.21.26#p1-1a5424a4",
     "text": "துன்மார்க்கமான வேலைக்காரர்கள் தங்கள் எஜமான்களுக்குத் தெரியாமல் அநேக தீமைகளைச் செய்கிறார்கள்.",
     "anchor": "செய்தவன் யார் என்று எனக்குத் தெரியாது"
    }
   ]
  },
  {
   "id": "geneva/GEN.21.32",
   "source_hash": "7d1edf4e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.21.32#p1-7d1edf4e",
     "text": "இவ்விதமாக தேவபக்தியுள்ளவர்கள், வெளிப்புற காரியங்களைப் பொறுத்தமட்டில், மெய்யான தேவனை அறியாத துன்மார்க்கரோடும் சமாதானம் செய்துகொள்ளலாம் என்று காண்கிறோம்.",
     "anchor": "பெயெர்செபாவிலே உடன்படிக்கை"
    }
   ]
  },
  {
   "id": "geneva/GEN.21.33",
   "source_hash": "f5e544f7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.21.33#p1-f5e544f7",
     "text": "அதாவது, அவன் மெய்யான தேவபக்திக்குரிய எல்லா அம்சங்களிலும் தேவனைத் தொழுதுகொண்டான்.",
     "anchor": "நாமத்தை அந்த இடத்தில் தொழுதுகொண்டான்"
    }
   ]
  }
 ]
}
