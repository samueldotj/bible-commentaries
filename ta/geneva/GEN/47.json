 "units": [
  {
   "id": "geneva/GEN.47.2",
   "source_hash": "e8276a9a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.47.2#p1-e8276a9a",
     "text": "அவர்கள் வந்திருக்கிறார்கள் என்று ராஜா உறுதியாக அறியும்படிக்கும், அவர்கள் எப்படிப்பட்டவர்கள் என்று காணும்படிக்குமே.",
     "anchor": "ஐந்துபேரை"
    }
   ]
  },
  {
   "id": "geneva/GEN.47.6",
   "source_hash": "b1e3e637",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.47.6#p1-b1e3e637",
     "text": "ராஜாவின் கற்பனையின்படியல்லாமல் யோசேப்பு எதையும் செய்ய முயலாதிருந்ததில் அவனுடைய பெருந்தன்மை காணப்படுகிறது.",
     "anchor": "எகிப்துதேசம் உனக்கு முன்பாக இருக்கிறது"
    }
   ]
  },
  {
   "id": "geneva/GEN.47.11",
   "source_hash": "9287d944",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.47.11#p1-9287d944",
     "text": "இது கோசேன் நாட்டிலுள்ள ஒரு பட்டணமாக இருந்தது, யாத்திராகமம் 1:11.",
     "anchor": "ராமசேஸ்"
    }
   ]
  },
  {
   "id": "geneva/GEN.47.12",
   "source_hash": "548c727b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.47.12#p1-548c727b",
     "text": "சிலர் இதை, அந்தப் பஞ்சத்திற்கு எதிராகத் தங்களுக்குத் தானே ஏற்பாடு செய்துகொள்ள முடியாதிருந்தபடியால், சிறு குழந்தைகளைப் போல அவர்களுக்கு உணவளித்தான் என்று வாசிக்கிறார்கள்.",
     "anchor": "அவரவர்கள் குடும்பத்திற்குத்தக்கதாக"
    }
   ]
  },
  {
   "id": "geneva/GEN.47.14",
   "source_hash": "f2970066",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.47.14#p1-f2970066",
     "text": "இதில் அவன் ராஜாவுக்குத் தன் உண்மையையும், தான் பொருளாசை இல்லாதவன் என்பதையும் வெளிப்படுத்துகிறான்.",
     "anchor": "அதைப் பார்வோன் அரண்மனையிலே கொண்டுபோய்ச் சேர்த்தான்"
    }
   ]
  },
  {
   "id": "geneva/GEN.47.19",
   "source_hash": "f1609f3f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.47.19#p1-f1609f3f",
     "text": "ஏனெனில் நிலம் பண்படுத்தப்பட்டு விதைக்கப்படாவிட்டால், அது பாழாகி இறந்துபோனது போலாகும்.",
     "anchor": "நிலங்கள்"
    }
   ]
  },
  {
   "id": "geneva/GEN.47.21",
   "source_hash": "83a59b67",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.47.21#p1-83a59b67",
     "text": "இந்த இடமாற்றத்தினால், தங்களுக்கென்று சொந்தமாக ஒன்றுமில்லை, எல்லாவற்றையும் ராஜாவின் தயவினால் பெற்றுக்கொண்டார்கள் என்பதைக் குறிக்கின்றனர்.",
     "anchor": "அந்தந்தப் பட்டணங்களில் குடிமாறிப்போகச்செய்தான்"
    }
   ]
  },
  {
   "id": "geneva/GEN.47.26",
   "source_hash": "5ce9f93c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.47.26#p1-5ce9f93c",
     "text": "விக்கிரக ஆசாரியர்களைக் கவனித்து ஏற்பாடு செய்த பார்வோன், தேவனுடைய வார்த்தையின் உண்மையான ஊழியக்காரரைப் புறக்கணிக்கிற எல்லோருக்கும் ஆக்கினைத்தீர்ப்பாக இருப்பான்.",
     "anchor": "ஆசாரியரின் நிலம் மாத்திரம்"
    }
   ]
  },
  {
   "id": "geneva/GEN.47.30",
   "source_hash": "f436f259",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.47.30#p1-f436f259",
     "text": "இதினாலே அவன் தன் பிதாக்களின் விசுவாசத்திலே மரணமடைந்தான் என்றும், தன் பிள்ளைகளுக்கு வாக்குத்தத்தத்தின் தேசத்தை எதிர்பார்த்திருக்கும்படி கற்பித்தான் என்றும் காண்பித்தான்.",
     "anchor": "நான் என் பிதாக்களோடு படுத்துக்கொள்ளவேண்டும்"
    }
   ]
  },
  {
   "id": "geneva/GEN.47.31",
   "source_hash": "f8994ed3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.47.31#p1-f8994ed3",
     "text": "யோசேப்பு தனக்கு வாக்குத்தத்தம் செய்தான் என்று அவன் மகிழ்ந்தான், மேலும் தன் தலையணைமேல் தன்னைத் தூக்கிக்கொண்டு, தேவனைத் துதித்தான்; 1 நாளாகமம் 29:10.",
     "anchor": "கை கோலில் சாய்ந்து தொழுதுகொண்டான்"
    }
   ]
  }
 ]
}
