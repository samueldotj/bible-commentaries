 "units": [
  {
   "id": "geneva/GEN.31.1",
   "source_hash": "a2ea811f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.31.1#p1-a2ea811f",
     "text": "தகப்பன் தன் இருதயத்தில் மறைத்து வைத்திருந்ததை மகன்கள் வார்த்தைகளாக வெளிப்படுத்தினார்கள்; ஏனெனில் பொருளாசைக்காரர் தங்களால் எடுத்துக்கொள்ளக்கூடாத எதையும், தங்களிடமிருந்து எடுத்துக்கொள்ளப்பட்டதாகவே நினைக்கிறார்கள்.",
     "anchor": "லாபானுடைய மகன்கள்... சொன்ன வார்த்தைகளை"
    }
   ]
  },
  {
   "id": "geneva/GEN.31.5",
   "source_hash": "05d1ffa5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.31.5#p1-05d1ffa5",
     "text": "என் தகப்பன்மார் தொழுதுகொண்ட தேவன்.",
     "anchor": "என் தகப்பனுடைய தேவன் என்னோடுகூட இருக்கிறார்"
    }
   ]
  },
  {
   "id": "geneva/GEN.31.9",
   "source_hash": "1a2d8bef",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.31.9#p1-1a2d8bef",
     "text": "யாக்கோபு முன்பு செய்தது தேவனுடைய கற்பனையினாலேயே செய்யப்பட்டது, வஞ்சனையினால் அல்ல என்பதை இது காண்பிக்கிறது.",
     "anchor": "தேவன்...ஆடுகளை எடுத்து"
    }
   ]
  },
  {
   "id": "geneva/GEN.31.13",
   "source_hash": "7e619f37",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.31.13#p1-7e619f37",
     "text": "இந்தத் தூதன் யாக்கோபுக்குப் பெத்தேலில் காட்சியளித்த கிறிஸ்துவே: இதனால் அவன் தன் மனைவிகளுக்குத் தேவனுக்குப் பயப்படுதலைப் போதித்திருந்தான் என்று தெரிகிறது; ஏனெனில் அவர்கள் இதை அறிந்திருந்தார்கள் என்பது போலவே அவன் பேசுகிறான்.",
     "anchor": "பெத்தேலிலே உனக்குக் காட்சியளித்த தேவன் நானே"
    }
   ]
  },
  {
   "id": "geneva/GEN.31.15",
   "source_hash": "97edb64c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.31.15#p1-97edb64c",
     "text": "ஏனெனில் அவர்கள் யாக்கோபுக்குத் அவனுடைய வேலைக்கான ஊதியமாகக் கொடுக்கப்பட்டார்கள், அது ஒருவகையான விற்பனையாக இருந்தது.",
     "anchor": "விற்று"
    }
   ]
  },
  {
   "id": "geneva/GEN.31.19",
   "source_hash": "47438b92",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.31.19#p1-47438b92",
     "text": "இங்குள்ள வார்த்தை அப்படியாகவே அர்த்தப்படுகிறது, ஏனெனில் லாபான் அவைகளைத் தேவன் என்று அழைக்கிறான், ஆதியாகமம் 31:30.",
     "anchor": "தன் தகப்பனுடைய வீட்டிலிருந்த சிலைகளை"
    }
   ]
  },
  {
   "id": "geneva/GEN.31.29",
   "source_hash": "d75eeb6d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.31.29#p1-d75eeb6d",
     "text": "அவன் விக்கிரக ஆராதனை செய்பவனாக இருந்தபடியால், யாக்கோபுடைய தேவனை தன் தேவனாக ஏற்றுக்கொள்ள மனதில்லாதிருந்தான்.",
     "anchor": "உங்கள் தகப்பனுடைய தேவன் சொன்னார்"
    }
   ]
  },
  {
   "id": "geneva/GEN.31.42",
   "source_hash": "58e20631",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.31.42#p1-58e20631",
     "text": "அதாவது, ஈசாக்கு பயந்து மதித்த தேவன்.",
     "anchor": "ஈசாக்கின் பயபக்திக்குரியவர்"
    }
   ]
  },
  {
   "id": "geneva/GEN.31.44",
   "source_hash": "593cf369",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.31.44#p1-593cf369",
     "text": "அவனுடைய மனச்சாட்சி யாக்கோபுக்குத் தான் செய்த தவறான நடத்தையினிமித்தம் அவனைக் கடிந்துகொண்டது, அதனால் அவன் சமாதானத்தைத் தேடும்படி தூண்டப்பட்டான்.",
     "anchor": "நீயும் நானும் உடன்படிக்கை செய்துகொள்ளலாம்"
    }
   ]
  },
  {
   "id": "geneva/GEN.31.47",
   "source_hash": "dbc8b79c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.31.47#p1-dbc8b79c",
     "text": "ஒருவன் அந்த இடத்திற்குச் சீரிய மொழியிலும், மற்றொருவன் எபிரெய மொழியிலும் பெயரிட்டான்.",
     "anchor": "கலயெத்"
    }
   ]
  },
  {
   "id": "geneva/GEN.31.49",
   "source_hash": "acb4dd35",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.31.49#p1-acb4dd35",
     "text": "குற்றம் செய்பவனைத் தண்டிப்பதற்கு.",
     "anchor": "நடுவில் நின்று கண்காணிப்பாராக"
    }
   ]
  },
  {
   "id": "geneva/GEN.31.50",
   "source_hash": "8951818d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.31.50#p1-8951818d",
     "text": "தன் ஆசையினிமித்தம் யாக்கோபை எந்தத் தவறு செய்யும்படி நிர்ப்பந்தித்தானோ, அந்தத் தவறுக்கு ஆக்கினைத்தீர்ப்பு கொடுக்கும்படி இயல்பே அவனை நிர்ப்பந்திக்கிறது.",
     "anchor": "என் மகள்களையல்லாமல் வேறு மனைவிகளை"
    }
   ]
  },
  {
   "id": "geneva/GEN.31.53",
   "source_hash": "415ffbc5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.31.53#p1-0a1a2bc8",
     "text": "விக்கிரக ஆராதனை செய்கிறவர்கள் மெய்யான தேவனை தங்கள் பொய்யான தெய்வங்களோடு எப்படிக் கலந்துவிடுகிறார்கள் என்பதைப் பாரும்.",
     "anchor": "நாகோரின் தேவனும்"
    },
    {
     "id": "geneva/GEN.31.53#p2-c1e8f3b3",
     "text": "ஈசாக்கு தொழுதுகொண்ட மெய்யான தேவனைக் குறிக்கிறது.",
     "anchor": "தன் தகப்பனாகிய ஈசாக்கின் பயபக்திக்குரியவர்மேல்"
    }
   ]
  },
  {
   "id": "geneva/GEN.31.55",
   "source_hash": "aa15527d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.31.55#p1-aa15527d",
     "text": "துன்மார்க்கருடைய இருதயங்களிலும் தேவனை அறியும் அறிவின் விதை எப்பொழுதும் இருக்கிறது என்று நாம் காண்கிறோம்.",
     "anchor": "ஆசீர்வதித்தான்"
    }
   ]
  }
 ]
}
