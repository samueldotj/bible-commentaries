 "units": [
  {
   "id": "geneva/GEN.48.1",
   "source_hash": "6fb44b2f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.48.1#p1-6fb44b2f",
     "text": "தேவனுடைய சபையாக இருந்த யாக்கோபின் குடும்பத்தில் தன் பிள்ளைகள் ஏற்றுக்கொள்ளப்படுவதை, எகிப்தின் எல்லாப் பொக்கிஷங்களையும் அனுபவிப்பதைவிட, யோசேப்பு அதிக மதிப்புள்ளதாகக் கருதினான்.",
     "anchor": "இரண்டு மகன்களாகிய"
    }
   ]
  },
  {
   "id": "geneva/GEN.48.4",
   "source_hash": "3ec6e5cf",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.48.4#p1-3ec6e5cf",
     "text": "இது கிறிஸ்துவின் வருகைவரை சரீரத்திற்குரிய இஸ்ரவேலிலும், ஆவிக்குரிய இஸ்ரவேலில் நித்தியமாகவும் உண்மையாயிருக்கும்.",
     "anchor": "என்றென்றைக்கும் சொந்தமாக"
    }
   ]
  },
  {
   "id": "geneva/GEN.48.9",
   "source_hash": "49f8f482",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.48.9#p1-49f8f482",
     "text": "உண்மையுள்ளவர்கள் எல்லா நன்மைகளும் தேவனுடைய சுயாதீன இரக்கத்திலிருந்தே வருகிறது என்று அறிக்கிறார்கள்.",
     "anchor": "தேவன் எனக்கு அருளின"
    }
   ]
  },
  {
   "id": "geneva/GEN.48.14",
   "source_hash": "e4735c06",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.48.14#p1-e4735c06",
     "text": "தேவனுடைய நியாயத்தீர்ப்புகள் பெரும்பாலும் மனுஷனுடைய நியாயத்தீர்ப்புகளுக்கு எதிரானவை; மனுஷன் அற்பமாக எண்ணுவதையே அவர் விரும்புகிறார்.",
     "anchor": "எப்பிராயீமுடைய தலையின்மேலும்"
    }
   ]
  },
  {
   "id": "geneva/GEN.48.16",
   "source_hash": "d7504956",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.48.16#p1-eff48686",
     "text": "இந்தத் தூதன் கிறிஸ்துவாகவே கருதப்படவேண்டும், ஆதியாகமம் 31:13, 32:1-ல் இருப்பதுபோல.",
     "anchor": "எல்லாத் தீமைக்கும் விலக்கி என்னை மீட்ட தூதனுமானவர்"
    },
    {
     "id": "geneva/GEN.48.16#p2-924a8bb4",
     "text": "இவர்கள் என் பிள்ளைகளாகவே எண்ணப்படக்கடவது.",
     "anchor": "என் பெயரும்...இவர்களுக்கு வைக்கப்படக்கடவது"
    }
   ]
  },
  {
   "id": "geneva/GEN.48.17",
   "source_hash": "ed730bff",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.48.17#p1-ed730bff",
     "text": "தேவனுடைய கிருபையை இயற்கையின் முறைமையோடு கட்டுவதினால் யோசேப்பு தவறு செய்கிறார்.",
     "anchor": "பிரியமில்லாததால்"
    }
   ]
  },
  {
   "id": "geneva/GEN.48.20",
   "source_hash": "7bcfdde9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.48.20#p1-7bcfdde9",
     "text": "தேவனுடைய கிருபைகள் வெளிப்படையாக விளங்கும்படியானவர்கள்.",
     "anchor": "எப்பிராயீமைப்போலவும் மனாசேயைப்போலவும்"
    }
   ]
  },
  {
   "id": "geneva/GEN.48.21",
   "source_hash": "9ed16a31",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.48.21#p1-9ed16a31",
     "text": "அவர்கள் இதைப் பெற்றது வாக்குத்தத்தத்தில் விசுவாசம் வைத்ததினாலேயே.",
     "anchor": "உங்கள் பிதாக்களின் தேசத்திற்கு"
    }
   ]
  },
  {
   "id": "geneva/GEN.48.22",
   "source_hash": "bf5b18fd",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.48.22#p1-bf5b18fd",
     "text": "என் நிமித்தமாக தேவன் காப்பாற்றிய என் பிள்ளைகளினால்.",
     "anchor": "சம்பாதித்த"
    }
   ]
  }
 ]
}
