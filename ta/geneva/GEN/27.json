 "units": [
  {
   "id": "geneva/GEN.27.4",
   "source_hash": "7e95a505",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.27.4#p1-7e95a505",
     "text": "தன் மகனுக்குக் கொண்டிருந்த சரீரத்திற்குரிய பாசம் தேவன் அவனுடைய மனைவியிடம் சொன்னதை அவன் மறந்துபோகும்படி செய்தது. ஆதியாகமம் 25:23.",
     "anchor": "என் ஆத்துமா உன்னை ஆசீர்வதிக்கவும், என்னிடத்தில்"
    }
   ]
  },
  {
   "id": "geneva/GEN.27.9",
   "source_hash": "762e2071",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.27.9#p1-762e2071",
     "text": "தேவன் தம்முடைய வாக்குத்தத்தத்தை நிறைவேற்றுவதற்குக் காத்திருக்க வேண்டியிருந்தபடியால், இந்தச் சூழ்ச்சி குற்றமுள்ளதாக இருக்கிறது.",
     "anchor": "நீ ஆட்டுமந்தைக்குப் போய்"
    }
   ]
  },
  {
   "id": "geneva/GEN.27.13",
   "source_hash": "56d0a1a8",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.27.13#p1-56d0a1a8",
     "text": "தேவனுடைய கட்டளையின் நிச்சயமுமாக அவளைத் தைரியப்படுத்தியது.",
     "anchor": "உன்மேல் வரும் சாபம் என்மேல் வரட்டும்"
    }
   ]
  },
  {
   "id": "geneva/GEN.27.19",
   "source_hash": "2dff1098",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.27.19#p1-2dff1098",
     "text": "யாக்கோபு இந்த ஆசீர்வாதத்தை விசுவாசத்தினால் நிச்சயமாக அறிந்திருந்தபோதிலும், அதைப் பொய்யினால் பெறத் தேடினதினால் அவன் தீமை செய்தான்; தேவனுடைய நாமத்தை அதன் மூலமாக அவமதித்ததினால் அது இன்னும் அதிக தீமையாயிற்று.",
     "anchor": "நான் உமது மூத்த மகனாகிய ஏசா"
    }
   ]
  },
  {
   "id": "geneva/GEN.27.22",
   "source_hash": "ebe4ce17",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.27.22#p1-ebe4ce17",
     "text": "இது அவன் ஏதோ சந்தேகித்தான் என்பதைக் காட்டுகிறது, ஆனாலும் தேவன் தம்முடைய கட்டளை மாறுவதற்கு இடங்கொடுக்கவில்லை.",
     "anchor": "சத்தம் யாக்கோபின் சத்தம்"
    }
   ]
  },
  {
   "id": "geneva/GEN.27.33",
   "source_hash": "ae02fc94",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.27.33#p1-ae02fc94",
     "text": "முன்பே தேவன் சொல்லியிருந்த தீர்மானத்திற்கு எதிராகத் தான் சுயதீர்மானமாக ஆசீர்வாத வாரிசு நியமித்ததின் தன் தவறை உணர்ந்ததினால்.",
     "anchor": "மிகவும் அதிர்ச்சியடைந்து நடுங்கி"
    }
   ]
  },
  {
   "id": "geneva/GEN.27.36",
   "source_hash": "ecdaafa1",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.27.36#p1-ecdaafa1",
     "text": "ஆதியாகமம் 25:26-ல் இவனுக்கு அப்படிப் பெயரிடப்பட்டது, அவன் தன் சகோதரனைக் கீழே தள்ளுவதுபோல அவனுடைய குதிகாலைப் பிடித்திருந்ததால்; ஆகவே இங்கே இவன் தள்ளுகிறவன், அல்லது ஏமாற்றுகிறவன் என்று அழைக்கப்படுகிறான்.",
     "anchor": "யாக்கோபு என்பது சரியல்லவா?, இதோடு இரண்டுமுறை என்னை ஏமாற்றினான்;"
    }
   ]
  },
  {
   "id": "geneva/GEN.27.37",
   "source_hash": "85bd901e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.27.37#p1-85bd901e",
     "text": "ஈசாக்கு இதைத் தேவனுடைய ஊழியக்காரனாகவும் தீர்க்கதரிசியாகவும் இருந்தபடியால் செய்தான்.",
     "anchor": "h"
    }
   ]
  },
  {
   "id": "geneva/GEN.27.40",
   "source_hash": "8851b670",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.27.40#p1-8f4cca4d",
     "text": "ஏனெனில் உன் சத்துருக்கள் உன்னைச் சுற்றிலும் இருப்பார்கள்.",
     "anchor": "உன் ஆயுதத்தால் நீ பிழைத்து"
    },
    {
     "id": "geneva/GEN.27.40#p2-7435dfa8",
     "text": "இது அவனுடைய சந்ததியாராகிய ஏதோமியரில் நிறைவேறியது: அவர்கள் ஒரு காலம்வரை இஸ்ரவேலுக்குக் கப்பம் செலுத்துவோராயிருந்து, பின்பு விடுதலைபெற்றார்கள்.",
     "anchor": "உன் சகோதரனுக்குப் பணிவிடை செய்வாய்"
    }
   ]
  },
  {
   "id": "geneva/GEN.27.41",
   "source_hash": "d5fef2a0",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.27.41#p1-d5fef2a0",
     "text": "மாயக்காரர் மனுஷரின் பயத்தினிமித்தமே பொல்லாங்கு செய்யாமல் விலகியிருப்பார்கள்.",
     "anchor": "கொன்றுபோடுவேன்"
    }
   ]
  },
  {
   "id": "geneva/GEN.27.42",
   "source_hash": "e7d5f4f3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.27.42#p1-e7d5f4f3",
     "text": "உன்னைக் கொன்றுபோட்டு தன் தலைமைத்தன்மையை மீண்டும் பெற்றுக்கொள்ளலாம் என்று அவன் எதிர்பார்க்கிறான்.",
     "anchor": "உன்னைக் கொன்றுபோட"
    }
   ]
  },
  {
   "id": "geneva/GEN.27.45",
   "source_hash": "cabf72a6",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.27.45#p1-cabf72a6",
     "text": "ஏனெனில் துன்மார்க்கமான மகன் தேவபக்தியுள்ள மகனைக் கொலைசெய்வான்; பின்பு தேவனுடைய வாதை அந்த துன்மார்க்க மகன்மேல் வரும்.",
     "anchor": "இருவரையும் இழந்துபோகவேண்டும்"
    }
   ]
  },
  {
   "id": "geneva/GEN.27.46",
   "source_hash": "25663d6d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.27.46#p1-c24c228c",
     "text": "ஏசாவின் மனைவிகள் யார் என்பது.",
     "anchor": "ஏத்தின் பெண்களில்"
    },
    {
     "id": "geneva/GEN.27.46#p2-ac8a96d6",
     "text": "இதினால் அவள் யாக்கோபு புறப்பட்டுப்போவதற்கு ஈசாக்கை சம்மதிக்கும்படி வற்புறுத்தினாள்.",
     "anchor": "என் உயிர் இருந்து என்ன பயன்"
    }
   ]
  }
 ]
}
