   "paragraphs": [
    {
     "id": "geneva/GEN.46.1#p1-8013a8ee",
     "text": "இதனால் தான் மெய்யான தேவனை தொழுதுகொண்டதையும், அந்நேரத்தில் தேவைக்காக விட்டுச்செல்ல வேண்டியிருந்த அந்த தேசத்தை உரிமையாக்கிக்கொள்ளும் நினைவை தன் இருதயத்தில் வைத்திருந்ததையும் அவன் காண்பித்தான்.",
     "anchor": "தேவனுக்குப் பலியிட்டான்"
    }
   ]
  },
  {
   "id": "geneva/GEN.46.4",
   "source_hash": "6153bd76",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.46.4#p1-05677da4",
     "text": "என் வல்லமையினால் உன்னை நடத்திக்கொண்டு.",
     "anchor": "நான் உன்னுடனே எகிப்திற்கு வருவேன்"
    },
    {
     "id": "geneva/GEN.46.4#p2-f4e73f18",
     "text": "உன் சந்ததியில்.",
     "anchor": "நான் உன்னைத் திரும்பவும் வரச்செய்வேன்"
    },
    {
     "id": "geneva/GEN.46.4#p3-dacd848a",
     "text": "நீ மரிக்கும்போது உன் கண்களை மூடுவான்: இது சந்ததியில் மிகவும் அருமையானவனுக்கு அல்லது தலைவனுக்கு உரிமையானது.",
     "anchor": "தன் கையால் உன் கண்களை மூடுவான்"
    }
   ]
  },
  {
   "id": "geneva/GEN.46.32",
   "source_hash": "53248109",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.46.32#p1-53248109",
     "text": "அவர்கள் அற்பமான நிலையில் இருந்தும், அவன் தன் தகப்பனையும் தன் குடும்பத்தையும் குறித்து வெட்கப்படவில்லை.",
     "anchor": "மேய்ப்பர்கள்"
    }
   ]
  },
  {
   "id": "geneva/GEN.46.34",
   "source_hash": "c2612363",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.46.34#p1-c2612363",
     "text": "தேவன் உலகம் தம்முடையவர்களைப் பகைக்க அனுமதிக்கிறார், அதனால் அவர்கள் உலகத்தின் அசுத்தத்தைத் தள்ளிவிட்டு, அவரைப் பற்றிக்கொள்வார்கள்.",
     "anchor": "எகிப்தியருக்கு அருவருப்பாக"
    }
   ]
  }
 ]
}
