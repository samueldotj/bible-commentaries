 "units": [
  {
   "id": "geneva/GEN.6.2",
   "source_hash": "6641c848",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.6.2#p1-8144c755",
     "text": "தேவபக்தியுள்ளவர்களின் பிள்ளைகள் சீர்கெடத் தொடங்கினார்கள்.",
     "anchor": "தேவனுடைய மகன்கள் ... மகள்களைக் கண்டு"
    },
    {
     "id": "geneva/GEN.6.2#p2-6cb3fbce",
     "text": "காயீனிடமிருந்து வந்ததுபோல, துன்மார்க்கமான பெற்றோர்களைக் கொண்டவர்கள்.",
     "anchor": "மனிதர்களுடைய"
    },
    {
     "id": "geneva/GEN.6.2#p3-62ee22bd",
     "text": "அவர்களுடைய நடத்தையையும் தேவபக்தியையும் விட, அவர்களுடைய அழகையும் இவ்வுலகக் கவலைகளையும் அதிகமாகக் கருதி.",
     "anchor": "அழகுள்ளவர்கள்"
    }
   ]
  },
  {
   "id": "geneva/GEN.6.3",
   "source_hash": "b2f9c448",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.6.3#p1-8595eacd",
     "text": "தேவன் மனிதனை வெல்ல முயற்சித்த தமது நீடிய பொறுமையினாலும் பொறுமையினாலும் மனிதன் வெல்லப்படாமலிருந்தபடியால், அவர் இனி தமது கோபாக்கினையை அடக்கமாட்டார்.",
     "anchor": "பொருதுக்கொள்வது"
    },
    {
     "id": "geneva/GEN.6.3#p2-3aa130e3",
     "text": "பூமியை அழிக்கும் முன்பாக மனிதன் மனந்திரும்புவதற்கு தேவன் கொடுத்த காலம் இது, 1 பேதுரு 3:20.",
     "anchor": "120 வருடங்கள்"
    }
   ]
  },
  {
   "id": "geneva/GEN.6.4",
   "source_hash": "5b2d4b07",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.6.4#p1-5b2d4b07",
     "text": "இவர்கள் மற்றவர்கள்மேல் அதிகாரத்தைக் கைப்பற்றி, தங்கள் முற்பிதாக்கள் வாழ்ந்த எளிமையிலிருந்து விலகினார்கள்.",
     "anchor": "பிரசித்திபெற்ற"
    }
   ]
  },
  {
   "id": "geneva/GEN.6.6",
   "source_hash": "3091a142",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.6.6#p1-3091a142",
     "text": "தேவன் ஒருபோதும் மனந்திரும்புவதில்லை, ஆனால் அவர் மனித வழக்கத்தில் பேசுகிறார், ஏனெனில் அவர் அவனை அழித்தார், அந்த வகையில் அவனை தமது சிருஷ்டியாக மறுத்தார் என்பதைக் காட்டும்படியே இப்படிச் சொல்லப்பட்டிருக்கிறது.",
     "anchor": "யெகோவா மனவேதனை அடைந்தார்"
    }
   ]
  },
  {
   "id": "geneva/GEN.6.7",
   "source_hash": "9bc0f645",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.6.7#p1-9bc0f645",
     "text": "பாவத்தின்மேல் தேவனுக்கிருக்கும் அருவருப்பு எவ்வளவு பெரிதென்பதை, அதற்கான தண்டனை மிருகங்கள்வரை பரவுவதைக்கண்டு, தேவன் வெளிப்படுத்துகிறார்.",
     "anchor": "மிருகங்கள்"
    }
   ]
  },
  {
   "id": "geneva/GEN.6.8",
   "source_hash": "1e32b001",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.6.8#p1-1e32b001",
     "text": "தேவன் அவனிடத்தில் இரக்கமாய் இருந்தார்.",
     "anchor": "கண்களில் கிருபை கிடைத்தது"
    }
   ]
  },
  {
   "id": "geneva/GEN.6.11",
   "source_hash": "2ff1451f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.6.11#p1-2ff1451f",
     "text": "அதாவது, எல்லோரும் தேவனை அசட்டைபண்ணுதலுக்கும், தங்கள் அயலகத்தாரை ஒடுக்குதலுக்கும் ஒப்புக்கொடுக்கப்பட்டிருந்தார்கள் என்பதாம்.",
     "anchor": "கொடுமையினால்"
    }
   ]
  },
  {
   "id": "geneva/GEN.6.16",
   "source_hash": "d6bc1e57",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.6.16#p1-d6bc1e57",
     "text": "அதாவது, மூன்று உயரங்களைக் கொண்டது.",
     "anchor": "கீழ் அறைகளையும், இரண்டாம் அடுக்கின் அறைகளையும், மூன்றாம் அடுக்கின் அறைகளையும்"
    }
   ]
  },
  {
   "id": "geneva/GEN.6.18",
   "source_hash": "930c4456",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.6.18#p1-930c4456",
     "text": "இந்தப் பெரிய முயற்சியிலும், உலகம் முழுவதும் இதை பரிகாசம் செய்யும் போதிலும், உன்னுடைய விசுவாசம் தவறாதபடி நீ உறுதிப்படுத்தப்படும்படியாக.",
     "anchor": "என்னுடைய உடன்படிக்கையை ஏற்படுத்துவேன்"
    }
   ]
  },
  {
   "id": "geneva/GEN.6.22",
   "source_hash": "4870d924",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/GEN.6.22#p1-4870d924",
     "text": "அதாவது, அவன் தேவனுடைய கற்பனையின்படி எல்லாவற்றிலும், ஒன்றையும் கூட்டாமலும் குறைக்காமலும் கீழ்ப்படிந்தான்.",
     "anchor": "அவன் செய்து முடித்தான்"
    }
   ]
  }
 ]
}
