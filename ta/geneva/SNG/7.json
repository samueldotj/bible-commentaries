    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/SNG.7.10#p1-27beace1",
     "text": "இதை மணவாட்டி சொல்லுகிறாள்.",
     "anchor": "நான் என் நேசருடையவள்"
    }
   ]
  },
