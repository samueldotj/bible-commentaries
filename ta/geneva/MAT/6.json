 "chapter": 6,
 "lang": "ta",
 "units": [
  {
   "id": "geneva/MAT.6.1",
   "source_hash": "fc297c02",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MAT.6.1#p1-6c4c3a9b",
     "text": "பெருமையானது தர்மத்தை வீணாக்குகிறது.",
     "anchor": "மனிதர்கள் காணவேண்டுமென்று அவர்களுக்கு முன்பாக உங்களுடைய நல்ல செயல்களைச்"
    },
    {
     "id": "geneva/MAT.6.1#p2-2eb3d932",
     "text": "\"பலன்\" என்ற இந்த வார்த்தை வேதவாக்கியங்களில் எப்போதும் கிரயமில்லாத ஈவாகவே எடுத்துக்கொள்ளப்படுகிறது; ஆகவே, பாடசாலை வாதியர் இதை ஒரு தகுதிக்கு பதிலாக இருக்கவேண்டியதாக மூடத்தனமாக நிலைநிறுத்தினார்கள், அதை அவர்கள் \"தகுதி\" என்று அழைக்கிறார்கள்.",
     "anchor": "பரலோகத்திலிருக்கிற உங்களுடைய பிதாவினிடத்தில் உங்களுக்குப் பலன்"
    }
   ]
  },
  {
   "id": "geneva/MAT.6.2",
   "source_hash": "f8b6295b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MAT.6.2#p1-f8b6295b",
     "text": "மாயக்காரர், ஏனெனில் மாயக்காரர் என்பவர்கள் ஒரு நாடகத்தில் வேடம் கட்டி நடிக்கும் கூத்தாடிகளாக இருந்தார்கள்.",
     "anchor": "மாயக்காரர்கள் ஆலயங்களிலும் வீதிகளிலும்"
    }
   ]
  },
  {
   "id": "geneva/MAT.6.5",
   "source_hash": "d95851a2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MAT.6.5#p1-d95851a2",
     "text": "ஜெபம் செய்கையில் அருவருப்பான இரண்டு குற்றங்களை அவர் கண்டிக்கிறார், அதாவது பெருமையையும் வீணான வாய் அலப்பலையும்.",
     "anchor": "நீ ஜெபம்செய்யும்போது"
    }
   ]
  },
  {
   "id": "geneva/MAT.6.7",
   "source_hash": "70465668",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MAT.6.7#p1-70465668",
     "text": "நீண்ட ஜெபம் குற்றஞ்சுமத்தப்படவில்லை, ஆனால் வீணான, தேவையற்ற, மூடநம்பிக்கையான ஜெபமே குற்றஞ்சுமத்தப்படுகிறது.",
     "anchor": "வீண்வார்த்தைகளைத் திரும்பத்திரும்ப"
    }
   ]
  },
  {
   "id": "geneva/MAT.6.9",
   "source_hash": "372030c9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MAT.6.9#p1-372030c9",
     "text": "எல்லா கிறிஸ்தவ ஜெபங்களின் மெய்யான சாரமும் வடிவமும்.",
     "anchor": "நீங்கள் ஜெபம் செய்யவேண்டிய விதமாவது"
    }
   ]
  },
  {
   "id": "geneva/MAT.6.11",
   "source_hash": "a21dd50e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MAT.6.11#p1-a21dd50e",
     "text": "நமது தினசரி ஆகாரத்திற்கு நமது இயல்புக்கு ஏற்றது, அல்லது நமது இயல்புக்கும் தேகநிலைக்கும் போதுமானது.",
     "anchor": "வேண்டிய ஆகாரத்தை இன்று"
    }
   ]
  },
  {
   "id": "geneva/MAT.6.13",
   "source_hash": "502af7b3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MAT.6.13#p1-502af7b3",
     "text": "சாத்தானிடமிருந்து, அல்லது எல்லா ஆபத்தினின்றும்.",
     "anchor": "தீமையிலிருந்து"
    }
   ]
  },
  {
   "id": "geneva/MAT.6.14",
   "source_hash": "af68d06f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MAT.6.14#p1-af68d06f",
     "text": "தவறுகளை மன்னிக்கிறவர்களுக்கு பாவங்கள் மன்னிக்கப்படும், ஆனால் பழிவாங்குகிறவர்களுக்கு பழிவாங்குதலே ஆயத்தமாக இருக்கும்.",
     "anchor": "மனிதர்களுடைய குற்றங்களை நீங்கள் அவர்களுக்கு மன்னித்தால்"
    }
   ]
  },
  {
   "id": "geneva/MAT.6.16",
   "source_hash": "e438b442",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MAT.6.16#p1-7fb110a4",
     "text": "அதாவது, உபவாசத்தினால் பரிசுத்தமான பெயரை விரும்புகிறவர்கள்.",
     "anchor": "நீங்கள் உபவாசிக்கும்போது"
    },
    {
     "id": "geneva/MAT.6.16#p2-3df4e88d",
     "text": "அவர்கள் தங்களுடைய இயற்கையான வெளிறிய நிறத்தை மறைக்காமல் காணப்படுத்துகிறார்கள் என்பதில்லை; அதாவது, தங்களுடைய முகத்தின் இயல்பான நிறத்தை மாறச் செய்கிறார்கள், அவர்கள் மெலிந்தவர்களாகவும் வாடிய முகமுடையவர்களாகவும் காணப்படும்படிக்கு.",
     "anchor": "தங்களுடைய முகங்களை வாடச்செய்கிறார்கள்"
    }
   ]
  },
  {
   "id": "geneva/MAT.6.19",
   "source_hash": "02c931c4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MAT.6.19#p1-02c931c4",
     "text": "நித்தியஜீவனுடைய நிச்சயமான சொத்தைப் பெறாமல், அழிந்துபோகும் வீணான செல்வத்தைச் சேர்க்கிறதிலே தங்கள் வாழ்நாட்களைச் செலவழிக்கும் மனிதர்களுடைய பிரயாசங்கள் வீணானவை என்று இங்கே காண்பிக்கப்படுகிறது.",
     "anchor": "பூமியிலே உங்களுக்கு சொத்துக்களைச் சேர்த்துவைக்கவேண்டாம்"
    }
   ]
  },
  {
   "id": "geneva/MAT.6.22",
   "source_hash": "c93d5f2d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MAT.6.22#p1-4749cdb9",
     "text": "மனிதர்கள் தங்களில் இருக்கிற இயற்கையின் சிறு வெளிச்சத்தையும் கொடுமையாகவும் தீயவழியாகவும் அணைத்துப்போடுகிறார்கள்.",
     "anchor": "கண்ணானது சரீரத்தின் விளக்காக இருக்கிறது"
    },
    {
     "id": "geneva/MAT.6.22#p2-d539dd4a",
     "text": "மனதின் நியாயத்தீர்ப்பு; அதாவது, சரீரம் கண்களினால் நடத்தப்படுவது போல, நம்முடைய முழு வாழ்க்கையும் சரியான ஆலோசனையினால், அதாவது நமக்கு வெளிச்சம் தருகிற பரிசுத்த ஆவியானவராலே நடத்தப்படும்.",
     "anchor": "கண் தெளிவாக"
    }
   ]
  },
  {
   "id": "geneva/MAT.6.24",
   "source_hash": "5c4b47f2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MAT.6.24#p1-253f39c1",
     "text": "தேவன் மனுஷன் முழுவதினாலும் தொழுதுகொள்ளப்படவேண்டும்.",
     "anchor": "ஒருவனாலும் முடியாது"
    },
    {
     "id": "geneva/MAT.6.24#p2-822f019c",
     "text": "இவர்கள் ஒருவரோடொருவர் பகைகொண்டவர்கள்; ஏனெனில் இருவரும் ஒத்திருந்தால் அவர்கள் ஒருவனைப் போலவே இருப்பார்கள்.",
     "anchor": "இரண்டு முதலாளிகளுக்கு"
    },
    {
     "id": "geneva/MAT.6.24#p3-18a07aea",
     "text": "இந்த வார்த்தை சீரிய வார்த்தையாகும், பணத்திற்குச் சொந்தமான எல்லாவற்றையும் குறிக்கும்.",
     "anchor": "உலகப்பொருள்"
    }
   ]
  },
  {
   "id": "geneva/MAT.6.25",
   "source_hash": "14849b4f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MAT.6.25#p1-14849b4f",
     "text": "தேவனுடைய பராமரிப்பினைக் குறித்த ஆழ்ந்த சிந்தனையினால், இவ்வுலக வாழ்க்கைக்குரிய காரியங்களைப்பற்றிய பிடிவாதமான, சுமையாகிய கவலை தேவனுடைய பிள்ளைகளில் திருத்தப்படுகிறது.",
     "anchor": "ஆகவே ... உங்களுக்குச் சொல்லுகிறேன்"
    }
   ]
  },
  {
   "id": "geneva/MAT.6.26",
   "source_hash": "5ddd0814",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MAT.6.26#p1-5ddd0814",
     "text": "காற்றுவெளியில், அல்லது காற்றில் பறக்கிற வரிசை: எல்லா மொழிகளிலும் ஏறக்குறைய \"பரலோகம்\" என்ற வார்த்தை காற்றுவெளியைக் குறிக்கும்.",
     "anchor": "வானத்துப் பறவைகளைக்"
    }
   ]
  },
  {
   "id": "geneva/MAT.6.27",
   "source_hash": "b50f1d58",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MAT.6.27#p1-b50f1d58",
     "text": "மனக்கவலையுடன் கூடிய கவலையைக் குறித்துப் பேசுகிறார், அத்தோடு பெருவாரியாக அவநம்பிக்கையும் இணைந்திருக்கும்.",
     "anchor": "கவலைப்படுகிறதினாலே ஒரு முழத்தைக் கூட்டுவான்"
    }
   ]
  },
  {
   "id": "geneva/MAT.6.28",
   "source_hash": "54af896f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MAT.6.28#p1-54af896f",
     "text": "பிரயாசத்தினால்.",
     "anchor": "உழைக்கிறதுமில்லை"
    }
   ]
  }
 ]
}
