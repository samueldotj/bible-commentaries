 "units": [
  {
   "id": "geneva/EXO.10.2",
   "source_hash": "0396345b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EXO.10.2#p1-0396345b",
     "text": "அற்புதங்கள் மிகவும் பெரியவைகளாக இருக்கும்படியாக, அவை என்றென்றைக்கும் பேசப்படும்; இதிலே பெற்றோர் தங்கள் பிள்ளைகளுக்குச் செய்யவேண்டிய கடமையையும் நாம் காண்கிறோம்.",
     "anchor": "உன்னுடைய பிள்ளைகளின் காதுகள்"
    }
   ]
  },
  {
   "id": "geneva/EXO.10.3",
   "source_hash": "40f87260",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EXO.10.3#p1-40f87260",
     "text": "தேவனுடைய கரத்தின்கீழ் நாம் மெய்யான மனந்திரும்புதலுடன் நம்மைத் தாழ்த்திக்கொள்வதே சிக்கலின் நோக்கமாகும்.",
     "anchor": "உன்னைத் தாழ்த்த"
    }
   ]
  },
  {
   "id": "geneva/EXO.10.7",
   "source_hash": "d9a85e5a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EXO.10.7#p1-d9a85e5a",
     "text": "அதாவது, இந்தத் தீங்குகளுக்கெல்லாம் காரணமானவன் என்று பொருள்: இவ்விதமாகவே தேவபக்தியுள்ளவர்கள் மேல் எப்போதும் குற்றம் சுமத்தப்படுவார்கள், எலியாவின்மேல் ஆகாப் குற்றம் சுமத்தியது போல.",
     "anchor": "தொல்லை கொடுக்கிறவனாக"
    }
   ]
  },
  {
   "id": "geneva/EXO.10.10",
   "source_hash": "c06e58d6",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EXO.10.10#p1-85a6c982",
     "text": "அதாவது, கர்த்தர் உங்கள்மேல் வைத்திருக்கும் பட்சத்தின் அளவு, நான் உங்களை விடுவிக்க விரும்பும் அளவுக்கு மேற்படாது என்று நான் நம்புகிறேன்.",
     "anchor": "யெகோவா உங்களுடன் இருப்பாராக"
    },
    {
     "id": "geneva/EXO.10.10#p2-00ac5b3f",
     "text": "தண்டனை உங்களுக்காக ஆயத்தமாக்கப்பட்டிருக்கிறது. சிலர், \"நீங்கள் ஏதோ தீங்கை நோக்கமாகக் கொண்டிருக்கிறீர்கள்\" என்று வாசிக்கிறார்கள்.",
     "anchor": "உங்களுக்கு தீங்குநேரிடும்"
    }
   ]
  },
  {
   "id": "geneva/EXO.10.16",
   "source_hash": "6f539326",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EXO.10.16#p1-6f539326",
     "text": "துன்மார்க்கர் தங்களுடைய தீங்கின் காலத்திலே தேவனுடைய ஊழியக்காரரை வெறுத்து இகழ்ந்தபோதிலும், அவர்களுடைய உதவியையே தேடுகிறார்கள்.",
     "anchor": "மோசேயையும், ஆரோனையும் விரைவாக அழைத்து"
    }
   ]
  },
  {
   "id": "geneva/EXO.10.19",
   "source_hash": "2f2d7602",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EXO.10.19#p1-2f2d7602",
     "text": "மணல் அல்லது கல் சிவப்பாக இருந்தபடியால் தண்ணீர் சிவப்பாகக் காணப்பட்டது; எபிரெயர்கள் அதைத் தூறுங்குச் செடிகளின் கடல் என்று அழைக்கிறார்கள்.",
     "anchor": "செங்கடலிலே"
    }
   ]
  },
  {
   "id": "geneva/EXO.10.21",
   "source_hash": "3a89400c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EXO.10.21#p1-3a89400c",
     "text": "அது மிகவும் அடர்த்தியாக இருந்தபடியால்.",
     "anchor": "தடவிக்கொண்டிருக்கும்படியான"
    }
   ]
  },
  {
   "id": "geneva/EXO.10.26",
   "source_hash": "fd202e8e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EXO.10.26#p1-7ef8531b",
     "text": "தேவனுடைய ஊழியக்காரர் தங்கள் மிஷனரி ஊழியத்தைக் குறித்து துன்மார்க்கருக்கு ஒரு இழுத்தும் இடம் விட்டுக்கொடுக்கலாகாது.",
     "anchor": "ஒரு குளம்பும் பின்வைக்கப்படுவதில்லை"
    },
    {
     "id": "geneva/EXO.10.26#p2-714542f8",
     "text": "அதாவது, எந்த மிருகங்களைக்கொண்டு, அல்லது எத்தனை மிருகங்களைக்கொண்டு.",
     "anchor": "இன்னதைக்கொண்டு யெகோவாவுக்கு ஆராதனை செய்வோம்"
    }
   ]
  },
  {
   "id": "geneva/EXO.10.28",
   "source_hash": "685cffff",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EXO.10.28#p1-685cffff",
     "text": "முன்னே அவன் மோசே நீதிமான் என்று ஒப்புக்கொண்டிருந்தும், மறுபடியும் தன் இருதயத்தில் அவனைக் கொலைசெய்ய அச்சுறுத்தினான்.",
     "anchor": "சாவாய்"
    }
   ]
  }
 ]
}
