 "units": [
  {
   "id": "geneva/EXO.13.3",
   "source_hash": "6a6f928c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EXO.13.3#p1-2a48361b",
     "text": "அவர்கள் மிகக் கொடிய அடிமைத்தனத்தில் இருந்த இடம்.",
     "anchor": "அடிமைத்தன வீடாகிய"
    },
    {
     "id": "geneva/EXO.13.3#p2-7d97b491",
     "text": "தங்கள் அப்பத்தைப் புளிக்கவைக்க அவர்களுக்கு நேரம் இல்லாதிருந்தது என்பதைக் குறிக்கும்.",
     "anchor": "புளித்த அப்பம் சாப்பிடவேண்டாம்"
    }
   ]
  },
  {
   "id": "geneva/EXO.13.4",
   "source_hash": "13412353",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EXO.13.4#p1-13412353",
     "text": "அந்த தேசத்தில் தானியம் விளையத் தொடங்கும் மார்ச் மாதத்தின் ஒரு பகுதியையும் ஏப்ரல் மாதத்தின் ஒரு பகுதியையும் உள்ளடக்கியது.",
     "anchor": "ஆபீப் மாதத்தின்"
    }
   ]
  },
  {
   "id": "geneva/EXO.13.6",
   "source_hash": "511b235d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EXO.13.6#p1-511b235d",
     "text": "முதலாம் நாளும் ஏழாம் நாளும் பரிசுத்தமாயிருந்தன, யாத்திராகமம் 12:16-ல் இருப்பதுபோல.",
     "anchor": "ஏழாம்நாளிலே யெகோவாவுக்குப் பண்டிகை அனுசரிக்கப்படவேண்டும்.\"d\"[முழுவசனத்தையும் குறிக்கும் குறியீடு]"
    }
   ]
  },
  {
   "id": "geneva/EXO.13.8",
   "source_hash": "6300cad2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EXO.13.8#p1-6300cad2",
     "text": "நீ புளிப்பில்லாத அப்பப் பண்டிகையைக் கொண்டாடும்போது.",
     "anchor": "அந்த நாளில்"
    }
   ]
  },
  {
   "id": "geneva/EXO.13.9",
   "source_hash": "d89e3508",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EXO.13.9#p1-d89e3508",
     "text": "கையிலிருக்கும் அல்லது கண்களுக்கு முன்பாக இருக்கும் ஒரு பொருளை நினைப்பது போல, நீ இதை எப்பொழுதும் நினைத்துக்கொள்வாய்.",
     "anchor": "கையிலே"
    }
   ]
  },
  {
   "id": "geneva/EXO.13.13",
   "source_hash": "b886a944",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EXO.13.13#p1-c1b5bfbe",
     "text": "இது குதிரையையும் பலியிடப்படாத மற்ற மிருகங்களையும் குறித்தும் விளங்கிக்கொள்ளப்படவேண்டும்.",
     "anchor": "கழுதையின் முதற்பிறப்பையெல்லாம்"
    },
    {
     "id": "geneva/EXO.13.13#p2-acd60e0b",
     "text": "சுத்தமான ஒரு மிருகத்தை காணிக்கையாகப் பலியிடுகிறதினால்; லேவியராகமம் 12:6.",
     "anchor": "மீட்டுக்கொள்வாயாக"
    }
   ]
  },
  {
   "id": "geneva/EXO.13.17",
   "source_hash": "ca21e387",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EXO.13.17#p1-ca21e387",
     "text": "பெலிஸ்தர்கள் அவர்களுடைய வழியை அடைத்து அவர்களுக்கு விரோதமாக நடத்தும் யுத்தத்தையே இது குறிக்கும்.",
     "anchor": "யுத்தத்தைக் கண்டால்"
    }
   ]
  },
  {
   "id": "geneva/EXO.13.18",
   "source_hash": "93f6e2ab",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EXO.13.18#p1-93f6e2ab",
     "text": "அதாவது, மறைவாக அல்ல, வெளிப்படையாக; மேலும் இந்த வார்த்தை குறிப்பதுபோல, ஐந்து ஐந்து பேராகக் கிரமமாக அணிவகுத்து.",
     "anchor": "கோத்திரம் கோத்திரமாக புறப்பட்டுப்போனார்கள்"
    }
   ]
  },
  {
   "id": "geneva/EXO.13.21",
   "source_hash": "c7ceab38",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/EXO.13.21#p1-c7ceab38",
     "text": "சூரியனுடைய வெயிலிலிருந்து அவர்களைப் பாதுகாக்கும்படி.",
     "anchor": "மேகத்தூண்"
    }
   ]
  }
 ]
}
