   "paragraphs": [
    {
     "id": "geneva/EXO.38.29#p1-0fae37e2",
     "text": "தாலந்தின் நிறையைப் பற்றி, யாத்திராகமம் 25:39-ல் காண்க.",
     "anchor": "தாலந்தும்"
