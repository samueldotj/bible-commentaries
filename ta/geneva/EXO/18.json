   },
   "paragraphs": [
    {
     "id": "geneva/EXO.18.27#p1-df9512b5",
     "text": "எண்ணாகமம் 10:29-ஐப் பார்க்கவும்.",
     "anchor": "தன்னுடைய மாமனை அனுப்பிவிட்டான்"
    }
   ]
  }
 ]
}
