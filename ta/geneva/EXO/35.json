   "paragraphs": [
    {
     "id": "geneva/EXO.35.2#p1-9237cde7",
     "text": "இதிலே நீங்கள் எல்லா சரீர வேலையிலிருந்தும் ஓய்ந்திருக்கவேண்டும்.",
     "anchor": "நாள்"
    }
   ]
  },
  {
   "id": "geneva/EXO.35.10",
   "source_hash": "4b4c49e9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
