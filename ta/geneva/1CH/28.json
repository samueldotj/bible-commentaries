 "units": [
  {
   "id": "geneva/1CH.28.2",
   "source_hash": "e9302497",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CH.28.2#p1-e9302497",
     "text": "பெட்டி தங்கி, இனிமேல் இங்குமங்கும் நீங்காமல் இருக்கும் இடம்.",
     "anchor": "பாதப்படியும் தங்குவதற்கு"
    }
   ]
  },
  {
   "id": "geneva/1CH.28.4",
   "source_hash": "4244beb2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CH.28.4#p1-4244beb2",
     "text": "யாக்கோபு தீர்க்கதரிசனம் சொன்னதின்படியே, ஆதி. 49:8.",
     "anchor": "யூதாவை"
    }
   ]
  },
  {
   "id": "geneva/1CH.28.7",
   "source_hash": "8b4ae9e8",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CH.28.7#p1-8b4ae9e8",
     "text": "அவன் இப்பொழுது நடக்கிறபடியே என்னுடைய நியாயப்பிரமாணத்தைக் காத்து, அதைவிட்டு விலகாதிருந்தால்.",
     "anchor": "இந்தநாளில் நடக்கிறபடியே"
    }
   ]
  },
  {
   "id": "geneva/1CH.28.8",
   "source_hash": "5cb24241",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CH.28.8#p1-1b926cbf",
     "text": "அதாவது, கானான்.",
     "anchor": "நல்ல தேசத்தை"
    },
    {
     "id": "geneva/1CH.28.8#p2-f94dbe3d",
     "text": "அவர்களுடைய பாவங்களும் அக்கிரமமும் தவிர வேறொன்றும், அவர்களையும் அவர்களுடைய சந்ததியையும் இந்த தேசத்தின் நன்மைகளில் இருந்து பிரிக்க முடியாது என்று அவர் அறிவிக்கிறார்.",
     "anchor": "என்றென்றைக்கும்"
    }
   ]
  },
  {
   "id": "geneva/1CH.28.10",
   "source_hash": "b0352737",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CH.28.10#p1-893ddd2a",
     "text": "அதாவது, அவருடைய பெட்டிக்காக.",
     "anchor": "பரிசுத்த இடமாக ஒரு ஆலயத்தை"
    },
    {
     "id": "geneva/1CH.28.10#p2-42c9f671",
     "text": "அதை நடைமுறையில் செய்.",
     "anchor": "அதை நடத்து"
    }
   ]
  },
  {
   "id": "geneva/1CH.28.15",
   "source_hash": "0049128b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CH.28.15#p1-0049128b",
     "text": "அதாவது, பத்து விளக்குத்தண்டுகள், 1 இராஜாக்கள் 7:49.",
     "anchor": "பொன் விளக்குத்தண்டுகளுக்கும்"
    }
   ]
  },
  {
   "id": "geneva/1CH.28.18",
   "source_hash": "0b87c875",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CH.28.18#p1-0b87c875",
     "text": "பெட்டியை மூடின, இரக்கத்தைக் காண்பிக்கும் கிருபாசனத்தைக் குறிக்கிறது; அது வாகனம் என்று சொல்லப்பட்டது, ஏனெனில் கர்த்தர் அங்கே தம்மைத் தாமே வெளிப்படுத்தினார்.",
     "anchor": "பொன் கேருபீன்களான வாகனத்தின்"
    }
   ]
  },
  {
   "id": "geneva/1CH.28.19",
   "source_hash": "e5c73fa7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CH.28.19#p1-e5c73fa7",
     "text": "ஏனெனில் இவையெல்லாம் நியாயப்பிரமாணப் புத்தகத்தில் எழுதப்பட்டவைகளாக இருந்தன, யாத்திராகமம் 25:40, அவைகளை ராஜா நடைமுறைப்படுத்தும்படி கட்டாயப்படுத்தப்பட்டிருந்தான், உபாகமம் 17:19.",
     "anchor": "யெகோவாவுடைய கரத்தினால் எனக்கு எழுதிக்கொடுக்கப்பட்டது என்றான்"
    }
   ]
  },
  {
   "id": "geneva/1CH.28.21",
   "source_hash": "67bf091a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CH.28.21#p1-67bf091a",
     "text": "அதாவது, ஒவ்வொருவரும் தேவன் தமக்குக் கொடுத்த வரங்களைக் கொண்டு உனக்கு உதவிசெய்யத் தயாராயிருப்பார்கள்.",
     "anchor": "திறமையுள்ளவர்களான மனப்பூர்வமுள்ள சகல மனிதர்களும்"
    }
   ]
  }
 ]
}
