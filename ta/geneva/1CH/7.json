 "units": [
  {
   "id": "geneva/1CH.7.1",
   "source_hash": "71c51e17",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CH.7.1#p1-71c51e17",
     "text": "இவன் ஆதியாகமம் 46:13-ல் யோபு என்றும் அழைக்கப்படுகிறான்.",
     "anchor": "யசுப்"
    }
   ]
  },
  {
   "id": "geneva/1CH.7.2",
   "source_hash": "ab23af16",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CH.7.2#p1-ab23af16",
     "text": "அதாவது, தாவீது மக்களை எண்ணிக்கை பார்த்தபோது அவர்களுடைய எண்ணிக்கை இவ்வளவு அதிகமாகக் காணப்பட்டது, 2 சாமுவேல் 24:1.",
     "anchor": "தாவீதின் நாட்களில் அவர்கள் எண்ணிக்கை"
    }
   ]
  },
  {
   "id": "geneva/1CH.7.3",
   "source_hash": "7f33433f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CH.7.3#p1-7f33433f",
     "text": "அதாவது நான்கு மகன்களும் தகப்பனும் என்று அர்த்தம்.",
     "anchor": "ஐந்துபேரும்"
    }
   ]
  },
  {
   "id": "geneva/1CH.7.6",
   "source_hash": "a5846ae2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CH.7.6#p1-fe9ac064",
     "text": "அஸ்பேல் என்றும் அழைக்கப்படுகிறார், ஆதியாகமம் 46:21, எண்ணாகமம் 26:38.",
     "anchor": "யெதியாயேல்"
    },
    {
     "id": "geneva/1CH.7.6#p2-7877e548",
     "text": "தலைவர்களாக இருந்தவர்கள்: அல்லது ஆதியாகமம் 46:21-ல் காணப்படுவது போல உண்மையில் ஏழுபேர் இருந்தனர்.",
     "anchor": "மூன்றுபேர்"
    }
   ]
  },
  {
   "id": "geneva/1CH.7.12",
   "source_hash": "948ab804",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CH.7.12#p1-948ab804",
     "text": "அதாவது, அவன் பென்யமீனின் மகன் அல்ல, தாணின் மகன் ஆவான் ஆதியாகமம் 46:23.",
     "anchor": "ஆகேரின்"
    }
   ]
  },
  {
   "id": "geneva/1CH.7.13",
   "source_hash": "367632d9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CH.7.13#p1-367632d9",
     "text": "இவர்கள் தாணிலும் நப்தலியிலும் வந்தவர்கள், அவர்கள் பில்காளின் மகன்களாக இருந்தனர், ஆதியாகமம் 46:23,24,25.",
     "anchor": "பில்காளின் பேரன்மார்கள்"
    }
   ]
  },
  {
   "id": "geneva/1CH.7.18",
   "source_hash": "119d08eb",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CH.7.18#p1-119d08eb",
     "text": "அதாவது, கீலேயாத்தின் சகோதரி.",
     "anchor": "இவனுடைய சகோதரியாகிய அம்மொளெகேத்"
    }
   ]
  },
  {
   "id": "geneva/1CH.7.21",
   "source_hash": "60b0940f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CH.7.21#p1-60b0940f",
     "text": "இது பெலிஸ்தரின் ஐந்து முக்கிய பட்டணங்களில் ஒன்று, இதிலுள்ளவர்களே எப்பிராயீமியரைக் கொன்றார்கள்.",
     "anchor": "காத்தூரார்களுடைய ஆடுமாடுகளைப் பிடிக்கப்போனதால்"
    }
   ]
  },
  {
   "id": "geneva/1CH.7.25",
   "source_hash": "06319fa4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/1CH.7.25#p1-06319fa4",
     "text": "அதாவது, எப்பிராயீமுடைய.",
     "anchor": "இவனுடைய மகன்"
    }
   ]
  }
 ]
}
