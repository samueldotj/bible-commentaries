 "units": [
  {
   "id": "geneva/NUM.32.1",
   "source_hash": "312b006f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.32.1#p1-c56b3f0a",
     "text": "ரூபன் லேயாளிடத்திலும், காத் அவளுடைய வேலைக்காரியாகிய சில்பாளிடத்திலும் பிறந்தான்.",
     "anchor": "ரூபன், காத் சந்ததிக்கும்"
    },
    {
     "id": "geneva/NUM.32.1#p2-fa7c8dd4",
     "text": "லாபானுக்கும் யாக்கோபுக்கும் இடையேயுள்ள உடன்படிக்கைக்கு அடையாளமாக யாக்கோபு அமைத்த கல்மேட்டினால் இந்தப் பெயர் ஏற்பட்டது (ஆதியாகமம் 31:47).",
     "anchor": "கீலேயாத்"
    }
   ]
  },
  {
   "id": "geneva/NUM.32.13",
   "source_hash": "4c1b23f6",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.32.13#p1-4c1b23f6",
     "text": "அவர்கள் முறுமுறுத்து, தேசத்தைக்குறித்து உண்மையைச் சொன்ன அறிக்கையை விசுவாசிக்க மனதில்லாதிருந்ததினால்.",
     "anchor": "யெகோவாவுடைய சமுகத்தில் தீங்குசெய்த"
    }
   ]
  },
  {
   "id": "geneva/NUM.32.15",
   "source_hash": "d297996f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.32.15#p1-d297996f",
     "text": "உங்களுடைய காரணத்தினால்.",
     "anchor": "இப்படி நீங்கள் இந்த மக்களையெல்லாம் அழியச்செய்வீர்கள்"
    }
   ]
  },
  {
   "id": "geneva/NUM.32.17",
   "source_hash": "2b7ca674",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.32.17#p1-2b7ca674",
     "text": "கானான் தேசத்தில்.",
     "anchor": "அவர்கள் இடத்திலே"
    }
   ]
  },
  {
   "id": "geneva/NUM.32.20",
   "source_hash": "4ebf5c7e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.32.20#p1-4ebf5c7e",
     "text": "கர்த்தருடைய பெட்டிக்கு முன்பாக.",
     "anchor": "யெகோவாவுடைய சமுகத்தில் யுத்தத்திற்கு ஆயத்தமாகி"
    }
   ]
  },
  {
   "id": "geneva/NUM.32.21",
   "source_hash": "b3cb04c0",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.32.21#p1-b3cb04c0",
     "text": "அதாவது, அந்த தேசத்தின் குடிகள்.",
     "anchor": "தம்முடைய எதிரிகளைத் தம்முடைய முகத்திற்கு முன்னின்று துரத்திவிடும்"
    }
   ]
  },
  {
   "id": "geneva/NUM.32.22",
   "source_hash": "6466b9e1",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.32.22#p1-6466b9e1",
     "text": "நீங்கள் கேட்கும் இந்தத் தேசத்தை கர்த்தர் உங்களுக்குக் கட்டாயம் கொடுப்பார், யோசுவா 1:15.",
     "anchor": "யெகோவாவுக்கு முன்பாக"
    }
   ]
  },
  {
   "id": "geneva/NUM.32.23",
   "source_hash": "85af9d3a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.32.23#p1-85af9d3a",
     "text": "நீங்கள் உங்கள் பாவத்திற்காக நிச்சயமாகத் தண்டிக்கப்படுவீர்கள்.",
     "anchor": "தொடர்ந்து பிடிக்கும்"
    }
   ]
  },
  {
   "id": "geneva/NUM.32.28",
   "source_hash": "089edaed",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.32.28#p1-089edaed",
     "text": "ரூபனியருக்கும் மற்றவர்களுக்கும் தான் செய்த வாக்குத்தத்தம் தன் மரணத்திற்குப் பின்பும் நிறைவேற்றப்படும் என்பதற்காக, அவர்கள் தங்கள் வாக்குத்தத்தத்தை மீறாதபடி மோசே கட்டளையிட்டான்.",
     "anchor": "ஆசாரியனாகிய எலெயாசாருக்கும்"
    }
   ]
  },
  {
   "id": "geneva/NUM.32.31",
   "source_hash": "99128297",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.32.31#p1-99128297",
     "text": "கர்த்தருடைய தூதுவன் சொல்வதே கர்த்தருக்குச் சொல்லப்பட்டதாக எண்ணப்படுகிறது.",
     "anchor": "யெகோவா எங்களுக்குச் சொன்னபடியே"
    }
   ]
  },
  {
   "id": "geneva/NUM.32.33",
   "source_hash": "cb49e0fb",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.32.33#p1-cb49e0fb",
     "text": "எமோரியர்கள் யோர்தானின் இருபுறங்களிலும் குடியிருந்தார்கள்: ஆனால் இங்கே யோர்தானுக்கு இப்புறத்தில் குடியிருந்தவர்களைக் குறித்துச் சொல்லுகிறார்: யோசுவா 10:12ல் யோர்தானுக்கு அப்புறத்தில் குடியிருந்தவர்களைக் குறித்துச் சொல்லுகிறார்.",
     "anchor": "எமோரியருடைய ராஜாவாகிய சீகோனின் ராஜ்ஜியத்தையும், பாசானுடைய ராஜாவாகிய ஓகின் ராஜ்ஜியத்தையும்"
    }
   ]
  },
  {
   "id": "geneva/NUM.32.41",
   "source_hash": "76af3d42",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.32.41#p1-76af3d42",
     "text": "அது யாவீரின் கிராமங்கள்.",
     "anchor": "யாவீர்"
    }
   ]
  }
 ]
}
