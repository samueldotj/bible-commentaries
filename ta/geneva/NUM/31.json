 "units": [
  {
   "id": "geneva/NUM.31.3",
   "source_hash": "dd80f554",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.31.3#p1-dd80f554",
     "text": "எண்ணாகமம் 25:17-ல் அவர் கட்டளையிட்டிருந்தபடி, தம்முடைய மக்களுக்கு எதிராகச் செய்யப்படும் தீங்கு தமக்கே எதிராகச் செய்யப்படுவதாக அவர் அறிவிக்கிறார்.",
     "anchor": "மீதியானியர்களிடம்பழிவாங்க​த்தக்க​,அவர்கள்மேல்​யுத்தத்திற்குப்போக​வேண்டும்​என்று​ சொ​ல்லு​தலு​க்கும்​ இது​ பொ​ரு​ந்தும்​;மீதியானியர்களுக்குமேல்பழிவாங்குதலுக்குரிய​தாக​ இருந்தது.வசனத்தில்​ கு​றி​க்கப்பட்ட​ சொ​ல்​​: “மீதியானியர்களிடம் பழிவாங்கத்தக்க”,"
    }
   ]
  },
  {
   "id": "geneva/NUM.31.6",
   "source_hash": "8c1b44a8",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.31.6#p1-8c1b44a8",
     "text": "அவன் கர்த்தருக்காகக் காண்பித்த மிகுந்த பக்திவைராக்கியத்தினிமித்தம், எண்ணாகமம் 25:13.",
     "anchor": "ஆசாரியனாகிய எலெயாசாரின் மகன் பினெகாஸ்"
    }
   ]
  },
  {
   "id": "geneva/NUM.31.8",
   "source_hash": "f115e0c9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.31.8#p1-f115e0c9",
     "text": "இஸ்ரவேலர்கள் தங்கள் தேவனுக்கு விரோதமாக பாதகம் செய்யும்படி ஆலோசனை கொடுத்த கள்ளத் தீர்க்கதரிசி.",
     "anchor": "பேயோரின் மகனாகிய பிலேயாமையும்"
    }
   ]
  },
  {
   "id": "geneva/NUM.31.12",
   "source_hash": "fe63c609",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.31.12#p1-fe63c609",
     "text": "பெண்களும் சிறு பிள்ளைகளும் ஆவர்.",
     "anchor": "சிறைப்பிடிக்கப்பட்ட மனிதர்களையும்"
    }
   ]
  },
  {
   "id": "geneva/NUM.31.15",
   "source_hash": "4ebf2897",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.31.15#p1-4ebf2897",
     "text": "இவர் சொன்னது போல, நீங்கள் ஒருவரையும் மீதியாக விடக்கூடாது என்பதாகும்.",
     "anchor": "பெண்கள் எல்லோரையும் உயிரோடு"
    }
   ]
  },
  {
   "id": "geneva/NUM.31.16",
   "source_hash": "6814a2bf",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.31.16#p1-6814a2bf",
     "text": "பேயோரை வணங்கின காரியத்தினிமித்தம்.",
     "anchor": "பேயோரின் சங்கதியிலே"
    }
   ]
  },
  {
   "id": "geneva/NUM.31.17",
   "source_hash": "0c0cb18f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.31.17#p1-0c0cb18f",
     "text": "அதாவது, ஆண் குழந்தைகள் அனைவரும்.",
     "anchor": "குழந்தைகளில் எல்லா ஆண்பிள்ளைகளையும்"
    }
   ]
  },
  {
   "id": "geneva/NUM.31.23",
   "source_hash": "1388fbd7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.31.23#p1-65a69060",
     "text": "மூன்றாம் நாளும், அது உருக்கப்படுவதற்கு முன்பும்.",
     "anchor": "தீட்டுக்கழிக்கும் தண்ணீராலும் அவைகள் சுத்திகரிக்கப்படவேண்டும்"
    },
    {
     "id": "geneva/NUM.31.23#p2-187a000e",
     "text": "அது கழுவப்படவேண்டும்.",
     "anchor": "தண்ணீர்"
    }
   ]
  },
  {
   "id": "geneva/NUM.31.28",
   "source_hash": "89c97268",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.31.28#p1-89c97268",
     "text": "போருக்குப் போன வீரர்களுக்குக் கிடைத்த கொள்ளையைக் குறித்தது.",
     "anchor": "யுத்தத்திற்குப் போன படைவீரர்களிடத்தில்"
    }
   ]
  },
  {
   "id": "geneva/NUM.31.30",
   "source_hash": "61057cf8",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.31.30#p1-61057cf8",
     "text": "போருக்குப் போகாதிருந்த இஸ்ரவேலர்கள் ஐம்பதில் ஒன்று கர்த்தருக்குச் செலுத்தினார்கள்; படைவீரர்களோ ஐந்நூற்றில் ஒன்று செலுத்தினார்கள்.",
     "anchor": "ஐம்பதிற்கு ஒன்று வீதமாக"
    }
   ]
  },
  {
   "id": "geneva/NUM.31.37",
   "source_hash": "0e919a8b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.31.37#p1-0e919a8b",
     "text": "இது போர்வீரர்கள் கர்த்தருக்குக் கொடுத்த பங்கு.",
     "anchor": "யெகோவாவுக்கு வரியாக வந்தது"
    }
   ]
  },
  {
   "id": "geneva/NUM.31.40",
   "source_hash": "cf1880b0",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.31.40#p1-cf1880b0",
     "text": "அதாவது, புருஷனுடன் சேராத கன்னிப்பெண்களைக் குறிக்கிறது.",
     "anchor": "மனிதஉயிர்கள் 16,000 பேர்"
    }
   ]
  },
  {
   "id": "geneva/NUM.31.42",
   "source_hash": "cb4e34ec",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.31.42#p1-cb4e34ec",
     "text": "கொள்ளைப்பொருளைப் பங்கிடும்போது அவர்களுக்குக் கொடுக்கப்பட்ட அந்தப் பங்கைக் குறிக்கிறது.",
     "anchor": "பாதிப்பங்காவது"
    }
   ]
  },
  {
   "id": "geneva/NUM.31.47",
   "source_hash": "cb810bdb",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.31.47#p1-cb810bdb",
     "text": "போருக்குச் செல்லாதிருந்தவர்கள்.",
     "anchor": "இஸ்ரவேல் மக்களின் பாதிப்பங்கு"
    }
   ]
  },
  {
   "id": "geneva/NUM.31.50",
   "source_hash": "1997fff2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.31.50#p1-1997fff2",
     "text": "படைத்தலைவர்கள் தமது சுயவிருப்பக் காணிக்கையினால், தேவன் தம்முடைய மக்களைப் பாதுகாத்த மிகுந்த நன்மையை அறிக்கை செய்கின்றனர்.",
     "anchor": "காணிக்கையாகக் கொண்டுவந்தோம்"
    }
   ]
  },
  {
   "id": "geneva/NUM.31.53",
   "source_hash": "56a15a22",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.31.53#p1-56a15a22",
     "text": "தங்கள் தளபதிகளுக்குப் பங்கு ஒன்றும் கொடுக்கவில்லை.",
     "anchor": "தங்கள் தங்களுக்காக"
    }
   ]
  },
  {
   "id": "geneva/NUM.31.54",
   "source_hash": "dc72df07",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.31.54#p1-dc72df07",
     "text": "கர்த்தர் இஸ்ரவேல் மக்களை நினைவுகூரும்படி.",
     "anchor": "இஸ்ரவேல் மக்களுக்கு ஞாபகக்குறியாக"
    }
   ]
  }
 ]
}
