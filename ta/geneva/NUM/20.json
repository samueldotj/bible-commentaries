   "paragraphs": [
    {
     "id": "geneva/NUM.20.21#p1-59e2f985",
     "text": "வேறொரு வழியாகக் கடந்துசெல்ல வேண்டியதற்காக.",
     "anchor": "விலகிப் போனார்கள்"
    }
   ]
  },
