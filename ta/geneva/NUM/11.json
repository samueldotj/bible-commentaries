 "units": [
  {
   "id": "geneva/NUM.11.4",
   "source_hash": "1aff7e79",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.11.4#p1-1aff7e79",
     "text": "இவர்கள் எகிப்திலிருந்து அவர்களுடன் வெளியே வந்த அந்நியர்கள், யாத்திராகமம் 12:38.",
     "anchor": "பல ஜாதியான அந்நிய மக்கள் மிகுந்த ஆசையுள்ளவர்களாக மாறினார்கள்"
    }
   ]
  },
  {
   "id": "geneva/NUM.11.5",
   "source_hash": "081cb727",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.11.5#p1-081cb727",
     "text": "விலை கொடுக்காமல், அல்லது மலிவான விலையில்.",
     "anchor": "விலையில்லாமல்"
    }
   ]
  },
  {
   "id": "geneva/NUM.11.6",
   "source_hash": "4ccfe291",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.11.6#p1-4ccfe291",
     "text": "சரீரத்தின் பேராசைக்குரிய இச்சையினால்.",
     "anchor": "வாடிப்போகிறது"
    }
   ]
  },
  {
   "id": "geneva/NUM.11.7",
   "source_hash": "69711ac3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.11.7#p1-69711ac3",
     "text": "இது வெண்மையான முத்து அல்லது விலையுள்ள கல்லாகும்.",
     "anchor": "முத்து"
    }
   ]
  },
  {
   "id": "geneva/NUM.11.11",
   "source_hash": "aae1c890",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.11.11#p1-aae1c890",
     "text": "அல்லது, நான் உமக்கு எவ்வாறு அதிருப்தி உண்டாக்கினேன்?",
     "anchor": "உம்முடைய கண்களில் எனக்குக் கிருபை"
    }
   ]
  },
  {
   "id": "geneva/NUM.11.12",
   "source_hash": "a99a8715",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.11.12#p1-9c88665a",
     "text": "நான் மட்டுமே இவர்களைப் பொறுப்பேற்கவேண்டியபடி, இவர்களுக்கு நான் தகப்பனா?",
     "anchor": "இந்த மக்களையெல்லாம் கர்ப்பந்தரித்தேனோ"
    },
    {
     "id": "geneva/NUM.11.12#p2-ce3395a2",
     "text": "நம்முடைய முன்னோர்களுக்கு வேறொருவரால் வாக்குத்தத்தம் செய்யப்பட்ட கானான் தேசம்.",
     "anchor": "இவர்களுடைய முன்னோர்களுக்கு நான் ஆணையிட்டுக்கொடுத்த தேசத்திற்கு"
    }
   ]
  },
  {
   "id": "geneva/NUM.11.15",
   "source_hash": "8f1de0f4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.11.15#p1-8f1de0f4",
     "text": "நான் காண்பதற்குப் பதிலாக, அவர்களுடைய கலகத்தினால் தினந்தினம் என்னுடைய துக்கமும் துன்பமும் அதிகரிப்பதைவிட, சாகவே விரும்புகிறேன்.",
     "anchor": "காணாதபடி"
    }
   ]
  },
  {
   "id": "geneva/NUM.11.17",
   "source_hash": "007e2aaf",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.11.17#p1-007e2aaf",
     "text": "நான் உனக்குக் கொடுத்தது போலவே, என் ஆவியை அவர்களுக்கும் பகிர்ந்துகொடுப்பேன்.",
     "anchor": "இருக்கிற ஆவியை அவர்கள்மேலும் வைப்பேன்"
    }
   ]
  },
  {
   "id": "geneva/NUM.11.18",
   "source_hash": "77ec6f19",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.11.18#p1-77ec6f19",
     "text": "நீங்கள் சுத்தமாயிருக்கும்படி உங்களைத் தயார்படுத்திக் கொள்ளுங்கள்.",
     "anchor": "நாளைக்காக உங்களைப் பரிசுத்தப்படுத்துங்கள்"
    }
   ]
  },
  {
   "id": "geneva/NUM.11.20",
   "source_hash": "d9992bbb",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.11.20#p1-fe953ae7",
     "text": "அல்லது, அவரை புறக்கணித்தீர்கள்; ஏனெனில் அவர் உங்களுக்கு மிகவும் தகுதியானதாக நியமித்த மன்னாவை நீங்கள் வெறுத்தீர்கள்.",
     "anchor": "உங்களுக்குள்ளே இருக்கிற யெகோவாவை அசட்டைசெய்து"
    },
    {
     "id": "geneva/NUM.11.20#p2-b5483331",
     "text": "உங்களை நடத்தி ஆளுகை செய்பவர்.",
     "anchor": "உங்களுக்குள்ளே"
    }
   ]
  },
  {
   "id": "geneva/NUM.11.21",
   "source_hash": "092c513a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.11.21#p1-092c513a",
     "text": "நான் யாருக்குப் பொறுப்பாளியாக இருக்கிறேனோ அவர்கள்.",
     "anchor": "என்னுடன் இருக்கிற"
    }
   ]
  },
  {
   "id": "geneva/NUM.11.25",
   "source_hash": "37f02ab4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.11.25#p1-37f02ab4",
     "text": "அன்று முதல் தீர்க்கதரிசன ஆவியானது அவர்கள்மேல் நிலைத்திருக்கவில்லை.",
     "anchor": "ஓய்ந்தார்கள்"
    }
   ]
  },
  {
   "id": "geneva/NUM.11.28",
   "source_hash": "f4811c4b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.11.28#p1-6efc1faa",
     "text": "அல்லது, தன் இளவயது முதலே அவனால் தெரிந்துகொள்ளப்பட்ட ஒரு வாலிபன்.",
     "anchor": "வாலிபர்களில்"
    },
    {
     "id": "geneva/NUM.11.28#p2-e14727ec",
     "text": "இப்படிப்பட்ட குருட்டு வைராக்கியம் அப்போஸ்தலர்களிலும் இருந்தது, மாற்கு 9:38, லூக்கா 9:44.",
     "anchor": "அவர்களைத் தடைசெய்யும்"
    }
   ]
  },
  {
   "id": "geneva/NUM.11.32",
   "source_hash": "f8a7a591",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.11.32#p1-f8a7a591",
     "text": "ஓமர் என்பதைக் குறித்து லேவியராகமம் 27:16-ஐயும் வாசிக்கவும்; அது யாத்திராகமம் 8:14; நியாயாதிபதிகள் 15:16-லும் இருப்பதுபோல ஒரு குவியலைக் குறிக்கிறது.",
     "anchor": "ஓமர்"
    }
   ]
  }
 ]
}
