 "units": [
  {
   "id": "geneva/NUM.27.3",
   "source_hash": "494c813d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.27.3#p1-494c813d",
     "text": "எல்லா மனிதரும் இறப்பது போலவே, ஏனெனில் அவர்கள் பாவிகளாய் இருக்கிறார்கள்.",
     "anchor": "பாவத்தினாலே"
    }
   ]
  },
  {
   "id": "geneva/NUM.27.5",
   "source_hash": "a99beb0f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.27.5#p1-a99beb0f",
     "text": "அதாவது, என்ன தீர்மானிக்க வேண்டுமென்று அறியும்படி நியாயந்தீர்க்கப்பட வேண்டிய அவர்களுடைய காரியம், அவன் எல்லா கடினமான காரியங்களையும் தீர்த்ததுபோல.",
     "anchor": "நியாயத்தைக் யெகோவாவுடைய சந்நிதியில்"
    }
   ]
  },
  {
   "id": "geneva/NUM.27.11",
   "source_hash": "207f1c39",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.27.11#p1-207f1c39",
     "text": "அதாவது, நியாயம் தீர்ப்பதற்கான ஒரு நியமம்.",
     "anchor": "நியாயவிதிப்பிரமாணமாக"
    }
   ]
  },
  {
   "id": "geneva/NUM.27.16",
   "source_hash": "44c4ad5e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.27.16#p1-44c4ad5e",
     "text": "அவர் எப்படி எல்லா மனிதர்களையும் படைத்தாரோ, அப்படியே அவர்களுடைய இருதயங்களையும் ஆளுகை செய்கிறார்.",
     "anchor": "சர்வ மனுஷரின் ஆவிகளின்"
    }
   ]
  },
  {
   "id": "geneva/NUM.27.17",
   "source_hash": "d3753a3c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.27.17#p1-d3753a3c",
     "text": "அதாவது, அவர்களை நடத்தி, தன் கடமையைச் செய்யவேண்டும், 2 நாளாகமம் 1:10 இல் இருக்கிறபடி.",
     "anchor": "போக்கும் வரத்துமாக இருக்கும்படி"
    }
   ]
  },
  {
   "id": "geneva/NUM.27.18",
   "source_hash": "5c16e5a3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.27.18#p1-5c16e5a3",
     "text": "இவ்வாறு அவனை அதிகாரியாக நியமிப்பாயாக.",
     "anchor": "அவன்மேல் உன்னுடைய கையை வைத்து"
    }
   ]
  },
  {
   "id": "geneva/NUM.27.20",
   "source_hash": "7520ccb2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.27.20#p1-7520ccb2",
     "text": "அவனை அந்த பதவிக்குப் பொருத்தமானவனாகவும் தேவனால் நியமிக்கப்பட்டவனாகவும் மக்களுக்குப் பரிந்துரைத்தல்.",
     "anchor": "உன்னுடைய அதிகாரத்தில் கொஞ்சம் அவனுக்குக் கொடு"
    }
   ]
  },
  {
   "id": "geneva/NUM.27.21",
   "source_hash": "12ad7ec7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.27.21#p1-12ad7ec7",
     "text": "அவனுடைய பதவிக்கேற்றபடி: இதனால், தேவனுடைய விருப்பம் என்று தான் அறிந்ததையே தவிர வேறொன்றையும் அரசாங்க அதிகாரி செய்யக்கூடாது என்பதைக் குறிக்கிறது.",
     "anchor": "ஊரீம் என்னும் நியாயத்தினாலே யெகோவாவுடைய சந்நிதானத்தில்"
    }
   ]
  },
  {
   "id": "geneva/NUM.27.23",
   "source_hash": "512de253",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.27.23#p1-512de253",
     "text": "தன்னுடைய பணியில் அவன் தன்னைத்தான் எப்படி நடத்திக்கொள்ள வேண்டும் என்பதைக் குறித்து.",
     "anchor": "கட்டளைகொடுத்தான்"
    }
   ]
  }
 ]
}
