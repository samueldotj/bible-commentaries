 "units": [
  {
   "id": "geneva/NUM.5.3",
   "source_hash": "dd7d8474",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.5.3#p1-dd7d8474",
     "text": "முகாம்கள் மூன்று வகையாக இருந்தன: கர்த்தருடையது, லேவியர்களுடையது, இஸ்ரவேலருடையது.",
     "anchor": "நான் வாசம்செய்கிற தங்களுடைய முகாம்களை"
    }
   ]
  },
  {
   "id": "geneva/NUM.5.6",
   "source_hash": "35f55ffe",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.5.6#p1-35f55ffe",
     "text": "விருப்பத்துடன் ஒரு குற்றத்தைச் செய்தல்.",
     "anchor": "மனிதர்கள் செய்யும்"
    }
   ]
  },
  {
   "id": "geneva/NUM.5.8",
   "source_hash": "5b014185",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.5.8#p1-5b014185",
     "text": "தீங்கு செய்யப்பட்டவன் இறந்துபோய், அவனுக்கு உறவினரும் இல்லாதிருந்தால்.",
     "anchor": "கேட்டு வாங்குகிறதற்கு இனத்தான் ஒருவனும் இல்லாமலிருந்தால்"
    }
   ]
  },
  {
   "id": "geneva/NUM.5.9",
   "source_hash": "1ef004de",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.5.9#p1-1ef004de",
     "text": "அல்லது, கர்த்தருக்குப் படைக்கப்படும் பொருள்கள், முதற்பலன்கள் முதலியவை.",
     "anchor": "இஸ்ரவேல் மக்கள் ஏறெடுத்துப் படைக்கும்படி... பரிசுத்தமான படைப்பு"
    }
   ]
  },
  {
   "id": "geneva/NUM.5.12",
   "source_hash": "61d580f4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.5.12#p1-61d580f4",
     "text": "திருமண பந்தத்தை முறித்து, விபசாரம் செய்வதினால்.",
     "anchor": "பிறர்முகம் பார்த்து"
    }
   ]
  },
  {
   "id": "geneva/NUM.5.15",
   "source_hash": "cc64aaf2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.5.15#p1-334f2f3c",
     "text": "பாவநிவாரணபலியில் மாத்திரமே, அப்படியே இந்த எரிச்சலின் காணிக்கையிலும் எண்ணெயும் தூபவர்க்கமும் படைக்கப்படவில்லை.",
     "anchor": "அதின்மேல் எண்ணெய் ஊற்றாமலும்"
    },
    {
     "id": "geneva/NUM.5.15#p2-e298ad1a",
     "text": "அல்லது, பாவத்தை நினைப்பூட்டுவது, அதை நிவிர்த்தி செய்வதல்ல.",
     "anchor": "நினைப்பூட்டும்"
    }
   ]
  },
  {
   "id": "geneva/NUM.5.17",
   "source_hash": "4d16108d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.5.17#p1-4d16108d",
     "text": "இது தீட்டுக்கழிக்கும் சுத்திகரிப்பின் தெளிப்புத் தண்ணீர் என்றும் அழைக்கப்படுகிறது, எண்ணாகமம் 19:9 ஐ வாசிக்கவும்.",
     "anchor": "பரிசுத்த தண்ணீர் ஒரு மண்பானையிலே"
    }
   ]
  },
  {
   "id": "geneva/NUM.5.18",
   "source_hash": "6790a9ed",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.5.18#p1-6790a9ed",
     "text": "அது அதன் விளைவினால் அப்படி அழைக்கப்பட்டது, ஏனெனில் அது அந்தப் பெண் சபிக்கப்பட்டவளாக இருப்பதையும், அவளுடைய அழிவுக்கு மாறியதையும் காண்பித்தது.",
     "anchor": "சாபகாரணமான"
    }
   ]
  },
  {
   "id": "geneva/NUM.5.21",
   "source_hash": "6a1bd683",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.5.21#p1-6a1bd683",
     "text": "அவள் மிகவும் அருவருப்பான குற்றத்தைச் செய்ததினாலும், அதை மறுத்து தன்னைத்தானே பொய்யாக ஆணையிட்டதினாலுமே இப்படிச் சொல்லப்படுகிறது.",
     "anchor": "சாபமும் ஆணையிடும் அடையாளமாகவும்"
    }
   ]
  },
  {
   "id": "geneva/NUM.5.22",
   "source_hash": "d6eb8fd8",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.5.22#p1-d6eb8fd8",
     "text": "அதாவது, நீ விரும்பியபடியே ஆகக்கடவது, சங்கீதம் 41:13; உபாகமம் 27:15-ல் உள்ளதுபோல.",
     "anchor": "ஆமென்"
    }
   ]
  },
  {
   "id": "geneva/NUM.5.23",
   "source_hash": "a5835301",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.5.23#p1-a5835301",
     "text": "எழுதப்பட்ட சாபங்களை, பாத்திரத்தில் இருக்கும் தண்ணீரில் கழுவிப்போடவேண்டும்.",
     "anchor": "கசப்பான தண்ணீரால் கழுவிப்போட்டு"
    }
   ]
  },
  {
   "id": "geneva/NUM.5.26",
   "source_hash": "7e437e3f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.5.26#p1-7e437e3f",
     "text": "தூபங்காட்டப்படும் இடம்.",
     "anchor": "பீடத்தின்மேல்"
    }
   ]
  },
  {
   "id": "geneva/NUM.5.31",
   "source_hash": "1c804ed0",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.5.31#p1-1c804ed0",
     "text": "சந்தேகத்தின்பேரில் கணவன் தன் மனைவியின்மேல் குற்றம் சாட்டியிருந்தும் அவன் கடிந்துகொள்ளப்படமாட்டான்.",
     "anchor": "கணவன் அக்கிரமத்திற்கு நீங்கலாக இருப்பான்"
    }
   ]
  }
 ]
}
