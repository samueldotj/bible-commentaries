 "units": [
  {
   "id": "geneva/NUM.21.1",
   "source_hash": "c08a2096",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.21.1#p1-c08a2096",
     "text": "அவர்களுடைய ஆபத்துகளை ஆராய்ந்த வேவுகாரர்கள் மிகவும் பாதுகாப்பானதாகக் கண்டறிந்த அந்த வழியின் வாயிலாக.",
     "anchor": "வேவுகாரர்கள் காண்பித்த வழி"
    }
   ]
  },
  {
   "id": "geneva/NUM.21.4",
   "source_hash": "7f14b02e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.21.4#p1-7f14b02e",
     "text": "ஏனெனில் அதை அழிக்கக் கூடாது என்று அவர்களுக்குத் தடை செய்யப்பட்டிருந்தது, உபாகமம் 2:5.",
     "anchor": "ஏதோம் தேசத்தைச் சுற்றிப்போகும்படி"
    }
   ]
  },
  {
   "id": "geneva/NUM.21.5",
   "source_hash": "0dbb7396",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.21.5#p1-0dbb7396",
     "text": "போஷிக்காது என்று அவர்கள் நினைத்த மன்னாவைக் குறிக்கிறது.",
     "anchor": "அப்பமும்"
    }
   ]
  },
  {
   "id": "geneva/NUM.21.6",
   "source_hash": "2b6bac16",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.21.6#p1-2b6bac16",
     "text": "ஏனெனில் அவைகளால் கடிக்கப்பட்டவர்கள் அவைகளின் விஷத்தினால் இவ்வளவு எரிச்சலடையச் செய்யப்பட்டு, அதனால் இறந்துபோனார்கள்.",
     "anchor": "விஷமுள்ள பாம்புகளை மக்களுக்குள்ளே அனுப்பினார்"
    }
   ]
  },
  {
   "id": "geneva/NUM.21.14",
   "source_hash": "669f3ef5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.21.14#p1-669f3ef5",
     "text": "இது நியாயாதிபதிகளின் புஸ்தகமாக இருக்கலாம் என்று தோன்றுகிறது; அல்லது சிலர் நினைப்பதுபோல, இப்போது இல்லாமல் போன ஒரு புஸ்தகமாக இருக்கலாம்.",
     "anchor": "யெகோவாவுடைய யுத்தங்களின் புஸ்தகம்"
    }
   ]
  },
  {
   "id": "geneva/NUM.21.17",
   "source_hash": "04cf3100",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.21.17#p1-04cf3100",
     "text": "இதன் பயனைப் பெறுகிற நீங்கள், இதற்காகத் துதியுங்கள்.",
     "anchor": "அதைக்குறித்துப் பாடுவோம்"
    }
   ]
  },
  {
   "id": "geneva/NUM.21.18",
   "source_hash": "69eec912",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.21.18#p1-69eec912",
     "text": "மோசேயும் ஆரோனும் மாத்திரம், மக்களின் தலைவர்களாக, தண்டால் அல்லது கோலால் கன்மலையை அடித்தார்கள்; அது ஆழமாகத் தோண்டப்பட்ட கிணறு போல தண்ணீரைக் கொடுத்தது.",
     "anchor": "நியாயப்பிரமாணத் தலைவனின்"
    }
   ]
  },
  {
   "id": "geneva/NUM.21.24",
   "source_hash": "0c8240b8",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.21.24#p1-ce430cdc",
     "text": "ஆறு.",
     "anchor": "யாப்போக்குவரைக்கும்"
    },
    {
     "id": "geneva/NUM.21.24#p2-14767804",
     "text": "ஏனெனில் அந்த மக்கள் இராட்சதரைப்போல் நெடிய உயரமும் பலமும் உடையவர்களாக இருந்தார்கள்; உபாகமம் 2:20.",
     "anchor": "பாதுகாப்பானதாக இருந்தது"
    }
   ]
  },
  {
   "id": "geneva/NUM.21.26",
   "source_hash": "7baf513a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.21.26#p1-7baf513a",
     "text": "ஏனெனில் அது மோவாபியருடையதாக இருந்திருந்தால், இஸ்ரவேலர்கள் அதைச் சொந்தமாக்கிக்கொள்ள முடியாதிருந்திருக்கும், உபாகமம் 2:9.",
     "anchor": "எஸ்போனானது எமோரியர்களின் ராஜாவாகிய சீகோனின் பட்டணமாக இருந்தது"
    }
   ]
  },
  {
   "id": "geneva/NUM.21.28",
   "source_hash": "f4e1d94b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.21.28#p1-f4e1d94b",
     "text": "அதாவது, யுத்தத்தைக் குறிக்கும்.",
     "anchor": "எஸ்போனிலிருந்து அக்கினியும்"
    }
   ]
  },
  {
   "id": "geneva/NUM.21.29",
   "source_hash": "7cc72751",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/NUM.21.29#p1-7cc72751",
     "text": "கேமோஷ் என்பது மோவாபியரின் விக்கிரகமாக இருந்தான், 1 இராஜாக்கள் 11:33; அவன் தன்னை ஆராதனை செய்தவர்களை, அவ்விக்கிரகத்தைத் தங்கள் தகப்பனாகக் கருதினவர்களைப் பாதுகாக்க வல்லவனாக இருக்கவில்லை.",
     "anchor": "கேமோஷ்"
    }
   ]
  }
 ]
}
