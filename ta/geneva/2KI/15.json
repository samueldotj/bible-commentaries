 "units": [
  {
   "id": "geneva/2KI.15.3",
   "source_hash": "6d0c5fd5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.15.3#p1-6d0c5fd5",
     "text": "அவன் தீர்க்கதரிசியாகிய சகரியாவின் சொல்லைக் கேட்டு நடந்தமட்டும்.",
     "anchor": "யெகோவாவின் பார்வைக்குச் செம்மையானதை"
    }
   ]
  },
  {
   "id": "geneva/2KI.15.5",
   "source_hash": "8640c5d3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.15.5#p1-58076cc7",
     "text": "இவனுடைய தகப்பனும் தாத்தனும் தங்கள் குடிமக்களாலும் வேலையாட்களாலும் கொலைசெய்யப்பட்டார்கள்; இவனோ தேவனுடைய நியமத்திற்கு விரோதமாக ஆசாரியப் பணியை கபடமாய் கையேற்க முயன்றதால், தேவனுடைய கரத்தால் உடனே தொழுநோயால் வாதிக்கப்பட்டான், 2 நாளாகமம் 26:21.",
     "anchor": "இந்த ராஜாவை வாதித்ததால்"
    },
    {
     "id": "geneva/2KI.15.5#p2-8e7e1126",
     "text": "தன் தகப்பனுக்கு பிரதிநிதியாகவும் சார்பு ஆளுநனாகவும்.",
     "anchor": "தேசத்தின் மக்களை நியாயம் விசாரித்தான்"
    }
   ]
  },
  {
   "id": "geneva/2KI.15.8",
   "source_hash": "bab8742e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.15.8#p1-bab8742e",
     "text": "இவன் யெகூவிலிருந்து நான்காம் வம்சாவளியில் வந்தவன்; யெகூ தேவனுடைய வாக்குத்தத்தத்தின்படி ஆட்சிசெய்தான், ஆனால் இவனில் தேவன் யெகூவின் வம்சத்திற்கு விரோதமாக தமது கடுங்கோபத்தை நிறைவேற்றத் தொடங்கினார்.",
     "anchor": "மாதங்கள்"
    }
   ]
  },
  {
   "id": "geneva/2KI.15.10",
   "source_hash": "65158bea",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.15.10#p1-65158bea",
     "text": "இஸ்ரவேலில் வாரிசாக ராஜ்யத்தைப் பெற்ற கடைசி அரசன் சகரியா ஆவான், மெனாகேமின் மகனாகிய பெக்காகியா மாத்திரமே இரண்டு வருடங்கள் மட்டும் ஆண்டான்.",
     "anchor": "வெட்டிக் கொன்றுபோட்டு"
    }
   ]
  },
  {
   "id": "geneva/2KI.15.16",
   "source_hash": "795316f7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.15.16#p1-795316f7",
     "text": "இது தன்னை ராஜாவாக ஏற்றுக்கொள்ள மனதில்லாமலிருந்த இஸ்ரவேலின் ஒரு பட்டணமாக இருந்தது.",
     "anchor": "திப்சா"
    }
   ]
  },
  {
   "id": "geneva/2KI.15.19",
   "source_hash": "4d8e3d9c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.15.19#p1-df2bdbbc",
     "text": "அதாவது, இஸ்ரவேலின்.",
     "anchor": "தேசத்திற்கு"
    },
    {
     "id": "geneva/2KI.15.19#p2-12105149",
     "text": "தேவனிடத்தில் உதவியைத் தேடாமல், அவன் பணத்தினால் இந்த அரசனுடைய தயவைப் பெற முயன்றான்; இவன் அவிசுவாசி; ஆகையால் தேவன் அவனைக் கைவிட்டார், பூல் விரைவில் தன் வாக்குத்தத்தங்களை முறித்து, அவனுடைய தேசத்தை அழித்து, அவனுடைய மக்களைச் சிறையிருப்பிற்குக் கொண்டுபோனான்.",
     "anchor": "ஆயிரம் தாலந்து வெள்ளி"
    }
   ]
  },
  {
   "id": "geneva/2KI.15.25",
   "source_hash": "30b597a2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.15.25#p1-30b597a2",
     "text": "இவர்கள் அந்தச் சதித்திட்டத்திலே கூட இருந்தவர்கள்.",
     "anchor": "அர்கோபையும் ஆரியேயையும"
    }
   ]
  },
  {
   "id": "geneva/2KI.15.29",
   "source_hash": "21252842",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.15.29#p1-21252842",
     "text": "தேவன் இஸ்ரவேலின் பாவங்களினிமித்தம் பூலையும் திகிலாத்பிலேசரையும் அவர்களுக்கு எதிராக எழுப்பினார், 1 நாளாகமம் 5:26.",
     "anchor": "திகிலாத்பிலேசர் வந்து"
    }
   ]
  },
  {
   "id": "geneva/2KI.15.34",
   "source_hash": "4565c0e6",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.15.34#p1-4565c0e6",
     "text": "அவனுடைய செம்மைத்தன்மை முழுமையானதாக இருக்கவில்லை, மாறாக அவனுக்கு அநேக பெருங்குற்றங்கள் இருந்தன என்பதைக் காண்பிக்கிறார்.",
     "anchor": "தன் தகப்பனாகிய உசியா செய்தபடியெல்லாம்"
    }
   ]
  },
  {
   "id": "geneva/2KI.15.37",
   "source_hash": "738c6491",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.15.37#p1-9662b781",
     "text": "யோதாம் இறந்தபின்பு.",
     "anchor": "அந்நாட்களிலே யெகோவா அனுப்பத்தொடங்கினார்"
    },
    {
     "id": "geneva/2KI.15.37#p2-1afbe8ef",
     "text": "இவன் யூதாவின் போராளிகளில் ஒரே நாளில் 1,20,000 பேரைக் கொன்றுபோட்டான் 2 நாளாகமம் 28:6, ஏனெனில் அவர்கள் மெய்யான தேவனை விட்டுவிட்டார்கள்.",
     "anchor": "ரெமலியாவின் மகனாகிய பெக்காவையும்"
    }
   ]
  }
 ]
}
