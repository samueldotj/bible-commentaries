 "chapter": 3,
 "lang": "ta",
 "units": [
  {
   "id": "geneva/2KI.3.1",
   "source_hash": "89127706",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.3.1#p1-89127706",
     "text": "2 இராஜாக்கள் 1:17-லுள்ள குறிப்பை வாசிக்கவும்.",
     "anchor": "யூதாவின் ராஜாவாகிய யோசபாத்தின் பதினெட்டாம் வருட ஆட்சியில்"
    }
   ]
  },
  {
   "id": "geneva/2KI.3.3",
   "source_hash": "6bfe7bce",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.3.3#p1-6bfe7bce",
     "text": "யெரொபெயாம் உண்டாக்கின பொற்கன்றுக்குட்டிகளுக்கு அவன் பலியிட்டான்.",
     "anchor": "நேபாத்தின் மகனாகிய யெரொபெயாமின் பாவங்களை"
    }
   ]
  },
  {
   "id": "geneva/2KI.3.4",
   "source_hash": "93d16f0b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.3.4#p1-93d16f0b",
     "text": "தாவீது மோவாபியரைத் தமது வாரிசுகளுக்குத் திறை செலுத்துகிறவர்களாக ஆக்கினதற்குப் பின்பு இது நடந்தது.",
     "anchor": "மோவாபின் ராஜாவாகிய மேசா"
    }
   ]
  },
  {
   "id": "geneva/2KI.3.7",
   "source_hash": "ad297694",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.3.7#p1-ad297694",
     "text": "1 இராஜாக்கள் 22:4-ஐ வாசிக்கவும்.",
     "anchor": "நான்தான் நீர்"
    }
   ]
  },
  {
   "id": "geneva/2KI.3.9",
   "source_hash": "dde0cc1c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.3.9#p1-dde0cc1c",
     "text": "யூதாவின் ராஜாவினுடைய பிரதிராஜாவைக் குறிக்கிறது, 1 இராஜாக்கள் 22:47.",
     "anchor": "ஏதோமின் ராஜாவும்"
    }
   ]
  },
  {
   "id": "geneva/2KI.3.11",
   "source_hash": "66d6da39",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.3.11#p1-66d6da39",
     "text": "அதாவது, அவனுடைய வேலைக்காரனாக இருந்தான் என்பது.",
     "anchor": "கைகளுக்குத் தண்ணீர் ஊற்றிய"
    }
   ]
  },
  {
   "id": "geneva/2KI.3.12",
   "source_hash": "f16e923c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.3.12#p1-f16e923c",
     "text": "இந்தக் காரியத்தில் தேவனுடைய சித்தம் என்ன என்பதை அவன் நமக்குக் கற்பிக்க வல்லவன்.",
     "anchor": "யெகோவாவுடைய வார்த்தை அவனிடத்தில் இருக்கிறது"
    }
   ]
  },
  {
   "id": "geneva/2KI.3.13",
   "source_hash": "d2c2189b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.3.13#p1-c5376ece",
     "text": "இந்த துன்மார்க்க ராஜா தன் காரியத்தை சாதிக்கும்படி மட்டுமே தன் ஆலோசனையைப் பயன்படுத்திக் கொள்வான் என்று அவன் அறிந்திருந்தான்; ஆகையால் அவனுக்கு பதில் சொல்வதை அவமானமாக எண்ணினான்.",
     "anchor": "எனக்கும் உமக்கும் என்ன?"
    },
    {
     "id": "geneva/2KI.3.13#p2-9b9f05ef",
     "text": "துன்மார்க்கர் தேவனுடைய ஊழியக்காரரை மதிப்பதில்லை, தற்போதுள்ள ஆபத்தினால் ஏற்படும் தேவை மற்றும் பயத்தினால் நெருக்கப்படும்போதே ஒழிய.",
     "anchor": "அப்படியல்ல"
    }
   ]
  },
  {
   "id": "geneva/2KI.3.14",
   "source_hash": "147761b4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.3.14#p1-147761b4",
     "text": "தேவன் துன்மார்க்கருக்குள் இருக்கிற தேவபக்தியுள்ளவர்களினிமித்தம், அவருடைய வார்த்தையானது துன்மார்க்கருக்கும் அறிவிக்கப்படுவதற்கு இடங்கொடுக்கிறார்.",
     "anchor": "நான் உம்மைக் கவனிக்கவும் பார்க்கவுமாட்டேன்"
    }
   ]
  },
  {
   "id": "geneva/2KI.3.15",
   "source_hash": "73f5735d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.3.15#p1-73f5735d",
     "text": "அவன் தேவனுடைய மகிமைக்கென்று பாடல்களைப் பாடினான், இதனால் தீர்க்கதரிசியின் இருதயத்தைத் தீர்க்கதரிசனம் சொல்ல எழுப்பினான்.",
     "anchor": "வாசித்தபோது"
    }
   ]
  },
  {
   "id": "geneva/2KI.3.18",
   "source_hash": "21431067",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.3.18#p1-21431067",
     "text": "அவர் அற்புதமாக உங்களுக்குத் தண்ணீரை மட்டும் கொடுப்பதோடல்லாமல், உங்கள் சத்துருக்களையும் உங்கள் கையிலே ஒப்புக்கொடுப்பார்.",
     "anchor": "பார்வைக்கு சாதாரணகாரியம்"
    }
   ]
  },
  {
   "id": "geneva/2KI.3.19",
   "source_hash": "3cab02e1",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.3.19#p1-3cab02e1",
     "text": "தேவன் சத்துருக்களுக்கு சிலகாலம் தமது நன்மைகளை அளித்தாலும், அவற்றை எடுத்துக்கொள்ளும் தமது காலங்களை வைத்திருக்கிறார்; அவர்கள் தங்களுக்கு ஆயத்தமாயிருக்கும் அவருடைய கோபத்தை காணும்படியே அப்படிச் செய்கிறார்.",
     "anchor": "நல்ல நிலத்தையெல்லாம் கல்மேடுகளாக்கிக் கெடுப்பீர்கள்"
    }
   ]
  },
  {
   "id": "geneva/2KI.3.23",
   "source_hash": "8d972af0",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.3.23#p1-8d972af0",
     "text": "துன்மார்க்கருடைய திடீர் மகிழ்ச்சி அவர்களுடைய அழிவுக்கான ஆயத்தமே அன்றி வேறல்ல, அந்த அழிவு சமீபமாயிருக்கிறது.",
     "anchor": "இது இரத்தம்"
    }
   ]
  },
  {
   "id": "geneva/2KI.3.24",
   "source_hash": "9b103439",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.3.24#p1-9b103439",
     "text": "அதாவது, அவர்கள் அவர்களைப் பட்டணங்கள் வரைக்கும் பின்தொடர்ந்து சென்றார்கள் என்று பொருள்.",
     "anchor": "அவர்களுடைய தேசத்திற்குள் புகுந்து, அங்கேயும் மோவாபியர்களைத் தாக்கி"
    }
   ]
  },
  {
   "id": "geneva/2KI.3.25",
   "source_hash": "38085318",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.3.25#p1-38085318",
     "text": "இது மோவாபியரின் பிரதான பட்டணங்களில் ஒன்றாக இருந்தது; அதில் அவர்கள் மதில்களைத் தவிர வேறொன்றையும் விட்டு வைக்கவில்லை.",
     "anchor": "கிராரேசேத்திலே மாத்திரம் அதின் மதில்கள்"
    }
   ]
  },
  {
   "id": "geneva/2KI.3.27",
   "source_hash": "675d2eb4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.3.27#p1-675d2eb4",
     "text": "சிலர் இதை ஏதோமின் ராஜாவின் மகனைக் குறிக்கிறது என்று சொல்கிறார்கள், அவனை அந்தச் சண்டையில் பிடித்திருந்தான் என்பர்: ஆனால் இது அவனுடைய சொந்த மகனாகவே இருந்திருக்க வேண்டும், அவனைத் தன் தெய்வங்களைச் சாந்தப்படுத்துவதற்காகப் பலியிட்டான்: இந்தக் காரிய கொடுமை இஸ்ரவேலரின் இருதயங்களில் மனதுருக்கத்தை எழுப்பி, அவர்களைப் புறப்பட்டுப் போகச் செய்தது.",
     "anchor": "அவனைச் சர்வாங்க தகனமாகப் பலியிட்டான்"
    }
   ]
  }
 ]
}
