 "units": [
  {
   "id": "geneva/2KI.5.1",
   "source_hash": "3f5f22c9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.5.1#p1-3f5f22c9",
     "text": "அவிசுவாசிகளுக்குள்ளும் தேவனுக்குச் சொந்தமானவர்கள் உண்டு என்றும், அவிசுவாசிகளும் தங்கள் நாட்டுக்கு நன்மை செய்கிறவர்களை மதிக்கிறார்கள் என்றும் இதிலிருந்து தெரிகிறது.",
     "anchor": "சீரியாவுக்கு வெற்றியை"
    }
   ]
  },
  {
   "id": "geneva/2KI.5.3",
   "source_hash": "479e129e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.5.3#p1-479e129e",
     "text": "எலிசாவைக் குறிக்கிறது.",
     "anchor": "சமாரியாவிலிருக்கிற தீர்க்கதரிசியினிடத்தில்"
    }
   ]
  },
  {
   "id": "geneva/2KI.5.4",
   "source_hash": "231e4e31",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.5.4#p1-231e4e31",
     "text": "அதாவது, நாகமான் இதைச் சீரியா ராஜாவுக்கு அறிவித்தான்.",
     "anchor": "நாகமான் போய்"
    }
   ]
  },
  {
   "id": "geneva/2KI.5.5",
   "source_hash": "a0364bf4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.5.5#p1-a0364bf4",
     "text": "இதை தீர்க்கதரிசிகளுக்கு ஒரு வெகுமதியாகக் கொடுப்பதற்காக.",
     "anchor": "பத்துத்தாலந்து வெள்ளியையும்"
    }
   ]
  },
  {
   "id": "geneva/2KI.5.8",
   "source_hash": "271ca351",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.5.8#p1-271ca351",
     "text": "தேவன் தம்முடைய வாக்குத்தத்தத்தில் உண்மையுள்ளவராக இருக்கிறாரென்பதையும், அதினிமித்தம் தம்முடைய சபையை ஒரு தீர்க்கதரிசியில்லாமல் விட்டுவிடமாட்டாரென்பதையும், அந்தத் தீர்க்கதரிசியின் ஜெபத்தை தேவன் கேட்பாரென்பதையும், மற்றவர்கள் ஆறுதலுக்காக அவனிடத்தில் ஓடிவரலாம் என்பதையும் அறியாமல் இருந்ததினிமித்தம் தீர்க்கதரிசி ராஜாவை கடிந்துகொள்ளுகிறான்.",
     "anchor": "நீர் உம்முடைய உடைகளை ஏன் கிழித்துக்கொள்ளவேண்டும்?"
    }
   ]
  },
  {
   "id": "geneva/2KI.5.11",
   "source_hash": "d6d8570d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.5.11#p1-d6d8570d",
     "text": "மனுஷ்யனுடைய அறிவு அடையாளங்களையும் வெளித்தோற்றமான காரியங்களையும் மட்டும் கவனிக்கும்போது முறுமுறுக்கிறது, அங்கே அடங்கியிருக்கும் தேவவசனத்தை அது கவனிக்கவில்லை.",
     "anchor": "கடுங்கோபம்கொண்டு"
    }
   ]
  },
  {
   "id": "geneva/2KI.5.13",
   "source_hash": "ee3c0bc9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.5.13#p1-ee3c0bc9",
     "text": "பிள்ளைகள் தங்கள் தகப்பன்மார்களைப் போன்று ஊழியக்காரர் தங்கள் எஜமான்களைப் பற்றி மதிப்பும் அன்பும் கொண்டிருக்க வேண்டும் என்றும், அதேபோல எஜமான்களும் தங்கள் ஊழியக்காரர்களை நோக்கி தங்கள் பிள்ளைகளைப் போன்று அன்புவைத்திருக்க வேண்டும் என்றும் இது காண்பிக்கிறது.",
     "anchor": "தகப்பனே"
    }
   ]
  },
  {
   "id": "geneva/2KI.5.16",
   "source_hash": "dedd172e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.5.16#p1-dedd172e",
     "text": "இவ்விதமாக, இலவசமாகப் பெற்றவர்கள் இலவசமாகவே கொடுக்கவேண்டும் என்று கர்த்தர் கட்டளையிடுகிறார்.",
     "anchor": "மறுத்துவிட்டான்"
    }
   ]
  },
  {
   "id": "geneva/2KI.5.18",
   "source_hash": "ce2562b1",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.5.18#p1-ce2562b1",
     "text": "விக்கிரக ஆராதனையின்போது தான் அங்கே இருந்ததினால் தன் மனச்சாட்சி காயப்பட்டதாக அவன் உணருகிறான், ஆகையால் தன் மாதிரியினால் மற்றவர்கள் விக்கிரக ஆராதனையில் விழுந்துவிடாதபடிக்கு தேவன் தன்னை மன்னிக்கவேண்டும் என்று விரும்புகிறான்; ஏனெனில் தன் சொந்த காரியத்திற்கு அவன் அறிக்கையிடுகிறான், தான் ஒருபோதும் மெய்யான தேவனையேயன்றி வேறொருவரையும் சேவிக்கமாட்டேன் என்று.",
     "anchor": "உமது அடியேனுக்கு மன்னிப்பாராக"
    }
   ]
  },
  {
   "id": "geneva/2KI.5.19",
   "source_hash": "29eaa051",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.5.19#p1-29eaa051",
     "text": "தீர்க்கதரிசி அவனுடைய செயலை ஏற்றுக்கொள்ளவில்லை, ஆனாலும் வழக்கமான பேச்சு முறையின்படி அவனிடம் விடைபெற்றுப் போகும்படி சொன்னான்.",
     "anchor": "சமாதானத்தோடே போ"
    }
   ]
  },
  {
   "id": "geneva/2KI.5.21",
   "source_hash": "aab9b178",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.5.21#p1-aab9b178",
     "text": "இதனால் அவன் தன் எஜமானாகிய தீர்க்கதரிசியின்மேல் வைத்திருந்த மதிப்பையும் அன்பையும் காண்பித்தான்.",
     "anchor": "இரதத்திலிருந்து குதித்து"
    }
   ]
  },
  {
   "id": "geneva/2KI.5.24",
   "source_hash": "a47b906f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.5.24#p1-a47b906f",
     "text": "நாகமானின் வேலைக்காரர்கள்.",
     "anchor": "அவர்கள்"
    }
   ]
  },
  {
   "id": "geneva/2KI.5.26",
   "source_hash": "4c16babf",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.5.26#p1-ecee6a5b",
     "text": "நான் ஆவியில் உன்னுடன் கூட இருக்கவில்லையா என்பது பொருள்.",
     "anchor": "என் மனம் உன்னுடன்கூடச் செல்லவில்லையா"
    },
    {
     "id": "geneva/2KI.5.26#p2-8c25bb39",
     "text": "அதாவது, சொத்துக்களை வாங்குவதற்கான பணம்; தேவனுடைய ஊழியர்கள் பொருளாசை உள்ள மனதைக் கொண்டிருப்பது அருவருப்பானது என்பதைக் குறிக்கிறது.",
     "anchor": "ஒலிவத்தோப்புகளையும்"
    }
   ]
  },
  {
   "id": "geneva/2KI.5.27",
   "source_hash": "395d6efd",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.5.27#p1-395d6efd",
     "text": "பொருளாசையினால் தேவனுடைய வார்த்தை அவதூறாக்கப்படக்கூடிய எல்லோருக்கும் ஒரு எடுத்துக்காட்டாக இருப்பதற்காக.",
     "anchor": "சந்ததியாரையும் என்றைக்கும்"
    }
   ]
  }
 ]
}
