 "units": [
  {
   "id": "geneva/2KI.4.1",
   "source_hash": "1e0e492b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.4.1#p1-256f63d6",
     "text": "2 இராஜாக்கள் 2:3.",
     "anchor": "தீர்க்கதரிசிகளுடைய கூட்டத்தாரில் ஒருவனுக்கு மனைவியாயிருந்த ஒரு பெண் எலிசாவைப் பார்த்து கூப்பிட்டாள்"
    },
    {
     "id": "geneva/2KI.4.1#p2-5abb2b74",
     "text": "ஆகவே அவன் அசதியினாலோ அல்லது ஆடம்பரத்தினாலோ அல்ல, கர்த்தருடைய கரத்தினாலேயே கடனில் விழுந்தான்.",
     "anchor": "யெகோவாவுக்குப் பயந்து நடந்தான்"
    },
    {
     "id": "geneva/2KI.4.1#p3-36d2ac11",
     "text": "நான் ஏழையாயிருந்து கடனைத் திருப்பிச் செலுத்த இயலாதவளாயிருந்தபடியால்.",
     "anchor": "அடிமைகளாக்கிக்கொள்ள"
    }
   ]
  },
  {
   "id": "geneva/2KI.4.2",
   "source_hash": "bd013212",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.4.2#p1-bd013212",
     "text": "இவ்விதமாக தேவன் தம்முடையவர்களை உதவி செய்யும் முன்பாக அநேகமுறை மிகுந்த தேவையான நிலைக்குக் கொண்டுவரப்படும்படி அனுமதிக்கிறார், பின்பு அவர்கள் அவருடைய இரக்கத்தை இன்னும் அதிகமாகத் துதிக்கும்படியாக.",
     "anchor": "ஒரு குடம் எண்ணெயை"
    }
   ]
  },
  {
   "id": "geneva/2KI.4.4",
   "source_hash": "158e4962",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.4.4#p1-158e4962",
     "text": "இதின்மூலமாக தீர்க்கதரிசி அவளுக்குத் தெரியப்படுத்துகிறார், தேவன் தம்முடைய ஊழியக்காரர்களையும் அவர்களுடைய மனைவிகளையும் பிள்ளைகளையும் தம்மைச் சார்ந்திருந்தால், ஒருபோதும் பராமரிக்காமல் விடுவதில்லை என்று.",
     "anchor": "அந்தப் பாத்திரங்கள் எல்லாவற்றிலும்"
    }
   ]
  },
  {
   "id": "geneva/2KI.4.6",
   "source_hash": "6521d0d3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.4.6#p1-6521d0d3",
     "text": "அல்லது பெருகுவது நின்றுவிட்டது.",
     "anchor": "நின்றுபோனது"
    }
   ]
  },
  {
   "id": "geneva/2KI.4.7",
   "source_hash": "d49f815a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.4.7#p1-d49f815a",
     "text": "தேவன் இங்கே தம்முடைய ஊழியக்காரனுக்காக அவனுடைய கடன்கள் தீர்க்கப்பட்டு, இவ்வாறு அவனுடைய உபதேசமும் அறிக்கையும் அவதூறு இல்லாமல் காக்கப்படும்படி செய்ததுமல்லாமல், அவனுடைய மனைவிக்கும் மகன்களுக்கும் ஏற்பாடு செய்தார்.",
     "anchor": "மீதம் இருக்கிறதைக்கொண்டு"
    }
   ]
  },
  {
   "id": "geneva/2KI.4.10",
   "source_hash": "f84c64a1",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.4.10#p1-f84c64a1",
     "text": "இது வீட்டின் மற்ற பகுதியிலிருந்து பிரிக்கப்பட்டதாக இருக்கும், அதனால் அவர் அதிக வசதியாகச் சிந்தனையிலும் ஜெபத்திலும் தன்னை ஈடுபடுத்திக்கொள்ளலாம்.",
     "anchor": "சிறிய அறையை"
    }
   ]
  },
  {
   "id": "geneva/2KI.4.13",
   "source_hash": "2aef677e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.4.13#p1-71dd0719",
     "text": "இவ்விதமாகத் தேவனுடைய ஊழியக்காரர் தமக்குக் கிடைத்த நன்மைகளுக்கு நன்றி மறவாதவர்களாய் இருக்கிறார்கள்.",
     "anchor": "உனக்கு நான் என்ன செய்யவேண்டும்"
    },
    {
     "id": "geneva/2KI.4.13#p2-808892a6",
     "text": "தேவன் எனக்கு அனுப்பியதில் நான் திருப்தியாய் இருக்கிறேன், ஒருவர் மற்றொருவருக்குச் செய்யக்கூடிய எதிலும் எனக்குக் குறைவில்லை.",
     "anchor": "என் மக்களின் நடுவே நான் சுகமாகக் குடியிருக்கிறேன்"
    }
   ]
  },
  {
   "id": "geneva/2KI.4.14",
   "source_hash": "001fb468",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.4.14#p1-001fb468",
     "text": "இது வெட்கக்கேடானதாய் இருந்தது, ஆகையால் தன் எஜமான் அவளுக்குப் பிள்ளை பாக்கியம் கிடைக்கும்படி தேவனிடத்தில் ஜெபம்பண்ணவேண்டும் என்று அவன் விரும்பினான்.",
     "anchor": "குழந்தை இல்லை"
    }
   ]
  },
  {
   "id": "geneva/2KI.4.19",
   "source_hash": "1dfec25e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.4.19#p1-1dfec25e",
     "text": "அவனுடைய தலை பலமாகக் காயப்பட்டதால் அவன் அழுதான்.",
     "anchor": "என் தலை"
    }
   ]
  },
  {
   "id": "geneva/2KI.4.23",
   "source_hash": "b5b03d66",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.4.23#p1-b5b03d66",
     "text": "ஏனெனில் அப்படிப்பட்ட காலங்களில் மக்கள் உபதேசத்திற்காகவும் ஆறுதலுக்காகவும் தீர்க்கதரிசிகளிடத்தில் சேர்ந்துவருவது வழக்கமாயிருந்தது.",
     "anchor": "அமாவாசை"
    }
   ]
  },
  {
   "id": "geneva/2KI.4.27",
   "source_hash": "fbeac511",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.4.27#p1-fbeac511",
     "text": "தான் அவனைச் சந்தித்த மகிழ்ச்சியையும், தாழ்மையையும் காண்பிக்கும் அடையாளமாக.",
     "anchor": "அவனுடைய காலைப் பிடித்துக்கொண்டாள்"
    }
   ]
  },
  {
   "id": "geneva/2KI.4.29",
   "source_hash": "03be7548",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.4.29#p1-03be7548",
     "text": "வழியில் ஒன்றும் உன்னைத் தடுக்காதபடி வேகமாகச் செல்லவேண்டும், லூக்கா 10:4.",
     "anchor": "வழியில் யாரைச் சந்தித்தாலும்"
    }
   ]
  },
  {
   "id": "geneva/2KI.4.34",
   "source_hash": "c5908dcd",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.4.34#p1-c5908dcd",
     "text": "எலியாவும் சாரிபாத்தில் இருந்த விதவையின் மகனுக்கு இப்படியே செய்தான் (1 இராஜாக்கள் 17:21), பவுலும் அப்போஸ்தலருடைய நடபடிகள் 20:10-ல் இப்படியே செய்தான்; இது தேவவசனத்தைச் சுமந்து, ஆவிக்குரிய ஜீவனைப் பகிர்ந்துகொடுக்கிறவர்களுக்கு இருக்கவேண்டிய கவனிப்பைக் குறிக்கிறது.",
     "anchor": "அவன்மேல் குப்புறப் படுத்துக்கொண்டான்"
    }
   ]
  },
  {
   "id": "geneva/2KI.4.35",
   "source_hash": "b924ceb2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.4.35#p1-b924ceb2",
     "text": "அதாவது, அடிக்கடி.",
     "anchor": "ஏழுமுறை"
    }
   ]
  },
  {
   "id": "geneva/2KI.4.38",
   "source_hash": "e7af2cf6",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.4.38#p1-e7af2cf6",
     "text": "அதாவது, இஸ்ரவேல் தேசத்திலே.",
     "anchor": "தேசத்திலே"
    }
   ]
  },
  {
   "id": "geneva/2KI.4.39",
   "source_hash": "abae34a1",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.4.39#p1-abae34a1",
     "text": "இதை மருந்து செய்பவர்கள் கொலோகொவின்டிடா என்று அழைக்கிறார்கள், அது மலம் கழிக்கச் செய்வதில் மிகவும் கடுமையானதும் ஆபத்தானதுமாக இருக்கிறது.",
     "anchor": "கொம்மட்டிக் கொடி"
    }
   ]
  },
  {
   "id": "geneva/2KI.4.40",
   "source_hash": "a825aa69",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.4.40#p1-a825aa69",
     "text": "கூழின் கசப்பினால் தங்களுக்கு விஷம் ஏற்பட்டதென்று அவர்கள் பயந்தார்கள்.",
     "anchor": "பானையில் விஷம் இருக்கிறது"
    }
   ]
  },
  {
   "id": "geneva/2KI.4.43",
   "source_hash": "4473ffaf",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.4.43#p1-4473ffaf",
     "text": "திருப்தியாக்குவது அப்பத்தின் அளவு அல்ல, தேவன் அருளும் ஆசீர்வாதமே.",
     "anchor": "இன்னும் மீதியுண்டாயிருக்கும்"
    }
   ]
  }
 ]
}
