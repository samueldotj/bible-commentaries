 "units": [
  {
   "id": "geneva/2KI.14.3",
   "source_hash": "862b7f6d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.14.3#p1-862b7f6d",
     "text": "தன் அரசாட்சியின் ஆரம்பத்தில் அவன் தேவபக்திக்கானவைகளின் ஒரு வெளித்தோற்றத்தைக் காட்டினான்; ஆனாலும் பின்பு அவன் விக்கிரக ஆராதனையில் ஈடுபட்டு ஏதோமியரின் விக்கிரகங்களைத் தொழுதுகொண்டான்.",
     "anchor": "யெகோவாவின் பார்வைக்குச் செம்மையானதைச் செய்தான்"
    }
   ]
  },
  {
   "id": "geneva/2KI.14.6",
   "source_hash": "ebc07d55",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.14.6#p1-ebc07d55",
     "text": "ஏனெனில் அவர்கள் தங்கள் தகப்பன்மார் செய்த அந்தச் செயலுக்கு உடன்படவும் இல்லை, அதில் பங்குடையவர்களாகவும் இருக்கவில்லை.",
     "anchor": "கொல்லவில்லை"
    }
   ]
  },
  {
   "id": "geneva/2KI.14.7",
   "source_hash": "9519c341",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.14.7#p1-9519c341",
     "text": "தாவீது வசப்படுத்தியிருந்த ஏதோமியர்கள், யோசபாத்தின் மகன் யோராமின் காலத்தில் கலகம் செய்தார்கள்.",
     "anchor": "ஏதோமியர்களில் உப்புப்பள்ளத்தாக்கிலே"
    }
   ]
  },
  {
   "id": "geneva/2KI.14.8",
   "source_hash": "88d89b5c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.14.8#p1-88d89b5c",
     "text": "நாம் ஒருவரோடொருவர் கைகலந்து யுத்தம்செய்து அதினால் தீர்மானிப்போம், ஒருவருடைய பட்டணங்களை ஒருவர் அழிக்கவேண்டாம்.",
     "anchor": "நம்முடைய திறமையைப் பார்ப்போம்"
    }
   ]
  },
  {
   "id": "geneva/2KI.14.9",
   "source_hash": "242a75be",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.14.9#p1-242a75be",
     "text": "இந்த உவமையினாலே யோவாஸ் தன்னைப் பத்துக் கோத்திரங்களை அரசாண்ட பெரிய ராஜ்யத்தினிமித்தம் கேதுருமரத்திற்கும், அமத்சியாவை இரண்டே கோத்திரங்களை அரசாண்டதினிமித்தம் முட்செடிக்கும் ஒப்பிடுகிறார்; காட்டுமிருகங்கள் யூதாவின் பட்டணங்களைக் கொள்ளையிட்ட யோவாஸின் போர்வீரர்களைக் குறிக்கும்.",
     "anchor": "லீபனோனிலுள்ள கேதுருமரம்"
    }
   ]
  },
  {
   "id": "geneva/2KI.14.10",
   "source_hash": "3822161d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.14.10#p1-3822161d",
     "text": "வெற்றியைக் குறித்து பெருமை பாராட்டிக்கொண்டு, உன் வீட்டிலேயே இரு, என்னைத் தூண்டிவிடாதே.",
     "anchor": "பெருமை பாராட்டிக்கொண்டு உன் வீட்டிலே இரு"
    }
   ]
  },
  {
   "id": "geneva/2KI.14.14",
   "source_hash": "323573ad",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.14.14#p1-323573ad",
     "text": "அதாவது, சமாதானத்திற்கு நிச்சயமுமாக இஸ்ரவேலருக்கு யூதாவினர் ஒப்புக்கொடுத்த பிணைக்கைதிகள்.",
     "anchor": "பிணைக்கைதிகளையும்"
    }
   ]
  },
  {
   "id": "geneva/2KI.14.19",
   "source_hash": "d489e3a7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.14.19#p1-d489e3a7",
     "text": "இதை ரெகொபெயாம் யூதாவில் ஒரு அரணான பட்டணமாகக் கட்டினான், 2 நாளாகமம் 11:9.",
     "anchor": "லாகீசுக்கு"
    }
   ]
  },
  {
   "id": "geneva/2KI.14.21",
   "source_hash": "f82d6b71",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.14.21#p1-f82d6b71",
     "text": "இவன் உசியா என்றும் அழைக்கப்படுகிறான், 2 நாளாகமம் 26:1.",
     "anchor": "அசரியாவை"
    }
   ]
  },
  {
   "id": "geneva/2KI.14.22",
   "source_hash": "8e4dc5ef",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.14.22#p1-8e4dc5ef",
     "text": "இது ஏலோன் அல்லது ஏலோத் என்றும் அழைக்கப்படுகிறது.",
     "anchor": "ஏலாத்தைக்"
    }
   ]
  },
  {
   "id": "geneva/2KI.14.24",
   "source_hash": "27acc6a4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.14.24#p1-27acc6a4",
     "text": "இந்த விக்கிரக ஆராதனை மனுஷர் ஜீவனுள்ள தேவனை விட்டுவிட்டு, மனுஷனுடைய கைவேலையாகிய கன்றுக்குட்டிகளைத் தொழுதுகொள்வதற்கு ஏதுவாக அவ்வளவு அருவருக்கத்தக்கதும் நம்பமுடியாததுமாக இருந்தபடியால், எல்லா விக்கிரகங்களை ஆராதனை செய்கிறவர்களுக்கும் நிந்தையாக வேதவாக்கியம் இதைப் பலமுறை திரும்பத்திரும்பச் சொல்லுகிறது.",
     "anchor": "இஸ்ரவேலைப் பாவம்செய்யவைத்த நேபாத்தின் மகனாகிய யெரொபெயாமின் பாவங்கள்"
    }
   ]
  },
  {
   "id": "geneva/2KI.14.26",
   "source_hash": "fae5cf9c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.14.26#p1-fae5cf9c",
     "text": "1 இராஜாக்கள் 14:10-ஐ பார்க்க.",
     "anchor": "அடைபட்டவனும்"
    }
   ]
  },
  {
   "id": "geneva/2KI.14.28",
   "source_hash": "5a35f9c8",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.14.28#p1-5a35f9c8",
     "text": "இது சீரியாவின் அந்தியோகியா அல்லது ரிப்லா என்றும் அழைக்கப்பட்டது.",
     "anchor": "ஆமாத்தையும்"
    }
   ]
  }
 ]
}
