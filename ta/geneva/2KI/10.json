 "chapter": 10,
 "lang": "ta",
 "units": [
  {
   "id": "geneva/2KI.10.1",
   "source_hash": "3978c50f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.10.1#p1-3978c50f",
     "text": "பிள்ளைகள் அல்லது பேரப்பிள்ளைகளையும் வேதவாக்கியம் மகன்கள் என்று அழைக்கிறது.",
     "anchor": "மகன்கள் இருந்ததால்"
    }
   ]
  },
  {
   "id": "geneva/2KI.10.3",
   "source_hash": "57e6105e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.10.3#p1-57e6105e",
     "text": "அவர்கள் தன் பக்கத்தில் நிற்பார்களோ இல்லையோ என்று சோதிக்கும்படி அவன் இதை எழுதினான்.",
     "anchor": "அவனை அவன் தகப்பனுடைய சிங்காசனத்தின்மேல் வைத்து"
    }
   ]
  },
  {
   "id": "geneva/2KI.10.6",
   "source_hash": "aebe120e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.10.6#p1-aebe120e",
     "text": "நீதியுள்ள நியாயாதிபதியாகிய தேவன் துன்மார்க்கத் தாய் தந்தையர்களின் துன்மார்க்கப் பிள்ளைகளை மூன்றாம் நாலாம் தலைமுறை வரைக்கும் தண்டிக்கிறார்.",
     "anchor": "தலைகளைத் துண்டித்து"
    }
   ]
  },
  {
   "id": "geneva/2KI.10.9",
   "source_hash": "dc5cc744",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.10.9#p1-dc5cc744",
     "text": "ராஜாவின் மரணத்தினிமித்தம் நீங்கள் என்மேல் நியாயமாக ஆக்கினைத்தீர்ப்பு விதிக்கமுடியாது, ஏனெனில் நீங்களும் அவனுடைய சந்ததியாருக்கு அதையே செய்திருக்கிறீர்கள்; ஏனெனில் கர்த்தர் எனக்குக் கட்டளையிட்டார், அவரே தமது நியாயத்தீர்ப்பை நிறைவேற்றும்படி உங்களையும் ஏவினார்.",
     "anchor": "நீதிமான்களல்லவா"
    }
   ]
  },
  {
   "id": "geneva/2KI.10.11",
   "source_hash": "b3dec7b5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.10.11#p1-b3dec7b5",
     "text": "விக்கிரக ஆராதனை செய்யும் ஆசாரியர்களைக் குறிக்கிறது.",
     "anchor": "ஆசாரியர்களையும்"
    }
   ]
  },
  {
   "id": "geneva/2KI.10.14",
   "source_hash": "cfc49064",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.10.14#p1-cfc49064",
     "text": "இவ்விதமாக துன்மார்க்கரோடு யாதொரு பங்கும் நெருக்கமும் உள்ளவர்கள்மேல் தேவனுடைய பழிவாங்குதல் வரும்.",
     "anchor": "அவர்களில் ஒருவனையும் அவன் மீதியாக விடவில்லை"
    }
   ]
  },
  {
   "id": "geneva/2KI.10.15",
   "source_hash": "1e24f697",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.10.15#p1-1e24f697",
     "text": "ஏனெனில் அவன் தேவனுக்குப் பயந்திருந்தான், மற்றும் அந்தக் காலங்களின் துன்மார்க்கத்தைக் குறித்துப் புலம்பினான்: ஆகையால் யெகூ அவனுடன் இணைந்துகொள்ள சந்தோஷப்பட்டான்: ரேகாபைக்குறித்து எரேமியா 35:2ஐ வாசிக்கவும்.",
     "anchor": "அவனை உபசரித்து"
    }
   ]
  },
  {
   "id": "geneva/2KI.10.18",
   "source_hash": "992fe8c5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.10.18#p1-992fe8c5",
     "text": "இங்கே பாகால் என்பது சீதோனியரின் விக்கிரகமாகிய அஸ்தரோத்தைக் குறிக்கிறது, அதை யேசபேல் தொழுதுகொள்ளும்படி செய்தாள்; அது 1 இராஜாக்கள் 22:53-ல் அப்படியே பயன்படுத்தப்பட்டிருக்கிறது.",
     "anchor": "பாகாலைச் சேவித்தது கொஞ்சம்"
    }
   ]
  },
  {
   "id": "geneva/2KI.10.23",
   "source_hash": "40ac2bb7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.10.23#p1-40ac2bb7",
     "text": "இவ்விதமாகத் தேவன் தம்முடைய ஊழியக்காரர்கள் காப்பாற்றப்படவும், விக்கிரக ஆராதனை செய்பவர்கள் அழிக்கப்படவும் விரும்புகிறார்; அவர் நியாயப்பிரமாணத்திலேயும் இதை வெளிப்படையான கட்டளையாகக் கொடுத்திருக்கிறார், உபா. 13:5.",
     "anchor": "யெகோவாவின் ஊழியக்காரர்களில்"
    }
   ]
  },
  {
   "id": "geneva/2KI.10.25",
   "source_hash": "5964c748",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.10.25#p1-5964c748",
     "text": "அது சமாரியாவிற்கு அருகில் இருந்தது.",
     "anchor": "பாகாலின் கோவிலைச் சேர்ந்த இடம்"
    }
   ]
  },
  {
   "id": "geneva/2KI.10.30",
   "source_hash": "7c397a4a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.10.30#p1-7c397a4a",
     "text": "இவ்வாறு தேவன் ஆகாபின் குடும்பத்தின்மேல் தமது நியாயத்தீர்ப்பை நிறைவேற்றுவதில் அவன் காட்டிய வைராக்கியத்தை ஏற்றுக்கொண்டு பலனளிக்கிறார், இருந்தபோதிலும் அவனுடைய துன்மார்க்கம் பின்பு தண்டிக்கப்பட்டது.",
     "anchor": "நான்கு தலைமுறையாக"
    }
   ]
  }
 ]
}
