 "units": [
  {
   "id": "geneva/2KI.2.1",
   "source_hash": "89754178",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.2.1#p1-89754178",
     "text": "இஸ்ரவேல் மக்கள் யோர்தானைக் கடந்து வந்தபின்பும், வனாந்தரத்திலே நாற்பது வருடங்கள் இருந்தபின்பும் விருத்தசேதனம் பண்ணிக்கொள்ளப்பட்ட இடம் இதுவே, யோசுவா 5:9.",
     "anchor": "கில்கால்"
    }
   ]
  },
  {
   "id": "geneva/2KI.2.3",
   "source_hash": "adb5d8d6",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.2.3#p1-d5e02d3b",
     "text": "பரம உபதேசத்தினாலே புதிதாகப் பிறப்பிக்கப்பட்டவர்கள் என்பதால் இவ்வாறு அழைக்கப்படுகிறார்கள்.",
     "anchor": "தீர்க்கதரிசிகளின் கூட்டத்தார்"
    },
    {
     "id": "geneva/2KI.2.3#p2-f96b1da7",
     "text": "அதாவது, இனிமேல் உன் தலைவனாக இருக்கமாட்டார் என்பதாம்: ஏனெனில் தலையாக இருப்பது எஜமானாக இருப்பதாம், பாதத்தில் இருப்பது சீஷனாக இருப்பதாம்.",
     "anchor": "உனக்குத் தலைமையாயிருக்கிற"
    },
    {
     "id": "geneva/2KI.2.3#p3-d5db2ce2",
     "text": "ஏனெனில் கர்த்தர் அதை அவனுக்கு வெளிப்படுத்தியிருந்தார்.",
     "anchor": "எனக்குத் தெரியும்"
    }
   ]
  },
  {
   "id": "geneva/2KI.2.5",
   "source_hash": "36ca4ad5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.2.5#p1-36ca4ad5",
     "text": "பெத்தேலிலே மாத்திரமல்ல, எரிகோவிலும் மற்ற இடங்களிலும் தீர்க்கதரிசிகள் இருந்தார்கள்; அவர்களுக்குச் சீஷர்கள் இருந்தார்கள், அவர்களை அவர்கள் உபதேசித்து, தேவனுடைய உண்மையான பயத்திலே வளர்த்து வந்தார்கள்.",
     "anchor": "எரிகோவிலிருந்த தீர்க்கதரிசிகளின் புத்திரர்கள் எலிசாவிடம் வந்து"
    }
   ]
  },
  {
   "id": "geneva/2KI.2.8",
   "source_hash": "9e37547e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.2.8#p1-9e37547e",
     "text": "அதாவது, யோர்தானின் தண்ணீர்.",
     "anchor": "தண்ணீரை"
    }
   ]
  },
  {
   "id": "geneva/2KI.2.9",
   "source_hash": "1086c05a",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.2.9#p1-1086c05a",
     "text": "இந்தக் கொடிய காலங்களின் நிமித்தம், உம்முடைய ஆவி என்னிடத்தில் இரண்டு மடங்கு பலமாக இருப்பதாக: அல்லது மற்ற தீர்க்கதரிசிகளைவிட எனக்கு இரண்டு மடங்கு கிடைப்பதாக: அல்லது உம்முடைய ஆவி மூன்று பங்குகளாகப் பிரிக்கப்படுமானால், எனக்கு இரண்டு பங்கு கிடைப்பதாக.",
     "anchor": "உம்மிடத்திலுள்ள ஆவியின்வரம் எனக்கு இரண்டு மடங்காக"
    }
   ]
  },
  {
   "id": "geneva/2KI.2.11",
   "source_hash": "13e77402",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.2.11#p1-13e77402",
     "text": "இவ்வாறு தேவன் நியாயப்பிரமாணத்திற்கு முன்பும், நியாயப்பிரமாணத்திலும், நற்செய்தியிலும் ஆகிய எல்லாக் காலங்களிலும் ஒரு சாட்சியை வைத்திருக்கிறார்.",
     "anchor": "பரலோகத்திற்கு"
    }
   ]
  },
  {
   "id": "geneva/2KI.2.15",
   "source_hash": "cf991ec5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.2.15#p1-cf991ec5",
     "text": "தீர்க்கதரிசனத்தின் ஆவி எலியாவுக்குக் கொடுக்கப்பட்டதுபோலவே இவனுக்கும் கொடுக்கப்பட்டது.",
     "anchor": "எலியாவின் ஆவி எலிசாவின்மேல் இறங்கியிருக்கிறது"
    }
   ]
  },
  {
   "id": "geneva/2KI.2.16",
   "source_hash": "7de33abe",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.2.16#p1-7de33abe",
     "text": "அந்தச் செயல் அசாதாரணமானதாக இருந்தபடியால், அவர் எங்கே போனார் என்பதில் அவர்களுக்குச் சந்தேகம் இருந்தது; ஆனால் அவர் தேவனிடம் எடுத்துக்கொள்ளப்பட்டார் என்பதில் எலிசாவுக்கு உறுதி இருந்தது.",
     "anchor": "அவர்களை அனுப்பவேண்டாம்"
    }
   ]
  },
  {
   "id": "geneva/2KI.2.21",
   "source_hash": "d5faa00b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.2.21#p1-d5faa00b",
     "text": "இவ்விதமாக, முன்பு தீங்கு விளைவித்திருந்த தண்ணீரை மனிதனுக்குப் பயன்படத்தக்கதாக மாற்றும்படி, இயற்கைக்கு விரோதமாகவும் தேவன் அவனுக்குப் வல்லமையைக் கொடுத்தார்.",
     "anchor": "உப்பை அதிலே போட்டு"
    }
   ]
  },
  {
   "id": "geneva/2KI.2.24",
   "source_hash": "344469a4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/2KI.2.24#p1-344469a4",
     "text": "கர்த்தருக்கும் அவருடைய வார்த்தைக்கும் விரோதமான அவர்களுடைய பொல்லாத இருதயத்தை உணர்ந்து, தனக்குச் செய்யப்பட்ட அவமானத்திற்குப் பழிவாங்கும்படி தேவனை வேண்டிக்கொள்கிறான்.",
     "anchor": "யெகோவாவின் நாமத்திலே அவர்களைச் சபித்தான்"
    }
   ]
  }
 ]
}
