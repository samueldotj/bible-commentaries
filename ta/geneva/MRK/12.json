 "units": [
  {
   "id": "geneva/MRK.12.1",
   "source_hash": "9247ce56",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MRK.12.1#p1-af93817a",
     "text": "தேவனுடைய அழைப்பு எல்லையற்றது, இடம், நபர், அல்லது காலம் என்பதில் விதிவிலக்கு இல்லாதது.",
     "anchor": "அவர்களுக்குச் சொன்னது"
    },
    {
     "id": "geneva/MRK.12.1#p2-97059ddc",
     "text": "சுவிசேஷகர்கள் பயன்படுத்தும் இந்த \"உவமை\" என்ற சொல், காரியங்களை ஒப்பிடுவதை மட்டுமல்ல, மறைமையான பொருள் கொண்ட பேச்சுகளையும் உருவகங்களையும் குறிக்கிறது.",
     "anchor": "உவமைகளாக"
    }
   ]
  },
  {
   "id": "geneva/MRK.12.2",
   "source_hash": "1e5875ac",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MRK.12.2#p1-1e5875ac",
     "text": "நிலத்தின் கனிகளைச் சேர்க்கும் காலம்.",
     "anchor": "பருவகாலத்திலே அவர்களிடம் ஒரு வேலைக்காரனை அனுப்பினான்"
    }
   ]
  },
  {
   "id": "geneva/MRK.12.12",
   "source_hash": "0826a2ba",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MRK.12.12#p1-0826a2ba",
     "text": "அவர்கள் பேராசை கொண்டவர்களாகவும் மிகவும் ஆவலுள்ளவர்களாகவும் இருந்தார்கள்.",
     "anchor": "கைது செய்ய முயற்சிசெய்தார்கள்"
    }
   ]
  },
  {
   "id": "geneva/MRK.12.13",
   "source_hash": "9830cc3c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MRK.12.13#p1-9830cc3c",
     "text": "நற்செய்தி அதிகார வர்க்கத்தின் அதிகாரத்தை தேவனுடைய பணிவிடையோடு இணைக்கிறது.",
     "anchor": "பரிசேயர்களிலும் ஏரோதியர்களிலும் சிலரை அவரிடம் அனுப்பினார்கள்"
    }
   ]
  },
  {
   "id": "geneva/MRK.12.14",
   "source_hash": "ce545136",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MRK.12.14#p1-ba455a14",
     "text": "நீர் வெளித்தோற்றத்தைப் பார்த்து நியாயம் தீர்க்காதவராயிருக்கிறீர், அதனால் சத்தியம் எவ்வகையிலும் மறைக்கப்படுவதில்லை.",
     "anchor": "எவனைக்குறித்தும் உமக்குக் கவலையில்லை"
    },
    {
     "id": "geneva/MRK.12.14#p2-3413189a",
     "text": "நாம் தேவனைக் காண வருகின்ற வழி இதுவே.",
     "anchor": "தேவனுடைய வழிகளைச் சத்தியமாக"
    }
   ]
  },
  {
   "id": "geneva/MRK.12.18",
   "source_hash": "5269d8eb",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MRK.12.18#p1-5269d8eb",
     "text": "சதுசேயர்களின் மதிகேடான அறியாமைக்கும் தீவினைக்கும் எதிராக, சரீரத்தின் உயிர்த்தெழுதல் உறுதிப்படுத்தப்படுகிறது.",
     "anchor": "உயிர்த்தெழுதல் இல்லை என்று சாதிக்கிற சதுசேயர்கள் அவரிடம் வந்து"
    }
   ]
  },
  {
   "id": "geneva/MRK.12.28",
   "source_hash": "d7f44009",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MRK.12.28#p1-d7f44009",
     "text": "தேவனுக்கும் நம்முடைய அயலகத்தாருக்கும் நாம் செய்யவேண்டியவைகளை முதலாவது செய்யாதிருந்தால், பலிகளும் புறம்பான தொழுதுகொள்ளுதலும் ஒருபோதும் தேவனுக்குப் பிரியமாயிராது.",
     "anchor": "வேதபண்டிதர்களில் ஒருவன்... அவரிடம் வந்து"
    }
   ]
  },
  {
   "id": "geneva/MRK.12.35",
   "source_hash": "caaf6444",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MRK.12.35#p1-caaf6444",
     "text": "கிறிஸ்து தாம் சரீரத்தின்படி தோன்றின தாவீதே கொண்டு தம்முடைய தேவத்துவத்தை நிரூபிக்கிறார்.",
     "anchor": "இயேசு தேவாலயத்தில் உபதேசம்பண்ணும்போது, அவர்:"
    }
   ]
  },
  {
   "id": "geneva/MRK.12.36",
   "source_hash": "37e92ea4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MRK.12.36#p1-37e92ea4",
     "text": "மூலமொழியில், \"பரிசுத்த ஆவியானவராலே\" என்று உள்ளது; இந்த வகையான சொல்வழக்கில் பெரிய வலிமை இருக்கிறது, இதனால் குறிக்கப்படுவது என்னவெனில், பேசினவர் தாவீதே அல்ல, மாறாக பரிசுத்த ஆவியானவரே, அவர் ஒரு விதத்தில் தாவீதை ஆட்கொண்டிருந்தார் என்பதாம்.",
     "anchor": "பரிசுத்த ஆவியானவராலே"
    }
   ]
  },
  {
   "id": "geneva/MRK.12.38",
   "source_hash": "2d00b6e2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MRK.12.38#p1-4c18535b",
     "text": "ஊழியக்காரரின் நடத்தையை மாதிரியாகக் கருதி அவசரமாகப் பின்பற்றக்கூடாது.",
     "anchor": "இயேசு உபதேசம்பண்ணும்போது அவர்களைப் பார்த்து"
    },
    {
     "id": "geneva/MRK.12.38#p2-9d31d1d6",
     "text": "அவர் அவர்களுக்கு உபதேசம்பண்ணிக்கொண்டிருக்கும்போது.",
     "anchor": "உபதேசம்பண்ணும்போது"
    },
    {
     "id": "geneva/MRK.12.38#p3-73ff6c4a",
     "text": "இந்த வார்த்தை \"ஸ்டோலே\" என்பதாகும், அது குதிங்கால்வரை தொங்கும் ஒருவகை பெண்களின் ஆடையாகும்; பொதுவாக இது அழகாகத் தோன்றும் எந்த ஆடையையும் குறிக்கும் வழக்கமான வார்த்தையாக எடுத்துக்கொள்ளப்படுகிறது, ஆனாலும் இந்த இடத்தில் அது உபாகமம் 22:12-இல் குறிப்பிடப்பட்டுள்ள தொங்கல்கள் உள்ள ஆடையைக் குறிப்பதாகவே தோன்றுகிறது.",
     "anchor": "நீண்ட அங்கிகளை அணிந்துகொண்டு திரியவும்"
    }
   ]
  },
  {
   "id": "geneva/MRK.12.41",
   "source_hash": "9b1b071e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/MRK.12.41#p1-66a3182c",
     "text": "தேவன் ஏற்றுக்கொள்ளும் நமது கடமைகளைச் செய்வது வெளிப்படையான மதிப்பின்படி மதிக்கப்படாமல், இருதயத்தின் உள்ளான உணர்வுகளின்படியே மதிக்கப்படுகிறது.",
     "anchor": "காணிக்கைப்பெட்டிக்கு எதிராக உட்கார்ந்து"
    },
    {
     "id": "geneva/MRK.12.41#p2-d03482d3",
     "text": "ரோமர் பயன்படுத்திய எந்த வகையான உலோகத்தினாலான பணமும் ஆகும்; அவர்கள் ஆரம்பத்தில் வெண்கலத்தினால் நாணயங்களை அடித்து உருவாக்கினார்கள், பின்பு அதை நாணயமாகப் பயன்படுத்தினார்கள்.",
     "anchor": "பணம் போடுகிறதை"
    }
   ]
  }
 ]
}
