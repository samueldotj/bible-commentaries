 "chapter": 4,
 "lang": "ta",
 "units": [
  {
   "id": "geneva/LAM.4.1",
   "source_hash": "172d9e83",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LAM.4.1#p1-172d9e83",
     "text": "தங்கத்தினால் அதிபதிகளையும், கற்களினால் ஆசாரியர்களையும் அவர் குறிக்கிறார்.",
     "anchor": "தங்கம் மங்கி"
    }
   ]
  },
  {
   "id": "geneva/LAM.4.2",
   "source_hash": "d694fa96",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LAM.4.2#p1-d694fa96",
     "text": "இவை அற்பமான விலையுடையவைகளும் மதிப்பில்லாதவைகளுமாய் இருக்கின்றன.",
     "anchor": "மண்பாத்திரங்களைப்போல"
    }
   ]
  },
  {
   "id": "geneva/LAM.4.3",
   "source_hash": "ae5971a3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LAM.4.3#p1-57355a91",
     "text": "திமிங்கிலங்கள் கொடியவைகளாக இருந்தாலும், அவை தங்கள் குட்டிகளுக்கு இரங்கி அவைகளை போஷிக்கும்; அதை எருசலேம் செய்யவில்லை.",
     "anchor": "மார்பகங்களை நீட்டி, தங்கள் குட்டிகளுக்குப் பால் கொடுக்கும்"
    },
    {
     "id": "geneva/LAM.4.3#p2-30b5d5bc",
     "text": "நெருப்புக்கோழி தன் முட்டைகளை விட்டுவிடுவதைப்போல, பெண்கள் தங்கள் பிள்ளைகளை விட்டுவிடுகின்றனர், யோபு 39:17.",
     "anchor": "வனாந்தரத்திலுள்ள நெருப்புக்கோழியைப்போல்"
    }
   ]
  },
  {
   "id": "geneva/LAM.4.8",
   "source_hash": "92ed999e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LAM.4.8#p1-92ed999e",
     "text": "முன்னே தேவனுடைய பிரியத்தில் மிகவும் இருந்தவர்கள் இப்பொழுது அவருக்கு மிகுந்த அருவருப்பானவர்களாக இருக்கிறார்கள்.",
     "anchor": "முகம் கரியைக்காட்டிலும் கறுத்துப்போனது"
    }
   ]
  },
  {
   "id": "geneva/LAM.4.9",
   "source_hash": "08089030",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LAM.4.9#p1-08089030",
     "text": "வயல்களின் பலன் இல்லாததால் அவர்கள் பசியினால் கரைந்து மெலிந்து போகிறார்கள்.",
     "anchor": "வயலில் விளைச்சல் இல்லாததால்"
    }
   ]
  },
  {
   "id": "geneva/LAM.4.13",
   "source_hash": "f847e692",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LAM.4.13#p1-f847e692",
     "text": "எல்லா மனிதர்களின் எதிர்பார்ப்புக்கும் மாறாக, இவை இதினால் நடந்தது என்று அவர் அர்த்தப்படுத்துகிறார்.",
     "anchor": "அதின்"
    }
   ]
  },
  {
   "id": "geneva/LAM.4.14",
   "source_hash": "0a017f05",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LAM.4.14#p1-a8495402",
     "text": "சிலர் இதைக் குருடர்களைக் குறித்ததாகக் கருதுகிறார்கள், அவர்கள் நடந்து செல்லும்போது நகரம் நிறைந்திருந்த இரத்தத்தில் இடறியடியார்கள் என்பதாம்.",
     "anchor": "வீதிகளில்"
    },
    {
     "id": "geneva/LAM.4.14#p2-08d4d82c",
     "text": "அவர்களை அழிக்க வந்த அந்நியமக்களே அவர்களை அணுக முடியவில்லை என்பதைக் குறிக்கிறது.",
     "anchor": "ஒருவரும் அவர்களுடைய உடைகளைத் தொடமுடியாதபடி"
    }
   ]
  },
  {
   "id": "geneva/LAM.4.16",
   "source_hash": "ccbce5e7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LAM.4.16#p1-ccbce5e7",
     "text": "அதாவது, எதிரிகள்.",
     "anchor": "முதியோரை மதிக்காமலும்"
    }
   ]
  },
  {
   "id": "geneva/LAM.4.17",
   "source_hash": "0676be49",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LAM.4.17#p1-0676be49",
     "text": "அவர்கள் அழிவுக்குக் காரணமான இரண்டு முதன்மையான காரியங்களை அவர் காண்பிக்கிறார்: அவர்களுடைய கடின இருதயமும், மனிதனில் அவர்கள் கொண்டிருந்த வீணான நம்பிக்கையும்; ஏனெனில் அவர்கள் எகிப்தியரின் உதவியை நம்பியிருந்தார்கள்.",
     "anchor": "காப்பாற்றமுடியாத மக்களுக்காக"
    }
   ]
  },
  {
   "id": "geneva/LAM.4.20",
   "source_hash": "0ad3704b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LAM.4.20#p1-0ad3704b",
     "text": "எங்கள் ராஜாவாகிய யோசியா, அவனிடத்திலே தேவனுடைய தயவின்மேலான எங்கள் நம்பிக்கை நிலைத்திருந்தது, எங்கள் நிலைமையும் உயிரும் அவனைச் சார்ந்திருந்தது, அவன் கொல்லப்பட்டான்; அவனை அபிஷேகம்செய்யப்பட்டவன் என்று அழைக்கிறார், ஏனெனில் அவன் கிறிஸ்துவின் நிழலாக இருந்தான்.",
     "anchor": "எங்கள் உயிர்மூச்சு"
    }
   ]
  },
  {
   "id": "geneva/LAM.4.21",
   "source_hash": "c01aabbe",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LAM.4.21#p1-c01aabbe",
     "text": "இது இளக்காரமாகச் சொல்லப்பட்டது.",
     "anchor": "மகளாகிய ஏதோமே"
    }
   ]
  },
  {
   "id": "geneva/LAM.4.22",
   "source_hash": "accddde5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/LAM.4.22#p1-accddde5",
     "text": "எழுபது வருடங்களுக்குப் பின்பு தங்கள் துக்கங்களுக்கு முடிவு வரும், ஆனால் துன்மார்க்கரோ என்றைக்கும் வேதனைக்குட்படுவார்கள் என்பதால் அவர் சபையைத் தேற்றரவு செய்கிறார்.",
     "anchor": "அவர் இனி உன்னை சிறைப்பட்டுப்போக விடமாட்டார்"
    }
   ]
  }
 ]
}
