 "chapter": 6,
 "lang": "ta",
 "units": [
  {
   "id": "geneva/JER.6.1",
   "source_hash": "f130bb7c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.6.1#p1-c76b8bfd",
     "text": "அவர்களுடைய கோத்திரத்தில் மற்ற பாதியான தங்கள் சகோதரர் இப்பொழுது சிறைப்பட்டு கொண்டுபோகப்பட்டிருந்த முன்மாதிரியைக் கண்டு அவர்கள் எச்சரிக்கையாய் இருக்கவேண்டும் என்பதற்காக முதன்மையாக அவர் இவர்களிடம் பேசுகிறார்.",
     "anchor": "பென்யமீன்"
    },
    {
     "id": "geneva/JER.6.1#p2-b4e37097",
     "text": "இது யூதாவில் இருந்த ஒரு பட்டணமாகும், பெத்லெகேமிலிருந்து ஆறு மைல் தூரத்தில் இருந்தது, 2 நாளாகமம் 11:6.",
     "anchor": "தெக்கோவாவில்"
    },
    {
     "id": "geneva/JER.6.1#p3-b33f0f44",
     "text": "நெகேமியா 3:14-ஐப் படிக்கவும்.",
     "anchor": "பெத்கேரேமின்மேல்"
    }
   ]
  },
  {
   "id": "geneva/JER.6.2",
   "source_hash": "6dbd91e5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.6.2#p1-6dbd91e5",
     "text": "நான் அவளை மென்மையாக நடத்தி, எல்லாவற்றையும் மிகுதியாகக் கொடுத்தேன்.",
     "anchor": "செல்வமாய் வளர்ந்த அழகுள்ள மகளாகிய"
    }
   ]
  },
  {
   "id": "geneva/JER.6.3",
   "source_hash": "fc792ead",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.6.3#p1-fc792ead",
     "text": "அவள் மந்தை மேய்க்கத்தக்கதாக இருக்கும்படி முழுவதுமாக அழிக்கப்படுவாள்.",
     "anchor": "அவளிடத்திற்கு வருவார்கள்"
    }
   ]
  },
  {
   "id": "geneva/JER.6.4",
   "source_hash": "d474e1dd",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.6.4#p1-d474e1dd",
     "text": "பாபிலோனியரின் வாயிலிருந்து இதைச் சொல்கிறார்; தங்கள் காரியங்களை நிறைவேற்றுவதற்குமுன் நேரம் தங்களுக்குப் போதுமாயில்லை என்று அவர்கள் புலம்புகிறார்கள்.",
     "anchor": "அவளுக்கு விரோதமாய் போர்செய்ய ஆயத்தம்செய்யுங்கள் என்றும்"
    }
   ]
  },
  {
   "id": "geneva/JER.6.7",
   "source_hash": "652eb39f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.6.7#p1-652eb39f",
     "text": "அது ஏன் அழிக்கப்படும் என்பதற்கான காரணத்தையும், அது தங்களிடமிருந்தே எப்படி வருகிறது என்பதையும் அவர் காண்பிக்கிறார்.",
     "anchor": "அதில் கொடுமையும் தீமையான காரியங்களும் கேட்கப்படுகிறது"
    }
   ]
  },
  {
   "id": "geneva/JER.6.8",
   "source_hash": "00c202ac",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.6.8#p1-00c202ac",
     "text": "அவர் தம்முடைய தண்டனையினால் அவர்கள் திருந்தும்படியும், மனந்திரும்புதலினால் தம்மிடத்தில் திரும்பும்படியும் அவர்களை எச்சரிக்கிறார்.",
     "anchor": "எருசலேமே"
    }
   ]
  },
  {
   "id": "geneva/JER.6.9",
   "source_hash": "69ac30c5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.6.9#p1-69ac30c5",
     "text": "அவர் பாபிலோனியரைத் தூண்டி, எல்லாவற்றையும் நுணுக்கமாகத் தேடி, ஒன்றையும் விட்டுவைக்காதபடி விடாமுயற்சியுடன் இருக்கும்படி எச்சரிக்கிறார்.",
     "anchor": "திராட்சைக்குலைகளை அறுக்கிறவனைப்போல உன் கையைத் திரும்பக் கூடைகளின்மேல் போடு"
    }
   ]
  },
  {
   "id": "geneva/JER.6.10",
   "source_hash": "6d40a48c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.6.10#p1-6d40a48c",
     "text": "அவர்கள் வீணானவற்றைக் கேட்பதிலே பிரியப்படுகிறார்கள், மற்றும் உண்மையான உபதேசத்திற்குத் தங்கள் காதுகளை அடைத்துக்கொள்கிறார்கள்.",
     "anchor": "விருத்தசேதனமில்லாதது"
    }
   ]
  },
  {
   "id": "geneva/JER.6.11",
   "source_hash": "a53e17cf",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.6.11#p1-6945dd46",
     "text": "கர்த்தர் அவனுக்குத் தமது வார்த்தையை, துன்மார்க்கரை எரிக்கும் தமது கோபத்தின் நெருப்பாக இருக்கும்படி கொடுத்திருந்தபடி, எரேமியா 5:14, எல்லா நிவாரணங்களும் கடந்துபோனதைக் கண்டபோது இப்பொழுது அதை மூட்டுகிறார்.",
     "anchor": "அதை ஊற்றிவிடுவேன், வீதிகளிலுள்ள பிள்ளைகளின்மேலும், வாலிபருடைய கூட்டத்தின்மேலெங்கும்,ல்;refs=JER.5.14"
    },
    {
     "id": "geneva/JER.6.11#p2-c609b4e3",
     "text": "ஒருவரும் விடுதலைப்பெறுவதில்லை.",
     "anchor": "வீதிகளிலுள்ள பிள்ளைகளின்மேலும்"
    }
   ]
  },
  {
   "id": "geneva/JER.6.14",
   "source_hash": "68fe4240",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.6.14#p1-68fe4240",
     "text": "மக்கள் தேவனுடைய நியாயத்தீர்ப்புகளுக்குப் பயப்படத் தொடங்கியபோது, பொய்த் தீர்க்கதரிசிகள் இச்சகம் பேசி அவர்களைத் தேற்றி, தேவன் யுத்தத்தை அல்ல, சமாதானத்தையே அனுப்புவார் என்று காண்பித்தார்கள்.",
     "anchor": "சமாதானம்"
    }
   ]
  },
  {
   "id": "geneva/JER.6.16",
   "source_hash": "05d27493",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.6.16#p1-05d27493",
     "text": "இவற்றில் கோத்திரத்தலைவர்களும் தீர்க்கதரிசிகளும் தேவவசனத்தால் வழிநடத்தப்பட்டு நடந்தார்கள்; தேவன் கட்டளையிட்ட வழியைத் தவிர வேறு உண்மையான வழி இல்லை என்பதைக் குறிக்கிறது.",
     "anchor": "முன்னோர்களின் பாதைகள்"
    }
   ]
  },
  {
   "id": "geneva/JER.6.17",
   "source_hash": "8de91b39",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.6.17#p1-8de91b39",
     "text": "நெருங்கிவரும் ஆபத்துகளைக் குறித்து உங்களை எச்சரிக்கும் தீர்க்கதரிசிகள்.",
     "anchor": "காவலாளரையும்"
    }
   ]
  },
  {
   "id": "geneva/JER.6.18",
   "source_hash": "86c93f8c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.6.18#p1-86c93f8c",
     "text": "யூதர்களின் நன்றியில்லாத தன்மைக்கு உலகம் முழுவதையும், உணர்வற்ற சிருஷ்டிகளையும் தேவன் சாட்சியாக அழைக்கிறார்.",
     "anchor": "தேசங்களே"
    }
   ]
  },
  {
   "id": "geneva/JER.6.20",
   "source_hash": "d3e02e11",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.6.20#p1-d3e02e11",
     "text": "ஏசாயா 1:11, ஆமோஸ் 5:21ஐ வாசிக்கவும்.",
     "anchor": "சேபாவிலிருந்து வருகிற தூபவர்க்கமும்"
    }
   ]
  },
  {
   "id": "geneva/JER.6.22",
   "source_hash": "bec3b795",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.6.22#p1-bec3b795",
     "text": "பாபிலோனிலிருந்து தாண் வழியாக, அது எருசலேமிற்கு வடக்கே இருந்தது.",
     "anchor": "வடதேசத்திலிருந்து"
    }
   ]
  },
  {
   "id": "geneva/JER.6.24",
   "source_hash": "df5e7649",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.6.24#p1-df5e7649",
     "text": "பகைவனுக்குப் பயந்ததால்: இதை அவர் யூதர்களின் பேச்சாகச் சொல்கிறார்.",
     "anchor": "தளர்ந்தது"
    }
   ]
  },
  {
   "id": "geneva/JER.6.27",
   "source_hash": "9ee4f036",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.6.27#p1-9ee4f036",
     "text": "பொருள், எரேமியா, தேவன் தூய உலோகத்தை களிம்பிலிருந்து புடமிடுபவன் பிரிப்பது போல, பக்தியுள்ளவர்களை துன்மார்க்கரிலிருந்து சோதித்துப் பிரிக்க நியமித்திருந்தார் என்பதே.",
     "anchor": "உன்னை...கோட்டைச்சுவராகவும்"
    }
   ]
  },
  {
   "id": "geneva/JER.6.29",
   "source_hash": "a827d0e7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.6.29#p1-a827d0e7",
     "text": "அவர்களுக்காக எடுத்த வேதனையும் பிரயாசமும் யாவும் வீணாகப்போயின.",
     "anchor": "தோல்பை வெந்தது"
    }
   ]
  }
 ]
}
