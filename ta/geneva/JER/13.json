 "units": [
  {
   "id": "geneva/JER.13.4",
   "source_hash": "bbdf500f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.13.4#p1-bbdf500f",
     "text": "இந்த நதி எருசலேமிலிருந்து வெகு தூரத்தில் இருந்தபடியால், இது ஒரு தரிசனமாக இருந்தது என்பது தெளிவாகிறது; இதினால், யூதர்கள் பாபிலோனில் சிறைப்பட்டவர்களாகும்படி ஐப்பிராத்து நதியைக் கடந்துபோவார்கள் என்றும், நீண்ட காலம் அங்கே அவர்கள் அழுகிப்போனவர்கள் போல் காணப்படுவார்கள் என்றும் குறிக்கப்பட்டது, ஆனாலும் அவர்கள் முன்பு ஒரு மனிதனின் இடுப்பைச் சுற்றியிருக்கும் கச்சையைப்போல கர்த்தரோடு இணைந்திருந்தார்கள்.",
     "anchor": "ஐப்பிராத்து நதிவரை"
    }
   ]
  },
  {
   "id": "geneva/JER.13.12",
   "source_hash": "297a02ed",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.13.12#p1-297a02ed",
     "text": "உங்கள் ஒவ்வொருவரும் ஆவிக்குரிய வெறியினால் நிரப்பப்படுவீர்கள், உங்களுக்கு உதவ வழிதேட எவ்வித அறிவும் இல்லாதவர்களாக இருப்பீர்கள்.",
     "anchor": "பாத்திரங்களும் திராட்சைரசத்தினால் நிரப்பப்படும்"
    }
   ]
  },
  {
   "id": "geneva/JER.13.14",
   "source_hash": "42dc780c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.13.14#p1-42dc780c",
     "text": "பெரியவர்களையும் பலவான்களையும் அழிப்பது, ஒரு மனிதன் மண்பானைகளை உடைப்பது எவ்வளவு எளிதோ அவ்வளவு எளிதாக எனக்கு இருக்கும்.",
     "anchor": "ஒருவர்மேல் ஒருவர் மோதி விழும்படிச்செய்வேன்"
    }
   ]
  },
  {
   "id": "geneva/JER.13.16",
   "source_hash": "e1f542a9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.13.16#p1-2c201da9",
     "text": "அதாவது, பாபிலோனியரால் வரும் உபத்திரவமும் துன்பமும், ஏசாயா 8:22.",
     "anchor": "அந்தகாரத்தை, இருள்... காரிருள்"
    },
    {
     "id": "geneva/JER.13.16#p2-2c1929ca",
     "text": "அதாவது, எகிப்தியரின் உதவியும் ஆதரவும்.",
     "anchor": "வெளிச்சத்திற்குக்"
    }
   ]
  },
  {
   "id": "geneva/JER.13.17",
   "source_hash": "ec81f927",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.13.17#p1-ec81f927",
     "text": "நீங்கள் நிச்சயமாக சிறைப்பட்டுக்கொண்டு போவீர்கள், நானோ உங்கள்மேலுள்ள என் பட்சத்தினிமித்தம் உங்கள் கடினத்தன்மைக்காக அழுது புலம்புவேன்.",
     "anchor": "மறைவிடங்களில் உங்கள் பெருமையினிமித்தம் துக்கித்து"
    }
   ]
  },
  {
   "id": "geneva/JER.13.18",
   "source_hash": "1c442d27",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.13.18#p1-1c442d27",
     "text": "ஏனெனில் யோயாக்கீனும் அவனுடைய தாயும் எரேமியாவின் ஆலோசனையின்படி பாபிலோன் ராஜாவினிடத்தில் தங்களை ஒப்புக்கொடுத்தார்கள், 2 இராஜாக்கள் 24:12.",
     "anchor": "ராஜாவையும் ராஜாத்தியையும்"
    }
   ]
  },
  {
   "id": "geneva/JER.13.19",
   "source_hash": "dae3cf42",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.13.19#p1-dae3cf42",
     "text": "அதாவது, யூதாவைக் குறிக்கிறது, அது பாபிலோனுக்குத் தெற்கே இருக்கிறது.",
     "anchor": "தெற்கிலுள்ள பட்டணங்கள் அடைக்கப்பட்டன"
    }
   ]
  },
  {
   "id": "geneva/JER.13.20",
   "source_hash": "177414ac",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.13.20#p1-177414ac",
     "text": "அவர் ராஜாவை நோக்கி, தன் மக்கள் எங்கே போய்விட்டார்கள் என்று கேட்கிறார்.",
     "anchor": "உனக்குக் கொடுக்கப்பட்டிருந்த மந்தையும்"
    }
   ]
  },
  {
   "id": "geneva/JER.13.21",
   "source_hash": "899d78c3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.13.21#p1-899d78c3",
     "text": "அந்நியரிடத்தில் உதவி தேடினதினால், நீ அவர்களைத் தமக்கு விரோதமாகச் சண்டையிடத் திறமையுள்ளவர்களாக ஆக்கினாய்.",
     "anchor": "நீ அவர்களைப் பழக்கப்படுத்தினாயே"
    }
   ]
  },
  {
   "id": "geneva/JER.13.22",
   "source_hash": "b506dcbc",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.13.22#p1-b506dcbc",
     "text": "மாயமாய் மூடிவைத்த போர்வை அகற்றப்பட்டு, உன் வெட்கம் வெளிப்படும்.",
     "anchor": "விலக்கப்பட்டு"
    }
   ]
  },
  {
   "id": "geneva/JER.13.26",
   "source_hash": "f77c67ad",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.13.26#p1-f77c67ad",
     "text": "உன் அக்கிரமங்கள் உலகமெல்லாமுக்கும் வெளிப்படுத்தப்பட்டதுபோல, உன் மானமும் தண்டனையும் அப்படியே வெளிப்படும்.",
     "anchor": "உன் மானம் காணப்பட"
    }
   ]
  },
  {
   "id": "geneva/JER.13.27",
   "source_hash": "06a27fc3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.13.27#p1-ecb8e9af",
     "text": "விக்கிரக ஆராதனை செய்பவர்களை பிடிவாலினால் கிளர்ந்த குதிரைகளுக்கு அவர் ஒப்பிடுகிறார்.",
     "anchor": "கனைப்புகளையும்"
    },
    {
     "id": "geneva/JER.13.27#p2-c9b694a7",
     "text": "உன் விக்கிரக ஆராதனையின் அடையாளங்களும் குறிகளும் காணப்படாத உயர்ந்த இடமும் தாழ்ந்த இடமும் இல்லை.",
     "anchor": "வெளியில் மேடுகளின்மேல்"
    }
   ]
  }
 ]
}
