 "units": [
  {
   "id": "geneva/JER.38.1",
   "source_hash": "51b6d7dd",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.38.1#p1-51b6d7dd",
     "text": "நேபுகாத்நேச்சார் வந்தபோது தேசத்தின் நிலைமை எப்படியிருக்கும் என்று கர்த்தரிடத்தில் விசாரிக்கும்படி சிதேக்கியா இவர்களை எரேமியாவினிடத்தில் அனுப்பியிருந்தார், எரேமியா 21:1 இல் இருப்பதுபோல.",
     "anchor": "மல்கியாவின்"
    }
   ]
  },
  {
   "id": "geneva/JER.38.2",
   "source_hash": "aefc1d34",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.38.2#p1-aefc1d34",
     "text": "எரேமியா 21:9, 45:5 வாசிக்கவும்.",
     "anchor": "கொள்ளைப்பொருள்"
    }
   ]
  },
  {
   "id": "geneva/JER.38.4",
   "source_hash": "7d90c535",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.38.4#p1-7d90c535",
     "text": "இவ்விதமாக, துன்மார்க்கர் தேவனுடைய வார்த்தையின் சத்தியத்தைக் கேட்பதைச் சகிக்காதபோது, ஊழியக்காரரை அரசாங்கத்திற்கு விரோதம் செய்கிறவர்களாகக் குற்றம் சாட்டி, அவர்களைக் கொலைசெய்யத் தேடுகிறார்கள் என்பதைக் காண்கிறோம்.",
     "anchor": "மீதியாயிருக்கிற போர்வீரர்களிடத்திலும், மற்றுமுள்ள எல்லா மக்களிடத்திலும்"
    }
   ]
  },
  {
   "id": "geneva/JER.38.5",
   "source_hash": "30f47b68",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.38.5#p1-30f47b68",
     "text": "இதில் அவன் கொடூரமாகக் குற்றம் செய்தான், ஏனெனில் அவன் தீர்க்கதரிசியினால் சொல்லப்பட்ட சத்தியத்தைக் கேட்க மறுத்ததுமட்டுமல்ல, மேலும் அவனைத் துன்மார்க்கரின் இச்சைகளுக்கு ஒப்புவித்து கொடூரமாக நடத்தப்படும்படி விட்டுவிட்டான்.",
     "anchor": "உங்களுக்கு விரோதமாக ஒன்றும் செய்யமுடியாது"
    }
   ]
  },
  {
   "id": "geneva/JER.38.7",
   "source_hash": "906fff5d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.38.7#p1-906fff5d",
     "text": "வழக்குகளைக் கேட்டு தீர்ப்பு வழங்குவதற்காக.",
     "anchor": "பென்யமீன் வாசலில்"
    }
   ]
  },
  {
   "id": "geneva/JER.38.9",
   "source_hash": "d8d13269",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.38.9#p1-d8d13269",
     "text": "இதனால் தீர்க்கதரிசி தன் சொந்த நாட்டைச் சேர்ந்தவர்களால் பெற்ற எல்லா நடத்தையிலும் அதிகமான தயவை இந்த அந்நியனிடத்தில் கண்டான் என்பது வெளிப்படுகிறது; இது அவர்களுக்கு பெரிய ஆக்கினைத்தீர்ப்பாக இருந்தது.",
     "anchor": "தகாத செய்கையாயிருக்கிறது"
    }
   ]
  },
  {
   "id": "geneva/JER.38.13",
   "source_hash": "05fa4394",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.38.13#p1-05fa4394",
     "text": "எரேமியா 37:21-ல் இருப்பது போல, அதிக விடுதலையுடன் இருப்பதற்காக ராஜா அவனை முன்பே அங்கே வைத்திருந்தான்.",
     "anchor": "காவல்நிலையத்தின் முற்றத்தில்"
    }
   ]
  },
  {
   "id": "geneva/JER.38.17",
   "source_hash": "e6491cdc",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.38.17#p1-e6491cdc",
     "text": "அவர்களுக்குக் கீழ்ப்படிந்து ஒப்புக்கொடுங்கள்.",
     "anchor": "பிரபுக்களிடம்"
    }
   ]
  },
  {
   "id": "geneva/JER.38.19",
   "source_hash": "289fa805",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.38.19#p1-289fa805",
     "text": "இது, தேவன் எச்சரித்ததைவிட மனிதர் இழிவுபடுத்துவதைக் குறித்தே அவன் அதிகமாகப் பயந்தான் என்பதைக் காண்பிக்கிறது.",
     "anchor": "பரியாசம்செய்ய"
    }
   ]
  },
  {
   "id": "geneva/JER.38.22",
   "source_hash": "3668fa98",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.38.22#p1-3668fa98",
     "text": "எக்கொனியாவும் அவனுடைய தாயும் மற்றவர்களுடன் சிறைப்பிடித்துக் கொண்டுபோகப்பட்டபோது, ராஜாவின் வீட்டில் இந்தப் பெண்கள் மீதியாக விடப்பட்டிருந்தார்கள்: இவர்கள் பிடிக்கப்பட்டு, பாபேல் ராஜாவிடம் சொல்லுவார்கள் என்று தீர்க்கதரிசி கூறுகிறார், சிதேக்கியா தன்னுடைய நெருங்கிய நண்பர்களாலும் பொய்த் தீர்க்கதரிசிகளாலும் ஏமாற்றப்பட்டு, சேற்றில் விடப்பட்டதைப் பற்றி.",
     "anchor": "யூதா ராஜாவின் வீட்டில் மீதியான"
    }
   ]
  },
  {
   "id": "geneva/JER.38.26",
   "source_hash": "cb3a9929",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/JER.38.26#p1-cb3a9929",
     "text": "தன் உபதேசத்தை மறுதலிக்காமலும், ஒருவருக்கும் தீங்கு உண்டாகாமலும், தான் இரட்சிக்கப்படும்படி தீர்க்கதரிசி வஞ்சனையாகப் பேசினதில் அவருடைய பலவீனம் தெரிகிறது.",
     "anchor": "அவர் முகத்திற்கு முன்பாக விண்ணப்பம்செய்தேன்"
    }
   ]
  }
 ]
}
