 "units": [
  {
   "id": "geneva/ISA.54.1",
   "source_hash": "5fd5510b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.54.1#p1-203b070b",
     "text": "கிறிஸ்துவின் மரணத்தை அறிவித்தபின், அவர் சபையை நோக்கிப் பேசுகிறார், ஏனெனில் அதே மரணத்தின் பலனை அது அனுபவிக்கும்; அவளைப் \"மலடி\" என்று அழைக்கிறார், ஏனெனில் சிறையிருப்பில் அவள் பிள்ளைகளைப் பெறுவதற்கு நம்பிக்கையில்லாத விதவையாக இருந்தாள்.",
     "anchor": "மலடியே"
    },
    {
     "id": "geneva/ISA.54.1#p2-c582cbdf",
     "text": "இந்த அவளுடைய துன்பத்திலும் சிறையிருப்பிலும் சபை, அவள் சுதந்திரமாயிருந்தபோது ஈன்றதைக் காட்டிலும் அதிக பிள்ளைகளைப் பெறுவாள்; அல்லது இது வியப்புடன் சொல்லப்பட்டிருக்கலாம், அவளிலிருந்து வரும் மகா திரள் எண்ணிக்கையைக் கருதி. கோரேசின் காலத்தில் அவளுடைய விடுதலை அவளுடைய குழந்தைப் பருவம் போன்றது; ஆகவே இது அவள் பூரணவளர்ச்சிக்கு வந்தபோது, அதாவது நற்செய்தியின் காலத்தில், நிறைவேறியது.",
     "anchor": "தனியாக இருக்கும் பெண்ணுடைய பிள்ளைகள்"
    }
   ]
  },
  {
   "id": "geneva/ISA.54.2",
   "source_hash": "16e42a65",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.54.2#p1-16e42a65",
     "text": "தேவன் அவளுக்குக் கொடுக்கும் பிள்ளைகளின் மிகுதியான எண்ணிக்கையினால், அவர்களைத் தங்க வைக்க இடம் போதாமல் இருக்கும் என்பதைக் குறிக்கிறது.",
     "anchor": "உன் கூடாரத்தின் இடத்தை விசாலமாக்கு"
    }
   ]
  },
  {
   "id": "geneva/ISA.54.4",
   "source_hash": "c0c2f427",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.54.4#p1-faeeb226",
     "text": "ஆரம்பத்தில் நீ அனுபவித்த உபத்திரவங்கள்.",
     "anchor": "வாலிபத்தின்"
    },
    {
     "id": "geneva/ISA.54.4#p2-566d65ce",
     "text": "உன் பாவங்களினிமித்தம் நீ தள்ளப்பட்டபோது, ஏசாயா 50:1.",
     "anchor": "விதவையிருப்பின் நிந்தையை இனி நினைக்காமலிருப்பாய்"
    }
   ]
  },
  {
   "id": "geneva/ISA.54.5",
   "source_hash": "4811f376",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.54.5#p1-e57db2bd",
     "text": "தம்முடைய பரிசுத்த ஆவியானவராலே உன்னை மறுபிறப்பு அடையச்செய்தவர்.",
     "anchor": "உன் சிருஷ்டிகரே உன் நாயகர்"
    },
    {
     "id": "geneva/ISA.54.5#p2-cfe240a9",
     "text": "முன்பு யூதேயாவில் அடைபட்டிருந்ததாகக் காணப்பட்ட அவருடைய மகிமை உலகம் முழுவதிலும் பிரகாசிக்கும்.",
     "anchor": "சர்வபூமியின் தேவன் என்னப்படுவார்"
    }
   ]
  },
  {
   "id": "geneva/ISA.54.6",
   "source_hash": "6b37c7c5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.54.6#p1-6b37c7c5",
     "text": "இளம்பிராயத்தில் கைவிடப்பட்ட மனைவியைப் போல.",
     "anchor": "இளம்பிராயத்தில் திருமணம்செய்து"
    }
   ]
  },
  {
   "id": "geneva/ISA.54.9",
   "source_hash": "98994c60",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.54.9#p1-98994c60",
     "text": "நான் நோவாவுக்குக் கொடுத்த வாக்குத்தத்தம் நிச்சயமாயிருந்ததுபோல, இனி தண்ணீர்கள் பூமியின்மேல் புரண்டுவருவதில்லை என்பதும் நிச்சயம்.",
     "anchor": "நோவாவின் காலத்திலுண்டான வெள்ளம் இனி பூமியின்மேல் புரண்டுவருவதில்லை என்று நான் ஆணையிட்டதுபோல"
    }
   ]
  },
  {
   "id": "geneva/ISA.54.11",
   "source_hash": "8669cfd7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.54.11#p1-8669cfd7",
     "text": "இதன் மூலம் அவர் கிறிஸ்துவின்கீழ் சபையின் மேன்மையான நிலையை வெளிப்படுத்துகிறார்.",
     "anchor": "பிரகாசிக்கும்படி வைத்து"
    }
   ]
  },
  {
   "id": "geneva/ISA.54.13",
   "source_hash": "1ec07ca4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.54.13#p1-1ec07ca4",
     "text": "அவருடைய வார்த்தையைக் கேட்பதினாலும் அவருடைய ஆவியானவரின் உள்ளான ஏவுதலினாலும்.",
     "anchor": "யெகோவாவால் போதிக்கப்பட்டிருப்பார்கள்"
    }
   ]
  },
  {
   "id": "geneva/ISA.54.14",
   "source_hash": "5a0c46d4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.54.14#p1-5a0c46d4",
     "text": "நிலைத்திருக்கும் உறுதியிலும் திடத்திலும், அது என்றென்றைக்கும் நிலைத்து நிற்கும்படி.",
     "anchor": "நீதியினால் உறுதியாக்கப்பட்டிருப்பாய்"
    }
   ]
  },
  {
   "id": "geneva/ISA.54.15",
   "source_hash": "0b680dfc",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.54.15#p1-485ccd84",
     "text": "அதனால் அது வெற்றிபெறாது.",
     "anchor": "என்னாலே"
    },
    {
     "id": "geneva/ISA.54.15#p2-8f4d1dc9",
     "text": "இது சபையின் உள்ளான பகைவர்களைக் குறிக்கிறது, அதாவது மாயக்காரர்களைக் குறிக்கிறது.",
     "anchor": "உனக்கு விரோதமாகக் கூடுகிறார்களோ, அவர்கள் உன் ஆளுகைக்குள்ளாக வருவார்கள்"
    }
   ]
  },
  {
   "id": "geneva/ISA.54.16",
   "source_hash": "856ea67e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.54.16#p1-856ea67e",
     "text": "இதனால், தேவன் வல்லமை தந்தளவுக்கே அல்லாமல் மனிதன் ஒன்றும் செய்யமுடியாது என்பதைக் குறிக்கிறார்: ஏனெனில் எல்லாரும் அவருடைய படைப்புகளாக இருக்கிறபடியால், அவரே அவர்களை ஆளுகை செய்து நடத்த வேண்டும்.",
     "anchor": "கரிநெருப்பை ஊதி... கொல்லனையும்"
    }
   ]
  }
 ]
}
