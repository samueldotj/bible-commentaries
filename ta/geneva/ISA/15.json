   "paragraphs": [
    {
     "id": "geneva/ISA.15.1#p1-fb42a3bd",
     "text": "ஏசாயா 13:1 ஜெனீவா குறிப்பைப் பார்க்கவும்",
     "anchor": "மோவாபைக்குறித்த செய்தி"
    },
    {
     "id": "geneva/ISA.15.1#p2-96c01d7e",
     "text": "தேசம் முழுவதையும் குறிக்கும் தலைநகரம்.",
     "anchor": "மோவாபிலுள்ள ஆர் என்னும் பட்டணம் பாழாக்கப்பட்டது"
    }
   ]
  },
  {
   "id": "geneva/ISA.15.2",
   "source_hash": "8b76726e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.15.2#p1-75896c24",
     "text": "மோவாபியர்கள் ஆறுதலடையும்படி தங்கள் விக்கிரகங்களினிடம் ஓடுவார்கள், ஆனால் அது தாமதமாகி விடும்.",
     "anchor": "பாயித்திற்கும்"
    },
    {
     "id": "geneva/ISA.15.2#p2-0f629038",
     "text": "இவை மோவாபின் பட்டணங்களாக இருந்தன.",
     "anchor": "நேபோவின்"
    },
    {
     "id": "geneva/ISA.15.2#p3-0365c6d8",
     "text": "மேற்குப் பகுதிகளில் மக்கள் துக்கப்படும்போது தங்கள் தலைமயிரை நீளமாக வளரவிடுவது வழக்கம்; ஆனால் கிழக்குப் பகுதிகளில் அதை மொட்டையடிப்பது வழக்கம்.",
     "anchor": "தலைகளெல்லாம் மொட்டையடித்திருக்கும்"
    }
   ]
  },
  {
   "id": "geneva/ISA.15.5",
   "source_hash": "4dba0034",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.15.5#p1-4cd7bf77",
     "text": "தீர்க்கதரிசி இதை மோவாபியர்களின் பேச்சாகவே சொல்கிறார்; அல்லது தேவனுடைய கடுமையான நியாயத்தீர்ப்பு அவர்கள்மேல் வரும் என்பதை உணர்ந்தவனாக இதைச் சொல்கிறார்.",
     "anchor": "என் இருதயம் மோவாபுக்காக ஓலமிடுகிறது"
    },
    {
     "id": "geneva/ISA.15.5#p2-de95232b",
     "text": "எப்பொழுதும் சுக போகத்தில் வாழ்ந்து, ஒருபோதும் துக்கத்தை உணராத பட்டணமாக இருந்தது என்பதைக் குறிக்கிறது.",
     "anchor": "மூன்று வயது கிடாரி"
    },
    {
     "id": "geneva/ISA.15.5#p3-6bb38540",
     "text": "மோவாபியர்களின் பரிதாபமான சிதறுதலையும் ஓட்டத்தையும் அவர் விவரிக்கிறார்.",
     "anchor": "நொறுங்குதலின் சத்தமிடுகிறார்கள்"
    }
   ]
  },
  {
   "id": "geneva/ISA.15.7",
   "source_hash": "6ade5368",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.15.7#p1-6ade5368",
     "text": "தங்களையும் தங்கள் பொருள்களையும் அங்கே மறைத்துக்கொள்வதற்காக.",
     "anchor": "அலரிகளின் ஆற்றுக்கப்பால்"
    }
   ]
  },
  {
   "id": "geneva/ISA.15.9",
   "source_hash": "a2025a37",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.15.9#p1-da3e552b",
     "text": "கொலையுண்டவர்களினுடையது.",
     "anchor": "இரத்தத்தால்"
    },
    {
     "id": "geneva/ISA.15.9#p2-f1c08a9f",
     "text": "எந்த வகையிலும் அவர்கள் தேவனுடைய கரத்திற்குத் தப்பமாட்டார்கள்; இவ்வண்ணமே தேவன் தமது சபையின் விரோதிகளைத் தண்டிப்பார்.",
     "anchor": "மோவாபிலே தப்பினவர்கள்மேலும்"
    }
   ]
  }
 ]
}
