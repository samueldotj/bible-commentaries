 "units": [
  {
   "id": "geneva/ISA.62.1",
   "source_hash": "4fd8ba05",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.62.1#p1-e78f8505",
     "text": "தீர்க்கதரிசி தன் மக்களுடைய இரட்சிப்பின் நல்ல செய்தியை அறிவிப்பதை ஒருபோதும் நிறுத்தமாட்டேன் என்று சொல்கிறார்.",
     "anchor": "மவுனமாயிராமலும்"
    },
    {
     "id": "geneva/ISA.62.1#p2-f26b06c3",
     "text": "அவர்களுக்கு முழு இரட்சிப்பு உண்டாகும்வரை: தேவனுடைய கிருபைகளைச் சபையின்மேல் அறிவிக்கும் காரியத்தில் மற்ற ஊழியக்காரர் அனைவரையும் உற்சாகப்படுத்துவதற்காக தீர்க்கதரிசி இதைச் சொல்கிறார்.",
     "anchor": "பிரகாசத்தைப்"
    }
   ]
  },
  {
   "id": "geneva/ISA.62.2",
   "source_hash": "52497c00",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.62.2#p1-52497c00",
     "text": "நீ இதுவரை பெற்றிருந்ததைவிட மிகவும் மேலான புகழைப் பெறுவாய்.",
     "anchor": "புதிய பெயரால்"
    }
   ]
  },
  {
   "id": "geneva/ISA.62.3",
   "source_hash": "e545ff87",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.62.3#p1-e545ff87",
     "text": "ஒரு ராஜா தன் கிரீடத்தை எவ்வளவு அருமையாகவும் விலையுள்ளதாகவும் எண்ணுகிறாரோ, அவ்வளவு அருமையாகவும் விலையுள்ளதாகவும் தேவன் உங்களை எண்ணுவார்.",
     "anchor": "அலங்காரமான கிரீடமும்"
    }
   ]
  },
  {
   "id": "geneva/ISA.62.4",
   "source_hash": "eeca2821",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.62.4#p1-1c546372",
     "text": "தன் கணவனால் கைவிடப்பட்ட பெண் என்று நீ இனி இழிவாக எண்ணப்படமாட்டாய்.",
     "anchor": "கைவிடப்பட்டவள்"
    },
    {
     "id": "geneva/ISA.62.4#p2-18cd2ce7",
     "text": "அது பிள்ளைகளால் நிறைந்திருக்கும்படி.",
     "anchor": "பியூலா"
    }
   ]
  },
  {
   "id": "geneva/ISA.62.5",
   "source_hash": "16647cf9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.62.5#p1-16647cf9",
     "text": "அவர்கள் உன்னுடன் ஒரே விசுவாசத்தையும் மதத்தையும் அறிக்கையிடுகிறவர்களாய் இருப்பதால், அவர்கள் உன்னுடன் அதே திருமண பந்தத்தில் இருக்கிறார்கள், மேலும் அவர்கள் சபையின் பிள்ளைகள் என்று அழைக்கப்படுகிறார்கள், ஏனெனில் கிறிஸ்து அவளைத் தமக்குப் பிள்ளைகளைப் பெறச் செய்யும்படி பரிபூரணமாக்குகிறார்.",
     "anchor": "உன்னை திருமணம்செய்வார்கள்"
    }
   ]
  },
  {
   "id": "geneva/ISA.62.6",
   "source_hash": "9ef75a6c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.62.6#p1-f95b68ad",
     "text": "தீர்க்கதரிசிகள், மேய்ப்பர்கள் மற்றும் ஊழியக்காரர்கள்.",
     "anchor": "காவற்காரர்களை"
    },
    {
     "id": "geneva/ISA.62.6#p2-f4e43c6c",
     "text": "தமது சபையின் விடுதலைக்காக ஜெபத்தினால் தேவனை நோக்கிக் கூப்பிடுவதை ஒருபோதும் நிறுத்தாதிருக்கவும், மற்றவர்களுக்கும் அப்படியே செய்யப் போதிக்கவும் ஊழியக்காரரை அவர் எச்சரிக்கிறார்.",
     "anchor": "யெகோவாவைப் பிரஸ்தாபம்செய்கிறவர்களே"
    }
   ]
  },
  {
   "id": "geneva/ISA.62.7",
   "source_hash": "797c1a6b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.62.7#p1-797c1a6b",
     "text": "அதை மீட்டமைத்ததற்காக உலகமெல்லாம் அவரைத் துதிக்கும்.",
     "anchor": "பூமியிலே புகழ்ச்சியாக்கும்"
    }
   ]
  },
  {
   "id": "geneva/ISA.62.10",
   "source_hash": "c1bfa449",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.62.10#p1-c1bfa449",
     "text": "சபைக்கு வந்து சேரும் பெரிய கூட்டத்தையும், அதை மீண்டும் நிலைநிறுத்துவதற்காக அவர் ஏற்படுத்தும் வழிமுறைகளையும் குறிக்கிறது, ஏசாயா 57:14 இல் உள்ளதுபோல.",
     "anchor": "வாசல்கள் வழியாக நுழையுங்கள், நுழையுங்கள்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்்,நுழையுங்கள்"
    }
   ]
  },
  {
   "id": "geneva/ISA.62.11",
   "source_hash": "45a24ebf",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.62.11#p1-455102dc",
     "text": "தீர்க்கதரிசிகளும் ஊழியக்காரருமாகிய நீங்கள் இந்த மக்களுக்கு அவர்களுடைய இரட்சிப்பை காண்பியுங்கள்: இது முதன்மையாகக் கிறிஸ்துவின் மூலமான நமது இரட்சிப்பைக் குறித்ததாகும், சகரியா 9:9, மத்தேயு 21:5.",
     "anchor": "மகளாகிய சீயோனை நோக்கி... சொல்லுங்கள்"
    },
    {
     "id": "geneva/ISA.62.11#p2-35cb843c",
     "text": "தமது நோக்கத்தை நிறைவேற்றுவதற்கு அவருக்கு எல்லா வல்லமையும் உண்டு, ஏசாயா 40:10 இல் இருப்பதுபோல.",
     "anchor": "அவர் செய்யும் பிரதிபலன் அவர் முன்பாகவும் வருகிறது"
    }
   ]
  },
  {
   "id": "geneva/ISA.62.12",
   "source_hash": "2be49d1d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.62.12#p1-2be49d1d",
     "text": "அதாவது, அவள் கைவிடப்பட்டிருந்தபோது அவளை மீட்டுக்கொள்ள தேவன் தனிப்பட்ட கரிசனை காட்டியவள்.",
     "anchor": "கைவிடப்படாத நகரமென்றும்"
    }
   ]
  }
 ]
}
