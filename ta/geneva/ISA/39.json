   "paragraphs": [
    {
     "id": "geneva/ISA.39.1#p1-fab811e2",
     "text": "இவன் தன் ஆட்சியின் பத்தாம் வருஷத்தில் அசீரியரை மேற்கொண்ட, பாபிலோனின் முதலாம் ராஜா.",
     "anchor": "மெரோதாக்பலாதான்"
    }
   ]
  },
  {
   "id": "geneva/ISA.39.2",
   "source_hash": "e2e6ff3e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
