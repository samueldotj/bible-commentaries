 "units": [
  {
   "id": "geneva/ISA.58.1",
   "source_hash": "7f1cfc37",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.58.1#p1-7f1cfc37",
     "text": "கர்த்தர் இவ்விதமாகத் தீர்க்கதரிசியிடத்தில் பேசி, மாயக்காரரைக் கடிந்துகொள்ளும்படி எல்லா ஜாக்கிரதையையும் கண்டிப்பையும் காட்டவேண்டுமென்று அவரிடம் விரும்புகிறார்.",
     "anchor": "சத்தமிட்டுக்"
    }
   ]
  },
  {
   "id": "geneva/ISA.58.2",
   "source_hash": "a1d34b3f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.58.2#p1-a1d34b3f",
     "text": "அவர்கள் என்னைத் தொழுதுகொள்வதாகவும் வெளிப்பரிசுத்தமுள்ளவர்களாகவும் காணப்படுவார்கள்.",
     "anchor": "நாள்தோறும் என்னைத் தேடி"
    }
   ]
  },
  {
   "id": "geneva/ISA.58.3",
   "source_hash": "517fa091",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.58.3#p1-1087a9ec",
     "text": "தேவனுடைய பேரில் மாறுவேஷக்காரர்கள் காண்பிக்கிற பொறாமையையும், அவர்களுடைய செய்கைகள் அங்கீகரிக்கப்படாதிருந்தால் அவர்கள் அடைகிற மனக்கசப்பையும் இவ்விடத்தில் காண்பிக்கிறார்.",
     "anchor": "நாங்கள் உபவாசிக்கும்போது நீர் கவனிக்காமல் இருக்கிறதென்ன?"
    },
    {
     "id": "geneva/ISA.58.3#p2-78c8f5ce",
     "text": "இவ்விதமாக, மாறுவேஷக்காரர்களுக்கு விசுவாசமும் மார்க்கமும் இல்லை என்பதை, இரண்டாம் பலகையினாலும், அவர்கள் தங்கள் அயலகத்தாருக்குச் செய்யவேண்டிய கடமையினாலும் அவர் நிரூபிக்கிறார்.",
     "anchor": "ஆசையின்படி"
    }
   ]
  },
  {
   "id": "geneva/ISA.58.4",
   "source_hash": "38684813",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.58.4#p1-38684813",
     "text": "நீங்கள் வழக்கையும் கொடுமையையும் நடத்திக்கொண்டிருக்கும் வரையில், உங்களுடைய உபவாசமும் ஜெபமும் கேட்கப்படமாட்டாது.",
     "anchor": "உயரத்திலே கேட்க"
    }
   ]
  },
  {
   "id": "geneva/ISA.58.6",
   "source_hash": "f9a59e53",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.58.6#p1-f9a59e53",
     "text": "நீங்கள் உங்களுடைய கொடுங்கொடுமைகளையெல்லாம் விட்டுவிடும்படி.",
     "anchor": "நுகத்தடி"
    }
   ]
  },
  {
   "id": "geneva/ISA.58.7",
   "source_hash": "976484bb",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.58.7#p1-976484bb",
     "text": "ஏனெனில் அவனில் நீ உன்னையே ஒரு கண்ணாடியில் காண்பது போல் காண்கிறாய்.",
     "anchor": "உன் உறவினனுக்கு"
    }
   ]
  },
  {
   "id": "geneva/ISA.58.8",
   "source_hash": "7d377b8c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.58.8#p1-c09deed8",
     "text": "அதாவது, தேவன் உன்னை ஆசீர்வதிக்கும் சுகவாழ்வான நிலைமையைக் குறிக்கும்.",
     "anchor": "உன் சுகவாழ்வு"
    },
    {
     "id": "geneva/ISA.58.8#p2-311b0ac4",
     "text": "உன் நன்மையின் சாட்சி தேவனுக்கு முன்பாகவும் மனிதருக்கு முன்பாகவும் தோன்றும்.",
     "anchor": "உன் நீதி உனக்கு முன்னாலே செல்லும்"
    }
   ]
  },
  {
   "id": "geneva/ISA.58.9",
   "source_hash": "1665e1b8",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.58.9#p1-1665e1b8",
     "text": "இதனால் எல்லாவிதமான அநியாயமும் குறிக்கப்படுகிறது.",
     "anchor": "குற்றம்சாட்டுதலையும்"
    }
   ]
  },
  {
   "id": "geneva/ISA.58.10",
   "source_hash": "84c35ece",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.58.10#p1-d81cdb51",
     "text": "அதாவது, அவர்களுடைய துக்கங்களில் மனதுருகுதல்.",
     "anchor": "பசியுள்ளவனிடத்தில் உன் ஆத்துமாவைச் சாய்த்து"
    },
    {
     "id": "geneva/ISA.58.10#p2-e0adb0c1",
     "text": "உன் துன்பம் நன்மையாக மாறும்.",
     "anchor": "இருள்"
    }
   ]
  },
  {
   "id": "geneva/ISA.58.12",
   "source_hash": "94e10114",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.58.12#p1-94e10114",
     "text": "யூதர்களிலிருந்து எருசலேமையும் யூதேயாவையும் மறுபடியும் கட்டுகிறவர்கள் தோன்றுவார்கள் என்பதைக் குறிக்கிறது; ஆனாலும் இது முதன்மையாக ஆவிக்குரிய எருசலேமைக் குறிக்கிறது, அதைக் கட்டினவர்கள் அப்போஸ்தலர்கள்.",
     "anchor": "பாழாய்க்கிடந்த இடங்களை"
    }
   ]
  },
  {
   "id": "geneva/ISA.58.13",
   "source_hash": "9c67426c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.58.13#p1-9c67426c",
     "text": "நீ உன் துன்மார்க்கமான செய்கைகளிலிருந்து உன்னைத் தடுத்துக்கொள்வாயானால்.",
     "anchor": "உன் காலை விலக்கி"
    }
   ]
  }
 ]
}
