 "units": [
  {
   "id": "geneva/ISA.61.1",
   "source_hash": "c855df91",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.61.1#p1-b7be4efa",
     "text": "இது தேவனுடைய எல்லா தீர்க்கதரிசிகளுக்கும் ஊழியக்காரருக்கும் பொதுவானது, ஆனாலும் முதன்மையாக கிறிஸ்துவைக் குறிக்கிறது; அவருடைய நிறைந்த கிருபைகளிலிருந்து ஒவ்வொருவரும் அவர் பங்கிடும்படி பிரியப்படுகிறவாறு பெற்றுக்கொள்கிறார்கள்.",
     "anchor": "என்மேல்"
    },
    {
     "id": "geneva/ISA.61.1#p2-08309459",
     "text": "தங்கள் பாவங்களின் உணர்வினால் உயிர்ப்புள்ளதாக தொடப்பட்டவர்களைக் குறிக்கிறது.",
     "anchor": "இருதயம் நொறுங்குண்டவர்களுக்கு"
    },
    {
     "id": "geneva/ISA.61.1#p3-6dda9d21",
     "text": "பாவத்தின் அடிமைத்தனத்தில் இருக்கிறவர்கள்.",
     "anchor": "சிறைப்பட்டவர்களுக்கு"
    }
   ]
  },
  {
   "id": "geneva/ISA.61.2",
   "source_hash": "0b58e07e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.61.2#p1-cad2ab98",
     "text": "தேவன் மனிதனுக்குத் தமது தயவைக் காண்பிக்க பிரியப்பட்ட காலம், அதைப் பவுல் காலத்தின் நிறைவு என்று அழைக்கிறார், கலா 4:4.",
     "anchor": "யெகோவாவுடைய அநுக்கிரக வருடத்தை"
    },
    {
     "id": "geneva/ISA.61.2#p2-0a803021",
     "text": "தேவன் தமது சபையை விடுவிக்கும்போது, அவர் தமது எதிரிகளை தண்டிக்கிறார்.",
     "anchor": "நம்முடைய தேவன் நீதியைநிலைப்படுத்தும் நாளையும்"
    }
   ]
  },
  {
   "id": "geneva/ISA.61.3",
   "source_hash": "34ed23a4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.61.3#p1-d79d70d0",
     "text": "இது துக்கத்தின் அடையாளமாக இருந்தது.",
     "anchor": "சாம்பலுக்குப் பதிலாக"
    },
    {
     "id": "geneva/ISA.61.3#p2-9c0b3bc0",
     "text": "நல்ல கனிகளைத் தரும் மரங்கள், மத். 3:8 இல் இருப்பதைப்போல.",
     "anchor": "நீதியின் மரங்கள்"
    }
   ]
  },
  {
   "id": "geneva/ISA.61.4",
   "source_hash": "b75a2983",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.61.4#p1-b75a2983",
     "text": "அதாவது, நீண்ட காலமாக.",
     "anchor": "தலைமுறை தலைமுறையாக"
    }
   ]
  },
  {
   "id": "geneva/ISA.61.5",
   "source_hash": "a13266b8",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.61.5#p1-a13266b8",
     "text": "அவர்கள் உங்களுடைய எல்லா தேவைகளிலும் உங்களுக்கு உதவி செய்ய ஆயத்தமாயிருப்பார்கள்.",
     "anchor": "நின்றுகொண்டு உங்கள் மந்தைகளை மேய்த்து"
    }
   ]
  },
  {
   "id": "geneva/ISA.61.6",
   "source_hash": "73d56b4b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.61.6#p1-53091146",
     "text": "இது கிறிஸ்துவின் காலத்தில் நிறைவேறியது; அவரால் உண்மையுள்ளவர்கள் எல்லோரும் ஆசாரியர்களும் ராஜாக்களுமாக்கப்படுகிறார்கள், 1பேதுரு 2:9, வெளிப்படுத்தின விசேஷம் 1:6, 5:10.",
     "anchor": "யெகோவாவின் ஆசாரியரென்று சொல்லப்படுவீர்கள்"
    },
    {
     "id": "geneva/ISA.61.6#p2-a552a6d0",
     "text": "ஏசாயா 6:11, 16-ஐ வாசிக்கவும்.",
     "anchor": "தேசங்களின் செல்வத்தை அநுபவித்து"
    }
   ]
  },
  {
   "id": "geneva/ISA.61.7",
   "source_hash": "783b9de6",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.61.7#p1-b9ca1f6a",
     "text": "இந்த வார்த்தை ஏசாயா 40:2-ல் பயன்படுத்தப்பட்டுள்ளதுபோல, ஏராளமான பலன்.",
     "anchor": "இரண்டு மடங்கு பலன்"
    },
    {
     "id": "geneva/ISA.61.7#p2-8ff43ae8",
     "text": "அதாவது, யூதர்கள்.",
     "anchor": "சந்தோஷப்படுவார்கள்"
    },
    {
     "id": "geneva/ISA.61.7#p3-8f3519c7",
     "text": "அதாவது, யூதரல்லாதவர்களுடையது.",
     "anchor": "தங்கள் பாகத்தில்"
    },
    {
     "id": "geneva/ISA.61.7#p4-92e8f6d5",
     "text": "முன்னாட்களில் யூதரல்லாதவர் யூதர்களின்மேல் ஆளுகை செய்திருந்தபோதும், இப்பொழுது அவர்கள் அவர்கள்மேல் இரண்டு மடங்கு அதிகாரம் பெற்று, இரண்டு மடங்கு உடையவராயிருப்பார்கள்.",
     "anchor": "இரட்டிப்பான"
    }
   ]
  },
  {
   "id": "geneva/ISA.61.8",
   "source_hash": "e01633a5",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.61.8#p1-e01633a5",
     "text": "கொள்ளையர்களும், வஞ்சகர்களும், மாயக்காரர்களும், அல்லது எனக்குரிய மகிமையைப் பறித்துக்கொள்பவர்களும் செலுத்தும் காணிக்கைகளை நான் ஏற்றுக்கொள்ளமாட்டேன்.",
     "anchor": "கொள்ளைப்பொருளினால் செலுத்தப்பட்ட தகனபலியை"
    }
   ]
  },
  {
   "id": "geneva/ISA.61.9",
   "source_hash": "531a51bd",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.61.9#p1-531a51bd",
     "text": "அதாவது, சபையினுடையது.",
     "anchor": "அவர்களுடைய சந்ததியானது அறியப்பட்டிருக்கும்"
    }
   ]
  },
  {
   "id": "geneva/ISA.61.10",
   "source_hash": "0b18e886",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.61.10#p1-0b18e886",
     "text": "தங்களுடைய விடுதலையை உணரும்போது அவர்களுக்கு உண்டாகும் உணர்வு எப்படியிருக்கும் என்பதைக் காண்பிக்கிறார்.",
     "anchor": "பூரிப்பாய் மகிழுகிறேன்"
    }
   ]
  }
 ]
}
