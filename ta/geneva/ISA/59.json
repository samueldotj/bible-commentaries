 "units": [
  {
   "id": "geneva/ISA.59.3",
   "source_hash": "1887f5f9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.59.3#p1-1887f5f9",
     "text": "ஏசாயா 1:15-ஐ பார்க்கவும்.",
     "anchor": "இரத்தத்தாலும்"
    }
   ]
  },
  {
   "id": "geneva/ISA.59.4",
   "source_hash": "1c0a7ffc",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.59.4#p1-98dcb435",
     "text": "எல்லா மனிதரும் அநியாயங்களையும் ஒடுக்குதல்களையும் கண்டுகொள்ளாதவர்போல் இருக்கிறார்கள், ஒருவரும் அவற்றைத் திருத்த முயலுகிறதில்லை.",
     "anchor": "சத்தியத்தின்படி வழக்காடுகிறவனுமில்லை"
    },
    {
     "id": "geneva/ISA.59.4#p2-fd40ce1d",
     "text": "தங்கள் துன்மார்க்கமான சூழ்ச்சிகளுக்கேற்ப, தங்கள் அயலகத்தாருக்குத் தீங்கு செய்கிறார்கள்.",
     "anchor": "அக்கிரமத்தைப் பெறுகிறார்கள்"
    }
   ]
  },
  {
   "id": "geneva/ISA.59.5",
   "source_hash": "8b5d2a73",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.59.5#p1-58c9264d",
     "text": "அவைகளிலிருந்து வருவதெல்லாம் விஷமும் மரணத்தை உண்டாக்குகிறதுமாக இருக்கும்.",
     "anchor": "கட்டுவிரியனின் முட்டைகளை"
    },
    {
     "id": "geneva/ISA.59.5#p2-92618f6f",
     "text": "அவைகள் எந்த நோக்கத்திற்கும் பயன்படாதவை.",
     "anchor": "வலைகளை"
    }
   ]
  },
  {
   "id": "geneva/ISA.59.9",
   "source_hash": "38c6801d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.59.9#p1-49a281a8",
     "text": "அதாவது, எங்கள் சத்துருக்களைத் தண்டிக்கும் தேவனுடைய கடுங்கோபம்.",
     "anchor": "நியாயம் எங்களுக்குத் தூரமாயிருக்கிறது"
    },
    {
     "id": "geneva/ISA.59.9#p2-27326749",
     "text": "எங்களைப் பாதுகாக்கும் தேவனுடைய பாதுகாப்பு.",
     "anchor": "நீதி எங்களைத் தொடர்ந்து பிடிக்காது"
    }
   ]
  },
  {
   "id": "geneva/ISA.59.10",
   "source_hash": "d80989f9",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.59.10#p1-d80989f9",
     "text": "நாங்கள் எல்லா ஆலோசனையும் இல்லாதவர்களாய் இருக்கிறோம், எங்கள் துக்கங்களுக்கு முடிவைக் கண்டுபிடிக்க முடியாதவர்களாய் இருக்கிறோம்.",
     "anchor": "குருடரைபோல்"
    }
   ]
  },
  {
   "id": "geneva/ISA.59.11",
   "source_hash": "da700e54",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.59.11#p1-da700e54",
     "text": "நாம் நம் துக்கங்களை வெளிப்படையான அடையாளங்களால் வெளிப்படுத்துகிறோம், ஒருவர் அதிகமாகவும் ஒருவர் குறைவாகவும்.",
     "anchor": "கரடிகளைப்போல உறுமி"
    }
   ]
  },
  {
   "id": "geneva/ISA.59.12",
   "source_hash": "c00d63f4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.59.12#p1-c00d63f4",
     "text": "இந்த அறிக்கை பாவமன்னிப்பைப் பெறுவதற்காக சபைக்குப் பொதுவானது, தீர்க்கதரிசிகளும் இதிலிருந்து தங்களைத் தவிர்த்துக்கொள்ளவில்லை.",
     "anchor": "எங்கள் பாவங்கள் எங்களுக்கு விரோதமாகச் சாட்சி சொல்கிறது"
    }
   ]
  },
  {
   "id": "geneva/ISA.59.13",
   "source_hash": "95a293c4",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.59.13#p1-95a293c4",
     "text": "அதாவது, எங்கள் அயலகத்தாருக்கு விரோதமாக.",
     "anchor": "கொடுமையாகவும்"
    }
   ]
  },
  {
   "id": "geneva/ISA.59.14",
   "source_hash": "dedb7bf8",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.59.14#p1-dedb7bf8",
     "text": "மனிதரிடையே நியாயமும் யதார்த்தமும் இல்லை.",
     "anchor": "நியாயம் பின்னிட்டு அகன்றது"
    }
   ]
  },
  {
   "id": "geneva/ISA.59.15",
   "source_hash": "1dedb090",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.59.15#p1-1dedb090",
     "text": "துன்மார்க்கர் அவனை அழிப்பார்கள்.",
     "anchor": "கொள்ளையாகிறான்"
    }
   ]
  },
  {
   "id": "geneva/ISA.59.16",
   "source_hash": "7d1c48e0",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.59.16#p1-4943b406",
     "text": "அதாவது, நியாயம் செய்யவும், அவ்வளவு ஒழுங்குகெட்டுப் போயிருந்தவைகளை சரிசெய்யவும் என்று அர்த்தம்.",
     "anchor": "ஆதலால் அவருடைய புயமே"
    },
    {
     "id": "geneva/ISA.59.16#p2-a13a0f8b",
     "text": "அதாவது, அவருடைய சபை அல்லது அவருடைய புயம் தானே தனக்கு உதவிசெய்து, வேறொருவரிடத்திலும் உதவியைத் தேடவில்லை என்று அர்த்தம்.",
     "anchor": "அவருக்கு இரட்சிப்பாகி"
    }
   ]
  },
  {
   "id": "geneva/ISA.59.17",
   "source_hash": "efc3698b",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.59.17#p1-efc3698b",
     "text": "தமது சபையை விடுவிக்கவும், அவர்களுடைய பகைவரைத் தண்டிக்கவும் தேவனுக்கு எல்லா வழிமுறைகளும் கைவசம் இருக்கிறது என்பதைக் குறிக்கிறது.",
     "anchor": "இரட்சிப்பென்னும் தலைக்கவசத்தைத் தமது தலையில்"
    }
   ]
  },
  {
   "id": "geneva/ISA.59.18",
   "source_hash": "a4e1d118",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.59.18#p1-a4e1d118",
     "text": "அதாவது, பல்வேறு இடங்களிலும், கடலுக்கு அப்பாலும் குடியிருக்கிற உங்கள் பகைவர்கள்.",
     "anchor": "தீவுகளுக்குத்தக்க பலனையும் சரிக்கட்டுவார்"
    }
   ]
  },
  {
   "id": "geneva/ISA.59.19",
   "source_hash": "1dd6b371",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.59.19#p1-1dd6b371",
     "text": "சபையில் மிகுந்த உபத்திரவம் உண்டாகும் என்று அவர் காண்பிக்கிறார், ஆனாலும் தேவன் எப்பொழுதும் தமக்குரியவர்களை விடுவிப்பார்.",
     "anchor": "வெள்ளம்போல் எதிரி வரும்போது"
    }
   ]
  },
  {
   "id": "geneva/ISA.59.20",
   "source_hash": "46970c83",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.59.20#p1-46970c83",
     "text": "இதனால் அவர் பாவத்திலும் சாத்தானிடத்திலும் இருந்து உண்டாகும் மெய்யான விடுதலை, தேவனுடைய பிள்ளைகளாகிய, அவர் நீதிமான்களாக்குகிறவர்களுக்கே அன்றி வேறு யாருக்கும் உரியதல்ல என்று அறிவிக்கிறார்.",
     "anchor": "மீறுதலைவிட்டுத் திரும்புகிறவர்களுக்கும்"
    }
   ]
  },
  {
   "id": "geneva/ISA.59.21",
   "source_hash": "21cb3402",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.59.21#p1-21cb3402",
     "text": "உபதேசம் ஆவியானவரின் வல்லமையினால் பயனுள்ளதாக்கப்படுவதால், அவர் இவ்விரண்டையும் ஒன்றுசேர்த்து, இவை இரண்டையும் தம்முடைய சபைக்கு என்றென்றைக்கும் அளிப்பதாக வாக்குத்தத்தம் செய்கிறார்.",
     "anchor": "உன் வாயிலிருந்தும் நீங்குவதில்லை"
    }
   ]
  }
 ]
}
