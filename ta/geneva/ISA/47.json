 "units": [
  {
   "id": "geneva/ISA.47.1",
   "source_hash": "51f31894",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.47.1#p1-a79dc383",
     "text": "செல்வத்திலும் சுகபோகத்திலும் வாழ்ந்து இதுவரை எந்தச் சத்துருக்களாலும் மேற்கொள்ளப்படாதவள்.",
     "anchor": "பாபிலோனின் கன்னிப்பெண்ணாகிய மகளே"
    },
    {
     "id": "geneva/ISA.47.1#p2-138f5209",
     "text": "உன் ஆளுகை உன்னிடமிருந்து எடுக்கப்படும்.",
     "anchor": "சிங்காசனம்"
    }
   ]
  },
  {
   "id": "geneva/ISA.47.2",
   "source_hash": "e59c6c23",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.47.2#p1-1dbfb2a8",
     "text": "நீ மிக்க இழிவான அடிமைத்தனத்திற்குள்ளாக்கப்படுவாய்; ஏனெனில் இயந்திரத்தைத் திருப்பி மாவரைப்பது அடிமைகளின் வேலையாக இருந்தது.",
     "anchor": "மாவரை"
    },
    {
     "id": "geneva/ISA.47.2#p2-5ed5b7fd",
     "text": "அவள் மிகவும் பெருமைப்படும் காரியங்கள் தலைமுதல் கால்வரை இழிவாக்கப்படும்.",
     "anchor": "வெறுங்காலும் நிர்வாணத்தொடையுமாக"
    }
   ]
  },
  {
   "id": "geneva/ISA.47.3",
   "source_hash": "3673136e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.47.3#p1-3673136e",
     "text": "நான் உங்கள்மேல் மனுஷீகமும் இரக்கமும் காண்பிக்கமாட்டேன்.",
     "anchor": "நான் ஒருவனையும் பாராமல்"
    }
   ]
  },
  {
   "id": "geneva/ISA.47.4",
   "source_hash": "3bd49fe3",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.47.4#p1-3bd49fe3",
     "text": "கர்த்தர் தம்முடைய சபையின் நிமித்தமாக இதைச் செய்கிறார் என்று இஸ்ரவேலர்கள் அறிக்கையிடுவார்கள்.",
     "anchor": "எங்கள் மீட்பருடைய நாமம்"
    }
   ]
  },
  {
   "id": "geneva/ISA.47.5",
   "source_hash": "1ae2e14d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.47.5#p1-1ae2e14d",
     "text": "வெட்கத்தினிமித்தம், உன்னை மறைத்துக்கொள்.",
     "anchor": "மவுனமாக உட்காரு"
    }
   ]
  },
  {
   "id": "geneva/ISA.47.6",
   "source_hash": "76e96f7e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.47.6#p1-76e96f7e",
     "text": "அவர்கள் தேவனுடைய நியாயத்தீர்ப்புகளை தவறாகப் பயன்படுத்தினார்கள்; அவர் இஸ்ரவேலரை முற்றிலும் தள்ளிவிடுவதற்காகவே தண்டிக்கிறார் என்று நினைத்தார்கள்; ஆகவே அவர்களுடைய துக்கத்தில் இரங்குவதற்குப் பதிலாக, நீ அதை அதிகரித்தாய்.",
     "anchor": "இரக்கம்வைக்காமல்"
    }
   ]
  },
  {
   "id": "geneva/ISA.47.9",
   "source_hash": "cf3d52d2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.47.9#p1-cf3d52d2",
     "text": "இதனால் உன் தண்டனை நினைத்துப் பார்க்கக்கூடிய அளவுக்கு மிகவும் பெரியதாக இருக்கும்.",
     "anchor": "உன் திரளான சூனியங்களினிமித்தமும், உன் வெகுவான மந்திரவித்தைகளினிமித்தமும் அவைகள் பூரணமாக"
    }
   ]
  },
  {
   "id": "geneva/ISA.47.10",
   "source_hash": "b8f76398",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.47.10#p1-b8f76398",
     "text": "உன் சொந்த ஞானமும் தந்திரமும் உன்னை இரட்சிக்கும் என்று நீ நினைத்தாய்.",
     "anchor": "உன் ஞானமும் உன் அறிவுமே"
    }
   ]
  },
  {
   "id": "geneva/ISA.47.12",
   "source_hash": "c8d21877",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.47.12#p1-c8d21877",
     "text": "தேவனை அல்லாமல் மற்றெதிலாகிலும் நம்பிக்கை வைக்கிறவர்களின் வீணான நம்பிக்கையை அவர் கேலி செய்கிறார்; அப்படியே ஜனங்களை ஏமாற்றுவதற்கும், தேவன் ஒருவரையே சார்ந்திருப்பதிலிருந்து அவர்களை விலக்குவதற்கும் மட்டுமே பயன்படுகிற அத்தகைய வீணான வித்தைகளையும் அவர் கண்டிக்கிறார்.",
     "anchor": "நீ உன் சிறுவயதுமுதல் பிரயாசப்பட்டு"
    }
   ]
  },
  {
   "id": "geneva/ISA.47.14",
   "source_hash": "bd021e6e",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.47.14#p1-bd021e6e",
     "text": "அவர்கள் முழுவதுமாக அழிந்துபோவார்கள், அவர்களில் ஒரு பங்கும் மீந்திருக்காது.",
     "anchor": "குளிர்காயத்தக்க"
    }
   ]
  },
  {
   "id": "geneva/ISA.47.15",
   "source_hash": "3c38d122",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.47.15#p1-3c38d122",
     "text": "தன்தன் ஆராய்ச்சிகளால் மிகவும் பாதுகாப்பானது என்று எண்ணிய இடத்திற்கு அவரவர் ஓடிப்போவார்கள்; ஆனாலும் அது அவர்களை மோசம்போக்கும்.",
     "anchor": "தங்கள் போக்கிலே"
    }
   ]
  }
 ]
}
