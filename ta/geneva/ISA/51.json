 "units": [
  {
   "id": "geneva/ISA.51.1",
   "source_hash": "89ce8a51",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.51.1#p1-81b79fcf",
     "text": "தங்கள் சிறு எண்ணிக்கையினிமித்தம் அவர்கள் மனந்தளராதபடிக்கு, சபையைத் தேற்றரவு செய்கிறார்.",
     "anchor": "நீதியைப் பின்பற்றி"
    },
    {
     "id": "geneva/ISA.51.1#p2-f942dd92",
     "text": "அதாவது, நீங்கள் யாரால் பிறப்பிக்கப்பட்டீர்களோ அந்த ஆபிரகாமையும், நாம் யாரால் பிறந்தோமோ அந்த சாராளையும் குறிக்கும்.",
     "anchor": "வெட்டி எடுக்கப்பட்ட கன்மலையை"
    }
   ]
  },
  {
   "id": "geneva/ISA.51.3",
   "source_hash": "c6386010",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.51.3#p1-c6386010",
     "text": "பரதீசைப்போல் செழிப்புள்ளது, ஆதி. 2:8,9.",
     "anchor": "ஏதேனைப்போலவும்"
    }
   ]
  },
  {
   "id": "geneva/ISA.51.4",
   "source_hash": "68d427f2",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.51.4#p1-68d427f2",
     "text": "நான் என் சபையை என் வாக்கினாலும் உபதேசத்தினாலும் ஆண்டு நடத்துவேன்.",
     "anchor": "வேதம் என்னிலிருந்து வெளிப்படும்"
    }
   ]
  },
  {
   "id": "geneva/ISA.51.5",
   "source_hash": "2acfdd1d",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.51.5#p1-4560617e",
     "text": "நான் என் வாக்குத்தத்தத்தை நிறைவேற்றும் காலம்.",
     "anchor": "என் நீதி சமீபமாயிருக்கிறது"
    },
    {
     "id": "geneva/ISA.51.5#p2-9e8f063f",
     "text": "என் வல்லமையும் பலமும்.",
     "anchor": "என் புயங்கள் மக்களை நியாயந்தீர்க்கும்"
    }
   ]
  },
  {
   "id": "geneva/ISA.51.6",
   "source_hash": "583c4c2c",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.51.6#p1-583c4c2c",
     "text": "எல்லாவற்றிலும் நேரிடும் பயங்கரமான மாற்றங்களையும் மாறுதல்களையும் குறித்து அவர்களை முன்கூட்டியே எச்சரிக்கிறார், இந்த ஆபத்துகள் எல்லாவற்றின் நடுவிலும் தம்முடைய சபையைத் தாம் எப்படிப் பாதுகாத்துக்கொள்வார் என்பதையும் காண்பிக்கிறார்.",
     "anchor": "வானம் புகையைப்போல் ஒழிந்துபோகும்"
    }
   ]
  },
  {
   "id": "geneva/ISA.51.9",
   "source_hash": "691783dc",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.51.9#p1-78f65fe5",
     "text": "எகிப்திலிருந்து அவர்களை விடுவித்த தமது பெரிய கிருபையை அவர்களுக்கு நினைவூட்டுகிறார், அதினால் அவர் தம்மில் நிலையாக நம்பிக்கை வைக்க அவர்கள் கற்றுக்கொள்வதற்காக.",
     "anchor": "முந்தின தலைமுறைகளிலும்"
    },
    {
     "id": "geneva/ISA.51.9#p2-8ecfcf66",
     "text": "எகிப்தைக் குறிக்கிறது, சங்கீதம் 87:4.",
     "anchor": "இராகாபை்த்து்ண்டித்ததும்"
    },
    {
     "id": "geneva/ISA.51.9#p3-d1a5601c",
     "text": "அதாவது, பார்வோன், எசேக்கியேல் 29:3.",
     "anchor": "வலுசர்ப்பத்தை"
    }
   ]
  },
  {
   "id": "geneva/ISA.51.11",
   "source_hash": "de134bf8",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.51.11#p1-de134bf8",
     "text": "பாபிலோனிலிருந்து.",
     "anchor": "திரும்பிவருவார்கள்"
    }
   ]
  },
  {
   "id": "geneva/ISA.51.14",
   "source_hash": "c529fc21",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.51.14#p1-c529fc21",
     "text": "அவர்களுடைய நாடுகடத்தலின் சுருக்கமான காலத்தினால் அவர் அவர்களுக்கு ஆறுதல் கொடுக்கிறார்: ஏனெனில் எழுபது வருடங்களில் அவர்கள் மீட்கப்பட்டு, உலகின் மிகப்பெரிய பேரரசு அழிக்கப்பட்டது.",
     "anchor": "துரிதமாக விடுதலையாவான்"
    }
   ]
  },
  {
   "id": "geneva/ISA.51.16",
   "source_hash": "cba9c9ec",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.51.16#p1-8edb2b0f",
     "text": "அதாவது, ஏசாயாவுக்கும், அவனுடைய பாதுகாப்பினால் காக்கப்படுகிற எல்லா உண்மையான ஊழியக்காரர்களுக்கும்.",
     "anchor": "வாயிலே"
    },
    {
     "id": "geneva/ISA.51.16#p2-94c2a445",
     "text": "பரலோகத்திலும் பூமியிலும் எல்லாம் திரும்ப ஸ்தாபிக்கப்படுவதற்காக, எபேசியர் 1:10.",
     "anchor": "வானத்தை நிலைப்படுத்தி...பூமியை அஸ்திபாரப்படுத்தி,"
    }
   ]
  },
  {
   "id": "geneva/ISA.51.17",
   "source_hash": "daf594c7",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.51.17#p1-daf594c7",
     "text": "ஏசாயா 40:2-ல் இருப்பதுபோல நீ நியாயமாகவும் போதுமான அளவிலும் தண்டிக்கப்பட்டாய்; இந்தத் தண்டனை தெரிந்துகொள்ளப்பட்டவர்களிடத்தில் அளவோடும், தேவன் அதைக் கேட்கும்படி கிருபை அளிக்கும் அளவுக்கும் ஏற்றபடி நிகழும்: ஆனால் தள்ளப்பட்டவர்களிடத்திலோ, ஏரேமியா 25:15,16-ல் இருப்பதுபோல, அது அவர்களை உணர்வின்மைக்கும் பைத்தியத்திற்கும் தள்ளும் தேவனுடைய நியாயமான கடும்பழிவாகும்.",
     "anchor": "கடுங்கோபத்தின் பாத்திரத்தை"
    }
   ]
  },
  {
   "id": "geneva/ISA.51.19",
   "source_hash": "a4e61ee8",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.51.19#p1-a4e61ee8",
     "text": "இவற்றில் ஒன்று சரீரத்திற்கு நேரிடும் காரியங்களைப் போல வெளிப்புறமானது, அதாவது யுத்தமும் பஞ்சமும்; மற்றொன்று உள்ளானது, மனதைச் சேர்ந்தது: அதாவது, ஆறுதல் இல்லாதிருக்கும் நிலை: ஆகையால் அவர் \"உன்னை எப்படி ஆறுதல்படுத்துவேன்\" என்று சொல்லுகிறார்.",
     "anchor": "இவ்விரண்டும் உனக்குச் சம்பவித்தது"
    }
   ]
  },
  {
   "id": "geneva/ISA.51.21",
   "source_hash": "8218f17f",
   "generator": {
    "name": "claude",
    "model": "claude-sonnet-5",
    "prompt_version": "c1",
    "generated_at": "2026-09-27"
   },
   "paragraphs": [
    {
     "id": "geneva/ISA.51.21#p1-8218f17f",
     "text": "ஆனால் கலக்கத்தினாலும் பயத்தினாலும்.",
     "anchor": "மதுபானங்குடிக்காமல்"
    }
   ]
  }
 ]
}
